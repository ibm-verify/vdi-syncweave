	<description>
		=========================================================================
		Target:		build-embedded
		Purpose:	Builds all the plugins able to run in the TDI's OSGi container
		Result:		The plugin bundles will be available in the directory kept in
					this property: ${project.root.export.osgi.embedded}
		=========================================================================
	</description>
	<target name="build-embedded" depends="setup-embedded">
		<!-- build the OSGi plugins that runs inside the TDI's JVM -->
		<runOSGiPluginBuild buildDirectory="${project.root.export.osgi.build}" eclipse.runtime.path="${project.root.export.osgi.runtime}" pde.build.path="${root.eclipse_rt_pde}" equinox.launcher.path="${root.eclipse_rt_launcher}" />

		<copy todir="${project.root.export.osgi.embedded}">
			<fileset dir="${project.root.export.osgi.build}/eclipse/plugins" includes="*.jar" />
			<mapper refid="osgi.plugins.name.normalizer" />
		</copy>

	
	<!-- Copy Jetty 12 and HTTP service bundles required for embedded OSGi server -->
	<echo message="Copying Jetty and HTTP service bundles to embedded directory..." />
	<copy todir="${project.root.export.osgi.embedded}" overwrite="true">
		<fileset dir="${project.root.export.osgi.runtime}">
			<!-- equinox HTTP stack -->
			<include name="org.eclipse.equinox.http.jetty.jar" />
			<include name="org.eclipse.equinox.http.servlet.jar" />
			<include name="org.eclipse.equinox.http.service.api.jar" />
			<!-- Jetty 12 core -->
			<include name="org.eclipse.jetty.http.jar" />
			<include name="org.eclipse.jetty.io.jar" />
			<include name="org.eclipse.jetty.security.jar" />
			<include name="org.eclipse.jetty.server.jar" />
			<include name="org.eclipse.jetty.session.jar" />
			<include name="org.eclipse.jetty.util.jar" />
			<!-- Jetty 12 EE8 layer (provides javax.servlet + ee8.nested) -->
			<include name="org.eclipse.jetty.ee8.security.jar" />
			<include name="org.eclipse.jetty.ee8.server.jar" />
			<include name="org.eclipse.jetty.ee8.servlet.jar" />
			<include name="org.eclipse.jetty.servlet-api.jar" />
			<!-- servlet API -->
			<include name="jakarta.servlet-api.jar" />
		</fileset>
	</copy>
	<echo message="Jetty bundles copied successfully" />

		<!-- Copy Jackson OSGi wrapper bundles required for JAX-RS 2.1 support -->
	<echo message="Copying Jackson OSGi bundles to embedded directory..." />
	<copy todir="${project.root.export.osgi.embedded}" overwrite="true">
		<fileset dir="${project.root.export.osgi.runtime}">
			<include name="jackson.annotations.jar" />
			<include name="jackson.core.jar" />
			<include name="jackson.databind.jar" />
			<include name="jackson-jaxrs-base.jar" />
			<include name="jackson-jaxrs-json-provider.jar" />
			<include name="jackson-module-jaxb-annotations.jar" />
		</fileset>
	</copy>
	<echo message="Jackson OSGi bundles copied successfully" />
	
	<!-- Copy JAX-RS API and JPA API OSGi bundles required for JAX-RS 2.1 support -->
	<echo message="Copying JAX-RS API and JPA API OSGi bundles to embedded directory..." />
	<copy todir="${project.root.export.osgi.embedded}" overwrite="true">
		<fileset dir="${project.root.export.osgi.runtime}">
			<include name="javax.ws.rs-api.jar" />
			<include name="javax.persistence-api.jar" />
		</fileset>
	</copy>
	<echo message="JAX-RS API and JPA API OSGi bundles copied successfully" />

	<!-- Copy Jersey runtime bundles (NO Jackson) -->
	<echo message="Copying Jersey runtime bundles to embedded directory..." />
	<copy todir="${project.root.export.osgi.embedded}" overwrite="true">
		<fileset dir="${project.root.export.osgi.runtime}">
			<include name="jersey-common.jar" />
			<include name="jersey-server.jar" />
			<include name="jersey-container-servlet.jar" />
			<include name="jersey-hk2.jar" />
		</fileset>
	</copy>
	<echo message="Jersey runtime bundles copied successfully" />

	<!-- Copy supporting dependency OSGi bundles to embedded directory -->
	<echo message="Copying supporting dependency OSGi bundles to embedded directory..." />
	<copy todir="${project.root.export.osgi.embedded}" overwrite="true">
		<fileset dir="${project.root.export.osgi.runtime}">
			<include name="javax.annotation-api.jar" />
