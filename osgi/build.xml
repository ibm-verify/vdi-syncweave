
<project name="SyncWeave OSGi Plugin Builder" default="build-embedded" basedir=".">

	<!--
    =========================================================================
      Properties
    =========================================================================
  	-->

	<!-- Import the project setup properties and macros -->
	<import file="${basedir}/../rules_mk/project_setup.xml" />

	<!-- Add Nashorn JavaScript engine to classpath for Java 15+ compatibility -->
	<path id="nashorn.classpath">
		<fileset dir="${basedir}/../lib/ivy">
			<include name="nashorn-core*.jar"/>
			<include name="asm*.jar"/>
		</fileset>
	</path>

	<!-- Import the project setup properties and macros -->
	<import file="${basedir}/../rules_mk/doc_rules.xml" />

	<dirname file="${root.eclipse_rt_buildfile_updatesite}" property="root.eclipse_rt_pde_scripts" />
	<dirname file="${root.eclipse_rt_pde_scripts}" property="root.eclipse_rt_pde" />

	<mapper id="osgi.plugins.name.normalizer">
		<!-- match all the versioned jar files and get only the base name -->
		<mapper type="regexp" from="^(.*)_\d+\.\d+\.\d+\..+\.jar$$" to="\1.jar" />
                <mapper type="regexp" from="^(.*)_\d+\..+\.jar$$" to="\1.jar" />
		<!-- match all the non-versioned jar files, this is a inverted case because above rule will fail -->
		<mapper type="regexp" from="^([^_]+)\.jar$$" to="\1.jar" />
	</mapper>

	<mapper id="osgi.3rdparty.plugins.name.normalizer">
		<mapper type="regexp" from="^(.*)-\d+\.\d+\.\d+\.jar$$" to="\1.jar" />
	</mapper>

	<description>
		=========================================================================
		Macro:    runOSGiPluginBuild
		Purpose:  Builds an OSGi plugin based on the input given.
		=========================================================================
	</description>
	<macrodef name="runOSGiPluginBuild">
		<attribute name="buildDirectory" />
		<attribute name="equinox.launcher.path" />
		<attribute name="pde.build.path" />
		<attribute name="eclipse.runtime.path" />
		<sequential>
			<!-- execute the ant build script -->
			<exec executable="java" failonerror="yes">
				<arg line="-jar" />
				<arg line="@{equinox.launcher.path}" />
				<arg line="-application" />
				<arg line="org.eclipse.ant.core.antRunner" />
				<arg line="-buildfile" />
				<arg line="@{pde.build.path}/scripts/build.xml" />
				<arg line='-Dbuilder="@{buildDirectory}"' />
				<arg line="-consoleLog" />
				<arg line="-nosplash" />

				<!-- these properties are usually specified in the build.properties file -->

				<!-- The type of the top level element we are building,  generally "feature" -->
				<arg line='-DtopLevelElementType=feature' />
				<!-- The id of the top level element we are building -->
				<arg line='-DtopLevelElementId="${project.tdi.osgi.plugins.prefix}.feature"' />
				<arg line='-DrunPackager=false' />
				<!-- The prefix that will be used in the generated archive -->
				<arg line='-DarchivePrefix=eclipse' />
				<!-- The list of {os, ws, arch} configurations to build.  This
					 value is a '&' separated list of ',' separate triples.  For example,
					     configs=win32,win32,x86 & linux,motif,x86
					 By default the value is *,*,* -->
				<arg line='-Dconfigs="*, *, *"' />
				<!-- The directory into which the build elements are fetched and where the build takes place. -->
				<arg line='-DbuildDirectory="@{buildDirectory}"' />
				<!-- Type of build.  Used in naming the build output.  Typically this value is
					 one of I, N, M, S, etc.. -->
				<arg line='-DbuildType=N' />
				<!-- ID of the build.  Used in naming the build output. -->
				<arg line='-DbuildId="build"' />
				<!-- Label for the build.  Used in naming the build output -->
				<arg line='-DbuildLabel=${project.tdi.osgi.plugins.prefix}' />
				<!-- Make sure the plugin has a timestamp corresponding to the build start -->
				<!-- arg line='-DforceContextQualifier=${DSTAMP}${TSTAMP}' / -->
				<!-- Because we want to avoid the needless manual update of the z/OS build we don't put the timestamp of the build at the end of the name -->
				<arg line='-DforceContextQualifier=0' />
				<!-- Set to true if you want the output to be ready for an update jar (no site.xml generated) -->
				<arg line='-DoutputUpdateJars=true' />
				<!-- Settings for the base Eclipse components and Java class libraries
					 against which you are building.
					 Base location for anything the build needs to compile against.  For example,
					 in most RCP app or a plug-in,  the baseLocation should be the location of a previously
					 installed Eclipse against which the application or plug-in code will be compiled and the RCP delta pack. -->
				<arg line='-DbaseLocation="@{eclipse.runtime.path}"' />
				<arg line='-Dbaseos=linux' />
					<arg line='-Dbasews=gtk' />
					<arg line='-Dbasearch=x86_64' />
				<!-- this property indicates whether you want the set of plug-ins and features to be considered
				during the build to be limited to the ones reachable from the features / plugins being built -->
				<arg line='-DfilteredDependencyCheck=false' />
				<!-- this property indicates whether the resolution should be done in
				development mode (i.e. ignore multiple bundles with singletons) -->
				<arg line='-Dresolution.devMode=true' />
				<arg line='-DskipBase=true' />
				<arg line='-DskipMaps=true' />
				<arg line='-DskipFetch=true' />
				<arg line='-DlogExtension=.log' />
				<arg line='-DjavacDebugInfo=true ' />
				<arg line='-DjavacFailOnError=true' />
				<arg line='-DjavacVerbose=false' />
				<arg line='-DjavacSource=21' />
				<arg line='-DjavacTarget=21' />
			</exec>

			<!-- the build output is producing a zip which when extracted produces
				an eclipse folder with the plugins inside -->
			<unzip dest="${project.root.export.osgi.build}" src="${project.root.export.osgi.build}/${project.tdi.osgi.plugins.prefix}/${project.tdi.osgi.plugins.prefix}.feature-build.zip" overwrite="true" />
		</sequential>
	</macrodef>

	<description>
		=========================================================================
		Macro:    copyPluginDeps
		Purpose:  Copies the specified dependencies (as nested "fileset") to the
				  "lib" folder of the specified plugin and updates the plugin's
				  MANIFEST.MF accordingly.
		=========================================================================
	</description>
	<macrodef name="copyPluginDeps">
		<attribute name="pluginsDir" />
		<attribute name="plugin" />
		<element name="dependencies" implicit="true" optional="false" />

		<sequential>
			<echo message="Creating directory: @{pluginsDir}/@{plugin}/lib" />
			<mkdir dir="@{pluginsDir}/@{plugin}/lib" />

			<copy todir="@{pluginsDir}/@{plugin}/lib" overwrite="false" flatten="true" verbose="true">
				<dependencies />
			</copy>

			<pathconvert property="@{plugin}.cp" pathsep="," dirsep="/">
				<fileset dir="@{pluginsDir}/@{plugin}/lib" includes="*.jar" />
				<map from="@{pluginsDir}/@{plugin}/" to="" />
			</pathconvert>

			<echo message="Setting Bundle-ClassPath to: ${@{plugin}.cp},." />
			<manifest file="@{pluginsDir}/@{plugin}/META-INF/MANIFEST.MF" mode="update">
				<attribute name="Bundle-ClassPath" value="${@{plugin}.cp},." />
			</manifest>
		</sequential>
	</macrodef>

	<description>
		=========================================================================
		Macro:    excludeDeps
		Purpose:  Configures the build to skip the packaging of the specified
				  dependencies. The code automatically looks into the folder
				  used by the "copyPluginDeps" macrodef. If it is different you
				  need to specify the relative path from the plugin's root dir.
		=========================================================================
	</description>
	<macrodef name="excludeDeps">
		<attribute name="pluginsDir" description="This is the dirctory into which the specified plugin could be found. The path must be using forward slashes as dir separators!" />
		<attribute name="plugin" description="The name of the plugin project in the pluginsDir." />
		<attribute name="deps" description="The list of jar names to exclude. The list is comma separated" />

		<sequential>
			<script language="javascript" classpathref="nashorn.classpath">
				<![CDATA[
			try {
				load("nashorn:mozilla_compat.js");
			} catch (e) {
				// Ignore if we are using Rhino
			}
			importClass(java.lang.StringBuilder);
			importClass(java.io.File);
			importClass(java.io.FileInputStream);
			importClass(java.io.FileOutputStream);
			importClass(java.util.Properties);
			importClass(org.apache.tools.ant.Project);

			LIBS_DIR = "lib/"

			props = new Properties();
			fis = null;
			try {
				fis = new FileInputStream(new File("@{pluginsDir}/@{plugin}/build.properties"));
				props.load(fis);
			} catch (e) {
				if (e instanceof java.io.FileNotFoundException) {
					// ignore
				} else if (e instanceof java.io.Exception) {
					project.log(e.getMessage(), Project.MSG_ERR);
				} else {
					project.log(e, Project.MSG_ERR);
				}
			} finally {
				if (fis != null) {
					fis.close();
				}
			}

			packAll = false;
			changed = false;
			incList = new java.util.ArrayList();
			binIncludes = props.getProperty("bin.includes");

			if (binIncludes != null) {
				incs = binIncludes.split(",");
				deps = "@{deps}".split(",");

				// configured to package all
				for (i = 0; i < incs.length; i++) {
					isExcluded = false;
					if (incs[i].equals(LIBS_DIR)) {
						// we need to list the libs dir and gather the other deps
						libsDir = new File("@{pluginsDir}/@{plugin}/" + LIBS_DIR);

						if (libsDir.exists()) {
							libs = libsDir.listFiles();
							for (l in libs) {
								if (!libs[l].isDirectory()) {
									isExcluded = false;
									for (d in deps) {
										if (deps[d] != null) {
											dep = new File(libsDir, deps[d]);
											if (libs[l].equals(dep)) {
												deps[d] = null;
												isExcluded = true;
												break;
											}
										}
									}
									if (!isExcluded) {
										include = LIBS_DIR + libs[l].getName();
										if (!incList.contains(include)) {
											incList.add(include);
											changed = true;
										}
									}
								}
							}
						}
						isExcluded = true;
					} else {
						for (d in deps) {
							if (deps[d] != null && (incs[i].equals(deps[d]) || incs[i].equals(LIBS_DIR + deps[d]))) {
								isExcluded = true;
								break;
							}
						}
					}
					if (!isExcluded && !incList.contains(incs[i])) {
						incList.add(incs[i]);
						changed = true;
					}
				}

				if (changed) {
					sb = new StringBuilder();

					for (i = 0; i < incList.size(); i++) {
						sb.append(incList.get(i));
						sb.append(',');
					}

					if (sb.length() > 0) {
						sb.deleteCharAt(sb.length() - 1);
					}
					binIncludes = sb.toString();
					props.setProperty("bin.includes", binIncludes);

					echo = project.createTask("echo");
					echo.setMessage("Setting bin.includes to:  " + binIncludes);
					echo.perform();

					fos = null;
					try {
						fos = new FileOutputStream(new File("@{pluginsDir}/@{plugin}/build.properties"));
						props.store(fos, "Modified by excludeDeps ANT task.");
					} catch (e) {
						if (e instanceof java.io.Exception) {
							project.log(e.getMessage(), Project.MSG_ERR);
						} else {
							project.log(e, Project.MSG_ERR);
						}
					} finally {
						if (fos != null) {
							fos.close();
						}
					}
				}
			}
			    ]]>
			</script>
		</sequential>
	</macrodef>

	<description>
		=========================================================================
		Macro:    removeBundleClassPath
		Purpose:  Removes specified JARs from the Bundle-ClassPath in MANIFEST.MF
		=========================================================================
	</description>
	<macrodef name="removeBundleClassPath">
		<attribute name="pluginsDir" />
		<attribute name="plugin" />
		<attribute name="deps" description="Comma-separated list of JAR names to remove from Bundle-ClassPath" />
		
		<sequential>
			<script language="javascript" classpathref="nashorn.classpath">
				<![CDATA[
			try {
				load("nashorn:mozilla_compat.js");
			} catch (e) {
				// Ignore if we are using Rhino
			}
			importClass(java.io.File);
			importClass(java.io.FileInputStream);
			importClass(java.io.FileOutputStream);
			importClass(java.util.jar.Manifest);
			importClass(java.util.jar.Attributes);
			importClass(org.apache.tools.ant.Project);

			manifestFile = new File("@{pluginsDir}/@{plugin}/META-INF/MANIFEST.MF");
			fis = null;
			fos = null;
			
			try {
				fis = new FileInputStream(manifestFile);
				manifest = new Manifest(fis);
				attrs = manifest.getMainAttributes();
				
				bundleClassPath = attrs.getValue("Bundle-ClassPath");
				if (bundleClassPath != null) {
					deps = "@{deps}".split(",");
					entries = bundleClassPath.split(",");
					newEntries = new java.util.ArrayList();
					
					for (i = 0; i < entries.length; i++) {
						entry = entries[i].trim();
						shouldRemove = false;
						
						for (d = 0; d < deps.length; d++) {
							dep = deps[d].trim();
							if (entry.equals("lib/" + dep) || entry.equals(dep)) {
								shouldRemove = true;
								break;
							}
						}
						
						if (!shouldRemove) {
							newEntries.add(entry);
						}
					}
					
					// Rebuild Bundle-ClassPath
					sb = new java.lang.StringBuilder();
					for (i = 0; i < newEntries.size(); i++) {
						if (i > 0) sb.append(",");
						sb.append(newEntries.get(i));
					}
					
					newBundleClassPath = sb.toString();
					attrs.putValue("Bundle-ClassPath", newBundleClassPath);
					
					echo = project.createTask("echo");
					echo.setMessage("Updated Bundle-ClassPath to: " + newBundleClassPath);
					echo.perform();
					
					fos = new FileOutputStream(manifestFile);
					manifest.write(fos);
				}
			} catch (e) {
				if (e instanceof java.lang.Exception) {
					project.log(e.getMessage(), Project.MSG_ERR);
				} else {
					project.log(e, Project.MSG_ERR);
				}
			} finally {
				if (fis != null) fis.close();
				if (fos != null) fos.close();
			}
			    ]]>
			</script>
		</sequential>
	</macrodef>

	<description>
		=========================================================================
		Macro:    bulkConvertTMSXMLToProperties
		Purpose:  Cycles throughout all the TMSXML files for a plugin and calls
				  convertTMSXMLToProperties for each one of them
		=========================================================================
	</description>
	<macrodef name="bulkConvertTMSXMLToProperties">
		<attribute name="pluginsDir" />
		<attribute name="plugin" />
		<attribute name="tmsXmlBaseName" />

		<sequential>
			<fileset dir="@{pluginsDir}/@{plugin}" id="@{plugin}.nls" includes="@{tmsXmlBaseName}*.xml" />

			<script language="javascript" classpathref="nashorn.classpath">
				<![CDATA[
		try {
			load("nashorn:mozilla_compat.js");
		} catch (e) {
			// Ignore if we are using Rhino
		}
		importClass(java.io.File);

		fs = project.getReference("@{plugin}.nls");
		ds = fs.getDirectoryScanner(project);
		srcFiles = ds.getIncludedFiles();

		for (i = 0; i < srcFiles.length; i++) {
			// get the values via Java API
			tmsFile = new File(fs.getDir(project), srcFiles[i]);

			macrotask = project.createTask("convertTMSXMLToProperties");
			macrotask.setDynamicAttribute("tmsxmlfile.loc", tmsFile.getAbsolutePath());
			macrotask.setDynamicAttribute("propsfile.loc", tmsFile.getAbsolutePath().substring(0, tmsFile.getAbsolutePath().lastIndexOf('.')) + ".properties");
			macrotask.setDynamicAttribute("logfile.log", project.getProperty("project.root.tmsxml.log"));
			macrotask.execute();
		}
		    ]]>
			</script>

			<delete>
				<fileset refid="@{plugin}.nls" />
			</delete>
		</sequential>
	</macrodef>

	<description>
		=========================================================================
		Macro:    convertTMSXMLForPlugins
		Purpose:  Copies the specified dependencies (as nested "fileset") to the
				  "lib" folder of the specified plugin and updates the plugin's
				  MANIFEST.MF accordingly.
		=========================================================================
	</description>
	<!-- MUST CONVERT THE PATH TO USE FORWARD SLASHES BECAUSE OTHERWISE THE SCRIPT IN
		THE MACRODEF IS MISINTERPRETED -->
	<macrodef name="convertTMSXMLForPlugins">
		<attribute name="pluginsDir" />
		<sequential>

			<echo message="Starting TMS XML to Properties conversation for all plugins in: @{pluginsDir}" />

			<script language="javascript" classpathref="nashorn.classpath">
				<![CDATA[
		try {
			load("nashorn:mozilla_compat.js");
		} catch (e) {
			// Ignore if we are using Rhino
		}
		importClass(java.io.File);
		importClass(java.io.FileInputStream);
		importClass(java.util.jar.Manifest);
		importClass(org.apache.tools.ant.Project);

		plnsDir = new File("@{pluginsDir}");
		children = plnsDir.listFiles();
		for (i in children) {
			plnDir = children[i];
			if (plnDir.isDirectory()) {
				try {
					fis = new FileInputStream(new File(plnDir, "META-INF/MANIFEST.MF"));
					man = new Manifest(fis);
					loc = man.getMainAttributes().getValue("Bundle-Localization");

					if (loc == null) {
						loc = "OSGI-INF/l10n/bundle";
					}

					locFile = new File(plnDir, loc + ".xml");
					if (locFile.exists()) {
						macrotask = project.createTask("bulkConvertTMSXMLToProperties");
						macrotask.setDynamicAttribute("pluginsdir", "@{pluginsDir}");
						macrotask.setDynamicAttribute("plugin", plnDir.getName());
						macrotask.setDynamicAttribute("tmsxmlbasename", loc);
						macrotask.execute();
					} else {
						project.log("Bundle: " + plnDir.getName() + " - Not localized!");
					}
				} catch (e) {
					if (e instanceof java.lang.Exception) {
						project.log(e.getMessage(), Project.MSG_ERR);
					} else {
						project.log(e, Project.MSG_ERR);
					}
				} finally {
					if (fis != null) {
						fis.close();
					}
				}
			}
		}
	    ]]>
			</script>
		</sequential>
	</macrodef>

	<description>
		=========================================================================
		Macro:    convertTMSXMLForPlugins
		Purpose:  Copies the specified dependencies (as nested "fileset") to the
				  "lib" folder of the specified plugin and updates the plugin's
				  MANIFEST.MF accordingly.
		=========================================================================
	</description>
	<macrodef name="bulkSetBundleVersion">
		<attribute name="pluginsDir" />
		<attribute name="version" />

		<sequential>
			<script language="javascript" classpathref="nashorn.classpath">
				<![CDATA[
		try {
			load("nashorn:mozilla_compat.js");
		} catch (e) {
			// Ignore if we are using Rhino
		}
		importClass(java.io.File);
		importClass(java.io.FileInputStream);
		importClass(java.io.FileOutputStream);
		importClass(java.util.jar.Manifest);
		importClass(org.apache.tools.ant.Project);

		plnsDir = new File("@{pluginsDir}");
		plns = plnsDir.listFiles();

		for (i in plns) {
			manifest = new File(plns[i], "META-INF/MANIFEST.MF");
			fis = null;
			fos = null;
			try {
				fis = new FileInputStream(manifest);
				man = new Manifest(fis);
				man.getMainAttributes().putValue("Bundle-Version", "@{version}");
				fos = new FileOutputStream(manifest);
				man.write(fos);
			} catch (e) {
				if (e instanceof java.lang.Exception) {
					project.log(e.getMessage(), Project.MSG_ERR);
				} else {
					project.log(e, Project.MSG_ERR);
				}
			} finally {
				if (fis != null) {
					fis.close();
				}
				if (fos != null) {
					fos.close();
				}
			}
		}
		    ]]>
			</script>

		</sequential>
	</macrodef>

	<description>
		=========================================================================
		Target:		setupBuildDirectory
		Purpose:	Prepares the build directory where the build will take place.
		Result:		After this task completes the provided buildDirectory will
					have the pde build templates setup.
		=========================================================================
	</description>

	<target name="setupWebUI">

		<!-- expand the OneUI release into com.ibm.di.ui.webui/static -->
		<unzip src="${root.oneui_src}" dest="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui/static.build" />

		<!-- expand the CodeMirror release into com.ibm.di.ui.webui/static -->
		<unzip src="${root.codemirror_src}" dest="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui/static.build" />

		<!-- move all static files over to static.build -->
		<move
			file="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui/static/tdi"
			todir="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui/static.build"
		/>

		<!-- preserve static image assets in the generated WebUI release -->
		<copy todir="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui/static.build/images">
			<fileset dir="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui/static/images" />
		</copy>

		<!-- Copy EasyETL nls properties to WebUI -->
		<copy todir="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui/nls">
			<fileset dir="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.easyetl/nls" />
		</copy>

		<!-- run the dojo build to generate all packages in the static directory (dojo, dijit, tdi etc) -->
		<exec osfamily="windows" executable="cmd"
			dir="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui"
			failonerror="false">
			<arg value="/c" />
			<arg value="static.build\\dojo_1.8.1\\util\\buildscripts\\build.bat" />
		    <arg value="--profile"/>
		    <arg value="tdi.profile.js"/>
		</exec>

		<!-- run the dojo build to generate all packages in the static directory (dojo, dijit, tdi etc) -->
		<exec osfamily="unix" executable="/bin/sh"
			dir="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui"
			failonerror="false">
			<arg value="static.build/dojo_1.8.1/util/buildscripts/build.sh" />
		    <arg value="--profile"/>
		    <arg value="tdi.profile.js"/>
		</exec>

                <!-- For some reason the end product requires the constructed
                     main.js file to also be named as Main.js.  So, we manually
                     copy the file here. -->
		<copy file="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui/static/tdi/main.js" tofile="${project.root.export.osgi.build.plugins}/com.ibm.di.ui.webui/static/tdi/Main.js"/>

	</target>

	<target name="setupBuildDirectory" depends="init">
		<!-- make sure the buildDirectory is cleaned properly -->
		<delete dir="${project.root.export.osgi.build}" />
		<mkdir dir="${project.root.export.osgi.build}" />
		<mkdir dir="${project.root.export.osgi.build.plugins}" />
		<mkdir dir="${project.root.export.osgi.build}/features" />

		<!-- copy all plugin projects over to the build directory -->
		<copy todir="${project.root.export.osgi.build.plugins}">
		<!-- Note: the skip.me files are skipped as they are only provided there to avoid CMVC flaw
		     of not working with empty directories, e.g. src, but they are needed by the eclipse builder.
			 This workaround will become useless once TDI source is spread out in OSGi bundles -->
			<fileset dir="${project.root.osgi}/plugins" includes="*/**" excludes="*/src/skip.me" />
		</copy>

		<!-- expand the Dojo release into com.ibm.di.ui.easyetl/static -->
