	<echo message="Supporting dependency OSGi bundles copied successfully" />

	<!-- Copy Wink common OSGi bundle (Atom/APP data models) to embedded directory -->
	<echo message="Copying Wink common OSGi bundle to embedded directory..." />
	<copy todir="${project.root.export.osgi.embedded}" overwrite="true">
		<fileset dir="${project.root.export.osgi.runtime}">
			<include name="org.apache.wink.common.jar" />
		</fileset>
	</copy>
	<echo message="Wink common OSGi bundle copied successfully" />

	</target>

	<!-- ============================================================
     Third-party OSGi runtime bundles
     These are true OSGi bundles resolved by PDE, not embedded jars
     ============================================================ -->

	<target name="init" depends="clean">

		<mkdir dir="${project.root.export.osgi}" />
		<mkdir dir="${project.root.export.osgi.embedded}" />
		<mkdir dir="${project.root.export.logs}" />

		<!-- copy the plugins here with "cleaned" names. -->
		<mkdir dir="${project.root.export.osgi.runtime}" />
		<copy todir="${project.root.export.osgi.runtime}">
			<fileset refid="root.osgi.runtime.fileset" />
			<mapper refid="osgi.plugins.name.normalizer" />
		</copy>

		<!-- gather 3rd party non-eclipse plugins on which our code depends -->
		<copy todir="${project.root.export.osgi.runtime}">
			<fileset refid="root.jackson_fileset" />
			<fileset refid="root.jackson_jaxrs_fileset" />
			<fileset refid="root.jakarta_fileset" />
			<fileset refid="root.jersey_fileset" />
			<fileset refid="root.hk2_fileset" />
			<fileset refid="root.asm_fileset" />
			<fileset refid="root.spifly_fileset" />
			<fileset refid="root.jaxrs_fileset" />
			<fileset refid="root.wink_fileset" />
			<fileset refid="root.jaxb_fileset" />
			<fileset refid="root.javassist_fileset" />
			<fileset refid="root.servlet_fileset" />
			
		</copy>

		<copy todir="${project.root.export.osgi.runtime}">
			<fileset dir="${ivy.lib.dir}/axis-2" includes="xml-apis-1.4.01.jar"/>
		</copy>

		<!-- Wrap Wink aggregate JAR into a real OSGi bundle -->
		<echo message="Wrapping Wink aggregate JAR and xml-apis into OSGi bundle..." />

		<pathconvert property="wink.jar.path">
			<fileset refid="root.wink_fileset" />
		</pathconvert>

		<jar destfile="${project.root.export.osgi.runtime}/org.apache.wink.common.jar">
			<zipfileset src="${wink.jar.path}" />

			<manifest>
				<attribute name="Manifest-Version" value="1.0"/>
				<attribute name="Bundle-ManifestVersion" value="2"/>
				<attribute name="Bundle-SymbolicName" value="org.apache.wink.common"/>
				<attribute name="Bundle-Name" value="Apache Wink Common (Wrapped)"/>
				<attribute name="Bundle-Version" value="1.0.0"/>
				<attribute name="Bundle-Vendor" value="Apache Software Foundation"/>
				<attribute name="Bundle-RequiredExecutionEnvironment" value="JavaSE-1.8"/>
				<attribute name="Export-Package"
					value="org.apache.wink.common.annotations;version=&quot;1.0.0&quot;,org.apache.wink.common.categories;version=&quot;1.0.0&quot;,org.apache.wink.common.model;version=&quot;1.0.0&quot;,org.apache.wink.common.model.atom;version=&quot;1.0.0&quot;,org.apache.wink.common.model.app;version=&quot;1.0.0&quot;,org.apache.wink.common.model.synd;version=&quot;1.0.0&quot;,org.apache.wink.common.model.multipart;version=&quot;1.0.0&quot;" />
				<attribute name="Import-Package"
					value="javax.xml.bind,
						javax.xml.bind.annotation"/>
				<attribute name="DynamicImport-Package" value="*"/>
				<attribute name="Main-Class" value="com.ibm.jaxrs.VersionInfo"/>
			</manifest>
		</jar>

		<jar destfile="${project.root.export.osgi.runtime}/javax.xml.api.jar">
			<zipfileset src="${ivy.lib.dir}/axis-2/xml-apis-1.4.01.jar"/>

			<manifest>
				<attribute name="Manifest-Version" value="1.0"/>
				<attribute name="Bundle-ManifestVersion" value="2"/>
				<attribute name="Bundle-SymbolicName" value="javax.xml.api"/>
				<attribute name="Bundle-Version" value="1.4.01"/>
				<attribute name="Bundle-Name" value="XML APIs (Wrapped)"/>

				<attribute name="Export-Package"
					value="javax.xml.namespace;version=1.0.1,
						javax.xml.parsers;version=1.4.0,
						javax.xml.transform;version=1.4.0,
						javax.xml.validation;version=1.4.0,
						javax.xml.xpath;version=1.4.0,
						javax.xml.stream;version=1.0.0,
						javax.xml.datatype;version=1.4.0,
						org.w3c.dom;version=3.0.0,
						org.w3c.dom.ls;version=3.0.0,
						org.xml.sax;version=2.0.2"/>
			</manifest>
		</jar>
		
