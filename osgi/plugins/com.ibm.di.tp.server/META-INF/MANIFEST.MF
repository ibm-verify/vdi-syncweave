 javax.servlet.descriptor;version="[2.5,5.0)",
 javax.ws.rs;version="[2.0,3.0)",
 javax.ws.rs.core;version="[2.0,3.0)",
 javax.ws.rs.ext;version="[2.0,3.0)",
 org.apache.wink.common.annotations;version="[1.0,2.0)",
 org.apache.wink.common.categories;version="[1.0,2.0)",
 org.apache.wink.common.model.atom;version="[1.0,2.0)",
 org.apache.wink.common.model.synd;version="[1.0,2.0)",
 org.glassfish.jersey.server,
