<Message ID="CTGDIB101W" prefix="yes">
   <MsgText pgmKey="SERVER.API.CONNECTION.MISSING.LOCAL.API" varFormat="Java">
   No Local Server API detected.
   </MsgText>
   <Explanation> <p>
	A Touchpoint Provider was configured to use the Local API, which is not 
	present in the current runtime.
   </p> </Explanation>
   <OperatorResponse> <p>
	Configure the Touchpoint Server to use the Remote Server API instead.
   </p> </OperatorResponse>
</Message>

<Message ID="CTGDIB102E" prefix="yes">
   <MsgText pgmKey="SERVER.API.CONNECTION.IVALID.HOST.OR.PORT" varFormat="Java">
   Invalid host(<q/><Variable formatSpec="{0}">actual host provided</Variable><q/>) 
   or port(<q/><Variable formatSpec="{1}">actual port provided</Variable><q/>) value.
   </MsgText>
   <Explanation> <p>
	See error message.
   </p> </Explanation>
   <OperatorResponse> <p>
	Provide correct values in order to be able to connect to the remote server.
   </p> </OperatorResponse>
</Message>

</TMSSource>
