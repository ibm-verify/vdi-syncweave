	xmlns="http://www.w3.org/2001/XMLSchema"
	xmlns:tns="http://www.ibm.com/xmlns/prod/tdi/72/config">


	<include schemaLocation="base.xsd"></include>
	<complexType name="LogBinding">
		<sequence>
			<element name="item" type="tns:LogItemBinding" maxOccurs="unbounded"
