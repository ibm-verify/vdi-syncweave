Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: TADDM Suite
Bundle-SymbolicName: com.ibm.di.connector.taddm;singleton:=true
Bundle-Version: 1.0.0.qualifier
Bundle-Vendor: IBM
Bundle-RequiredExecutionEnvironment: JavaSE-21
Require-Bundle: com.ibm.di.bundle,
 com.ibm.di.server.entry,
 com.ibm.di.server,
 com.ibm.di.util,
 com.ibm.di.config,
 com.ibm.di.component
