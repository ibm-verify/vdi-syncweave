 com.ibm.icu.util,
 org.eclipse.core.runtime;version="3.4.0",
 org.osgi.framework;version="1.5.0",
 org.osgi.service.component;version="1.1.0"
Bundle-ClassPath: lib/cdm.jar,
 lib/platform-model.jar,
 lib/taddm-api-client.jar,
 .
Service-Component: OSGI-INF/taddmConn.xml, OSGI-INF/taddmCdc.xml
Bundle-Localization: OSGI-INF/l10n/taddmconnector
