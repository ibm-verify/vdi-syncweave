			<parameter name="formevents"><![CDATA[
				function idmlMode_changed () {
					var val = form.getConfig("idmlMode");
					var checkBox =  form.getControl("explicitRelns");
					if ( val == null || checkBox == null) {
						return;
					} 
					if ( val.equalsIgnoreCase("true") ) {
						checkBox.setEnabled(true);
					} else {
						checkBox.setEnabled(false);
					}
				}
				idmlMode_changed ();
			]]></parameter>
