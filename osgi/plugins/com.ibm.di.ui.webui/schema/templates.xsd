<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.w3.org/2001/XMLSchema" targetNamespace="http://www.example.org/templates" xmlns:tns="http://www.example.org/templates" elementFormDefault="qualified">


    <element name="ConfigTemplate" type="tns:ConfigTemplate"></element>
    
    <complexType name="ConfigTemplate">
    	<attribute name="Name" type="string"></attribute>
    </complexType>

    <complexType name="ConfigTemplates">
    	<sequence>
    		<element name="ConfigTemplate" type="tns:ConfigTemplate" maxOccurs="unbounded" minOccurs="0"></element>
    	</sequence>
    </complexType>
</schema>