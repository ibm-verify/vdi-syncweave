<?xml version="1.0" encoding="UTF-8"?>
<schema ecore:nsPrefix="ex" ecore:package="extractor" elementFormDefault="qualified" targetNamespace="http://www.eclipse.org/hyades/schema/Extractor.xsd" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" xmlns:ex="http://www.eclipse.org/hyades/schema/Extractor.xsd" xmlns:pu="http://www.eclipse.org/hyades/schema/ProcessUnit.xsd">
