        are made available under the terms of the Eclipse Public License v1.0
        which accompanies this distribution, and is available at
        http://www.eclipse.org/legal/epl-v10.html
	  </documentation>
	 </annotation>
	<import namespace="http://www.eclipse.org/hyades/schema/Context.xsd" schemaLocation="Context.xsd"/>
	<import namespace="http://www.eclipse.org/hyades/schema/ComponentConfiguration.xsd" schemaLocation="ComponentConfiguration.xsd"/>
	<element name="Adapter">
		<annotation>
			<documentation>
			This is the root element of a Generic Log Adapter configuration file.
			It contains a Contexts element defined in Context.xsd and a Configuration element defined in ComponentConfiguration.xsd.
			</documentation>
        </annotation>
		<complexType>
			<sequence>
				<element maxOccurs="1" minOccurs="1" ref="Context:Contexts"/>
				<element maxOccurs="1" minOccurs="0" ref="cc:Configuration"/>
			</sequence>
		</complexType>
	</element>
</schema>
