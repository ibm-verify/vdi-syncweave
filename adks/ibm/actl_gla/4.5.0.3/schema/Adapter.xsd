<?xml version="1.0" encoding="UTF-8"?>
<schema ecore:nsPrefix="adapter" ecore:package="adapter" elementFormDefault="qualified" targetNamespace="http://www.eclipse.org/hyades/schema/Adapter.xsd" xmlns="http://www.w3.org/2001/XMLSchema" xmlns:Adapter="http://www.eclipse.org/hyades/schema/Adapter.xsd" xmlns:Context="http://www.eclipse.org/hyades/schema/Context.xsd" xmlns:cc="http://www.eclipse.org/hyades/schema/ComponentConfiguration.xsd" xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore">
