        <ContainerDF name="DataFlowContainer">
            <ModTime>1438930304932</ModTime>
            <Script name="Initialize">
                <ModTime>1430136882032</ModTime>
                <parameter name="script"><![CDATA[typeOfEntry = tcb.getString("$typeOfEntry");
operation = tcb.getString("$operation");
search = tcb.getObject("$search");
filter = null;

tcb["$change"] = false;
tcb["$writeStatus"] = "failed";
tcb["$status"] = "failed";

sourceDN = work.getString("targetDN"); // in case it is changelog
if (sourceDN == null) {
	sourceDN = work.getString("$sourceDN");
}
if (sourceDN == null) {
	sourceDN = work.getString(auxLinkedDNAttribute);
}	
if (sourceDN == null) {
	sourceDN = work.getString("$" + auxLinkedDNAttribute);
}	

// The external Id must be the source DN to allow for translation of group members
// so sourceGUID is set to null to prevent it from being used as the esternalId
//sourceGUID = opEntry.getString("$sourceGUID");
sourceGUID = null;

if (sourceDN != null) {
	try {
		sourceDNclean = cleanDN(sourceDN);
	} catch (ex) {
		// do nothing
	}
	
	sourceDN = sourceDNclean.toLowerCase();
}

work["$sourceDN"] = sourceDN;

// Now to prepare the search filter.
// If the sourceGUID attribute is available, then this is AD so use it, otherwise
// if the sourceDN attribute is available, then use it. Otherwise grab the actual
// search crit passed to this AL
//
search = task.getTCB().getObject("$search");
if (search !== null) {
	crit = search.getCriteria();
	searchAttribute = crit[0].name;
	searchValue = crit[0].value;
	if ("$dn".equalsIgnoreCase(searchAttribute)
		 || auxLinkedDNAttribute.equalsIgnoreCase(searchAttribute)) {
		searchAttribute = "externalId";
		
		if (sourceGUID !== null) {
			searchValue = sourceGUID;
		} else {
			searchValue = sourceDN;
		}	
	}
	
	if ("externalId".equals(searchAttribute) && 
		!searchValue.startsWith("{") /* AD GUID string */) {
		searchValue = searchValue.toLowerCase();
	} else
	if (auxLinkedGUIDAttribute.equalsIgnoreCase(searchAttribute)) {
		searchAttribute = "id";
	}
	
	work["$searchAttribute"] = searchAttribute;
	work["$searchValue"] = searchValue;
	
	filter = work.getString("$searchAttribute") 
				+ " eq "
				+ "\"" + work.getString("$searchValue") + "\"";
} else {
	if (sourceGUID !== null) {
		filter = "externalId eq \"" + sourceGUID + "\"";
	} else {
		filter = "externalId eq \"" + sourceDN + "\"";
	}	
}	
work["$searchFilter"] = filter;

// check type of entry
if (typeOfEntry === null) {
	typeOfEntry = "*unknown entry type*";
}

if (deBug) logmsg("SCIM:W2T - <<" 
							+ tcb.getString("$operation")
							+ ">> " + typeOfEntry
							+ "  $dn: " + work.getString("$dn")
							+ "  filter: " + filter);]]></parameter>
            </Script>
