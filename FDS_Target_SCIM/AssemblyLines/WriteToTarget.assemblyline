	try {
		dn = new javax.naming.ldap.LdapName(dn).toString().toLowerCase();
		dn = cleandn(dn);	
	} catch (ex) {
//		logmsg("ERROR", resource.getString("LDAPSYNC."))
	}
	
	p = dn.indexOf("\\");
	if (p > 0) {
		newdn = dn.replace(/\\/g,"");
	}
}	
return dn;]]></Script>
