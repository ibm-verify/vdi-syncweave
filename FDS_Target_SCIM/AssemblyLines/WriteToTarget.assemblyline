                                <InheritFrom>[parent]</InheritFrom>
                            </Schema>
                            <LinkCriteria>
                                <InheritFrom>[parent]</InheritFrom>
                                <AdvancedLinkMode>true</AdvancedLinkMode>
                                <Script>return work.getString("$searchFilter");</Script>
                                <LinkCriteriaItem>
                                    <Key>142fbfe20d6</Key>
                                    <Attribute>externalId</Attribute>
                                    <Value>$sourceDN</Value>
                                </LinkCriteriaItem>
                            </LinkCriteria>
                            <Hooks>
                                <InheritFrom>[parent]</InheritFrom>
                                <Hook name="after_add">
                                    <InheritFrom>[no inheritance]</InheritFrom>
                                    <Name>after_add</Name>
                                    <Script><![CDATA[tcb["$writeStatus"] = "success"
tcb["$status"] = "success"
tcb["$change"] = true;]]></Script>
                                    <Enabled>true</Enabled>
                                </Hook>
                                <Hook name="after_lookup">
                                    <InheritFrom>[no inheritance]</InheritFrom>
                                    <Name>after_lookup</Name>
                                    <Script>if (doTiming) timing("writetotarget - mapping")</Script>
                                    <Enabled>true</Enabled>
                                </Hook>
                                <Hook name="after_modify">
                                    <InheritFrom>[no inheritance]</InheritFrom>
                                    <Name>after_modify</Name>
                                    <Script><![CDATA[tcb["$writeStatus"] = "success"
tcb["$status"] = "success"
tcb["$change"] = true;]]></Script>
                                    <Enabled>true</Enabled>
                                </Hook>
                                <Hook name="before_add">
                                    <InheritFrom>[no inheritance]</InheritFrom>
                                    <Name>before_add</Name>
                                    <Script><![CDATA[tcb["$operation"] = "add";
if (conn.getString("members") == null) {
	conn.removeAttribute("members");
}]]></Script>
                                    <Enabled>true</Enabled>
                                </Hook>
                                <Hook name="before_lookup">
                                    <InheritFrom>[no inheritance]</InheritFrom>
                                    <Name>before_lookup</Name>
                                    <Script>if (doTiming) timing("writetotarget - update lookup");</Script>
                                    <Enabled>true</Enabled>
                                </Hook>
                                <Hook name="before_modify">
                                    <InheritFrom>[no inheritance]</InheritFrom>
                                    <Name>before_modify</Name>
                                    <Script><![CDATA[tcb["$operation"] = "modify";

// first copy over content that won't be mapped out, but resides in SCIM
mapped = system.newEntry();
mapped.merge(conn);
mapped.id = current.id;
mapped.meta = current.meta;
mapped.active = current.active;
mapped.schemas = current.schemas;

// now create Javascript objects from conn and current
newJObj = fromJson(mapped.toJSON());
currentJObj = fromJson(current.toJSON());

// finally, perform compute changes to determine if the write is necessary
if (hasContent(newJObj, currentJObj)) {
	tcb["$writeStatus"] = "skipped"
	tcb["$status"] = "success"
	tcb["$change"] = false;
	system.ignoreEntry();
}]]></Script>
                                    <Enabled>true</Enabled>
                                </Hook>
                                <Hook name="default_fail">
                                    <InheritFrom>[no inheritance]</InheritFrom>
                                    <Name>default_fail</Name>
                                    <Script>work.setAttribute("$error", error);</Script>
                                    <Enabled>true</Enabled>
                                </Hook>
                                <Hook name="modify_apply">
                                    <InheritFrom>[no inheritance]</InheritFrom>
                                    <Name>modify_apply</Name>
                                    <Script/>
                                    <Enabled>true</Enabled>
                                </Hook>
                                <Hook name="modify_nochange">
                                    <Name>modify_nochange</Name>
                                    <Enabled>true</Enabled>
                                </Hook>
                            </Hooks>
                            <CheckpointConfig/>
                            <SandboxConfig/>
                            <Reconnect>
                                <InheritFrom>[parent]</InheritFrom>
                                <ReconnectRules/>
                            </Reconnect>
                            <Operations/>
                            <PoolDefinition>
                                <InheritFrom>[parent]</InheritFrom>
                            </PoolDefinition>
                            <PoolInstance/>
                        </Connector>
                        <Conditions/>
                        <MatchAny>false</MatchAny>
                        <Enabled>true</Enabled>
                        <Type>2</Type>
                    </Branch>
                    <ScriptCondition>return typeOfEntry == "group" // &amp;&amp; !cloudSync;</ScriptCondition>
                    <Conditions/>
                    <MatchAny>false</MatchAny>
                    <Enabled>true</Enabled>
                    <Type>1</Type>
                </Branch>
                <ScriptCondition><![CDATA[return "putEntry".equalsIgnoreCase(operation)
		|| "modEntry".equalsIgnoreCase(operation)
		|| "deleteEntry".equalsIgnoreCase(operation)]]></ScriptCondition>
                <Conditions/>
                <MatchAny>false</MatchAny>
                <Enabled>true</Enabled>
                <Type>1</Type>
            </Branch>
            <Script name="debugDisplay">
                <ModTime>1407504238906</ModTime>
                <parameter name="script">if (debugging) java.lang.System.out.println("...leaving SCIM:W2T...")</parameter>
            </Script>
        </ContainerDF>
        <ThreadOptions/>
        <Operations/>
        <InitParams>
            <Schema name="AssemblyLineInitParams"/>
        </InitParams>
    </AssemblyLine>
</MetamergeConfig>