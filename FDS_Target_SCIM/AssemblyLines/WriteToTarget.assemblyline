                    <Branch name="Add or Modify for Group">
                        <ModTime>1431808604814</ModTime>
                        <Script name="Translate membership">
                            <ModTime>1413292665472</ModTime>
                            <parameter name="script"><![CDATA[badMembers = "";
members = work.member;
if (members === null) {
	members = work.uniqueMember;
}

targetMembers = system.newAttribute("members");

if (members != null) {
	targetMembers.setOperation(members.getOperation());

	if (members !== null) {
		for (ndx = 0; ndx < members.size(); ndx++) {
			thisMember = members.getValue(ndx);
			thisMemberOp = members.getValueOper(ndx);
			
			sc = system.newSearchCriteria();
			
			try {
				cleanMember = cleanDN(thisMember);
				thisMember = cleanMember;
			} catch (ex) {
				// do nothing
			}
			
			sc.addCriteria("externalId", sc.EXACT, thisMember.toLowerCase());
			
			try {
				if ( (foundMember = scimUsers.findEntry(sc)) !== null 
					|| (foundMember = scimGroups.findEntry(sc)) !== null ) {
						memId = foundMember.getString("id");
						if (memId !== null) {
							targetMembers.addValue(memId, thisMemberOp);
						}	
				} else 
				if (sourceLDAP !== null
					&& (result = checkScope(thisMember, sourceLDAP, changeDetType)).inScope) {
					memId = extIdSuffix + thisMember.toLowerCase();
					targetMembers.addValue(memId, thisMemberOp);
				} else {
					badMembers += "--> " +
								resource.getString("LDAPSYNC.SKIPPING.MEMBER.BECAUSE.NO.ENTRY.WAS.FOUND.IN.THE.TARGET") 
								+ " - " + thisMember + "\n"
					addToStats(flowKey, "warn","warn")
				}
			} catch (ex) {
				addToStats(flowKey, "error", "error");
				logmsg("ERROR", ex);
			}	
		}
		
		if (badMembers.length > 0) {
			logmsg("WARN", badMembers);
		}
	}
}

work.setAttribute("members", targetMembers);]]></parameter>
                        </Script>
