                    <Branch name="User has been added">
                        <ModTime>1410265856410</ModTime>
                        <Script name="Correct group members if required">
                            <ModTime>1410265856410</ModTime>
                            <parameter name="script"><![CDATA[// find any groups that have the untranslated DN of this user
//
groups = new java.util.ArrayList();
extmember = extIdSuffix + sourceDN.toLowerCase();
group = scimGroups.findEntry("members", extmember);

if (group !== null) {
	groups.add(group);
} else 
if (scimGroups.getFindEntryCount() > 0) {
	do {
		group = scimGroups.getNextFindEntry();
		if (group !== null) {
			groups.add(group);
		}	
	} while (group !== null);
}

for (groupEntry in groups) {
	performUpdate = false;
	group = fromJson(groupEntry.toJSON());
	members = group.members;
	if (members != null) {
		for (var i = 0; i < members.length; i++) {
			member = members[i];
			if (extmember.equals(member.value)) {
				if (deBug) task.logmsg("--%%--> Found ext id member: " + toJson(member));
				member.operation = "delete";
				fixedMember = {value: addedUserId, operation: "add"}
				members[members.length] = fixedMember;
				group.members = members;
				performUpdate = true;
				break;
			}	
		}
	}
	
	if (performUpdate) {
		sc = system.newSearchCriteria();
		sc.addCriteria("id", sc.EXACT, groupEntry.id);
		try {
			groupEntry = groupEntry.fromJSON(toJson(group));
			scimGroups.modEntry(groupEntry, sc);
			translatedGroupDN = translateDN(groupEntry.getString("externalId"), "CN", groupEntry.getString("displayName"), targetSuffixForGroups, null, null);
			addToStats(flowKey, "group", "modify", isSync, translatedGroupDN);
		} catch (ex) {
			if (deBug) logmsg("ERROR", "--%%--> Error updating group membership for: " + groupEntry.id);
		}	
	}
}]]></parameter>
                        </Script>
                        <ScriptCondition><![CDATA[// externalId is set in the Assignment to 'externalId' in the Output Map of the
// UpdateSCIM_Person connector.
//
// Here we check that an add or delete has been successfully performed.
//
operationPerformed = tcb.getString("$operation");
return "success".equals(tcb.getString("$writeStatus"))
		&& "add".equals(operationPerformed)]]></ScriptCondition>
