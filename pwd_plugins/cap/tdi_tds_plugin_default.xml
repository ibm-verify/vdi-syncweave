<subagents xmlns="http://www.tivoli.ibm.com/itm/kwgcap" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.tivoli.ibm.com/itm/kwgcap kwgcap.xsd">
    <!-- DO NOT EDIT THIS PORTION OF THE CAP FILE -->
    <subagent id="IBMTDITDSL">
      <agentName>Security Verify Directory Integrator - Password Integrator Java Proxy Component for IBM Security Directory Server</agentName>
        <process>
            <procName>java</procName>
		    <commandLine regex="true">tds\/.*.props.* \S.*\/(tds)\/.*.props$</commandLine>
        </process>
      <agentType>Console</agentType>
      <agentPath><TDI_INSTALL_DIR>/jvm/jre/bin/java</agentPath>
      <platform xsi:type="PlatformLinux"></platform>
    <!--END-->
      <checkFrequency>1800</checkFrequency>
      <managerType>NotManaged</managerType>
      <maxRestarts>1</maxRestarts>
      <startScript>
        <command><TDI_INSTALL_DIR>/pwd_plugins/bin/startProxy.sh <TDI_INSTALL_DIR>/pwd_plugins/tds/pwsync.props</command>
        <returnCodeList>
          <returnCode type="OK">0</returnCode>
        </returnCodeList>
      </startScript>
      <stopScript>
        <command><TDI_INSTALL_DIR>/pwd_plugins/bin/stopProxy.sh <TDI_INSTALL_DIR>/pwd_plugins/tds/pwsync.props</command>
        <returnCodeList>
          <returnCode type="OK">0</returnCode>
        </returnCodeList>
      </stopScript>
    </subagent>
