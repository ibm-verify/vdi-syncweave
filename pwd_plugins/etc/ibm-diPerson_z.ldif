# Module Name: SyncWeave 1.0.0 ( 1.3.18.0.2.24.78 ) 
# Dependencies: 
#
dn:cn=schema
changetype: modify
add: attributetypes
attributetypes: (
  1.3.18.0.2.4.3015
  NAME 'ibm-diTimestamp'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.24
  DESC 'Timestamp entry for synchronizing passwords with IBM Directory Integrator.'
  EQUALITY generalizedTimeMatch
  ORDERING generalizedTimeOrderingMatch
  USAGE userApplications
  )
ibmattributetypes: (
  1.3.18.0.2.4.3015
  DBNAME( 'diTimestamp'  'diTimestamp' )
  ACCESS-CLASS normal
  )

dn:cn=schema
changetype: modify
add: attributetypes
attributetypes: (
  1.3.18.0.2.4.3013
  NAME 'ibm-diCustomData'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  DESC 'Custom data entry for synchronizing passwords with IBM Directory Integrator.'
  EQUALITY caseIgnoreMatch
  ORDERING caseIgnoreOrderingMatch
  SUBSTR caseIgnoreSubstringsMatch
  USAGE userApplications
  )
ibmattributetypes: (
  1.3.18.0.2.4.3013
  DBNAME( 'diCustomData'  'diCustomData' )
  ACCESS-CLASS normal
  )

dn:cn=schema
changetype: modify
add: attributetypes
attributetypes: (
  1.3.18.0.2.4.2990
  NAME 'ibm-diExtendedData'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  DESC 'Extended data entry for synchronizing passwords with IBM Directory Integrator.'
  EQUALITY caseIgnoreMatch
  ORDERING caseIgnoreOrderingMatch
  SUBSTR caseIgnoreSubstringsMatch
  USAGE userApplications
  )
ibmattributetypes: (
  1.3.18.0.2.4.2990
  DBNAME( 'diExtendedData'  'diExtendedData' )
  ACCESS-CLASS normal
  )

dn:cn=schema
changetype: modify
add: attributetypes
attributetypes: (
  1.3.18.0.2.4.3009
  NAME 'ibm-diPassword'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.40
  DESC 'Encrypted value of password to be synchronized.'
  EQUALITY octetStringMatch
  USAGE userApplications
  )
ibmattributetypes: (
  1.3.18.0.2.4.3009
  DBNAME( 'diPassword'  'diPassword' )
  ACCESS-CLASS normal
  )

dn:cn=schema
changetype: modify
add: attributetypes
attributetypes: (
  1.3.18.0.2.4.3011
  NAME 'ibm-diUserid'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.15
  DESC 'Userid  for synchronizing passwords with IBM Directory Integrator.'
  EQUALITY caseIgnoreMatch
  ORDERING caseIgnoreOrderingMatch
  SUBSTR caseIgnoreSubstringsMatch
  USAGE userApplications
  )
ibmattributetypes: (
  1.3.18.0.2.4.3011
  DBNAME( 'diUserid'  'diUserid' )
  ACCESS-CLASS normal
  )

dn:cn=schema
changetype: modify
add: objectclasses
objectclasses: (
  1.3.18.0.2.6.547
  NAME 'ibm-diPerson'
  DESC 'Person entry for synchronizing passwords with IBM Directory Integrator.'
  SUP top
  STRUCTURAL
  MAY ( ibm-diTimestamp $ ibm-diCustomData $ ibm-diExtendedData $ secretKey $ ibm-diPassword $ ibm-diUserid $ uid )
  )

