dn:cn=schema
changetype: modify
add: attributetypes
attributetypes: (
  1.3.18.0.2.4.3015
  NAME 'ibm-diTimestamp'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.24
  )
-
add: ibmattributetypes
ibmattributetypes: (
  1.3.18.0.2.4.3015
  DBNAME( 'diTimestamp'  'diTimestamp' )
  )

dn:cn=schema
changetype: modify
replace: attributetypes
attributetypes: (
  1.3.18.0.2.4.3015
  NAME 'ibm-diTimestamp'
  DESC 'Timestamp entry for synchronizing passwords with IBM Directory Integrator.'
  EQUALITY generalizedTimeMatch
  ORDERING generalizedTimeOrderingMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.24
  USAGE userApplications
  )
-
replace: ibmattributetypes
ibmattributetypes: (
  1.3.18.0.2.4.3015
  DBNAME( 'diTimestamp'  'diTimestamp' )
  ACCESS-CLASS normal
  )

