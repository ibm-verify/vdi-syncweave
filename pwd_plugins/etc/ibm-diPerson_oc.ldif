dn:cn=schema
changetype: modify
add: objectclasses
objectclasses: (
  1.3.18.0.2.6.547
  NAME 'ibm-diPerson'
  STRUCTURAL
  )

dn:cn=schema
changetype: modify
replace: objectclasses
objectclasses: (
  1.3.18.0.2.6.547
  NAME 'ibm-diPerson'
  DESC 'Person entry for synchronizing passwords with IBM Directory Integrator.'
  SUP top
  STRUCTURAL
  MAY ( ibm-diTimestamp $ ibm-diCustomData $ ibm-diExtendedData $ secretKey $ ibm-diPassword $ ibm-diUserid $ uid )
  )

dn:cn=schema
changetype: modify
replace: attributetypes
attributetypes: (
  1.2.840.113556.1.2.50
  NAME 'isSoftDeleted'
  DESC 'The indication that the user is soft deleted.'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.7
  SINGLE-VALUE
  USAGE userApplications
  )
-
replace: ibmattributetypes
ibmattributetypes: (
  1.2.840.113556.1.2.50
  DBNAME( 'isSoftDeleted'  'ISSOFTDELETED' )
  ACCESS-CLASS normal
  LENGTH 5
  )
  
  
dn:cn=schema
changetype: modify
replace: attributetypes
attributetypes: (
  1.2.840.113556.1.2.51
  NAME 'softDeletedTimestamp'
  DESC 'Specifies the time that the user was soft deleted'
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.24
  SINGLE-VALUE
  USAGE userApplications
  )
-
replace: ibmattributetypes
ibmattributetypes: (
  1.2.840.113556.1.2.51
  DBNAME( 'softDeletedTimestamp'  'SOFTDELETEDTIMESTAMP' )
  ACCESS-CLASS normal
  )
  
  
dn:cn=schema
changetype: modify
replace: objectclasses
objectclasses: (
  2.5.6.6
  NAME 'person'
  DESC 'Defines entries that generically represent people.'
  SUP top
  STRUCTURAL
  MUST ( cn $ sn ) 
  MAY ( description $ isSoftDeleted $ softDeletedTimestamp $ seeAlso $ telephoneNumber $ userPassword )
  )
