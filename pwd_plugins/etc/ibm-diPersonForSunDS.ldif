dn:cn=schema
changetype: modify
add: attributetypes
attributetypes: (
  1.3.18.0.2.4.155
  NAME 'secretKey'
  DESC 'This attribute contains an encrypted key used in the generation of a passticket or password..'
  EQUALITY octetStringMatch
  SYNTAX 1.3.6.1.4.1.1466.115.121.1.5
  SINGLE-VALUE
  USAGE userApplications
  )

dn:cn=schema
changetype: modify
add: objectclasses
objectclasses: (
  1.3.18.0.2.6.547
  NAME 'ibm-diPerson'
  DESC 'Person entry for synchronizing passwords with IBM Directory Integrator.'
  SUP top
  STRUCTURAL
  MAY ( ibm-diTimestamp $ ibm-diCustomData $ ibm-diExtendedData $ secretKey $ ibm-diPassword $ ibm-diUserid $ uid )
  )

