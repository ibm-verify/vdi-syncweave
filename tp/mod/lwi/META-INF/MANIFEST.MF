Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: TP Server
Bundle-SymbolicName: com.ibm.di.tp.server;singleton:=true
Bundle-Version: 7.1.0.qualifier
Bundle-Vendor: IBM
Bundle-RequiredExecutionEnvironment: JavaSE-1.7,
 JavaSE-1.8
Import-Package: javax.naming,
 javax.servlet;version="[2.4,5.0)",
 javax.servlet.http;version="[2.4,5.0)",
 javax.xml,
 javax.xml.bind,
 javax.xml.bind.annotation,
 javax.xml.bind.annotation.adapters,
 javax.xml.bind.attachment,
 javax.xml.bind.helpers,
 javax.xml.bind.util,
 javax.xml.namespace,
 javax.xml.parsers,
 javax.xml.transform,
 javax.xml.transform.dom,
 javax.xml.transform.sax,
 javax.xml.transform.stream,
 javax.xml.validation,
 javax.xml.xpath,
 org.osgi.framework,
 org.osgi.service.http,
 org.osgi.util.tracker,
 org.w3c.dom,
 org.w3c.dom.traversal,
 org.xml.sax,
 org.xml.sax.ext,
 org.xml.sax.helpers
Bundle-Activator: com.ibm.di.tp.server.ServerActivator
Bundle-ClassPath: .,
 WEB-INF/classes/,
 WEB-INF/lib/jaxrs-api-1.0.jar,
 WEB-INF/lib/slf4j-api-1.7.36.jar,
 WEB-INF/lib/slf4j-jdk14-1.7.36.jar,
 WEB-INF/lib/ibm-wink-jaxrs-1.0.0.jar,
 WEB-INF/lib/JSON4J.jar,
 WEB-INF/lib/diserverapi.jar,
 WEB-INF/lib/diserverapirmi.jar,
 WEB-INF/lib/miconfig.jar,
 WEB-INF/lib/miserver.jar,
 WEB-INF/lib/tdiresource.jar
Bundle-ActivationPolicy: lazy
Export-Package: com.ibm.di.api

