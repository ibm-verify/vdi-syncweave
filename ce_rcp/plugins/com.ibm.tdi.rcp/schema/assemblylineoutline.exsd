<?xml version='1.0' encoding='UTF-8'?>
<!-- Schema file written by PDE -->
<schema targetNamespace="com.ibm.tdi.rcp">
<annotation>
      <appInfo>
         <meta.schema plugin="com.ibm.tdi.rcp" id="assemblyline" name="AssemblyLine"/>
      </appInfo>
      <documentation>
         This extension point can be used to extend the AssemblyLine editor in various aspects. It is used internally to define toolbars and context menus.

The following points are defined:

&lt;ul&gt;
&lt;li&gt;outline - The treeview showing the outline of the assemblyline&lt;/li&gt;
&lt;/ul&gt;
      </documentation>
   </annotation>

   <element name="extension">
      <complexType>
         <sequence>
            <element ref="outline"/>
            <element ref="toolbar"/>
         </sequence>
         <attribute name="point" type="string" use="required">
            <annotation>
               <documentation>
                  
               </documentation>
            </annotation>
         </attribute>
         <attribute name="id" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
            </annotation>
         </attribute>
         <attribute name="name" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
               <appInfo>
                  <meta.attribute translatable="true"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="outline">
      <annotation>
         <documentation>
            The outline is the popup menu for the AssemblyLine outline tree you see in the editor.
         </documentation>
      </annotation>
      <complexType>
         <attribute name="class" type="string" use="required">
            <annotation>
               <documentation>
                  If the class implements ISelectionListener the editor will add your instance as a selection listener. Use this approach if you only need access to the selection in the outline tree. Otherwise, you may want to use the Workbench selection listener service.
               </documentation>
               <appInfo>
                  <meta.attribute kind="java" basedOn="org.eclipse.jface.action.IAction"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="label" type="string" use="required">
            <annotation>
               <documentation>
                  
               </documentation>
               <appInfo>
                  <meta.attribute translatable="true"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="id" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
            </annotation>
         </attribute>
         <attribute name="icon" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
               <appInfo>
                  <meta.attribute kind="resource"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="types" type="string">
            <annotation>
               <documentation>
                  The action will be enabled when the selection matches the following keywords:

&lt;ul&gt;
&lt;li&gt;connector - Connector Components&lt;/li&gt;
&lt;li&gt;function - Function Components&lt;/li&gt;
&lt;li&gt;container - Container Components (e.g. Branches and Folders)&lt;/li&gt;
&lt;li&gt;hooks - AssemblyLine Hooks&lt;/li&gt;
&lt;li&gt;all - Applies to all types&lt;/li&gt;
&lt;/ul&gt;
               </documentation>
            </annotation>
         </attribute>
         <attribute name="multi" type="boolean" use="required">
            <annotation>
               <documentation>
                  Specify true if action can handle multiple selected configuration items.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="name" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
            </annotation>
         </attribute>
         <attribute name="tooltip" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="toolbar">
      <annotation>
         <documentation>
            The toolbar can be populated by ToolItems. Your class must at least implement IAction or be a Control subclass (it can be both). When a Control class is provided, we invoke ToolItem.setControl(your-class). If you provide an IAction interface we will invoke the run() method when the toolitem has been selected (SDI creates a selection listener to invoke the run method).

&lt;p&gt;
If the class implements ISelectionListener the editor will add your instance as a selection listener. Use this approach if you only need access to the AssemblyLineConfig. Otherwise, you may want to use the Workbench selection listener service. The toolbar provides no dynamic config object selections but it will always provide its AssemblyLineConfig object as to the setEditingConfigObject() method so you can access this object when the handler runs.
         </documentation>
      </annotation>
      <complexType>
         <attribute name="class" type="string" use="required">
            <annotation>
               <documentation>
                  Provide an IAction or Control class.
               </documentation>
               <appInfo>
                  <meta.attribute kind="java"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="label" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
            </annotation>
         </attribute>
         <attribute name="icon" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
               <appInfo>
                  <meta.attribute kind="resource"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="id" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
            </annotation>
         </attribute>
         <attribute name="style" type="string" use="default" value="push">
            <annotation>
               <documentation>
                  Enter the style for the toolbar item. Valid choices are: check, push, dropdown
               </documentation>
            </annotation>
         </attribute>
         <attribute name="tooltip" type="string">
            <annotation>
               <documentation>
                  
               </documentation>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <annotation>
      <appInfo>
         <meta.section type="since"/>
      </appInfo>
      <documentation>
         7.1
      </documentation>
   </annotation>

   <annotation>
      <appInfo>
         <meta.section type="examples"/>
      </appInfo>
      <documentation>
         
      </documentation>
   </annotation>

   <annotation>
      <appInfo>
         <meta.section type="apiInfo"/>
      </appInfo>
      <documentation>
         Extensions must implement IAction and will be added to the specified toolbar/context menu
      </documentation>
   </annotation>

   <annotation>
      <appInfo>
         <meta.section type="implementation"/>
      </appInfo>
      <documentation>
         
      </documentation>
   </annotation>

   <annotation>
      <appInfo>
         <meta.section type="copyright"/>
      </appInfo>
      <documentation>
         
      </documentation>
   </annotation>

</schema>
