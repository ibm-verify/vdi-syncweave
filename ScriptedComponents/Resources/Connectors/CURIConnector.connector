            <parameter name="script"><![CDATA[vrs = "20130218.b" // Corrected parsing of valueType == status to return an Entry with correct value

java.lang.System.out.println("CURI Connector v." + vrs)


var baseURL = null
var datasetURI = null
var fullURL = null
var user = null
var password = null
var start = null
var count = null
var params = null
var conditions = null
var entries = null
var entryCnt = 0
var jsonString = ""
var valueField = "value"
var deBug = false
var useJSON = null
var useProxy = false;
var proxyServer = null;
var proxyUser = null;
var proxyPassword = null;

// attributes for each Entry in the same dataset (Dataset fields - prefixed with $ to avoid overwriting properties)
var DSField = null

if (typeof(system) == "undefined") {
	var c = java.lang.Class.forName("com.ibm.di.function.UserFunctions")
	system = new c
}	

http = system.getConnector("ibmdi.HTTPClient")

function initialize() {
	var p
	var p2
	var embeddedURI

	deBug = ("true" == connector.getParam("debug"))

//	if (deBug) 
	/*	useJSON = connector.getParam("userComment") // @@@@@
	if (useJSON != null && useJSON.trim().length == 0)
		useJSON = null
	else
		useJSON = fromJson(useJSON)*/
	
	baseURL = connector.getParam("baseURL")
	datasetURI = connector.getParam("dataset")
	
	p = datasetURI.indexOf("|<<")
	p2 = datasetURI.indexOf(">>|")
	if (p > 0 && p2 > 0 && p2 > p) {
		embeddedURI = datasetURI.substring(p+3, p2)
		datasetURI = embeddedURI + datasetURI.substring(p2+3)
	}	
	
	fullURL = baseURL + datasetURI
	
	user = connector.getParam("user")
	password = connector.getParam("password")
	start = connector.getParam("start")
	count = connector.getParam("count")
	useProxy = "true".equalsIgnoreCase(connector.getParam("useProxy"));
	proxyServer = connector.getParam("proxyServer");
	proxyUser = connector.getParam("proxyUser");
	proxyPassword = connector.getParam("proxyPassword");
	entries = null
	
	var useDisplayValue = connector.getParam("useDisplayValue")
	
	if (useDisplayValue == true) {
		valueField = "displayValue";
	} else {
		valueField = "value";
	}	
		
	var proxySettings = "";
	if (useProxy) {
		proxySettings = "\nusing proxy: " + proxyServer + " with username: " + proxyUser;
	}	
		
	if (deBug) java.lang.System.out.println("\n\ninitialize() - \nurl: " + baseURL 
			+ "\ndataset uri: " + datasetURI + "\nfull url: " + fullURL
			+ proxySettings);
	
	if (!baseURL || baseURL == null || baseURL.trim() == "")
		throw "Required parameter for the Provider Dataset URL not set."
	
	if (baseURL.endsWith("/"))
		baseURL = baseURL.substring(0,baseURL.length-1)
		
//	task.logmsg("initialize() - baseURL: " + baseURL)
	
	conditions = connector.getParam("conditions")
	params = getParams()
}

function terminate() {
	baseURL = null
	entries = null
}


function querySchema() {
	var url = fullURL + "/columns" + queryStringParams()
	var p
	var e
	var schema
	var json
	var attNames
	
	java.lang.System.out.println("querySchema()")

	if (useJSON == null)
		json = makeCall(url, "No columns returned from Dataset")
	else
		return null
	
	schema = system.newEntry()
	for (var i = 0; i < json.items.length; i++)  {
		p = json.items[i]
		schema[p.id] = p.valueType
	}		
	
	attNames = schema.getAttributeNames()
	for (var att in attNames)  {
		e = system.newEntry()
		
		e.name = att
		e.syntax = schema.getString(att)
		list.add(e);
		params.put(p.id, e)
	}
		
	result.setStatus (1);
}


function selectEntries() {
	var url = fullURL + "/items" + queryStringParams(start, count)
	var json
	
//	java.lang.System.out.println("selectEntries()")
	
	if (useJSON != null)
		json = useJSON
	else
		json = makeCall(url, "No columns returned from Dataset")
	
	DSField = new java.util.HashMap()
	
	for (var o in json)
		if (typeof(json[o]) != "object")
			DSField.put(o, json[o])
	
	entries = json.items
	id = entries.id
	label = entries.label
	entryCnt = 0
}

function toEntry(thisProp) {
	var e = system.newEntry()
	
	for (var p in thisProp)
		e[p] = thisProp[p]
		
	return e
}

function addAttributes(entry, json, depth, attname) {
	var props = json.properties
	
	if (typeof(attname) == "undefined")
		attname = "?????"
	
	if (typeof(depth) == "undefined" || depth <= 0) {
		for (var o in json)
			if (typeof(json[o]) != "object")
				entry[o] = json[o]
				
		depth = 0
	} else {
		if (typeof(json[valueField]) != "undefined")
			entry[attname] = json[valueField]
	}
	
	if (typeof(props) != "undefined" && props != null) {
		for (var i = 0; i < props.length; i++) {
			thisProp = props[i]
			
			if (typeof(thisProp[valueField]) == "object") {
				if ("status".equals(thisProp.valueType)) {
					entry[thisProp.id] = toEntry(thisProp)
					var e = entry.getObject(thisProp.id)
					e.value = toEntry(thisProp.value)
				} else
					addAttributes(entry, thisProp[valueField], depth+1, thisProp.id)
			}
			else
			if (typeof(thisProp[valueField]) != "undefined") {
				entry[thisProp.id] = thisProp[valueField]
			}
			else {
				java.lang.System.out.println("addAttributes() - parsing problem: " + toJSON(thisProp))
			}	
		}
	}	
}

function getNextEntry () {
	var p
	var i
	var itr
	var key
	var json
	var val

	if (deBug) java.lang.System.out.println("getNextEntry() - entryCnt: " + entryCnt + "   length: " + entries.length)
	
	if (entries == null || entryCnt >= entries.length) {
		result.setStatus (0);
		return;
	}

	json = entries[entryCnt]
	
//	addAttributes(entry, json)

	entryCnt++
		
	entry["$rowNumber"] = entryCnt
	entry["$totalRows"] = entries.length
	
	// now add fields from the top-level - the message itself
	itr = DSField.keySet().iterator()
	while (itr.hasNext()) {
		key = itr.next()
		entry["$" + key] = DSField.get(key)
	}	

	// add fields - apart from properties - for this item
	addAttributes(entry, json)
	
	result.setStatus (1);
	return entry		
}

function getParams() {
	var url = fullURL + "/parameters"
	var json
	var p
	var e
	var params = new java.util.HashMap()
	
	if (useJSON == null)
		json = makeCall(url, "No parameters returned from Dataset")
	else
		return params

	for (var i = 0; i < json.items.length; i++)  {
		p = json.items[i]
		e = system.newEntry()
		e.id = p.id
		e.label = p.label
		e.type = p.type
		e.description = p.description
		e.required = p.required
		if ( ("!" + p["default"]) != "!undefined" ) 
			e["default"] = p["default"]
		else
			e["default"] = ""

		params.put(p.id, e)
	}		

	return params		
}

function queryStringParams(strt, cnt) {
	var qs = ""
	var itr = params.keySet().iterator()
	var e
	var pval
	
	itr = params.keySet().iterator()
	
	while (itr.hasNext()) {
		e = params.get(itr.next())
		pval = connector.getParam(e.id.getValue())
		if (pval && pval != null && pval.trim() != "")
			if (!qs)
				qs = "?param_" + e.id + "=" + pval
			else
				qs += "&param_" + e.id + "=" + pval
	}
	
	if (conditions && conditions != null && conditions.trim() != "")
		if (!qs)
			qs += "conditions=" + conditions
		else
			qs += "&conditions=" + conditions
			
	if (typeof(strt) != "undefined" && strt != "")
		qs += "&start=" + strt
	if (typeof(cnt) != "undefined" && cnt != "")
		qs += "&count=" + cnt
    
    qs += "&properties=all"
    
	if (qs.startsWith("&"))
		qs = "?" + qs.substring(1)
		
//java.lang.System.out.println("qs: " + qs)

	return qs
}

function makeCall(uri, errormsg) {
	var httpEntry
	var jsonStr
	var json

	http.setParam("url", uri)
	http.setParam("username", user)
	http.setParam("password", password)
	http.initialize(null)
	
	if (useProxy && proxyServer !== null) {
		http.setParam("proxy", proxyServer);
		http.setParam("proxyUsername", proxyUser);
		http.setParam("proxyPassword", proxyPassword);
	}

	httpEntry = system.newEntry();
	httpEntry["http.content-type"] = "application/json"
	httpEntry["http.method"] = "GET"
	httpEntry["http.accept"] = "application/json"
	
	if (deBug) java.lang.System.out.println("uri: " + uri)

	httpEntry = http.queryReply(httpEntry)	

	jsonStr = httpEntry.getString("http.bodyAsString")
	
	if (deBug) {
		java.lang.System.out.println(">>Making call to " + uri + "\n<<Received: " + jsonStr)
	}
	// java.lang.System.out.println("json: " + jsonStr)
	
	jsonString = jsonStr
	connector.setParam("jsonString", jsonString)
	
	if (jsonStr == null) {
		throw errormsg + " - HTTP return:\n" + httpEntry.toString()
	}	
	else {
		try {
			json = fromJson(jsonStr)
		} catch (ex) {
			throw errormsg + " - Error parsing JSON received: " + ex + "    JSON: " + jsonStr
		}	
//		eval("json=" + jsonStr)
	}	

	if (typeof(json) == "undefined" || json == null) {
		throw errormsg + " - HTTP return:\n" + httpEntry.toString()
	} else
	if (json.msgSeverity)
		throw json.msgText + "\nJSON returned:\n" + jsonStr
	
	return json
}
