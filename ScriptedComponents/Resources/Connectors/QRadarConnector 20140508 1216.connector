            <parameter name="script"><![CDATA[/*
vrs = "20120504"	// Created
vrs = "20121212"	// Fixed parseDate() to use paramDateMask
vrs = "20121206"	// Corrected date mask dropdown list (in form)
vrs = "20121125"	// Corrected Form according to Chirag's review
vrs = "20121022"	// Fixed schema discovery, paramDateMask handling (default = QRadarDateMask) and reading LEEF format, plus closing input file in case of Connect + Next
vrs = "20121018"	// Improved querySchema to return Required/Optional for attributes in the returned schema
vrs = "20121016"	// Removed prefix for mandatory attributes + added new date mask "EEE MMM dd HH:MM:ss z yyyy"
vrs = "20121218 1140"	// Fixed parsing of first attribute after LEEF Header
vrs = "20121218 1150"	// Corrected Syslog header date output - must be ISO date format
vrs = "20121218 1221"	// Fixed parseDate() to use two ISO data masks (2 and 3 digit msec value)
vrs = "20121218 1343"	// Corrected parsing of syslog header during read
vrs = "20130311 1644"	// Added Syslog output support
vrs = "20130313 1053"	// Made syslog output in LEEF format
vrs = "20130403 1040"	// Beefed up date parsing
vrs = "20130723 1223"	// corrected an error that required the file path set for syslog output
vrs = "20130723 1540"	// added debugOutput
vrs = "20130927 1223"	// fixed a bug in setting the 'port' param and removed debugOutput
vrs = "20131004 1725"   // CJ - changed work[attributes] to work.getAttributes(attributes)
vrs = "20131011 1523"   // CJ - changed getDate()
 */
vrs = "20140507 2206"   // Fixed output to not include $ attributes

var syslog = true

// -------------------------------------------------------------------------------------------
// First variables for LEEF output
// -------------------------------------------------------------------------------------------

var LEEFVersion = "1.0"
var ISOdateMask = "yyyy-MM-dd'T'HH:mm:ss.SSZ"
var ISOdateMask2 = "yyyy-MM-dd'T'HH:mm:ss.SSSZ"
var QRadarDateMask = "MMM dd yy HH:mm:ss"
var QRadarSyslogHeaderMask = "^(?:<\\d{1,3}>)?(\\w{1,3})\\s+(\\d{1,2})\\s+(\\d{1,2}):(\\d{1,2}):(\\d{1,2})(?:\\s+(20\\d\\d))?\\s+(?:Message forwarded from\\s+)?((\\w|\\.|\\-|\\/){1,254})\\s+"

// parameters
var paramFilePath = "C:/temp/LEEF_output.txt"
var paramSplitOnEvents = null
var eventCnt = 0
var paramDateMask = QRadarDateMask

var outFile  = null // output fileWriter
var inFile = null   // input fileReader
var protocolNames = new java.util.HashMap()
var protocolNumbers = new java.util.HashMap()
var eventAttributes = new java.util.HashMap()
var predefinedLEEFAttributes = system.newEntry()
var syslogHeaderAttributes = system.newEntry()
var leefHeaderAttributes = system.newEntry()
var syslogAttributes = system.newEntry()
var currentYear = 12
var debug = false;

// -------------------------------------------------------------------------------------------
// variables for Syslog
// -------------------------------------------------------------------------------------------

// Date formatter
//simpleDateFormat = new java.text.SimpleDateFormat("MMMM d HH:mm:ss");
//simpleDateFormat = new java.text.SimpleDateFormat(ISOdateMask);

// severity codes
severity = [
	"Emergency",
	"Alert",
	"Critical",
	"Error",
	"Warning",
	"Notice",
	"Informational",
	"Debug"
];

// facility codes
facility = [
	"kernel",
	"user",
	"mail",
	"system daemons",
	"security/authorization",
	"internal syslogd",
	"line printer subsystem",
	"network news subsystem",
	"UUCP subsystem",
	"clock daemon",
	"security/authorization messages",
	"FTP daemon",
	"NTP subsystem",
	"log audit (note 1)",
	"log alert (note 1)",
	"clock daemon (note 2)",
	"local0",
	"local1",
	"local2",
	"local3",
	"local4",
	"local5",
	"local6",
	"local7"
];


function logmsg(msg) {
	if (debug)
		java.lang.System.out.println(msg)
	try {
		task.logmsg(msg)
	} catch (ex) {
		main.logmsg(msg)
	}	
}

function initialize() {
	debug = "true".equalsIgnoreCase(connector.getParam("detailedLog"))
	syslog = "true".equalsIgnoreCase(connector.getParam("useSyslog"))
	
	logmsg("Initializing QRadar Connector vrs. " + vrs + " - LEEF Version supported is " + LEEFVersion + "   syslog output: " + syslog)

	if (syslog) {
		syslog_initialize()
	}	

	leef_initialize()
}	

function terminate() {
	if (syslog) {
		syslog_terminate()
	}	

	leef_terminate()
}

function querySchema() {
	var schema = config.getSchema(false);
	
	if (debug) logmsg("LEEFConnector querySchema called")

	if (syslog) {
		syslog_querySchema(schema)
	} 

	leef_querySchema(schema)

	result.setStatus(0)
}

function putEntry() {
	if (syslog) {
		syslog_putEntry(entry)
	} else {
		leef_putEntry(entry)
	}
}

// To enable Connect + Read next (In/Out Maps) & the Data Browser
function selectEntries() {
	// does nothing - just so that you can do a Connect + Next	
}

function getNextEntry() {
	if (syslog) {
		throw "Iterator mode is not support for Syslog output"
	} else {
		leef_getNextEntry()
	}
}


// -------------------------------------------------------------------------------------------
// Functions for Syslog
// -------------------------------------------------------------------------------------------

// Get a UDP socket on first available localhost port
var socket = new java.net.DatagramSocket();

function getArrValue(str, arr) {
	var value = str;
	for(var i = 0; i < arr.length; i++) {
		if(arr[i].equalsIgnoreCase(str)) {
			return i;
		}
	}
	return value;
}

function getFacility(fac) {
	try {
		return java.lang.Integer.parseInt(fac);
	} catch(err) {
		return getArrValue(fac, facility);
	}
}

function getSeverity(sev) {
	try {
		return java.lang.Integer.parseInt(sev);
	} catch(err) {
		return getArrValue(sev, severity);
	}
}

function getPriority(e) {
	var fac = e.getString("$facility");
	if(fac == null) {
		fac = connector.getParam("facility");
	}	
	if(fac == null) {
		fac = "local0";
	}	
	fac = getFacility(fac);
	
	var sev = e.getString("$severity");
	if(sev == null) {
		sev = connector.getParam("severity");
	}	
	if(sev == null)
		sev = "Informational";
	sev = getSeverity(sev);
	
	return java.lang.Integer.toString( (fac << 3) + sev );
}

function getHost(str) {
	if(str == null)
		str = connector.getParam("hostname");
	if(str == null)
		str = "localhost";
		
	return java.net.InetAddress.getByName(str);
}

function getPort(str) {
	if(str == null) {
		str = connector.getParam("port");
	}
	
	try {
		var port = java.lang.Integer.parseInt(str)
	} catch (ex) {
		port = 9514
	}

	return port
}

function getDate(date) {
	if(date == null)
		date = new java.util.Date();
		
	//date = date.toString()
	try {
		var datestr = system.formatDate(date,ISOdateMask)
		date = datestr
	} catch (ex) {
		//do nothing
	}  

	return system.formatDate(parseDate(date, true), ISOdateMask)
}

function getLocalhost(str) {
	if(str != null)
		return str;
		
	var iaddr = socket.getInetAddress();
	if(iaddr == null)
		iaddr = java.net.InetAddress.getLocalHost();
		
	return iaddr.getHostName();
}

function prepareSyslogAttributes() {
	var fields = ["$host", "$port", "$severity", "$facility"];
	for(var i = 0; i < fields.length; i++) {
		var f = fields[i]
		if (f == "$port") {
			syslogAttributes.setAttribute(f, { type:"Integer", range: [0, 65535] })
		} else {
			syslogAttributes.setAttribute(f, { type:"String", length: 1024 })
		}
	}	
}

function syslog_initialize() {
	prepareSyslogAttributes()	
}

/**
 * <PRI><TIME-STAMP><HOSTNAME><MSG>
 * 
 * <27>Jul 27 00:30:13 Shelob newsyslog[24155]: logfile turned over
 * 
 *
 */
function syslog_putEntry(entry) {
	var buf = new java.lang.StringBuffer();
	var msg = buildLeefMessage(entry);

	buf.append("<");
	buf.append(getPriority(entry));
	buf.append(">");
	
	buf.append(getDate(entry.getObject("SyslogHeader_Timestamp")));
	buf.append(" ");
	
	buf.append(getLocalhost(entry.getString("SyslogHeader_IPAddress")));
	buf.append(" ");
	
	buf.append(msg);

	if (debug) logmsg(buf.toString());

	var bytes = buf.toString().getBytes();
	var packet = new java.net.DatagramPacket(bytes, bytes.length, getHost(entry.getString("$hostname")),
		getPort(entry.getString("$port")) );
		
	socket.send(packet);
}

function syslog_querySchema(schema) {
	addToSchema(syslogAttributes, schema)
}

function syslog_terminate() {
	if(socket != null) {
		socket.close();
		socket = null;
	}
}

// -------------------------------------------------------------------------------------------
// Functions for LEEF output 
// -------------------------------------------------------------------------------------------

function openFile(filePath) {
	var mode = connector.getMode()
}


function leef_initialize() {
	leef_terminate()

	// get parameters
	if (!syslog) {
		paramFilePath = connector.getParam("filePath")
		if (paramFilePath == null || paramFilePath == "") {
			throw "File path parameter not specified"
		}	
	}	

	paramDateMask = connector.getParam("dateMask")
	if (paramDateMask == null || paramDateMask == "")
		paramDateMask = QRadarDateMask
		
	if (system.formatDate(new java.util.Date(), paramDateMask) == null)
		throw "Invalid date mask parameter value: " + paramDateMask

	getProtocolNumbers()
	prepareLEEFHeaderAttributes()
	prepareSyslogHeaderAttributes()
	preparePredefinedLEEFAttributes(prefinedLEEFAttributesStr)

	paramSplitOnEvents = connector.getParam("splitOnEvents")
	if (paramSplitOnEvents != null && system.isValidInt(paramSplitOnEvents))
		maxEvent = system.toInt(paramSplitOnEvents)
	else
		maxEvent = -1	

//	paramSplitOnFileSize = connector.getParam("splitOnFileSize")
//	if (paramSplitOnFileSize != null && system.isValidInt(paramSplitOnFileSize))
//		maxFileSize = system.toInt(paramSplitOnFileSize)
//	else
//		maxFileSize = -1	

	var cal = new java.util.GregorianCalendar()
	currentYear = cal.get(java.util.Calendar.YEAR)

	entryCnt = 0
}	

function leef_terminate() {
	if (debug)
		logmsg("Closing LEEFConnector")

	// first close input file (in case of Connect/Next opening)
	try {
		if (typeof(inFile) != "undefined" && inFile != null) {
			inFile.close()
		}
	} catch(ex) {
		// do nothing		
	}

	// now, if output mode, close the output file
	try {
		if (config.getMode() == "AddOnly" && typeof(outFile) != "undefined" && outFile != null) {
			outFile.flush()
			outFile.close()
		}
	}  catch (ex) {
		throw "Error closing file: " + ex
	}
	
	inFile = null
	outFile = null
}

function leef_querySchema (schema) {
	addToSchema(leefHeaderAttributes, schema, true /* required = true */)
	addToSchema(syslogHeaderAttributes, schema)
	addToSchema(predefinedLEEFAttributes, schema)

	result.setStatus(0)
}

function addToSchema(attlist, schema, required) {
	var atts = attlist.getAttributeNames()
	var presenceFlag = (typeof(required) == "undefined" || !required) ? "Optional" : "Required"
	
//	logmsg("addToSchema - attList: " + attlist.toString() + "\nschema: " + schema + "\nrequired: " + required)
	
	for (var attname in atts) {
		var p = attlist.getObject(attname)
		try {
			var item = schema.newItem(attname);
			item.setExternalSyntax(p.type);
			item.setPresenceFlag(presenceFlag)
		} catch (ex) {
			// do nothing - attribute already exists in the schema
		}	
		
//		logmsg("LEEFConnector - adding to schema: " + attname + " (" + p.type + ") " + presenceFlag)
	}
}

// To enable Connect + Read next (In/Out Maps) & the Data Browser
function leef_getNextEntry() { // to enable Data Browser functionality
	var idx = 0
	var attName
	var attValue
	var useFileName = paramFilePath
	var file
	
	if (typeof(inFile) == "undefined" || inFile == null) {
		file = new java.io.File(useFileName)
		if (!file.exists()) {
			file = new java.io.File(newFileName(useFileName,0))
			if (file.exists()) {
				useFileName = newFileName(useFileName,0)
			}
		}
	
		inFile = system.openFileForInput(useFileName)
	}

	inLine = inFile.readLine()

	if (inLine == null) {
		result.setStatus(0)
		return null
	}

//	if (inLine.matches(QRadarSyslogHeaderMask)) {
//		logmsg("Matches: " + QRadarSyslogHeaderMask)
//	}

	parts = inLine.split("\t")
	if (parts.length < 2) {
		throw "Too few tabs (min=3) found in line: " + inLine
	}

	bits = parts[0].split("|")

	var readVersion = bits[0].substring(bits[0].length-8)
	if (readVersion != "LEEF:" + LEEFVersion)
		throw "LEEF Version should be " + LEEFVersion + "    input: " + inLine

	bits[0] = bits[0].substring(0, bits[0].length - readVersion.length).trim()

	var p = -1
	for (p = bits[0].length-1; p >= 0; p--)
		if (bits[0].substring(p,p+1) == " ")
			break; 
		
	var date = parseDate(bits[0].substring(0,p).trim())
	if (date != null) {	
		entry["SyslogHeader_Timestamp"] = date

		var ip = bits[0].substring(bits[0].lastIndexOf(" ")).trim()
		if (ip.indexOf(".") > 0) // @@@@@ TODO - need to add handling of IPv6
			entry["SyslogHeader_IPAddress"] = ip
	}	

	idx++
	entry["LEEFHeader_Vendor"] = bits[idx++]
	entry["LEEFHeader_Product"] = bits[idx++]
	entry["LEEFHeader_ProductVersion"] = bits[idx++]
	entry["LEEFHeader_EventID"] = bits[idx++]
	
	// 20121218 need to grab the first attribute after the LEEF Header
	if (idx < bits.length) {
		var p = bits[idx].indexOf("=")
		attValue = bits[idx].substring(p+1)
		attName = bits[idx].substring(0, p)
		entry[attName] = attValue
	}	
	

	for (idx = 1; idx < parts.length; idx++) {
		p = parts[idx].indexOf("=")
		attValue = parts[idx].substring(p+1)
		attName = parts[idx].substring(0, p)
		entry[attName] = attValue
	}

	result.setStatus(1)
}

function digits(num, len) {
	var zeroes = "00000000"
	var dig = zeroes + Math.round(num)
	return dig.substring(dig.length-len)
}

function newFileName(fileName, fileNumber) {
	var newName = fileName
	var p = newName.lastIndexOf(".")
	if (p > 0 && p < (newName.length-1) ) {
		newName = newName.substring(0, p) + "_" + digits(fileNumber,3) + newName.substring(p)
	} else
		newName += "_" + fileNumber
	return newName
}

function buildLeefMessage(entry) {
	var attNames
	var attName
	var attValue
	var parseObj
	var customAtts = new java.util.ArrayList()
	var outLine = ""
	var eventAtts = new java.lang.StringBuffer()
	var str
	var dateMask
	var outLine = new java.lang.StringBuffer()

	// first make sure required attributes are present
	attNames = leefHeaderAttributes.getAttributeNames()
	for (attName in attNames)
		if (entry.getString(attName) == null)
			throw "Required LEEF Header Attribute missing from Output Map: " + attName

	// validate attribute values and look for custom ones
	attNames = entry.getAttributeNames()
	for (attName in attNames) {
		attValue = entry.getObject(attName)
		parseObj = getParseObj(attName)
		if (parseObj == null)
			customAtts.add(attName) // now you must have the devTime attribute
		else
			validateAttribute(attName, attValue, parseObj)
	}

	// if custom attributes detected, make sure devTime is present
	if (customAtts.size() > 0) {
		if (entry.getString("devTime") == null)
			throw "Attribute devTime missing from Output Map. Custom attributes detected: " + arrayList2String(customAtts)
	}	

	if (entry.devTime != null && entry.devTimeFormat == null)
		entry.devTimeFormat = paramDateMask

	if (entry.devTimeFormat == null || entry.devTimeFormat.getValue() == null)
		dateMask = paramDateMask
	else
		dateMask = entry.devTimeFormat.getValue()

	if (dateMask == null || dateMask.trim().length == 0)
		dateMask = ISODateMask

	// create output line
	// start with Syslog header if not syslog
	if (entry.getString("SyslogHeader_Timestamp") != null && !syslog) {
		str = system.formatDate(parseDate(entry.getObject("SyslogHeader_Timestamp"), true), QRadarDateMask)
		outLine.append(str + " " + entry.getString("SyslogHeader_IPAddress") + " ")
	}

	// now the LEEF header
//	if (!syslog)
		outLine.append("LEEF:")
	outLine.append(LEEFVersion
					+ "|" + entry.getString("LEEFHeader_Vendor") 
					+ "|" + entry.getString("LEEFHeader_Product")
					+ "|" + entry.getString("LEEFHeader_ProductVersion")
					+ "|" + entry.getString("LEEFHeader_EventID")
					+ "|")

	// collect event attributes
	correctCase(entry)
	attNames = entry.getAttributeNames()
	for (attName in attNames) {
		if (!attName.startsWith("LEEFHeader_") && !attName.startsWith("SyslogHeader_") && !attName.startsWith("$")) {
			if (eventAtts.length() > 0)
				eventAtts.append("\t")

			var att = predefinedLEEFAttributes.getAttribute(attName);

			if (att != null)
				attName = att.getName()

			attValue = entry.getObject(attName)

			var dateValue = parseDate(attValue)
			if (dateValue != null)
				attValue = system.formatDate(dateValue, dateMask)

			eventAtts.append(attName + "=" + attValue)
		}
	}

	return outLine.toString() + eventAtts.toString()
}

function leef_putEntry(entry) {
	var outLine = ""

	if (typeof(outFile) == "undefined" || outFile == null) {
		outFile = system.openFileForOutput(paramFilePath)
	}

	eventCnt++

	if ((maxEvent > 0 && (eventCnt % maxEvent) == 0)) {
		var fileNumber = Math.floor(eventCnt/maxEvent)

		outFile.flush()
		outFile.close()

		if (fileNumber == 1) {
			system.renameFile(paramFilePath,newFileName(paramFilePath,0))
			logmsg("LEEF Connector - renaming first file to " + newFileName(paramFilePath, 0))
		}

		newName = newFileName(paramFilePath, fileNumber)
		outFile = system.openFileForOutput(newName)
		logmsg("LEEF Connector - splitting on event #" + eventCnt + " to " + newName)
	}

	outLine = buildLeefMessage(entry)
	
	// write line
	outFile.write(outLine)
	outFile.newLine()
}

function correctCase(e) {
	var attNames = e.getAttributeNames();
	var attName
	var LEEPName
	for (attName in attNames) {
		var att = predefinedLEEFAttributes.getAttribute(attName);
		if (att != null)
			e.getAttribute(attName).setName(attName);
	}	
}

function arrayList2String(arrList) {
	var s = ""
	for (var i = 0; i < arrList.size(); i++)
		s += arrList.get(i) + ","
	return s.substring(0,s.length-1)
}

function parseDate(attValue) {
	var date = null
	var Zs = ["z","Z"]
	var zcnt = 0
	
	if (attValue.getClass().getName() == "java.lang.String") {
		attValue = attValue.trim()
		if (attValue.endsWith("Z")) {
			attValue = attValue.substring(0, attValue.length-1) + "+0000"
		}
		date = system.parseDate(attValue, paramDateMask)
		if (date === null) {
			if (date === null)
				date = system.parseDate(attValue, QRadarDateMask)
	
			if (system.isValidInt(attValue.substring(0,1)))
				date = system.parseDate(attValue, ISOdateMask)
	
			if (date === null && system.isValidInt(attValue.substring(0,1)))
				date = system.parseDate(attValue, ISOdateMask2)
	
			zcnt = 0
			
			if (date == null) {
				do {
					date = system.parseDate(attValue, "MMM dd yyyy HH:mm:ss.SSS " + Zs[zcnt])
					if (date === null)
						date = system.parseDate(attValue, "MMM dd yyyy HH:mm:ss " + Zs[zcnt])
					if (date === null)
						date = system.parseDate(attValue, "MMM dd yyyy HH:mm:ss")
		
					if (date === null) {
							date = system.parseDate(attValue, "MMM dd yy HH:mm:ss.SSS " + Zs[zcnt])
						if (date === null)
							date = system.parseDate(attValue, "MMM dd yy HH:mm:ss " + Zs[zcnt])
						if (date === null)
							date = system.parseDate(attValue, "MMM dd yy HH:mm:ss")
			
						if (date === null) {
							date = system.parseDate(attValue, "MMM dd HH:mm:ss.SSS " + Zs[zcnt])
							if (date === null)
								date = system.parseDate(attValue, "MMM dd HH:mm:ss " + Zs[zcnt])
							if (date === null)
								date = system.parseDate(attValue, "MMM dd HH:mm:ss")
								
							if (date != null) { // in this case, year will be 1970, so we make it the same as the current year
								var dtval = system.formatDate(date, "MMM dd HH:mm:ss.SSS z")
								date = system.parseDate(dtval.substring(0,7) + currentYear + dtval.substring(6), "MMM dd yyyy HH:mm:ss.SSS z")									
							}
						}
					}	
					
					if (date === null) {
						date = system.parseDate(attValue, "EEE MMM dd HH:MM:ss " + Zs[zcnt] + " yyyy")
					}
					zcnt++
				} while (date === null && zcnt < Zs.length)
			}	
		}
	} else
	if (attValue.getClass().getName() == "java.util.Date")
		date = attValue
	return date
}

function validateAttribute(attName, attValue, parseObj) {
	var errorMsg = ""
	var numValue
	switch (parseObj.type) {
		case "String":		if (attValue.length > parseObj.length)
								errorMsg = "String value length exceeds max of " + parseObj.length
							break
		case "Integer":		if (attValue.getClass().getName() == "java.lang.String") {
								if (!system.isValidInt(attValue)) {
									errorMsg = "Non-numeric Integer value detected"
									break
								} else {
									numValue = system.toInt(attValue)
								}	
							} else {
								numValue = Math.round(attValue)
							}	
							if (numValue < parseObj.range[0] || numValue > parseObj.range[1])
								errorMsg = "Integer value outside accepted range " + parseObj.range[0] + "-" + parseObj.range[1]
							break
		case "Date":		if (parseDate(attValue) == null)
								errorMsg = "Invalid Date value"
							break
		case "IPAddress": 	if (!validIPAddress(attValue))
								errorMsg = "Invalid IP Address"
							break
		case "MACAddress": 	if (!validMACAddress(attValue))
								errorMsg = "Invalid MAC Address"
							break
		case "Protocol": 	if (system.isValidInt(attValue)) {
								if (protocolNumbers.get(attValue) == null)
									errorMsg = "Protocol number not recognized"
							} else {
								if (protocolNames.get(attValue) == null)
									errorMsg = "Protocol keyword not recognized"
							}
							break
	}
	
	if (errorMsg) {
		throw "Attribute " + attName + " in error. " + errorMsg + ": '" + attValue + "'"
	}
}

function getParseObj(attName) {
	var parseObj = predefinedLEEFAttributes.getObject(attName)
	if (parseObj == null)
		parseObj = syslogHeaderAttributes.getObject(attName)
	if (parseObj == null)
		parseObj = leefHeaderAttributes.getObject(attName)
	return parseObj
}

