function preparePredefinedLEEFAttributes(listStr) {
	var parts = system.splitString(listStr,"@")
	var parseObj
	for (var p in parts) {
		parseObj = null		
		var bits = system.splitString(p, ",")
		if (bits.length >= 2) {
			if (bits[1].toLowerCase().startsWith("string")) {
				if (bits.length == 2)
					len = 1024
				else
				if (!system.isValidInt(bits[2]))
					break
				else
					len = system.toInt(bits[2])

				parseObj = { type:"String", length:len }
			}
			else
			if (bits[1].toLowerCase().startsWith("integer")) {
				if (bits.length == 2) {
//					parseObj = { type:"Integer", range: [-32768.0, 32767] }
					parseObj = { type:"Integer", range: [0, 65535] }
				} else {
					intRange = system.splitString(bits[2], "-")
					parseObj = { type:"Integer", range: [0, 0] }
					for (var i = 0; i < intRange.length; i++) {
						if (system.isValidInt(intRange[i]))
							parseObj.range[i] = system.toInt(intRange[i])
					}
				}
			}
			else
			if (bits[1].toLowerCase().startsWith("date")) {
				parseObj = { type: "Date" }
			}
			else
			if (bits[1].toLowerCase().startsWith("ipaddress")) {
				parseObj = { type: "IPAddress" }
			}
			else
			if (bits[1].toLowerCase().startsWith("macaddress")) {
				parseObj = { type: "MACAddress" }
			}
			else
			if (bits[1].toLowerCase().startsWith("protocol")) {
				parseObj = { type: "Protocol" }
			}
		}	
		
		if (parseObj == null)
			throw "**ERROR parsing predefined LEEF attributes string: " + p
		else
			predefinedLEEFAttributes.setAttribute(bits[0], parseObj)
	}
} 

function prepareSyslogHeaderAttributes() {
	syslogHeaderAttributes.setAttribute("SyslogHeader_Timestamp",{ type:"Date" })
	syslogHeaderAttributes.setAttribute("SyslogHeader_IPAddress",{ type:"IPAddress" })
}

function prepareLEEFHeaderAttributes() {
//	leefHeaderAttributes.setAttribute("LEEFHeader_LEEFVersion",{ type:"String", length: 1024 })
	leefHeaderAttributes.setAttribute("LEEFHeader_Vendor",{ type:"String", length: 1024 })
	leefHeaderAttributes.setAttribute("LEEFHeader_Product",{ type:"String", length: 1024 })
	leefHeaderAttributes.setAttribute("LEEFHeader_ProductVersion",{ type:"String", length: 1024 })
	leefHeaderAttributes.setAttribute("LEEFHeader_EventID",{ type:"String", length: 1024 })
}

// returns true if aname is a valid predefined LEEF attribute
function validPredefinedLEEFAttributeName(aname) {
	return protocolNames.get(aname) != null
