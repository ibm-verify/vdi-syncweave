function getProtocolNumbers() {
	var entry = null
/*	
	try {
		entry = system.httpGet(protocolNumbersURL)
	} catch (ex) {
		entry = null
	}	
*/	
	if (entry != null) { 
		var parser = system.getParser("ibmdi.XML2")
	
		var html = entry.getString("http.bodyAsString")
		parser.setInputStream(java.io.StringReader(html))
		parser.setParam("entry.tag",null)
		parser.initParser()
		var xml = parser.readEntry()
		var recs = xml.getElementsByTagName("record")
	
		for (var r in recs) {
			for (var a in r) {
				if (a.getName() == "value")
					v = a.getValue()
				else
				if (a.getName() == "name")
					n = a.getValue()
			}
			if (system.isValidInt(v) && a != null && a != "") {
				protocolNames.put(n, v)
				protocolNumbers.put(v, n)
			}	
		}	
	}	
	else { // use backup numbers
		var parts = system.splitString(protoNumbers,"@")
		for (var p in parts) {
			var bits = system.splitString(p,",")
			protocolNames.put(bits[0],bits[1])
			protocolNumbers.put(bits[1],bits[0])
		}
	}
}

var zeroCode = "0".getBytes()[0]
var aCode = "A".getBytes()[0]
function fromHex(hexStr) {
	hexStr = hexStr.toUpperCase()
	var hexVal = hexStr.toCharArray()
	var numValue = 0
	var bytes = hexStr.getBytes()
	if (hexVal.length == 0)
		return 0
	for (var i = hexVal.length-1; i >= 0; i--) {
		var ch = hexVal[i]
		if (ch >= "0" && ch <= "9")
			numValue = numValue + ((bytes[i] - zeroCode)*Math.pow(16,(3-i)))
		else
		if (ch >= "A" && ch <= "F")
			numValue = numValue + ((bytes[i] - aCode + 10)*Math.pow(16,(3-i)))
		else
			return -1
	}
	return numValue
}

// should rewrite to use Regex matching instead // @@@@@@@@@ TODO
function validIPAddress(val) {
	var parts
	return true; // short-circuited until I add support for hostnames  // @@@@@@@@@ TODO
	if (val.indexOf(":") > 0) { // IPv6
		parts = val.split(":")
		if (parts.length != 8)
			return false
		for (var i = 0; i < parts.length; i++) {
			var p = parts[i]
//		for (var p in parts) {
			if (p != null && p != "") {
				if (p.length != 4)
					return false
				if (fromHex(p) < 0)
					return false
			}				
		}
		return true
	}
	else { // IPv4
		parts = system.splitString(val,".")
		if (parts.length != 4)
			return false
		for (p in parts) {
			if (!system.isValidInt(p))
				return false
				
			var v = system.toInt(p)
			if (v < 0 || v > 255)
				return false
		}
		return true
	}
}

// should rewrite to use Regex matching instead // @@@@@@@@@ TODO
function validMACAddress(val) {
	var parts
	if (val.indexOf(":") > 0)
		parts = system.splitString(val,":")
	else
	if (val.indexOf("-") > 0)
		parts = system.splitString(val,"-")
	else
		return false
		
	if (parts.length != 6)
		return false
		
	for (var p in parts) {
		if (p.length != 2)
			return false
		if (fromHex(p) < 0)
			return false
	}
	
	return true
}

