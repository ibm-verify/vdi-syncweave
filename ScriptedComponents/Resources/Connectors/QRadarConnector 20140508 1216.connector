        <parameter name="formevents"><![CDATA[syslogParams = ["hostname","port","severity","facility"]
leefParams = ["filePath","splitOnEvents"]
params = new java.util.HashMap()
params.put(true, syslogParams)
params.put(false, leefParams)

useSyslog_changed()

function useSyslog_changed() {
	useSyslog = form.getControl("useSyslog").getSelection()
	
//	form.alert("param: " + form.getControl("useSyslog").getSelection() + "   useSyslog: " + useSyslog)
	var pset = params.get(useSyslog)
	var strOn = ""
	for (var p in pset) {
		strOn += (strOn == "") ? p : ", " + p
		form.getControl(p).setEnabled(true)
	}	
	pset = params.get(!useSyslog)
	var strOff = ""
	for (var p in pset) {
		strOff += (strOff == "") ? p : ", " + p
		form.getControl(p).setEnabled(false)
	}
//	form.alert("ON: " + strOn + "\nOFF: " + strOff)

	var sections = form.getChildren()[0].getChildren()[0].getChildren()[0].getChildren()[1].getChildren()
	sections[1].setVisible(useSyslog)
	sections[1].setEnabled(useSyslog)
	sections[1].setExpanded(useSyslog)
	sections[2].setVisible(!useSyslog)
	sections[2].setEnabled(!useSyslog)
	sections[2].setExpanded(!useSyslog)
}]]]]><![CDATA[></parameter>
