            <parameter name="dataset">Application Server Status |&lt;&lt;/providers/itm.TEMS/datasources/TMSAgent.%25IBM.STATIC186/datasets/MetricGroup.KYNAPSST&gt;&gt;|</parameter>
            <parameter name="datasource">WebSphere Agent |&lt;&lt;/providers/itm.TEMS/datasources/TMSAgent.%25IBM.STATIC186&gt;&gt;|</parameter>
