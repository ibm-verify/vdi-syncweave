            <parameter name="script"><![CDATA[// SoftLayer Users Script connector
// 
var version = "20140603 1956" // started

var http = system.getConnector("ibmdi.HTTPClient");
var host, port, user, apiKey, baseurl, pagesize, accountId, account, authToken, returnas;
var list, listCnt, totalCnt, startkey;
var cookies = system.newEntry();
var requestEntry = system.newEntry();
var deBug = true;
var initialized = false;
var tempPassword = "Abcdefg123#";

var message = new Array();
message["Required parameter not set"] = "Required parameter not set";
message["SoftLayer Connector vrs."] = "SoftLayer Connector vrs.";
message["Response from SoftLayer"] = "Response from SoftLayer";
message["Request to SoftLayer"] = "Request to SoftLayer";
message["Unnamed entry"] = "Unnamed entry";
message["Error from SoftLayer"] = "Error from SoftLayer";
message["User not found"] = "User not found";
message["The URL does not reference a valid SoftLayer service"] = "The URL does not reference a valid SoftLayer service, or the account is not active.";
message["Unrecognizable return from SoftLayer"] = "Unrecognizable return from SoftLayer";

// service functions

function verifySoftLayer() {
	var reply;
	reply = makeRequest({verb : "GET", 
						 url : baseurl + "SoftLayer_Account/getAccountStatus.json",
						 where : "verifySoftLayer"});
						 
	if (reply == null || reply.id == null || !"Active".equalsIgnoreCase(reply.name)) {
		throwException({msg: message["The URL does not reference a valid SoftLayer service"],
						where: "verifySoftLayer - getAccountStatus"});
	}

	reply = makeRequest({verb : "GET", 
						 url : baseurl + "SoftLayer_Account/getCurrentUser.json",
						 where : "verifySoftLayer"});

	if (reply == null || reply.accountId == null)	{
		throwException({msg: message["The URL does not reference a valid SoftLayer service"],
						where: "verifySoftLayer - getCurrentUser"})
	} else {	
		accountId = reply.accountId;
		account = reply.accound;
		authToken = reply.authenticationToken;
	}	
}


function checkForErrors(jsonReply, where) {
	if (typeof where === "undefined") { where = null; }
	 	
	if (jsonReply.error != null) {
		var msg = "reply.error: " + jsonReply.error;
		if (jsonReply.reason != null) {
			msg += " - reply.error: " + jsonReply.error;	
		}
		
		throwException({msg: message["Error from SoftLayer"] + ": " + msg,
						where: where});
	}
}

function makeRequest(params) {
	var verb = params.verb; 	// HTTP method
	var url = params.url;		// URL
	var body = params.body;		// payload to send (for a POST)
	var ctype = params.ctype;	// MIME Content-Type
	var accept = params.accept;	// MIME Accept
	var where = params.where;	// where makeRequest is called from

	if (verb == null) { verb = "GET"; } 
	if (url == null) { url = ""; } 
	if (ctype == null) { ctype = "application/json"; }
	if (accept == null) { accept = "application/json"; } 
	if (where == null) { where = ""; } 
	
	if (url.toLowerCase().indexOf(baseurl.toLowerCase()) < 0) {
		url = baseurl + url;
	}
	
	requestEntry.removeAllAttributes();
	
	if (typeof body !== "undefined" && body !== null && body.trim().length > 0) {
		requestEntry["http.body"] = body;
	}
	
	http.setParam("method", verb.toUpperCase());
	http.setParam("url", url);
	http.setParam("username", user);
	http.setParam("password", apiKey);

	requestEntry["http.Content-Type"] = ctype;
	
	if (cookies.size() > 0) {
		requestEntry.merge(cookies);
	}	

	http.terminate();
	
	http.initialize(null);
	
	if (deBug) {
		logDetails({"msg" : message["Request to SoftLayer"], 
					"obj" : requestEntry, 
					"url" : url, 
					"verb" : verb, 
					"ctype" : ctype,
					"accept" : accept, 
					"where" : where});
	}
	
	var retEntry = http.queryReply(requestEntry);
	
	if (deBug) {
		logDetails({"msg" : message["Response from SoftLayer"], 
				    "obj" : retEntry});
	}
	
	try {
		reply = parseReply(retEntry);
		checkForErrors(reply, where);
	} catch (ex) {
		if (!"true".equalsIgnoreCase(retEntry["http.bodyAsString"])) {
			throwException({msg: ex,
							where: "makeRequest"});
		}
	}
	
	
	return reply;
}

function throwException(params) {
	var msg = params.msg;
	var where = params.where;
	var whereStr = "";
	
	if (where != null) {
		whereStr = "(" + where + ") "
	}
	
	throw new java.lang.IllegalArgumentException(whereStr + msg);
}

function logmsg(lvl, msg) {
	if (typeof lvl === "undefined") { lvl = ""; } 
	if (typeof msg === "undefined") {
		msg = lvl;
		lvl = "INFO";
	}
	
	if (deBug) {
		java.lang.System.out.println(msg);
	}
		
	try {
		task.logmsg(lvl, msg);
	} catch (ex) {
		main.logmsg(lvl, msg);
	}	
}

function getParam(pname, required) {
	if (typeof required === "undefined") { required = true; }
	var pval = connector.getParam(pname);
	
	if (pval === null && required) {
		throwException({ msg: message["Required parameter not set"] + ": " + pname,
						 where: "getParam"});
	} 
	
	return pval;
}

function parseReply(replyEntry) {
	if (replyEntry === null) { return; } 
	
	var body = replyEntry.getString("http.bodyAsString");
	var reply = fromJson(body);
	
	var setCookie = replyEntry.getAttribute("http.Set-Cookie");
	if (setCookie !== null) {
		for (var i = 0; i < setCookie.size(); i++) {
			var thisCookie = setCookie.getValue(i);
			var p = thisCookie.indexOf("=");
			if (p > 0) {
				cookies["http." + thisCookie.substring(0,p)] = thisCookie.substring(p+1);
			}
		}	
	}
	
	return reply;
}

function item2Entry(item) {
	var entry = system.newEntry();

	if (typeof item === "undefined" || item == null) {
		return entry;
	}
	
	if (returnas.toLowerCase().startsWith("flat")) {
		for (var prop in item) {
			entry[prop] = item[prop];
		}
	} else {
		entry = entry.fromJSON(toJson(item));
	}	
	entry["$js_object"] = item;
	entry["$json"] = toJson(item);
	
	return entry;
}

function resetConnector() {
	initialized = false;
	view = null;
	list = null;
	listCnt = 0;
	startkey = "";
	cookies.removeAllAttributes();
}

function logDetails(params) {
	var msg = params.msg;
	var obj = params.obj; 
	var url = params.url;
	var verb = params.verb;
	var ctype = params.ctype; 
	var where = params.where;
	
	if (msg == null) {
		msg = message["Unnamed entry"];
	}

	var s = new java.lang.StringBuffer();
	
	if (where != null) {
		s.append("\n@@@------> (" + where + ") " + msg);
	} else {
		s.append("\n---------> " + msg);
	}
	
	if (verb != null) { s.append("   " + verb.toUpperCase()); } 
	if (ctype != null) { s.append("   " + ctype); } 
	if (url != null) { s.append("   " + url); } 
	s.append("\n");

	if (obj != null) {
		if (obj instanceof com.ibm.di.entry.Entry) {	
			var attNames = obj.getAttributeNames();
			for (var a in attNames) {
				if (a.indexOf("http.") >= 0 && 
					!("http.body".equalsIgnoreCase(a)
						|| "http.bodyAsBytes".equalsIgnoreCase(a)) ) {
					s.append(" " + a + ": " + obj[a] + "\n");
				}
			}	
		} else {
			s.append(obj.toString());
		}
	}	
	logmsg(s.toString());
}

function matchFound(search, entry) {
	var code, op1, op2, not, match, searchType, finalMatch;
	
	searchType = search.getType();
	finalMatch = null;
	
	for (var i = 0; i < search.size(); i++) {
		crit = search.getCriteria(i);
		code = crit.match;
		op1 = crit.name;
		op1value = entry.getString(op1);
		if (op1value !== null) { op1value = String(op1value).toLowerCase(); } 
		op2 = String(crit.value).toLowerCase();
		not = crit.negate;
		match = false;
		
		switch (code) {
			case com.ibm.di.server.SearchCriteria.EXACT: 
				match = op1value == op2;
				break;
			case com.ibm.di.server.SearchCriteria.GREATER_THAN: 
				match = op1value > op2;
				break;
			case com.ibm.di.server.SearchCriteria.GREATER_THAN_OR_EQUAL: 
				match = op1value >= op2;
				break;
			case com.ibm.di.server.SearchCriteria.LESS_THAN: 
				match = op1value < op2;
				break;
			case com.ibm.di.server.SearchCriteria.LESS_THAN_OR_EQUAL: 
				match = op1value <= op2;
				break;
			case com.ibm.di.server.SearchCriteria.NOT_STRING: 
				match = op1value != op2;
				break;
			case com.ibm.di.server.SearchCriteria.FINAL_STRING:
				match = op1value.endsWith(op2);
				break;
			case com.ibm.di.server.SearchCriteria.INITIAL_STRING: 
				match = op1value.startsWith(op2);
				break;
			case com.ibm.di.server.SearchCriteria.SUBSTRING: 
				match = op1value.indexOf(op2) >= 0;
				break;
			default: throwException({msg: message["Unrecognized operator for Link Criteria"] + ": " + code,
									 where: "findEntry - matchFound"});
		}
		
		if (not) {
			match = !match;
		}
		
		if (finalMatch === null) {
			finalMatch = match;
		} else 
		if (searchType == search.SEARCH_AND) {
			finalMatch = finalMatch && match;
		} else
		if (searchType == search.SEARCH_OR) {
			finalMatch = finalMatch || match;
		} else {
			throwException({msg: message["Unrecognized Link Criteria type: "] + searchType,
							where: "findEntry - matchFound"})
		}
		
		if (!finalMatch && searchType == search.SEARCH_AND) {
			return false;
		}
	}	

	return finalMatch;
}

function entry2SLObject(entry) {
	var json = entry.getString("$json");
	var item = entry.getObject("$object");
	var itemEntry = system.newEntry();
	
	if (item === null && json !== null && json.trim() != "") {
		item = fromJson(json);
	} 
	
	if (item == null) {
		var itemEntry = system.newEntry();
		itemEntry.merge(entry);
		var attNames = itemEntry.getAttributeNames();
		for (var name in attNames) {
			if (name.startsWith("$")) {
				itemEntry.removeAttribute(name);
			}
		}
		item = fromJson(itemEntry.toJSON());
	}

	return item;
}

// --------------------------------------------------------------------
// connector interface functions
// --------------------------------------------------------------------

function initialize() {
	logmsg(message["SoftLayer Connector vrs."] + " " + version);

	if (initialized) {
		terminate();
	}
	
	// reset variables
	resetConnector();

	// get all parameter settings
	host = getParam("host");
	port = getParam("port");
	user = getParam("user", false);
	apiKey = getParam("apikey", false);
	returnas = getParam("returnas", false);
	pagesize = getParam("pagesize", false);
	deBug = "true".equals(getParam("deBug", false));
	
	if (returnas == null) { returnas = "flat"; } 
	
	if (!system.isValidInt(pagesize)) {
		// not a valid number
		pagesize = 100;
	} else {
		pagesize = pagesize*1.0;
	}
	
	// prepare base URL
	var usePort = "";
	if (port != null && !"80".equals(port)) {
		usePort = ":" + port;
	}
//	baseurl = "https://" + user + ":" + apiKey + "@" + host + usePort + "/rest/v3/";
	baseurl = "https://" + host + usePort + "/rest/v3/";

	// verify that this is a SoftLayer service
	verifySoftLayer();
	
	initialized = true;
}	

function selectEntries() {
	list = null;
	listCnt = 0;
	totalCnt = 0;
	startkey = "";
	
	list = makeRequest({verb : "GET", 
						url : baseurl + "SoftLayer_Account/getUsers.json", 
						where : "selectEntries"});
						 
}

function getNextEntry() {
	if (typeof entry === "undefined" || entry === null) { entry = system.newEntry(); } 
	if (list !== null && listCnt < list.length) {
		var item = list[listCnt];
		listCnt++;
		totalCnt++;
		var hEntry = item2Entry(item);
		entry.merge(hEntry);
		result.setStatus(1);
		return entry;
	} else {
		result.setStatus(0);
		return null;
	}
}

function putEntry() {
	var item = entry2SLObject(entry);
	var reply = makeRequest({verb : "POST",
							 url : baseurl + "SoftLayer_User_Customer.json",
							 body : '{"parameters":[' + toJson(item) + ',"' + tempPassword + '"]}',
							 where : "putEntry"});
							 
	entry["$response"] = reply;
	entry["$id"] = reply.id;
}

function findEntry() {
	var foundEntry, matchEntry, key, itr;
	var matches = new java.util.concurrent.ConcurrentHashMap();
	
	current = system.newEntry();
	
	// get all users
	selectEntries();

	do {
		foundEntry = getNextEntry();
		
		if (foundEntry !== null) {
			if (matchFound(search, foundEntry)) {
				matchEntry = system.newEntry();
				matchEntry.merge(foundEntry);
				matches.put(foundEntry.id, matchEntry);
			}
		}	
	} while (foundEntry !== null);
	
	if (matches.size() == 0) {
		result.setStatus(0);
		return null;
	} else
	if (matches.size() == 1) {
		result.setStatus(1);
		key = matches.keySet().toArray()[0];
		entry.merge(matches.get(key));
		current.merge(entry);
		return entry;
	} else {
		result.setStatus(1);
		itr = matches.keySet().iterator();
		while (itr.hasNext()) {
			key = itr.next();
			connector.addFindEntry(matches.get(key)); 
		}
		return matches;
	}
}

function modEntry() {
	var item = entry2SLObject(entry);
	var reply = makeRequest({verb : "PUT",
							 url : baseurl + "SoftLayer_User_Customer/" + current.id + "/setObject.json",
							 body : '{"parameters":[' + toJson(item) + ']}',
							 where : "modEntry"});
}

function deleteEntry() {
	var item = entry2SLObject(entry);
	var reply = makeRequest({verb : "DELETE",
							 url : baseurl + "SoftLayer_User_Customer/" + current.id + ".json",
							 where : "deleteEntry"});
}

function terminate() {
	resetConnector();
	
	try {
		http.terminate();
	} catch (ex) {
		// do nothing
	}
}

