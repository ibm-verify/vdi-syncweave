                    <Script name="Display">
                        <ModTime>1401884647163</ModTime>
                        <parameter name="script"><![CDATA[task.logmsg("\n------------ found username: " + work.username);
return;
if (work.isDOMEnabled()) {
	task.logmsg("\n" + work.toString());	
} else {
	atts = work.getAttributeNames();
	java.util.Arrays.sort(atts);
	
	s = ""
	for (a in atts) {
		s += "\n      " + a + ": " + work[a];
	}
	
	task.logmsg(s);
}]]></parameter>
