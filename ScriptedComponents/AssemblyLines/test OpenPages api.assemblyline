<?xml version="1.0" encoding="UTF-8"?><MetamergeConfig Cycle="142" UUID="339ab8c4-de7b-466c-8d58-d2758c5305ca" created="Wed Sep 10 17:26:54 CEST 2014" createdBy="Administrator" main="test OpenPages api" modified="Fri Sep 12 13:06:59 CEST 2014" modifiedBy="Administrator" project="ScriptedComponents" version="7.1.1">
