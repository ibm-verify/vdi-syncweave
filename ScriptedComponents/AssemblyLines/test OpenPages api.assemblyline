        <SimulationConfig>
            <SimulationStates>
                <Component name="connector" state="Enabled"/>
                <Component name="functions" state="Enabled"/>
                <Component name="test" state="Enabled"/>
                <Component name="HTTPClientConnector" state="Simulated"/>
            </SimulationStates>
