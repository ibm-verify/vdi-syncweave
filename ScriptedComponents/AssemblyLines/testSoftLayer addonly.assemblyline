        <ContainerDF name="DataFlowContainer">
            <ModTime>1401883684428</ModTime>
            <Script name="Display">
                <ModTime>1401874907183</ModTime>
                <parameter name="script"><![CDATA[if (work.isDOMEnabled()) {
	task.logmsg("\n" + work.toString());	
} else {
	atts = work.getAttributeNames();
	java.util.Arrays.sort(atts);
	
	s = ""
	for (a in atts) {
		s += "\n      " + a + ": " + work[a];
	}
	
	task.logmsg(s);
}]]></parameter>
