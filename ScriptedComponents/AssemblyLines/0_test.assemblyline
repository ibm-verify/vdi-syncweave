            <Script name="debug script">
                <ModTime>1404041859276</ModTime>
                <parameter name="script"><![CDATA[function loadFile(filename, errormsg, throwException) {
	var strbuf = new java.lang.StringBuffer()
	if (typeof(throwException) == "undefined")
		throwException = true;

	if (typeof(errormsg) == "undefined" || errormsg == null)
		errormsg = "** ERROR LOADING FILE:"
		
	try {
		var file = system.openFileForInput(filename)
		var line = ""
	
		do {
			line = file.readLine()
			if (line != null)
				strbuf.append(line + "\n")
		} while (line != null)

		file.close()
	} catch (ex) {
		if (typeof(file) != "undefined" && file != null)
			file.close()
		if (throwException)
			throw errormsg.trim() + " " + filename + " - " + ex
		return null
	}		

	return strbuf.toString()
}]]></parameter>
            </Script>
            <Script name="test">
                <ModTime>1404116066395</ModTime>
                <parameter name="script"><![CDATA[function logmsg(lvl, msg) {
	task.logmsg(lvl, msg);
	java.lang.System.out.println(lvl + " - " + msg);
}

// mapping service object. 
provider = function() {
	this.customScript = loadFile("temp/customscript.js", "error loading customscript");
	this.mapLines = new java.util.HashMap();
	
	this.loadMap = function() {
		this.mapLines.clear();
		var mapStr = loadFile("temp/attribute.map", "error loading map file");
		if (mapStr !== null) {
			var mlines = system.splitString(mapStr, "\n");
			for (var line in mlines ) {
				if (!line.trim().startsWith("#")) {
					var p = line.indexOf("=");
					if (p > 0) {
						var attname = line.substring(0, p).trim();
						var assignment = line.substring(p+1).trim();
						this.mapLines.put(attname, assignment);
					}
				}	
			}
		}	
	}
	
	this.map = function(fromEntry) {
		var toEntry = system.newEntry();

		if (this.mapLines.size() == 0) {
			toEntry.merge(fromEntry);
			return toEntry;
		}
		
		var itr = this.mapLines.keySet().iterator();
		
		try {
			if (this.customScript !== null) {
				eval(this.customScript);
			}
		} catch (ex) {
			throw "Error parsing custom script - " + ex;
		}	
		
		while (itr.hasNext()) {
			try {
				var attname = itr.next();
				var assignment = this.mapLines.get(attname);
				var value = eval(assignment);
				toEntry.setAttribute(attname, value);
			} catch (ex) {
				logmsg("ERROR", "Error mapping " + attname 
						+ " with assignment: " + assignment 
						+ "\n------> exception: " + ex);
			}
		}
		
		return toEntry;	
	}
	
	this.initialize = function() {
		this.loadMap();
	}
	
	// initialization
	this.initialize();
	
	return this;
}

prov = new provider("givenname=work.first\ncn=work.first + ' ' + work.last");
e = prov.map(work);
task.dumpEntry(e);]]></parameter>
            </Script>
