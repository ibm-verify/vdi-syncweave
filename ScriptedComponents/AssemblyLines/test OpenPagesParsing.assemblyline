        <ContainerDF name="DataFlowContainer">
            <ModTime>1410436181569</ModTime>
            <Script name="debug">
                <ModTime>1410433397897</ModTime>
                <parameter name="script"><![CDATA[function logmsg(lvl, msg) {
	if (typeof msg === "undefined") {
		msg = lvl;
		lvl = "INFO";
	}
	
	task.logmsg(lvl, msg);
	java.lang.System.out.println(msg);
}

deBug = true;

function dumpEntry(entry) {
	if (entry === null) { return; }
	 
	var attNames = entry.getAttributeNames();
	var s = "";
	java.util.Arrays.sort(attNames);
	for (var name in attNames) {
		s += "\n" + entry[name].toString()
	}
	
	task.logmsg(s);
}]]></parameter>
            </Script>
            <Script name="functions">
                <ModTime>1410436181569</ModTime>
                <parameter name="script"><![CDATA[function GRCtoEntry(json) {
	var entry = system.newEntry();
	
	try {
		var jobj = fromJson(json);
		var type = null;
		
		var links = jobj.links;
		for (var i = 0; i < links.length; i++) {
			if ("describedby".equals(links[i].rel)) {
				type = links[i].href.substring(9);
				var p = type.indexOf("?");
				type = type.substring(0, p);
			}
		}
		
		if (type !== null) {
			entry["GRC Type"] = type;
		}
		
		var fields = jobj.fields.field;
		for (var i = 0; i < fields.length; i++) {
			addGrcField(entry, fields[i]);
		}		
	} catch(ex) {
		if (deBug) logmsg("--!!--> OPtoEntry - Error parsing json: " + ex + "\nJSON: " + json);
	}
	
	if (entry.size() === 0) {
		return null;
	} else {
		return entry;
	}	
}

function addGrcField(entry, field) {
	if (typeof field === "undefined" || field == null) { return; }
	
	var fieldName = field.name;
	var fieldValue = field.value;
	
	if (typeof fieldName !== "undefined" && fieldName !== null && fieldName.trim().length > 0) {

		fieldName = fieldName.trim();

		try {
			switch(field.dataType) {
				case "STRING_TYPE":
				case "ID_TYPE": 
									addAttributeValue(entry, fieldName, fieldValue);
									break;
				case "INTEGER_TYPE":
									if (typeof fieldValue !== "undefined") {
										var intValue = 0;
										try {
											intValue = system.toInt(fieldValue);
										} catch(ex) {
											intValue = "Error parsing integer value: " + fieldValue;
										}
										addAttributeValue(entry, fieldName, intValue);
									} else {
										entry[fieldName] = null;
									}	
									break;
				case "ENUM_TYPE": 	
									if (typeof field.enumValue !== "undefined") {
										addAttributeValue(entry, fieldName, field.enumValue.name);
									}	
									break;
				case "MULTI_VALUE_ENUM":
									if (typeof field.multiEnumValue !== "undefined") {
										var enums = field.multiEnumValue.enumValue;
										if (typeof enums !== "undefined" && enums.length > 0) {
											for (var i = 0; i < enums.length; i++) {
												addAttributeValue(entry, fieldName, enums[i].name, false);
											}
										}
									}	
									break;
				case "DATE_TYPE":
									var dateValue = system.parseDate(fieldValue, "yyyy-MM-dd'T'HH:mm:ss.SSSZ");
									addAttributeValue(entry, fieldName, dateValue);
									break;
				case "CURRENCY_TYPE":
									addAmount(entry, fieldName, "", field.baseAmount, field.baseCurrency);
									addAmount(entry, fieldName, " Local Amount", field.localAmount, field.localCurrency);
									break;
			} 
		} catch (ex) {
			if (deBug) logmsg("ERROR", "--!!--> Error parsing GRC field: " + toJson(field) + " - " + ex);
		}
	}	
}

function addAttributeValue(entry, attName, attValue, replace) {
	if (typeof attName === "undefined" || attName == null) { return; }
	
	if (typeof replace === "undefined" || !"false".equalsIgnoreCase(replace)) { replace = true; } 
		
	if (typeof attValue === "undefined" || attValue == null) {
		entry[attName] = null;
	} else 
	if (replace) {
		entry.setAttribute(attName, attValue);
	} else {	
		entry.addAttributeValue(attName, attValue);
	}	
}

function addAmount(entry, attName, attSuffix, attValue, currency) {
	if (typeof attName === "undefined" || attName == null) { return; }
	
	var doubleVal;
	try {
		doubleVal = java.lang.Double.parseDouble(attValue); // TODO use BigDecimal?
	} catch (ex) {
		doubleVal = "Error parsing amount: " + attValue + " - " + ex;
	}
	
	addAttributeValue(entry, attName + attSuffix, doubleVal);
	
	if (typeof currency !== "undefined" && typeof currency.isoCode !== "undefined") {
		addAttributeValue(entry, attName + attSuffix + " Currency", currency.isoCode);
	} 	
}]]></parameter>
            </Script>
            <Script name="parse">
                <ModTime>1410434978623</ModTime>
                <parameter name="script"><![CDATA[str = work.getString("string");

//task.logmsg("\n---------------\n" + str + "\n---------------\n");

entry = GRCtoEntry(str);

dumpEntry(entry);]]></parameter>
            </Script>
        </ContainerDF>
