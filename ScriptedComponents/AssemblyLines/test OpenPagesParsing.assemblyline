                <Parser>
                    <InheritFrom>system:/Parsers/ibmdi.ScriptParser</InheritFrom>
                    <ModTime>1410376432202</ModTime>
                    <parameter name="script"><![CDATA[//
// This is a simple parser that returns one line at a time from
// the input stream.
//

var counter = 0;

function writeEntry ()
{
	out.write (entry.getString("line"));
	out.newLine();
}

function readEntry ()
{
	var str;
	var strBuf = new java.lang.StringBuffer();

	do {
		str = inp.readLine();
		if (str !== null) {
			strBuf.append(str + "\n");
		}
	} while (str !== null);

	if (strBuf.length() == 0) {
		result.setStatus (0);
		result.setMessage ("End of input");
		return;
	}

	entry.setAttribute ("string", strBuf.toString());
	result.setStatus (1);
}

function querySchema ()
{
	var e = new com.ibm.di.entry.Entry();
	e.addAttributeValue("name","string");
	e.addAttributeValue("syntax","String");
	list.add(e);
	result.setStatus (1);
}
]]></parameter>
                </Parser>
