            <Script name="init">
                <ModTime>1403692031990</ModTime>
                <parameter name="script"><![CDATA[// ---- debug stuff
function control(value) {
	this.value = value;
	this.getText = function() {
		return this.value;
	}
	
	this.removeAll = function() {}
	
	this.add = function(val) {}
	
	this.select = function(ndx) {}
	
	return this;
}

form = {
	getControl : function(cname) {
		switch (cname) {
			case "url" : return new control("http://eddiehartman.cloudant.com");
			case "user" : return new control("eddiehartman");
			case "password" : return new control("secret123");
			case "database" : return new control("database");
			case "startkey" : return new control("a");
			case "endkey" : return new control("a");
			case "view" : return new control("_design/es/_view/es");
			case "dbtype" : return new control("Cloudant");
		}
	},
	
	alert : function(msg) {
		task.logmsg(msg);
	},

	getClass : function() {}
	
}]]></parameter>
            </Script>
            <Script name="Init Script">
                <ModTime>1403692232869</ModTime>
                <parameter name="script"><![CDATA[var message = new Array();
message["Required parameter not set"] = "Required parameter not set";
message["CouchDB Connector vrs."] = "CouchDB Connector vrs.";
message["Response from"] = "Response from";
message["Request to"] = "Request to";
message["Unnamed entry"] = "Unnamed entry";
message["Error from"] = "Error from";
message["Database or document not found"] = "Database or document not found";
message["The URL does not reference a valid service"] = "The URL does not reference a valid service";
message["Only the 'key' attribute can be use for Link Criteria when temporary views are disabled."] = "Only the 'key' attribute can be use for Link Criteria when temporary views are disabled.";
message["Unrecognized operator for Link Criteria"] = "Unrecognized operator for Link Criteria";
message["Link Criteria as Javascript"] = "Link Criteria as Javascript";
message["Mandatory property of document to modify is missing"] = "Mandatory property of document to modify is missing";
message["Document with this _id already exists"] = "Document with this _id already exists";
message["Invalid format for URL parameter"] = "Invalid format for URL parameter";
message["Unable to parse JSON return from"] = "Unable to parse JSON return from";

if (typeof(system) == "undefined") {
	var c = java.lang.Class.forName("com.ibm.di.function.UserFunctions");
	system = new c;
}	

var http = system.getConnector("ibmdi.HTTPClient");
var requestEntry = system.newEntry();
var cookies = system.newEntry();
var deBug = true;
var authenticated = false;
http.initialize(null);]]></parameter>
            </Script>
            <Script name="Event Script">
                <ModTime>1403691807608</ModTime>
                <parameter name="script"><![CDATA[// 20140615 0027

function getCertificate () {
	form.setWaitCursor();
	try {
		var msg = com.ibm.di.security.GetSSLCertificate.installCertificateFrom(url, 443);
	} finally {
		form.setNormalCursor();
	}
	form.alert(msg);
}


function getViews() {
	var database = getParam("database");
	var views = new Array();

	var reply = makeRequest({verb: "GET",
							 url: database + '/_all_docs?startkey="_design/"&endkey="_design0"'});

	if (!reply || !reply.rows || reply.rows.length == 0) {
		return views;
	}
	
	var ddocs = reply.rows;

	for (var i = 0; i < ddocs.length; i++) {
		reply =  makeRequest({verb: "GET",
							 url: database + "/" + ddocs[i].id});
	
		if (reply && reply.views) {
			for (var v in reply.views) {
				views[views.length] = ddocs[i].id + "/_view/" + v;

//				if (deBug) form.alert("View #" + views.length + ": " + ddocs[i].id + "/_view/" + v);

			}
		}
	}	
	
	views.sort();
	
	return views;
}

function makeRequest(params) {
	var verb = params.verb;
	var url = params.url;
	var body = params.body;
	var ctype = params.ctype;
	var where = params.where;
	var rev = params.rev;
	var authenticating = params.authenticating;
	var dbtype = getParam("dbtype");
	var baseurl = fixUrl({url: getParam("url"), dbtype: dbtype});
	var user = getParam("user");
	var password = getParam("password");

	if (verb == null) { verb = "GET"; } 
	if (url == null) { url = ""; } 
	if (ctype == null) { ctype = "application/json"; }
	if (where == null) { where = ""; } 
	if (rev != null) { rev = "?rev=" + rev } else { rev = "" };
/*
	if (url.indexOf("_all_docs") > 0) {
		url = "http://localhost/" + url
	} else
*/
	if (url.toLowerCase().indexOf(baseurl.toLowerCase()) < 0) {
		url = baseurl + url;
	}
	
	requestEntry.removeAllAttributes();
	
	if (typeof body !== "undefined" && body !== null && body.trim().length > 0) {
		method = "POST";
		requestEntry["http.body"] = body;
	}
	
	http.setParam("method", verb.toUpperCase());
	http.setParam("url", url + rev);

	requestEntry["http.Content-Type"] = ctype;
	requestEntry["http.Accept"] = "application/json";
	requestEntry["http.Connection"] = "keep-alive";
	requestEntry["http.remote_user"] = user;
	requestEntry["http.remote_pass"] = password;

//	requestEntry["http.Accept-Encoding"] = "gzip, deflate";
//	requestEntry["http.Accept-Language"] = "en-US,en;q=0.5";
//	requestEntry["http.User-Agent"] = "IBM Security Verify Directory Integrator";
//	requestEntry["http.Authorization"] = "BASIC " + system.base64Encode(String(user + ":" + password).getBytes());
	
	if (cookies.size() > 0) {
		requestEntry["X-CouchDB-WWW-Authenticate"] = "Cookie";
		requestEntry.merge(cookies);
	}	

	if (deBug) {
		logDetails({"msg" : message["Request to"] + " " + dbtype, 
					"obj" : requestEntry, 
					"url" : url, 
					"verb" : verb, 
					"ctype" : ctype, 
					"where" : where});
	}

	var retry = 0;
	var maxRetry = 2;
	var retEntry = null;
	
	do {
		try {	
			retEntry = http.queryReply(requestEntry);
		} catch (ex) {
			if (ex instanceof javax.net.ssl.SSLHandshakeException) {
				if (retry == 0) {
					getCertificate();
				} else {	
					throwException("You must restart the SDI server in order for the imported certificate to be trusted.")
				}
			} else {
				throw ex;
			}	
		}
		
		retry++;
	} while (retEntry === null && retry < maxRetry);
	
	if (deBug) {
		logDetails({"msg" : message["Response from"] + " " + dbtype, 
				    "entry" : retEntry});
	}
	
	var reply = parseReply(retEntry);
	
	checkForErrors(reply);
	
	return reply;
}

function throwException(msg) {
	throw new java.lang.IllegalArgumentException(msg);
}

function logmsg(lvl, msg) {
	if (typeof lvl === "undefined") { lvl = ""; } 
	if (typeof msg === "undefined") {
		msg = lvl;
		lvl = "INFO";
	}
	
	if (deBug) {
		java.lang.System.out.println(msg);
	}
		
	try {
		connector.logmsg(lvl, msg);
	} catch (ex) {
		main.logmsg(lvl, msg);
	}	
}

function getParam(pname, required) {
	if (typeof required === "undefined") { required = true; }
	var ctrl = form.getControl(pname);
	if (ctrl == null && required) {
		throwException(message["Required parameter not set"] + ": " + pname);
	}
	
	pval = ctrl.getText();
	
	if (pval === null && required) {
		throwException(message["Required parameter not set"] + ": " + pname);
	} 
	
	return pval;
}

function parseReply(replyEntry) {
	if (replyEntry === null) { return; } 
	
	var body = replyEntry.getString("http.bodyAsString");
	var reply = fromJson(body);
	
	var setCookie = replyEntry.getAttribute("http.Set-Cookie");
	if (setCookie !== null) {
		for (var i = 0; i < setCookie.size(); i++) {
			var thisCookie = setCookie.getValue(i);
			var p = thisCookie.indexOf("=");
			if (p > 0) {
				cookies["http." + thisCookie.substring(0,p)] = thisCookie.substring(p+1);
			}
		}	
	}
	
	return reply;
}

function fixUrl(params) {
	var url = params.url;
	var dbtype = params.dbtype;
	var protocolSpes = "http:";
	var auth = "";
	
	if (url.startsWith("http")) {
		var p = url.indexOf("/");
		if (p > 0) {
			protocolSpes = url.substring(0, p);
			var p2 = url.indexOf("/", p+1);
			if (p2 == (p+1)) {
				url = url.substring(p2+1);
			} else {
				throwException(message["Invalid format for URL parameter"] + ": " + url);
			}
		}
	}

	if (!url.endsWith("/")) {
		return protocolSpes + "//" + auth + url + "/";
	} else {
		return protocolSpes + "//" + auth + url;
	}
}

function queryDatabases() {
	var uri = "_all_dbs";
	var controlName = "database";
	
	var jobj = makeRequest({verb : "GET",
						url : uri, 
						where : "updateDatabases"}); 

	form.getClass();
	var combo = form.getControl(controlName);
	combo.removeAll();

	if (!jobj) {
		return;
	}	
			
	var arr = new java.util.ArrayList();
	for (var i = 0; i < jobj.length; i++) {
		arr.add(jobj[i]);
	}
	
	arr = arr.toArray();
	java.util.Arrays.sort(arr);

	for (var a in arr) {
		combo.add(a);
	}	
	
	combo.select(0);
}

function queryViews() {
	var uri = "_all_dbs";
	var controlName = "view";
	
	var views = getViews();

	form.getClass();
	var combo = form.getControl(controlName);
	combo.removeAll();

	if (!views) {
		return;
	}	

	if (deBug) form.alert(views);
			
	var arr = new java.util.ArrayList();
	for (var i = 0; i < views.length; i++) {
		arr.add(views[i]);
	}
	
	arr = arr.toArray();
	java.util.Arrays.sort(arr);

	for (var a in arr) {
		combo.add(a);
	}	
	
	combo.select(0);
}

function logDetails(params) {
	var msg = params.msg;
	var obj = params.obj; 
	var url = params.url;
	var verb = params.verb;
	var ctype = params.ctype; 
	var where = params.where;
	
	if (msg == null) {
		msg = message["Unnamed entry"];
	}

	var s = new java.lang.StringBuffer();
	
	if (where != null) {
		s.append("\n@@@------> (" + where + ") " + msg);
	} else {
		s.append("\n---------> " + msg);
	}
	
	
	if (verb != null) { s.append("   " + verb.toUpperCase()); } 
	if (ctype != null) { s.append("   " + ctype); } 
	if (url != null) { s.append("   " + url); } 
	s.append("\n");

	if (obj != null) {
		if (obj instanceof com.ibm.di.entry.Entry) {	
			var attNames = obj.getAttributeNames();
			for (var a in attNames) {
				if (a.indexOf("http.") >= 0 && 
					!("http.bodyAsString".equalsIgnoreCase(a)
						|| "http.bodyAsBytes".equalsIgnoreCase(a)) ) {
					s += " " + a + ": " + obj[a] + "\n";
				}
			}	
		} else {
			s.append(obj.toString());
		}
	}	
	form.alert(s.toString());
}

function checkForErrors(jsonReply) {
	if (jsonReply.error != null) {
		var msg = "reply.error: " + jsonReply.error;
		if (jsonReply.reason != null) {
			msg += " - reply.reason: " + jsonReply.reason;	
		}
		
		if ("not_found".equals(jsonReply.error)) {
			msg = message["Database or document not found"]	+ " - " + msg;
		}
		throwException(message["Error from CouchDB"] + ": " + msg);
	}
}

function authenticate() {
	var user = getParam("user");
	var password = getParam("password");
	var reply = makeRequest({verb : "POST", 
							 url : "_session", 
							 body : "name=" + user + "&password=" + password, 
							 ctype : "application/x-www-form-urlencoded", 
							 where : "authenticate",
							 authenticating : true});
	authenticated = true;
}]]></parameter>
