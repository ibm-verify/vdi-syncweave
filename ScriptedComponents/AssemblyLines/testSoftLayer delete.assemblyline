                <Branch name="user">
                    <ModTime>1401911607089</ModTime>
                    <Script name="Display">
                        <ModTime>1401909812696</ModTime>
                        <parameter name="script"><![CDATA[if (work.isDOMEnabled()) {
	task.logmsg("\n" + work.toString());	
} else {
	atts = work.getAttributeNames();
	java.util.Arrays.sort(atts);
	
	s = ""
	for (a in atts) {
		s += "\n      " + a + ": " + work[a];
	}
	
	task.logmsg(s);
}

atts = work.getAttributeNames();
for (att in atts) {
	if (att.startsWith("$")) {
		work.removeAttribute(att);
	}
}]]></parameter>
