			<parameter name="formevents"><![CDATA[
function assemblyLine_changed() {
	cfg = com.ibm.tdi.eclipse.custom.ALFC.getInitSchema(config, form);
	if ( cfg != null ) {
		ui = form.getControl("operationInit");
		ui.updateSchema(cfg);
	}
}

function queryServer() {
	var str = com.ibm.tdi.eclipse.custom.ALFC.selectAL(config, form);
	if ( str != null ) {
		var name = button.getName();
		form.setConfig(name, str);
		form.updateControl(name);
	}
}

function queryConfig() {
	var str = com.ibm.tdi.eclipse.custom.ALFC.selectConfig(config, form);
	if ( str != null ) {
		var name = button.getName();
		form.setConfig(name, str);
		form.updateControl(name);
	}
}

function queryOperation() {
	str = com.ibm.tdi.eclipse.custom.ALFC.selectOperation(config, form);
	if ( str != null ) {
		var name = button.getName();
		form.setConfig(name, str);
		form.updateControl(name);
	}
}

function server_changed() {
	var val = form.getConfig ( "server" );
	var enable = ( val == null || val.equals("") || val.equalsIgnoreCase ("local") );
	form.getControl ("shareLog").setEnabled (enable);
}

assemblyLine_changed();
server_changed();
]]></parameter>
			<parameter name="title">CONN_TITLE</parameter>
