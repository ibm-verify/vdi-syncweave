			<parameter name="formevents"><![CDATA[
var configObj = form.getConfigObject();

if (!configObj.hasParameter("mergeMode")){
	if(configObj.getMetamergeConfig().getConfigVersion().compareTo("7.0") < 0) {
		form.setConfig("mergeMode", "Merge changelog and changed data");
		form.updateControl("mergeMode");
	}
}

function nsSleepInterval_focusout() {
	checkMinMax("nsSleepInterval",  "nsTimeout", true);
}
function nsTimeout_focusout() {
	checkMinMax("nsSleepInterval",  "nsTimeout", false);
}
function checkMinMax(p1, p2, mm) {
	min = 0;
	max = 0;
	try {
		min = java.lang.Integer.parseInt(form.getConfig(p1));
	} catch(ign) {}
	try {
		max = java.lang.Integer.parseInt(form.getConfig(p2));
	} catch(ign) {}
	
	if(min > max && max > 0) {
		if(mm) {
			form.setConfig(p2, form.getConfig(p1));
			form.updateControl(p2);
		} else {
			form.setConfig(p1, form.getConfig(p2));
			form.updateControl(p1);
		}
	}
}
]]></parameter>
