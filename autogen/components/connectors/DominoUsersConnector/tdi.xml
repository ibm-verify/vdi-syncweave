			<parameter name="formevents"><![CDATA[
function setDominoSessionTypeControlValue() {
	var dominoSessionType = form.getConfigValue("dominoSessionType"); 
	if (dominoSessionType.equalsIgnoreCase("LocalClient")) { 
		form.getControl("userName").setEnabled(false); 
		form.getControl("useSSL").setEnabled(false); 
		form.getControl("httpPort").setEnabled(false); 
		form.getControl("ior").setEnabled(false); 
	} else if (dominoSessionType.equalsIgnoreCase("LocalServer")) { 
		form.getControl("userName").setEnabled(true); 
		form.getControl("useSSL").setEnabled(false); 
		form.getControl("httpPort").setEnabled(false); 
		form.getControl("ior").setEnabled(false); 
	} else if (dominoSessionType.equalsIgnoreCase("IIOP")) { 
		form.getControl("userName").setEnabled(true); 
		form.getControl("useSSL").setEnabled(true); 
		form.getControl("httpPort").setEnabled(true); 
		form.getControl("ior").setEnabled(true); 
	}
}

setDominoSessionTypeControlValue();

function dominoSessionType_changed() {
	setDominoSessionTypeControlValue();
}

function setUseFTSearchControlValue() {
	var useFTSearch = form.getConfigValue("useFTSearch").equalsIgnoreCase("true"); 

	if (form.getControl("fullTextFilter") != null)
		form.getControl("fullTextFilter").setEnabled(useFTSearch); 
	if (form.getControl("formulaFilter") != null) 
		form.getControl("formulaFilter").setEnabled(!useFTSearch); 
}

setUseFTSearchControlValue();

function useFTSearch_changed() {
	setUseFTSearchControlValue();
}
]]></parameter>
