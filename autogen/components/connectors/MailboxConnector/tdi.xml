				<parameter name="modes">AddOnly</parameter>
			</FormItem>
			<FormItem name="excludeFolders">
				<parameter name="description">MAIL_EXCLUDE_FOLDER_DESC</parameter>
				<parameter name="label">MAIL_EXCLUDE_FOLDER_LABEL</parameter>
				<parameter name="syntax">String</parameter>
				<parameter name="modes">-AddOnly</parameter>
			</FormItem>
			<FormItem name="getSubfolders">
				<parameter name="description">MAIL_GET_SUBFOLDER_DESC</parameter>
				<parameter name="label">MAIL_GET_SUBFOLDER_LABEL</parameter>
