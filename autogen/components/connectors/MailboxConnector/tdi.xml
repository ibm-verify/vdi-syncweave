			<FormItem name="mailPassword">
				<parameter name="description">MAIL_PASSWORD_DESC</parameter>
				<parameter name="label">MAIL_PASSWORD_LABEL</parameter>
				<parameter name="syntax">password</parameter>
				<parameter name="Required">true</parameter>
			</FormItem>
			<FormItem name="mailProtocol">
				<Values>
					<ListItem>pop3</ListItem>
					<ListItem>imap</ListItem>
				</Values>
				<LocalizedValues>
					<Item>
						<Key>imap</Key>
						<Value>Localized.imap</Value>
					</Item>
					<Item>
						<Key>pop3</Key>
						<Value>Localized.pop3</Value>
					</Item>
				</LocalizedValues>
				<parameter name="description">MAIL_PROTOCOL_DESC</parameter>
				<parameter name="label">MAIL_PROTOCOL_LABEL</parameter>
				<parameter name="syntax">droplist</parameter>
				<parameter name="Required">true</parameter>
			</FormItem>
			<FormItem name="mailServer">
				<parameter name="description">MAIL_SERVER_DESC</parameter>
				<parameter name="label">MAIL_SERVER_LABEL</parameter>
				<parameter name="syntax">String</parameter>
				<parameter name="Required">true</parameter>
			</FormItem>
			<FormItem name="mailUser">
				<parameter name="description">MAIL_USER_DESC</parameter>
				<parameter name="label">MAIL_USER_LABEL</parameter>
				<parameter name="syntax">String</parameter>
				<parameter name="Required">true</parameter>
			</FormItem>
			<FormItem name="pollInterval">
				<parameter name="description">MAIL_POLLINTERVAL_DESC</parameter>
				<parameter name="label">MAIL_POLLINTERVAL_LABEL</parameter>
				<parameter name="syntax">String</parameter>
				<parameter name="modes">Iterator</parameter>
			</FormItem>
			<FormItem name="useSSL">
				<parameter name="description">MAIL_USESSL_DESC</parameter>
				<parameter name="label">MAIL_USESSL_LABEL</parameter>
				<parameter name="syntax">BOOLEAN</parameter>
			</FormItem>
			<parameter name="formevents"><![CDATA[
				function mailProtocol_changed () {
					var val = form.getConfig("mailProtocol");
					var enabled = "imap".equalsIgnoreCase(val);
					var control = form.getControl("getSubfolders");
					if (control != null) {
						control.setEnabled(enabled);
					}
				}
				mailProtocol_changed ();
			]]></parameter>
			<parameter name="title">CONN_TITLE</parameter>
		</Form>
