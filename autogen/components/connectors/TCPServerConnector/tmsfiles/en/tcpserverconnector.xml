<Message ID="CTGDJI101E" prefix="yes">
   <MsgText pgmKey="CONNECTOR.TCPSRV.MISSING.TCPPORT.EXCEP" varFormat="Java">
   The &apos;tcp.port&apos; parameter must be set to use
   the TCP Server Connector.
   </MsgText>
   <Explanation> <p>
   The required parameter tcp.port was not specified in the
   TCP Server Connector.
   </p> </Explanation>
   <OperatorResponse> <p>
   Specify the tcp.port parameter in the Connector.
   </p> </OperatorResponse>
</Message>

