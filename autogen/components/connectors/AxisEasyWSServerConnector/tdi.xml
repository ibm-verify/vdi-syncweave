			<parameter name="formscript"><![CDATA[
function genWsdl () {
	var wsdlToGenFileName = form.getConfigValue("wsdlToGenFileName");
	var webServiceLocation = form.getConfigValue("webServiceLocation");
	form.setWaitCursor();
	var generatedSuccessfully = false;
	try {
		Packages.com.ibm.di.fc.webservice.axis2.WSDLGenerator.generateWsdl(config, wsdlToGenFileName, webServiceLocation);
		generatedSuccessfully = true;
	} finally {
		form.setNormalCursor();
	}
	if (generatedSuccessfully) {
		form.alert(form.translate("ALERT_WFGS"));
	}
}

function selectWSOperation() {
	var wsdlFile = form.getConfigValue("wsdlFile");
	if (wsdlFile == null || wsdlFile.equals("")) {
		form.alert(form.translate("ALERT_WFMNBE"));
		return;
	}
	form.setWaitCursor();
	var operations = null;
	try {
		operations = Packages.com.ibm.di.fc.webservice.axis2.WSDLData.getSoapOperations(wsdlFile);
	} finally {
		form.setNormalCursor();
	}
	var sel = null;
	if (operations.size() == 0) {
		form.alert(form.translate("ALERT_CNFASODIW") + " '" + wsdlFile + "'");
	} else {
		sel = form.chooseFromList (form.translate("BT_SWSO"), operations);
	}
	if (sel != null) {
		form.setConfig (button.getName(), sel);
		form.updateControl (button.getName());
	}
}
]]></parameter>
