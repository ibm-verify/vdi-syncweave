			<parameter name="formscript"><![CDATA[
// tests if a connection to a remote system can be established by a Connector
function checkConnection() {
	var conn = form.loadConnector();
	
	conn.initialize (null);
	var exceptionText = null;

	exceptionText = conn.checkDbConnection();
	var jdbcParams = "";
	jdbcParams += conn.getJdbcUrl() + ", ";
	jdbcParams += conn.getJdbcDriver() + ", ";
	jdbcParams += conn.getDbUsername() ;
	conn.terminate();
	
	if (exceptionText == null) {
		form.alert(Messages.getMessage("ASForms.Connection.Success", jdbcParams));
	} else {
		// log the values of the jdbc parameters used in the connecion attempt
		form.alert(Messages.getMessage("ASForms.Connection.Failure", jdbcParams, exceptionText));
	}	
}           
]]></parameter>						
