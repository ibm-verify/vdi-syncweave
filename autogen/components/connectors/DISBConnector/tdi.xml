			<parameter name="formevents"><![CDATA[
		function setJMSDriverParams() {
		var jmsDriver = form.getConfigValue("jms.driver"); 
		if (jmsDriver!=null) { 
			if (jmsDriver.equalsIgnoreCase("IBMMQe")) { 
				form.getControl("jms.serverChannel").setEnabled(false); 
				form.getControl("jms.qManager").setEnabled(false); 
				form.getControl("jms.clientID").setEnabled(false); 
				form.getControl("jms.username").setEnabled(false); 
				form.getControl("jms.password").setEnabled(false); 
				form.getControl("jms.sslUseFlag").setEnabled(false); 
				form.getControl("jms.sslCipher").setEnabled(false); 
				form.getControl("jms.sslServerChannel").setEnabled(false);
			} else { 
				form.getControl("jms.serverChannel").setEnabled(true); 
				form.getControl("jms.qManager").setEnabled(true); 
				form.getControl("jms.clientID").setEnabled(true); 
				form.getControl("jms.username").setEnabled(true); 
				form.getControl("jms.password").setEnabled(true); 
				form.getControl("jms.sslUseFlag").setEnabled(true); 
				form.getControl("jms.sslServerChannel").setEnabled(true); 
				form.getControl("jms.sslCipher").setEnabled(true); 
			}
			form.updateControl("jms.serverChannel"); 
		}
}

setJMSDriverParams();

function jms_driver_changed() {
		setJMSDriverParams();
}

function idmlMsgFlag_changed(){
		var idmlMsg = form.getConfigValue("idmlMsgFlag");
		if (idmlMsg != null){
					if(idmlMsg.equalsIgnoreCase("true")){
						form.getControl("validateIdmlFlag").setEnabled(true);
						form.getControl("jsonMsgFlag").setEnabled(false);
					}
					else{
						form.getControl("validateIdmlFlag").setEnabled(false);
						form.getControl("jsonMsgFlag").setEnabled(true);
					}
		}
}

function jsonMsgFlag_changed(){
		var jsonMsg = form.getConfigValue("jsonMsgFlag");
		if (jsonMsg != null){
			if(jsonMsg.equalsIgnoreCase("false")){
			form.getControl("idmlMsgFlag").setEnabled(true);
			}
			else{
			form.getControl("idmlMsgFlag").setEnabled(false);
			}
		}	
}

function topicType_changed(){
		var topicType = form.getConfigValue("topicType");
		if (topicType!=null){
			if(topicType.equalsIgnoreCase("Instance Topic")){
				form.getControl("jms.topic").setText("DisInstanceTopic");
			}
			else if(topicType.equalsIgnoreCase("Model Topic")){
				form.getControl("jms.topic").setText("DisModelTopic");
			}
			else if(topicType.equalsIgnoreCase("GUIDLifeCycle Topic")){
				form.getControl("jms.topic").setText("DisGuidLifeCycleTopic");
			}
			form.updateControl("jms.topic");
		}
}

function update_controls() {
			var co = form.getConfigObject();
			if ( co == null ) {
						return;
			} 				
			var cmode = co.getParent().getMode();
			if ( cmode.equalsIgnoreCase("AddOnly")){ 
				form.getControl("jms.connectionType").setText("Queue");
				form.getControl("jms.connectionType").setEnabled(false);
				form.getControl("jms.messageType").setEnabled(false);
				form.getControl("jms.topic").setText("DisSubscriptionQueue");
				form.getControl("idmlMsgFlag").setEnabled(false);
				form.getControl("validateIdmlFlag").setEnabled(false);
 			}
			else if (cmode.equalsIgnoreCase("Iterator"))					
			{
				form.getControl("jms.connectionType").setText("Topic");
				form.getControl("jms.connectionType").setEnabled(false);
				form.getControl("topicType").setText("Instance Topic");
				form.getControl("jms.topic").setText("DisInstanceTopic");
				form.getControl("jms.propertiesAsAttributes").setEnabled(false);
				form.getControl("jms.specificPropertiesAsAttributes").setEnabled(false);
			}
			form.updateControl ("jms.connectionType");
			form.updateControl("jms.topic");
}
update_controls();			
idmlMsgFlag_changed();
jsonMsgFlag_changed();
topicType_changed();

]]></parameter>
