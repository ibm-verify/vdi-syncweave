function selectTAMDomain () {
	conn = form.loadConnector();
	conn.initialize(null);
	var sel = form.chooseFromList (form.translate("SELECT_DOMAIN"), conn.queryTAMDomains());
	if (sel != null) {
		form.setConfig (button.getName(), sel);
		form.updateControl (button.getName());
	}
	conn.terminate();
}]]></parameter>
