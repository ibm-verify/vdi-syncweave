			<parameter name="formevents"><![CDATA[
var mode = form.getConfigObject().getParent().getMode(); 
if (mode!=null) { 
	if (mode.equalsIgnoreCase("Iterator")) { 
		form.getControl("notesSelection").setEnabled(true); 
	} else { 
		form.getControl("notesSelection").setEnabled(false); 
		form.getControl("supportRichText").setEnabled(false); 
	} 
}

function setSessionControlValue() {
	var session = form.getConfigValue("dominoSessionType"); 
	if (session!=null) { 
		if (session.equalsIgnoreCase("LocalServer")) { 
			form.getControl("dominoHost").setEnabled(false); 
			form.getControl("httpPort").setEnabled(false); 
			form.getControl("dominoLogin").setEnabled(true); 
			form.getControl("iiopSSL").setEnabled(false); 
		} else if (session.equalsIgnoreCase("IIOP")) {
			form.getControl("dominoHost").setEnabled(true); 
			form.getControl("httpPort").setEnabled(true); 
			form.getControl("dominoLogin").setEnabled(true); 
			form.getControl("dominoPassword").setEnabled(true); 
			form.getControl("iiopSSL").setEnabled(true);
		} 
	}
}

setSessionControlValue();

function dominoSessionType_changed() {
	setSessionControlValue();
}
]]></parameter>
