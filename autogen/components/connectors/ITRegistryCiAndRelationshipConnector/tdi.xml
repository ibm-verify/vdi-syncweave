	<Folder name="Forms">
		<Form name="com.ibm.di.connector.ITRegistryConnector">
			<TranslationFile>NLS/idi_conn_itregistry</TranslationFile>
			<Validators>
				<ListItem type="map" name="output">com.ibm.di.cdm.jar.CDMComponentAttributesValidator</ListItem>
			</Validators>
			<parameter name="title">ITREGISTRY_CONNECTOR_TITLE</parameter>
			<parameter name="description">CONN_DESC</parameter>
			<parameter name="formevents"><![CDATA[
				function artifactType_changed() {
					var val = form.getConfig("artifactType");
					if ( val != null ) {
						form.getControl("classType").setText("");
					}
				}
				function useDate_changed(){
					var val = form.getConfig("useDate");
					if(val!=null){
						var enableDate=false;
						var enableAttr=false;
						if(val.equalsIgnoreCase("true")){
							enableDate=true;
							enableAttr=false;
						}else{
							enableDate=false;
							enableAttr=true;
						}
						var dateFilter = form.getControl("dateFilter");
						if (dateFilter != null) {
							dateFilter.setEnabled(enableDate);
						}
						var attributeFilter = form.getControl("attributeFilter");
						if (attributeFilter != null) {
							attributeFilter.setEnabled(enableAttr);
						}
					}
				}
				useDate_changed();
			]]></parameter>
			<FormSectionNames>
				<ListItem>General</ListItem>
				<ListItem>Advanced</ListItem>
			</FormSectionNames>
