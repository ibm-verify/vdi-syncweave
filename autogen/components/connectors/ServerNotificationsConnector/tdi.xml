			<parameter name="formevents"><![CDATA[
function enabled (param, value){
	form.getControl(param).setEnabled(value);
}

function connectionType_changed(){
	var val = form.getConfig ("connectionType");
	var local_mode = false;
	if ( val != null && val.equalsIgnoreCase ("local") )
		local_mode = true;
	enabled("url", !local_mode);
	enabled("username", !local_mode);
	enabled("password", !local_mode);
}

function checkBoxes(){
	var val = form.getConfig ("di_ci_all");
	var enable_ci_all = false;
	if ( val != null && val.equalsIgnoreCase ("true") )
		enable_ci_all = true;
	val = form.getConfig ("di_al_all");
	var enable_al_all = false;
	if ( val != null && val.equalsIgnoreCase ("true") )
		enable_al_all = true;
	val = form.getConfig ("di_all");
	var enable_all = false;
	if ( val != null && val.equalsIgnoreCase ("true") ) {
		enable_all = true;
		enable_ci_all = true;
		enable_al_all = true;
	}
	enabled("di_ci_all", !enable_all);
	enabled("di_al_all", !enable_all);
	enabled("di_server_stop", !enable_all);
	enabled("di_ci_start", !enable_ci_all);
	enabled("di_ci_stop", !enable_ci_all);
	enabled("di_ci_file_updated", !enable_ci_all);
	enabled("di_al_start", !enable_al_all);
	enabled("di_al_stop", !enable_al_all);
}

function hasCustomNotifications_changed(){
	var val = form.getConfig ("hasCustomNotifications");
	var enable_custom = false;
	if ( val != null && val.equalsIgnoreCase ("true") )
		enable_custom = true;
	enabled("customNotifications", enable_custom);
}

function di_all_changed(){
	checkBoxes();
}

function di_ci_all_changed(){
	checkBoxes();
}

function di_al_all_changed(){
	checkBoxes();
}

connectionType_changed();
checkBoxes();
hasCustomNotifications_changed();
]]></parameter>
