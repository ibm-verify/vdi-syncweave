			</FormItem>
			<parameter name="title">CONN_TITLE</parameter>
			<parameter name="formevents"><![CDATA[

updateExplicitMode();
function updateExplicitMode() {
	var security = form.getConfigValue("ftpSecurity");
	var enabled = !"None".equals(security);
	form.getControl("ftpExplicitModeSSL").setEnabled(enabled);
	if(enabled) {
		// If ssl enabled let explicit mode determine port
		ftpExplicitModeSSL_changed();
	} else if("990".equals(form.getConfigValue("ftpPort"))) {
		form.setConfig("ftpPort", "21");
		form.updateControl("ftpPort");
	}
}
function ftpSecurity_changed() {
	updateExplicitMode();
}

function ftpExplicitModeSSL_changed() {
	if("true".equals(form.getConfigValue("ftpExplicitModeSSL"))) {
		if("990".equals(form.getConfigValue("ftpPort"))) {
			form.setConfig("ftpPort", "21");
		}
	} else {
		if("21".equals(form.getConfigValue("ftpPort"))) {
			form.setConfig("ftpPort", "990");
		}
	}
	form.updateControl("ftpPort");
}
]]></parameter>
