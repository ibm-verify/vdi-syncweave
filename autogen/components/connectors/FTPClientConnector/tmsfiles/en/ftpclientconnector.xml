<Message ID="CTGDIP001I" prefix="yes">
   <MsgText pgmKey="CONNECTOR.FTPCLIENT.TERMINATING" varFormat="Java">
   Connector terminating: &apos;&apos;<Variable formatSpec="{0}">Connector name</Variable>&apos;&apos;.
   </MsgText>
   <NoHelp/>
</Message>

<Message ID="CTGDIP002W" prefix="yes">
   <MsgText pgmKey="CONNECTOR.FTPCLIENT.SOCKETCLOSE.WARNING" varFormat="Java">
   Exception encountered while closing socket connection to ftp
   server: &apos;&apos;<Variable formatSpec="{0}">error</Variable>&apos;&apos;
   </MsgText>
   <Explanation> <p>
   An exception was encountered while trying to close the socket connection
   to ftp server. The exception was caught and the program will continue running.
   </p> </Explanation>
   <OperatorResponse> <p>
   No action is required.
   </p> </OperatorResponse>
</Message>

<Message ID="CTGDIP003I" prefix="yes">
   <MsgText pgmKey="CONNECTOR.FTPCLIENT.CONNECTIONOPEN.INFO" varFormat="Java">
   Opening connection to FTP Server: &apos;&apos;<Variable formatSpec="{0}">hostname</Variable>&apos;&apos;.
   </MsgText>
   <NoHelp/>
</Message>

<Message ID="CTGDIP004I" prefix="yes">
   <MsgText pgmKey="CONNECTOR.FTPCLIENT.CONNECTIONUSER.INFO" varFormat="Java">
   Logging onto FTP server with user ID &apos;&apos;<Variable formatSpec="{0}">user ID</Variable>&apos;&apos;.
   </MsgText>
   <NoHelp/>
</Message>

<Message ID="CTGDIP005I" prefix="yes">
   <MsgText pgmKey="CONNECTOR.FTPCLIENT.SELECTENTRIES.INFO" varFormat="Java">
   Using FTP operation &apos;&apos;<Variable formatSpec="{0}">operation</Variable>&apos;&apos;
   at server location &apos;&apos;<Variable formatSpec="{1}">location</Variable>&apos;&apos;.
   </MsgText>
   <NoHelp/>
</Message>

<Message ID="CTGDIP006E" prefix="yes">
   <MsgText pgmKey="CONNECTOR.FTPCLIENT.MISSINGSRV" varFormat="Java">
   The &apos;ftpHost&apos; parameter must be set to use
   the FTP Client Connector.
   </MsgText>
   <Explanation> <p>
   The required parameter ftpHost was not specified in the
   FTP Client Connector.
   </p> </Explanation>
   <OperatorResponse> <p>
   Specify the ftpHost parameter in the Connector.
   </p> </OperatorResponse>
</Message>

