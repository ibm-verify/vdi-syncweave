			<parameter name="title">CONN_TITLE</parameter>
			<parameter name="formevents"><![CDATA[
function sleepInterval_focusout() {
	checkMinMax("sleepInterval",  "timeout", true);
}
function timeout_focusout() {
	checkMinMax("sleepInterval",  "timeout", false);
}
function checkMinMax(p1, p2, mm) {
	min = 0;
	max = 0;
	try {
		min = java.lang.Integer.parseInt(form.getConfig(p1));
	} catch(ign) {}
	try {
		max = java.lang.Integer.parseInt(form.getConfig(p2));
	} catch(ign) {}
	
	if(min > max && max > 0) {
		if(mm) {
			form.setConfig(p2, form.getConfig(p1));
			form.updateControl(p2);
		} else {
			form.setConfig(p1, form.getConfig(p2));
			form.updateControl(p1);
		}
	}
}

function useNotifications_changed() {
	str = form.getConfig("useNotifications");
	if(str == null)
		str = "false";
	enabled = str.equals("false");
	try {
		form.getControl("timeout").setEnabled(enabled);
		form.getControl("sleepInterval").setEnabled(enabled);
	} catch (ign) {
		form.alert(ign);
	}
}

useNotifications_changed();

]]></parameter>
