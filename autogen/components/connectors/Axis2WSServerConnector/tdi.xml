			<parameter name="formscript">
			<![CDATA[
				function genWsdl () {
				
					var wsdlToGenFileName = form.getConfigValue("wsdlToGenFileName");
					var webServiceLocation = form.getConfigValue("webServiceLocation");
					var wsdlVersion = form.getConfigValue("wsdlVersion");
					
					Packages.com.ibm.di.connector.axis2.util.SchemaUtils.generateWsdl(config, wsdlToGenFileName, webServiceLocation, wsdlVersion);
					var wsdlGeneratedMsg = Packages.com.ibm.di.connector.axis2.Axis2WSServerConnector.getResHash().getString("CONNECTOR.AXIS2WSSERVER.SCRIPT.WSDL.GENERATED");
					form.alert(wsdlGeneratedMsg); 
				}
			]]>
			</parameter>
			
