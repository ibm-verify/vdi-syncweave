			<parameter name="formevents">
				<![CDATA[
function enabled (param, value){
	if(form.getControl(param) != null)
		form.getControl(param).setEnabled(value);
}

function clearSchemaCache () { 
	conn = form.loadConnector(); 
	conn.initialize(null); 
	
	try { 
		conn.clearSchemaCache(); 
		form.alert(conn.getResHash().getString("MXCONN.SCHEMA.CACHE.CLEARED")); 
	} catch (e) { 
		conn.terminate(); 
		throw e;
	} 
	conn.terminate(); 
}

function externalSystem_changed() {
	var es = form.getConfig ("externalSystem");
	var isEnabled = false;
	
	if ( es != null && es.trim().length() > 0 )
		isEnabled = true;
	
	enabled("maxobjEnterpriseService", isEnabled);
	enabled("enterpriseServiceSync", isEnabled);
	enabled("enterpriseServiceQuery", isEnabled);
}

externalSystem_changed();
]]>
