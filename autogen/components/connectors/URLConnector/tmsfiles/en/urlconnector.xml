<Message ID="CTGDIR201E" prefix="yes">
   <MsgText pgmKey="CONNECTOR.URL.MISSING.EXCEP" varFormat="Java">
   Either the &apos;url&apos; or &apos;puturl&apos; parameter must be set to use
   the URL Connector.
   </MsgText>
   <Explanation> <p>
   The required parameter url or puturl was not specified in the
   URL Connector.
   </p> </Explanation>
   <OperatorResponse> <p>
   Specify either the puturl or url parameter
   in the Connector.
   </p> </OperatorResponse>
</Message>

