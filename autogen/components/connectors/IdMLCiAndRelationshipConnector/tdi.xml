<?xml version="1.0" encoding="UTF-8"?>
<MetamergeConfig created="Wed Sep 16 12:00:00 SGT 2009" version="7.1.1">
	<Folder name="Connectors">
		<Connector name="ibmdi.IdMLConnector">
                        <SupportedModes>CallReply</SupportedModes>
			<Configuration>
				<parameter name="connectorType">com.ibm.di.connector.IdMLConnector</parameter>
				<parameter name="parserOption">Useless</parameter>
				<parameter name="artifactType">CI</parameter>
				<parameter name="classType"/>
				<parameter name="bookName"/>
				<parameter name="useITRegistryCdm">false</parameter>
				<parameter name="jdbcUrl"/>
				<parameter name="jdbcDriver"/>
				<parameter name="dbUsername"/>
				<parameter name="dbPassword"/>
			</Configuration>
			<Schema name="Input">
				<SchemaItem>
					<Name>$id</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
			</Schema>
			<Schema name="Output">
				<SchemaItem>
					<Name>$idmlBookName</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>$operation</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
			</Schema>
		</Connector>
	</Folder>
	<Folder name="Forms">
		<Form name="com.ibm.di.connector.IdMLConnector">
			<TranslationFile>NLS/idi_conn_idml</TranslationFile>
			<parameter name="title">IDML_CONNECTOR_TITLE</parameter>
			<parameter name="description">CONN_DESC</parameter>
			<parameter name="formevents"><![CDATA[
				function useITRegistryCdm_changed () {
					var val = form.getConfig("useITRegistryCdm");
					if ( val != null ) {
						var enable = false;
						if ( val.equalsIgnoreCase("true") ) {
							enable = true;
						} else {
							enable = false;
							form.getControl("jdbcUrl").setText("");
							form.getControl("jdbcDriver").setText("");
							form.getControl("dbUsername").setText("");
							form.getControl("dbPassword").setText("");
						}
						form.getControl("jdbcUrl").setEnabled(enable);
						form.getControl("jdbcDriver").setEnabled(enable);
						form.getControl("dbUsername").setEnabled(enable);
						form.getControl("dbPassword").setEnabled(enable);
					}
				}
				function artifactType_changed () {
					var val = form.getConfig("artifactType");
					if ( val != null ) {
						form.getControl("classType").setText("");
					}
				}
				
				useITRegistryCdm_changed ();
			]]></parameter>
			<FormSectionNames>
				<ListItem>General</ListItem>
				<ListItem>Advanced</ListItem>
			</FormSectionNames>
			<FormSection name="General">
				<FormSectionNames>
					<ListItem>artifactType</ListItem>
					<ListItem>classType</ListItem>
					<ListItem>$GLOBAL.userComment</ListItem>
					<ListItem>$GLOBAL.debug</ListItem>
				</FormSectionNames>
			</FormSection>
			<FormSection name="Advanced">
				<parameter name="title">Advanced</parameter>
				<parameter name="initiallyExpanded">false</parameter>
				<FormSectionNames>
					<ListItem>bookName</ListItem>
					<ListItem>useITRegistryCdm</ListItem>
					<ListItem>jdbcUrl</ListItem>
					<ListItem>jdbcDriver</ListItem>
					<ListItem>dbUsername</ListItem>
					<ListItem>dbPassword</ListItem>
				</FormSectionNames>
			</FormSection>
			<FormItemNames>
					<ListItem>artifactType</ListItem>
					<ListItem>classType</ListItem>
					<ListItem>bookName</ListItem>
					<ListItem>useITRegistryCdm</ListItem>
					<ListItem>jdbcUrl</ListItem>
					<ListItem>jdbcDriver</ListItem>
					<ListItem>dbUsername</ListItem>
					<ListItem>dbPassword</ListItem>
					<ListItem>$GLOBAL.userComment</ListItem>
					<ListItem>$GLOBAL.debug</ListItem>
			</FormItemNames>
			<FormItem name="artifactType">
				<Values>
					<ListItem>CI</ListItem>
					<ListItem>RELATIONSHIP</ListItem>
				</Values>
				<LocalizedValues>
					<Item>
						<Key>CI</Key>
						<Value>IDML_CONN_CI</Value>
					</Item>
					<Item>
						<Key>RELATIONSHIP</Key>
						<Value>IDML_CONN_RELATIONSHIP</Value>
					</Item>
				</LocalizedValues>
				<parameter name="description">IDML_CONN_ARTIFACTTYPE_DESC</parameter>
				<parameter name="label">IDML_CONN_ARTIFACTTYPE_LABEL</parameter>
				<parameter name="syntax">droplist</parameter>
			</FormItem>
			<FormItem name="classType">
				<parameter name="description">IDML_CONN_CLASSTYPE_DESC</parameter>
				<parameter name="label">IDML_CONN_CLASSTYPE_LABEL</parameter>
				<parameter name="script">getCdmTypes</parameter>
				<parameter name="scriptLabel">IDML_CONN_CLASSTYPE_SCRIPT_LABEL</parameter>
				<parameter name="scripthelp">IDML_CONN_CLASSTYPE_SCRIPT_HELP</parameter>
				<parameter name="syntax">string</parameter>
				<parameter name="Required">true</parameter>
			</FormItem>
			<FormItem name="bookName">
				<parameter name="description">IDML_CONN_BOOK_DESC</parameter>
				<parameter name="label">IDML_CONN_BOOK_LABEL</parameter>
				<parameter name="syntax">string</parameter>
			</FormItem>
			<FormItem name="useITRegistryCdm">
				<parameter name="description">IDML_CONN_USEITREGISTRYCDM_DESC</parameter>
				<parameter name="label">IDML_CONN_USEITREGISTRYCDM_LABEL</parameter>
				<parameter name="script">getCdmVersion</parameter>
				<parameter name="scriptLabel">IDML_CONN_CHECKCDM_SCRIPT_LABEL</parameter>
				<parameter name="scripthelp">IDML_CONN_CHECKCDM_SCRIPT_HELP</parameter>
				<parameter name="syntax">boolean</parameter>
			</FormItem>
			<FormItem name="jdbcUrl">
				<parameter name="description">IDML_CONN_JDBCURL_DESC</parameter>
				<parameter name="label">IDML_CONN_JDBCURL_LABEL</parameter>
				<parameter name="script">checkDbConnection</parameter>
				<parameter name="scriptLabel">IDML_CONN_QUERYDB_SCRIPT_LABEL</parameter>
				<parameter name="scripthelp">IDML_CONN_QUERYDB_SCRIPT_DESC</parameter>
				<parameter name="syntax">string</parameter>
			</FormItem>
			<FormItem name="jdbcDriver">
				<parameter name="description">IDML_CONN_JDBCDRIVER_DESC</parameter>
				<parameter name="label">IDML_CONN_JDBCDRIVER_LABEL</parameter>
				<parameter name="syntax">string</parameter>
			</FormItem>
			<FormItem name="dbUsername">
				<parameter name="description">IDML_CONN_DBUSERNAME_DESC</parameter>
				<parameter name="label">IDML_CONN_DBUSERNAME_LABEL</parameter>
				<parameter name="syntax">string</parameter>
			</FormItem>
			<FormItem name="dbPassword">
				<parameter name="description">IDML_CONN_DBPASSWORD_DESC</parameter>
				<parameter name="label">IDML_CONN_DBPASSWORD_LABEL</parameter>
				<parameter name="syntax">PASSWORD</parameter>
			</FormItem>
		</Form>
	</Folder>
</MetamergeConfig>
