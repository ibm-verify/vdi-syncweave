			<parameter name="title">CONN_TITLE</parameter>
			<parameter name="formevents"><![CDATA[
try {
	alias = form.getConfig("keyAlias")
	control = form.getControl("keyAlias")
	control.setItems(com.ibm.di.api.security.CryptoUtils.getKeyStoreAliases())
	if (alias != null)
		control.setText(alias)
} catch (e) {}

function keyAlias_changed() {
	var val = form.getConfig("keyAlias");
	var enable = val == null || val.equals("");
	form.getControl("secret").setEnabled(enable);
}

keyAlias_changed();
]]></parameter>
