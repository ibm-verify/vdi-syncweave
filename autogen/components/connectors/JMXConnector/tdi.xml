<?xml version="1.0" encoding="UTF-8"?>
<MetamergeConfig created="Wed Nov 21 16:20:10 SGT 2007" version="7.1.1">
	<Folder name="Connectors">
		<Connector name="ibmdi.JMXConnector">
                        <SupportedModes>Iterator</SupportedModes>
			<Configuration>
				<parameter name="connectorType">com.ibm.di.connector.JMXConnector</parameter>
				<parameter name="parserOption">Useless</parameter>
				<parameter name="allMBeans">true</parameter>
				<parameter name="mode">remote</parameter>
				<parameter name="url">service:jmx:rmi://localhost/jndi/jmx</parameter>
			</Configuration>
			<Schema name="Input">
				<SchemaItem>
					<Name>event.mbean.name</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>event.mbean.objectName</Name>
					<Syntax>javax.management.ObjectName</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>event.message</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>event.originator</Name>
					<Syntax>com.ibm.di.connector.JMXConnector</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>event.rawNotification</Name>
					<Syntax>javax.management.Notification</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>event.sequenceNumber</Name>
					<Syntax>Long</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>event.source</Name>
					<Syntax>javax.management.ObjectName</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>event.timestamp</Name>
					<Syntax>Long</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>event.type</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>event.userData</Name>
					<Syntax>Object</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
			</Schema>
		</Connector>
	</Folder>
	<Folder name="Forms">
		<Form name="com.ibm.di.connector.JMXConnector">
			<TranslationFile>NLS/idi_conn_jmx</TranslationFile>
			<FormSectionNames>
				<ListItem>General</ListItem>
				<ListItem>Advanced</ListItem>
			</FormSectionNames>
			<FormSection name="General">
				<FormSectionNames>
					<ListItem>mode</ListItem>
					<ListItem>url</ListItem>
					<ListItem>$GLOBAL.userComment</ListItem>
					<ListItem>$GLOBAL.debug</ListItem>
				</FormSectionNames>
			</FormSection>
			<FormSection name="Advanced">
				<parameter name="title">Advanced</parameter>
				<parameter name="initiallyExpanded">false</parameter>
				<FormSectionNames>
					<ListItem>allMBeans</ListItem>
					<ListItem>mBeanTypes</ListItem>
					<ListItem>eventTypes</ListItem>
				</FormSectionNames>
			</FormSection>
			<FormItemNames>
				<ListItem>mode</ListItem>
				<ListItem>url</ListItem>
				<ListItem>allMBeans</ListItem>
				<ListItem>mBeanTypes</ListItem>
				<ListItem>eventTypes</ListItem>
				<ListItem>$GLOBAL.debug</ListItem>
			</FormItemNames>
			<FormItem name="allMBeans">
				<parameter name="description">JMX_ALLMBEANS_DESC</parameter>
				<parameter name="label">JMX_ALLMBEANS_LABEL</parameter>
				<parameter name="syntax">BOOLEAN</parameter>
			</FormItem>
			<FormItem name="eventTypes">
				<parameter name="description">JMX_EVENTTYPES_DESC</parameter>
				<parameter name="label">JMX_EVENTTYPES_LABEL</parameter>
				<parameter name="syntax">textarea</parameter>
			</FormItem>
			<FormItem name="mBeanTypes">
				<parameter name="description">JMX_MBEANTYPES_DESC</parameter>
				<parameter name="label">JMX_MBEANTYPES_LABEL</parameter>
				<parameter name="syntax">textarea</parameter>
			</FormItem>
			<FormItem name="mode">
				<Values>
					<ListItem>remote</ListItem>
					<ListItem>local</ListItem>
				</Values>
				<LocalizedValues>
					<Item>
						<Key>local</Key>
						<Value>Localized.local</Value>
					</Item>
					<Item>
						<Key>remote</Key>
						<Value>Localized.remote</Value>
					</Item>
				</LocalizedValues>
				<parameter name="description">JMX_MODE_DESC</parameter>
				<parameter name="label">JMX_MODE_LABEL</parameter>
				<parameter name="syntax">droplist</parameter>
			</FormItem>
			<FormItem name="url">
				<parameter name="description">JMX_URL_DESC</parameter>
				<parameter name="label">JMX_URL_LABEL</parameter>
				<parameter name="syntax">String</parameter>
				<parameter name="Required">true</parameter>
			</FormItem>
			<parameter name="title">CONN_TITLE</parameter>
		</Form>
	</Folder>
</MetamergeConfig>
