			<parameter name="formscript"><![CDATA[
function genWsdl () {
	var wsdlToGenFileName = form.getConfigValue("wsdlToGenFileName");
	var webServiceLocation = form.getConfigValue("webServiceLocation");
	form.setWaitCursor();
	var generatedSuccessfully = false;
	try {
		Packages.com.ibm.di.fc.webservice.axis2.WSDLGenerator.generateWsdl(config, wsdlToGenFileName, webServiceLocation);
		generatedSuccessfully = true;
	} finally {
		form.setNormalCursor();
	}
	if (generatedSuccessfully) {
		form.alert(form.translate("ALERT_WFGS"));
	}
}]]></parameter>
