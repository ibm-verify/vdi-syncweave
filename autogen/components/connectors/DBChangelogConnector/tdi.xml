			<parameter name="formevents"><![CDATA[
	function getNumberOfRecords(){
	var driver = form.getConfigValue("jdbcDriver");
	var table =  form.getConfigValue("jdbcTable");
	var pass =  form.getConfigValue("jdbcPassword");
	var login =  form.getConfigValue("jdbcLogin");
	var source =  form.getConfigValue("jdbcSource");
	var schema =  form.getConfigValue("jdbcSchema");
	if(schema!=null&&schema.trim().length()!=0) table = schema + "." + table;
	java.lang.Class.forName(driver.trim());
	var con = java.sql.DriverManager.getConnection(source, login ,pass);
	form.alert("1 .. " + com.ibm.di.connector.DBChangelogConnector.getNumberOfRecords(table,con));

}
]]></parameter>
