			<parameter name="formevents"><![CDATA[
function setStartAtControlValue() {
	var startAt = form.getConfigValue("startAt"); 
	if (startAt.equalsIgnoreCase("Specific date")) { 
		form.getControl("startDate").setEnabled(true); 
	} else {
		form.getControl("startDate").setEnabled(false); 
	}
}

function setSessionControlValue() {
	var session = form.getConfigValue("sessionType"); 
	if (session!=null) { 
		if (session.equalsIgnoreCase("LocalClient")) { 
			form.getControl("httpPort").setEnabled(false); 
			form.getControl("ior").setEnabled(false); 
			form.getControl("userName").setEnabled(false); 
			form.getControl("iiopSSL").setEnabled(false); 
		} else if (session.equalsIgnoreCase("IIOP")) { 
			form.getControl("httpPort").setEnabled(true); 
			form.getControl("ior").setEnabled(true); 
			form.getControl("userName").setEnabled(true); 
			form.getControl("iiopSSL").setEnabled(true); 
		}
	}
}

setSessionControlValue();

function sessionType_changed() {
		setSessionControlValue();
}

setStartAtControlValue();

function startAt_changed() {
	setStartAtControlValue();
}
]]></parameter>
