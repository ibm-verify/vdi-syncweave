<?xml version="1.0" encoding="UTF-8"?>
<MetamergeConfig created="Wed Nov 21 16:20:10 SGT 2007" version="7.1.1">
	<Folder name="Connectors">
		<Connector name="ibmdi.HTTPServer">
                        <SupportedModes>Server,Iterator</SupportedModes>
			<Configuration>
				<parameter name="connectorType">com.ibm.di.connector.HTTPServerConnector</parameter>
				<parameter name="parserOption">Optional</parameter>
				<parameter name="authConnector">(none)</parameter>
				<parameter name="authRealm">IBM Security Verify Directory Integrator</parameter>
				<parameter name="contentType">text/html</parameter>
				<parameter name="headersAsProperties">false</parameter>
				<parameter name="httpAuth">false</parameter>
				<parameter name="msgChunked">false</parameter>
				<parameter name="needClientAuth">false</parameter>
				<parameter name="serverReply">true</parameter>
				<parameter name="tcpDataAsProperties">false</parameter>
				<parameter name="tcpPort">80</parameter>
				<parameter name="useSSL">false</parameter>
			</Configuration>
			<Schema name="Input">
				<SchemaItem>
					<Name>http.*</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>http.Authorization</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>http.body</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>http.base</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>http.content-length</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>http.content-type</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>http.method</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>http.qs.*</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>http.remote_pass</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>http.remote_user</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>http.url</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>tcp.inputstream</Name>
					<Syntax>InputStream</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>tcp.localHost</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>tcp.localIP</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>tcp.localPort</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>tcp.outputstream</Name>
					<Syntax>OutputStream</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>tcp.remoteHost</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>tcp.remoteIP</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>tcp.remotePort</Name>
					<Syntax>String</Syntax>
				</SchemaItem>
				<SchemaItem>
					<Name>tcp.socket</Name>
					<Syntax>Socket</Syntax>
				</SchemaItem>
			</Schema>
			<Schema name="Output">
				<SchemaItem>
					<Name>http.body</Name>
					<Syntax>String|File|InputStream</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>http.content-type</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>http.redirect</Name>
					<Syntax>String</Syntax>
					<Presence>Optional</Presence>
				</SchemaItem>
				<SchemaItem>
					<Name>http.status</Name>
					<Syntax>String</Syntax>
					<Presence>Always</Presence>
				</SchemaItem>
			</Schema>
		</Connector>
	</Folder>
	<Folder name="Forms">
		<Form name="com.ibm.di.connector.HTTPServerConnector">
