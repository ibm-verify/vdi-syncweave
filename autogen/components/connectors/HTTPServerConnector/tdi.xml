			<FormItemNames>
				<ListItem>tcpPort</ListItem>
				<ListItem>backlog</ListItem>
				<ListItem>contentType</ListItem>
				<ListItem>tcpDataAsProperties</ListItem>
				<ListItem>headersAsProperties</ListItem>
				<ListItem>httpAuth</ListItem>
				<ListItem>authRealm</ListItem>
				<ListItem>authConnector</ListItem>
				<ListItem>useSSL</ListItem>
				<ListItem>needClientAuth</ListItem>
				<ListItem>msgChunked</ListItem>
				<ListItem>$GLOBAL.debug</ListItem>
			</FormItemNames>
			<FormItem name="authConnector">
				<Values>
					<ListItem>(none)</ListItem>
					<ListItem>@CONNECTORS@</ListItem>
				</Values>
				<LocalizedValues>
					<Item>
						<Key>(none)</Key>
						<Value>Localized.none</Value>
					</Item>
				</LocalizedValues>
				<parameter name="description">AUTH_CONN_DESCR</parameter>
				<parameter name="label">AUTH_CONN_LABEL</parameter>
				<parameter name="syntax">dropedit</parameter>
				<parameter name="readonly">true</parameter>
			</FormItem>
			<FormItem name="authRealm">
				<parameter name="description">AUTH_REALM_DESC</parameter>
				<parameter name="label">AUTH_REALM_LBL</parameter>
			</FormItem>
			<FormItem name="backlog">
