			<parameter name="formevents"><![CDATA[
function selectDBDriver_changed(){
	var selDriver = form.getConfig("selectDBDriver");
	if(selDriver == null || selDriver.trim().length() <= 0) {
		selDriver = com.ibm.di.store.StoreFactory.getJdbcDriver();
	}
	var crtStmt = com.ibm.di.store.StoreFactory.getSysStoreCreateStmtByDriver(selDriver);
	if(crtStmt != null){
		form.getControl("createTable").setText(crtStmt);
	}
}
selectDBDriver_changed();
			]]>
