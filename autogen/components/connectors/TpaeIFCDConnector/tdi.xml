function enabled (param, value){
	if(form.getControl(param) != null)
		form.getControl(param).setEnabled(value);
}

function useSSL_changed() {
	var ssl= form.getConfig ("useSSL");
	if ( ssl!= null && ssl.equals("true"))
		enabled("needClientAuth", true);
	else	
		enabled("needClientAuth", false);
}

useSSL_changed();
