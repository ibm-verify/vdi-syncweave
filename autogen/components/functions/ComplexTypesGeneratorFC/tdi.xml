				<parameter name="scriptLabel">WU_SLBL</parameter>
				<parameter name="scripthelp">WU_SHLP</parameter>
				<parameter name="syntax">string</parameter>
				<parameter name="Required">true</parameter>
			</FormItem>
			<parameter name="formscript"><![CDATA[
function genComplexTypes () {
	var fc = form.loadFunction();
	var wsdlUrl = form.getConfigValue("wsdlUrl");
	var wsdlToJavaOptions = form.getConfigValue("wsdlToJavaOptions");
	if (wsdlUrl == null || wsdlUrl.equals("")) {
		util.messageError(form.translate("WUMNBE"));
		return;
	}
	var jdkPath = form.getConfigValue("jdkPath");
	var jarFile = form.getConfigValue("jarFile");
	if (jarFile == null || jarFile.equals("")) {
		util.messageError(form.translate("JFMNBE"));
		return;
	}
	var autoGenJavaSrcFiles = form.getConfigValue("autoGenJavaSrcFiles");
	form.setWaitCursor();
	try {
		fc.generateComplexTypes(wsdlUrl, wsdlToJavaOptions, jdkPath, jarFile, java.lang.Boolean.valueOf(autoGenJavaSrcFiles).booleanValue());
		form.setNormalCursor();
		form.alert(form.translate("JFSG"));
	} catch(e) {
		form.setNormalCursor();
		util.messageError(e.toString());
	}
}]]></parameter>
			<parameter name="title">FC_TITLE</parameter>
		</Form>
