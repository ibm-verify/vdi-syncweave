			<parameter name="formscript"><![CDATA[
function selectWSOperation() {
	var wsdlUrl = form.getConfigValue("wsdlUrl");
	if (wsdlUrl == null || wsdlUrl.equals("")) {
		form.alert(form.translate("WFMNBE_MSG"));
		return;
	}
	form.setWaitCursor();
	var operations = null;
	try {
		operations = Packages.com.ibm.di.fc.webservice.axis2.WSDLData.getSoapOperations(wsdlUrl);
	} finally {
		form.setNormalCursor();
	}
	var sel = null;
	if (operations.size() == 0) {
		form.alert(form.translate("CNFASODIW_MSG") + " '" + wsdlUrl + "'");
	} else {
		sel = form.chooseFromList ("SWSO_LBL", operations);
	}
	if (sel != null) {
		form.setConfig (button.getName(), sel);
		form.updateControl (button.getName());
	}
}]]></parameter>
