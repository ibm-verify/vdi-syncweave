			<parameter name="formevents"><![CDATA[
importPackage(com.ibm.tdi.eclipse);

function deleteDelta ()
{
   var path = form.getConfigValue ("deltaDB");
   if (path == null || path.length() == 0)
	  return;
		
	  if ( form.prompt (com.ibm.di.fc.DeltaFC.getResHash().getString("DELTAFC.DELETE.DELTA.TABLE.PROMPT", path)) )
	  {
	var table = path;
	if (! table.startsWith("IDI_DS_"))
	   table = "IDI_DS_" + path;
		 var str = com.ibm.di.store.StoreFactory.dropTable ( table );
		 com.ibm.di.store.DeltaSysTable["delete"](path); // ugly way to call delete method
		 if ( str != null )
			form.alert ( str );
		 else
			form.alert (com.ibm.di.fc.DeltaFC.getResHash().getString("DELTAFC.TABLE.DELETED", path));
		com.ibm.di.store.StoreFactory.shutdown();
	  }
}

function changeDetectionMode_changed(){
	var value = form.getConfigValue ("changeDetectionMode");
	var enable = !value.equalsIgnoreCase(com.ibm.di.fc.DeltaFC.PARAM_DETECT_ALL);
	form.getControl ("attributeList").setEnabled (enable);
}

changeDetectionMode_changed();]]>
