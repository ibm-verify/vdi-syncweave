<?xml version="1.0" encoding="UTF-8"?>
<MetamergeConfig created="Wed Nov 21 16:20:10 SGT 2007" version="7.1.1">
	<Folder name="Parsers">
		<Parser name="ibmdi.CSV">
			<parameter name="class">com.ibm.di.parser.CSVParser</parameter>
			<parameter name="characterSet"/>
			<parameter name="csvColumnSeparator">;</parameter>
			<parameter name="csvColumns"/>
			<parameter name="csvEnableQuoting">true</parameter>
			<parameter name="csvQuoteAllFields">false</parameter>
			<parameter name="csvLogLongLines">0</parameter>
			<parameter name="csvWriteHeader">true</parameter>
			<parameter name="csvWriteBOM">false</parameter>
