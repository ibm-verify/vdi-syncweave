			<TranslationFile>NLS/idi_par_csv</TranslationFile>
			<FormSectionNames>
				<ListItem>General</ListItem>
				<ListItem>Advanced</ListItem>
			</FormSectionNames>
			<FormSection name="General">
				<FormSectionNames>
					<ListItem>csvColumnSeparator</ListItem>
					<ListItem>csvSortFields</ListItem>
