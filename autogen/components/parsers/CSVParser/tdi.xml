				<FormSectionNames>
					<ListItem>csvColumns</ListItem>
					<ListItem>csvEnableQuoting</ListItem>
					<ListItem>csvQuoteAllFields</ListItem>
					<ListItem>csvWriteHeader</ListItem>
					<ListItem>csvWriteBOM</ListItem>
					<ListItem>csvLogLongLines</ListItem>
					<ListItem>csvCombineLastFields</ListItem>
					<ListItem>characterSet</ListItem>
			</FormSectionNames>
			</FormSection>
			<FormItemNames>
				<ListItem>csvColumnSeparator</ListItem>
				<ListItem>csvColumns</ListItem>
				<ListItem>csvSortFields</ListItem>
				<ListItem>csvEnableQuoting</ListItem>
				<ListItem>csvQuoteAllFields</ListItem>
				<ListItem>csvWriteHeader</ListItem>
				<ListItem>csvWriteBOM</ListItem>
				<ListItem>csvLogLongLines</ListItem>
				<ListItem>csvCombineLastFields</ListItem>
				<ListItem>characterSet</ListItem>
				<ListItem>$GLOBAL.debug</ListItem>
			</FormItemNames>
			<FormItem name="characterSet">
				<parameter name="description">set_desc</parameter>
				<parameter name="label">set_label</parameter>
				<parameter name="syntax">STRING</parameter>
			</FormItem>
			<FormItem name="csvColumnSeparator">
				<parameter name="description">sep_desc</parameter>
				<parameter name="label">sep_label</parameter>
				<parameter name="syntax">STRING</parameter>
				<parameter name="Required">true</parameter>
			</FormItem>
			<FormItem name="csvSortFields">
				<parameter name="description">sort_attr_desc</parameter>
				<parameter name="label">sort_attr_label</parameter>
				<parameter name="syntax">boolean</parameter>
				<parameter name="Required">false</parameter>
			</FormItem>
			<FormItem name="csvColumns">
				<parameter name="description">col_desc</parameter>
				<parameter name="label">col_label</parameter>
				<parameter name="syntax">TEXTAREA</parameter>
			</FormItem>
			<FormItem name="csvEnableQuoting">
				<parameter name="description">quo_desc</parameter>
				<parameter name="label">quo_label</parameter>
				<parameter name="syntax">boolean</parameter>
			</FormItem>
			<FormItem name="csvQuoteAllFields">
				<parameter name="description">quo_all_desc</parameter>
				<parameter name="label">quo_all_label</parameter>
				<parameter name="syntax">boolean</parameter>
			</FormItem>			
			<FormItem name="csvLogLongLines">
				<parameter name="description">line_desc</parameter>
				<parameter name="label">line_label</parameter>
				<parameter name="syntax">string</parameter>
			</FormItem>
			<FormItem name="csvWriteHeader">
				<parameter name="description">head_desc</parameter>
				<parameter name="label">head_label</parameter>
				<parameter name="syntax">boolean</parameter>
			</FormItem>
			<FormItem name="csvWriteBOM">
				<parameter name="description">bom_desc</parameter>
				<parameter name="label">bom_label</parameter>
				<parameter name="syntax">boolean</parameter>
			</FormItem>
			<FormItem name="csvCombineLastFields">
				<parameter name="description">combine_last_desc</parameter>
				<parameter name="label">combine_last_label</parameter>
