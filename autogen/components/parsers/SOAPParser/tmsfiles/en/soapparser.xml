<Message ID="CTGDJV001E" prefix="yes">
   <MsgText pgmKey="PARSER.SOAP.WRITE.NOINPUT.ERROR" varFormat="Java">
   Failed to read XML because input stream was not found. The
   input or output modes of the SOAP Parser may not be valid.
   </MsgText>
   <Explanation> <p>
   See message.
   </p> </Explanation>
   <OperatorResponse> <p>
   Check the input and output modes of the SOAP Parser.
   </p> </OperatorResponse>
</Message>

<Message ID="CTGDJV002E" prefix="yes">
   <MsgText pgmKey="PARSER.SOAP.XML.DOCUMENT.HAS.NO.SOAP.BODY" varFormat="Java">
   XML document has no &lt;SOAP-ENV:Body&gt; element.
   </MsgText>
   <Explanation> <p>
   The SOAP message is not valid.
   </p> </Explanation>
   <OperatorResponse> <p>
   Check the input SOAP message for node &lt;SOAP-ENV:Body&gt;.
   </p> </OperatorResponse>
</Message>

<Message ID="CTGDJV003E" prefix="yes">
   <MsgText pgmKey="PARSER.SOAP.SOAP.ENV.BODY.TAG.HAS.NO.ELEMENTS" varFormat="Java">
   &lt;SOAP-ENV:Body&gt; tag has no elements.
   </MsgText>
   <Explanation> <p>
   The SOAP message is not valid.
   </p> </Explanation>
   <OperatorResponse> <p>
   The SOAP tag &lt;SOAP-ENV:Body&gt; must have at least an element.
   </p> </OperatorResponse>
</Message>

