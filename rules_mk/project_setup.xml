<?xml version="1.0"?>

<project name="setup" basedir=".">

  <!-- Give the user a chance to override without editing this file (and
       without typing -D each time they run it). -->
  <property file="${user.home}/${propfile}"/>
  <property file="${basedir}/${propfile}"/>

  <!-- Specifically define certain variables recognized by ant.  -->
  <property name="deprecation"   value="false"/>
  <property name="optimize"      value="true"/>

  <!-- Bring in the environment variables..  -->
  <property environment="project_env_vars"/>

  <!-- Set the product name info for later use in the build.  -->
  <property name="project.tdi.name"   value="SyncWeave"/>

  <!-- Set the version number info for later use in the build.
       Is tied to the version numbering in the CE plugin -->
  <property name="project.tdi.version"   value="1.0.0"/>

  <!-- Set the version number info use in the installer executable name.  -->
  <property name="project.tdi.version.installer"   value="10"/>

  <!-- Set the value to use in the swgtag files we make -->
  <property name="project.tdi.swgtag.vers"   value="1.0.0"/>
  
  <!-- Set the prefix of all TDI OSGi bundles -->
  <property name="project.tdi.osgi.plugins.prefix" value="com.ibm.di" />

  <!-- Set the location of the project source root.  -->
  <dirname property="project.basedir" file="${ant.file.setup}"/>
  <property name="project.root"   location="${project.basedir}/.."/>

  <!-- set the location of the tools directory. -->
  <property name="project.tools_home"   location="${project_env_vars.TOOLS_HOME}"/>

  <!-- The CMVC Release. -->
  <property name="project.cmvc_release"   value="10.0.0"/>

  <!-- The short name of the cmvc family TDI uses. -->
  <property name="project.cmvc_family.short"   value="integrator"/>

  <!-- The CMVC Level for this build. It will only have a value in a product build. -->
  <property name="project.cmvc_level"   value="0"/>

  <!-- set the location of the adks directory. -->
  <property name="project.adks_home"   location="${project.root}/adks"/>

  <!-- set the location of the tmsxml directory. -->
  <property name="project.tmsxml"   location="${project.root}/tools/tmsxml_to_properties"/>

  <!-- set the location of the adks lib.nodist directory. The are old jars used for building. -->
  <property name="project.adks.lib.nodist"   location="${project.adks_home}/lib.nodist"/>

  <!-- Set the location the install root directory.  -->
  <property name="project.root.install"   location="${project.root}/install"/>

  <!-- Set the location the install bin directory.  -->
  <property name="project.root.install.bin"   location="${project.root.install}/bin"/>
  
  <!-- Set the location the install utils directory.  -->
  <property name="project.root.install.utils"   location="${project.root.install}/utils"/>

  <!-- Set the location of the license directory.  -->
  <property name="project.root.license"   location="${project.root.install}/lib/license"/>

  <!-- Set the location of where the overall ship tree will be for the build.  -->
  <property name="project.root.ship"   location="${project.root}/ship"/>

  <!-- Set the location of where the lum license files will be for the build.  -->
  <property name="project.root.lum"   location="${project.root}/lum"/>

  <!-- The base location of where the cd images will go. -->
  <property name="project.root.img.cdimage"  location="${project.root.ship}/cdimage"/>

  <!-- The base location of where the images should be shipped to depending on the edition. -->
  <property name="project.root.general.ed.img.base"     location="${project.root.img.cdimage}/gen_purpose_edition"/>
  <property name="project.root.identity.ed.img.base"    location="${project.root.img.cdimage}/identity_edition"/>

