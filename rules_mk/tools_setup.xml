	<!-- set properties for javac -->
	<!-- Single release version used by all javac tasks via ${root.javac_release.vers}.
	     Both legacy properties are kept pointing at the same value so existing
	     source= / target= attributes in build.xml continue to work unchanged. -->
	<property name="root.javac_release.vers"  value="21"/>
	<property name="root.javac_src.vers"      value="${root.javac_release.vers}"/>
	<property name="root.javac_tgt.vers"      value="${root.javac_release.vers}"/>
	<property name="root.javac_dbg"           value="on" />
	<property name="root.javadocs_url"        value="https://docs.oracle.com/en/java/javase/21/docs/api/index.html" />

	<!-- Global <javac> preset (Ant 1.9.3+ presetdef).
	     build.xml tasks use source= and target= explicitly; passing \-\-release
	     alongside those flags is a javac error ("option \-\-release cannot be used
	     together with -source or -target").  The correct fix that touches zero
	     call sites is therefore to suppress the advisory warning itself via
	     -Xlint:-options, which silences:
	       "location of system modules is not set in conjunction with -source N"
	     Future migration path: change root.javac_src.vers/root.javac_tgt.vers
	     usages in build.xml to release= and drop source=/target= entirely. -->
	<presetdef name="javac">
		<javac>
			<compilerarg value="-Xlint:-options"/>
		</javac>
	</presetdef>

