  <description>
    =========================================================================
      Macro:  buildDefaultSCH

      Purpose:  Builds a default.sch file.
    =========================================================================
  </description>
  <macrodef name="buildDefaultSCH">
    <!-- Name and location to produce the default.sch file. -->
    <attribute name="plugin.default.sch"/>
    <!-- The title of the guide for the default.sch file. -->
    <attribute name="guide.title"/>
    <!-- The location of the directory where the guide specific files are located. -->
    <attribute name="guide.base.loc"/>
    <!-- The location of the directory where the guide specific files are located. -->
    <attribute name="guide.base.exp.loc"/>
    <!-- The language directory to look in. -->
    <attribute name="guide.lang"/>

    <sequential>
      <echo>Building @{guide.title} default.sch file...</echo>

      <!-- create a default.sch file. -->
      <echo file="@{plugin.default.sch}" append="false">PROJ:
      FILE:@{guide.base.loc}
      FILE:${base.common_ide_files}
      FILE:${base.common_plugin_files}/common
      FILE:${base.common_ide_files}/@{guide.lang}
      FILE:${base.common_plugin_files}/@{guide.lang}
      FILE:${base.common_dita_files}/@{guide.lang}
      FILE:@{guide.base.exp.loc}</echo>
      
    </sequential>

  </macrodef>

  <description>
    =========================================================================
      Macro:  buildDefaultDSH

      Purpose:  Builds a default.dsh file.
    =========================================================================
  </description>
  <macrodef name="buildDefaultDSH">
    <!-- Name and location to produce the default.dsh file. -->
    <attribute name="plugin.default.dsh"/>
    <!-- The title of the guide for the default.sch file. -->
    <attribute name="guide.title"/>
    <!-- The location of the directory where the guide specific files are located. -->
    <attribute name="guide.base.loc"/>
    <!-- The location of the directory where the guide specific files are located. -->
    <attribute name="guide.base.exp.loc"/>
    <!-- The language directory to look in. -->
    <attribute name="guide.lang"/>

    <sequential>
      <echo>Building @{guide.title} default.dsh file...</echo>

      <!-- create a default.sch file. -->
      <echo file="@{plugin.default.dsh}" append="false">
      DIR:@{guide.base.loc}
      DIR:${base.common_dita_files}/@{guide.lang}
      DIR:${base.common_plugin_files}/@{guide.lang}
      DIR:${base.common_plugin_files}/common
      DIR:@{guide.base.exp.loc}</echo>
      
    </sequential>

  </macrodef>

  <description>
    =========================================================================
      Macro:  zipGuide

      Purpose:  Adds a guides plugin files to a zip file.
    =========================================================================
  </description>
  <macrodef name="zipGuide">
    <!-- Name and location of the zip file being produced. -->
    <attribute name="plugin.zip"/>
    <!-- The location of the directory with all of the files to zip up. -->
    <attribute name="plugin.input.dir"/>

    <sequential>
      <zip zipfile="@{plugin.zip}" update="true">
           <zipfileset dir="@{plugin.input.dir}" >
               <include name="*.htm"/>
               <include name="*.gif"/>
               <include name="*.pdf"/>
               <include name="**/*.gif"/>
               <exclude name="nl/**"/>
           </zipfileset>
      </zip>
    </sequential>

  </macrodef>

  <description>
    =========================================================================
      Macro:  splitAUIMLHelpFile

      Purpose:  Runs splitter program to convert one html help file into several
                for an eclipse plugin.
    =========================================================================
  </description>
  <macrodef name="splitAUIMLHelpFile">
    <!-- The location and name of the input html file. -->
    <attribute name="auimlhtmlfile.loc"/>
    <!-- The to send the split html files. -->
    <attribute name="htmloutput.dir"/>
    <attribute name="codepage"/>

    <sequential>
        <echo>AUIML SPLITER TOOL started: @{auimlhtmlfile.loc}</echo>
        <exec executable="java" failonerror="yes" error="${project.root.auiml.splitter.log}"> 
        <arg line=' -classpath "${Split_Classpath}" -Dfile.encoding=@{codepage} ${Split_Tool} "@{auimlhtmlfile.loc}" "@{htmloutput.dir}" '/> 
        </exec>
        <echo>AUIML SPLITER TOOL successful: @{auimlhtmlfile.loc}</echo>
    </sequential>

  </macrodef>

</project>
