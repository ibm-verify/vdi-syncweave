  <description>
    =========================================================================
      Macro:  convertToPDF

      Purpose:  Runs transform to convert a ide file to a PDF file.
    =========================================================================
  </description>
  <macrodef name="convertToPDF">
    <!-- Name and location of the input IDE file. -->
    <attribute name="iddfile.loc"/>
    <!-- Name and location of the output PDF file. -->
    <attribute name="pdffile.loc"/>
    <!-- Location of the temporary directory of the files during pdf generation. -->
    <attribute name="pdf.exp.dir"/>
    <!-- The location of the default.sch file for the guide. -->
    <attribute name="plugin.default.sch"/>
    <!-- The title of the guide. -->
    <attribute name="guide.title"/>
    <!-- name and location of the temporary internet file. -->
    <attribute name="pdffile.output.pdf.loc"/>
    <!-- where the outdir will be. -->
    <attribute name="pdf.output.dir"/>

    <sequential>
      <echo>Building @{guide.title}...</echo>
      
      <!-- process the .idd file to get a .pdf file -->
      <exec executable="cmd.exe" failonerror="yes" dir="@{pdf.exp.dir}"> 
        <arg line='/c call iiddfpsl "@{iddfile.loc}" /V:"${pdf.props.file}" /S:"@{plugin.default.sch}" /OUTDIR:"@{pdf.output.dir}" ${pdf.commom.params}'/> 
      </exec>
      
      <!-- Rename the generated file. -->
      <copy file="@{pdffile.output.pdf.loc}" tofile="@{pdf.output.dir}/tmp1.pdf"/>
      <move file="@{pdf.output.dir}/tmp1.pdf" tofile="@{pdffile.loc}"/>
    </sequential>

  </macrodef>

  <description>
    =========================================================================
      Macro:  convertDitaToPDF

      Purpose:  Runs transform to convert dita files to a PDF file.
    =========================================================================
  </description>
  <macrodef name="convertDitaToPDF">
    <!-- Name and location of the input dita map file. -->
    <attribute name="ditamapfile.loc"/>
    <!-- Location of the temporary directory of the files during pdf generation. -->
    <attribute name="pdf.exp.dir"/>
    <!-- The location of the default.sch file for the guide. -->
    <attribute name="plugin.default.dsh"/>
    <!-- The title of the guide. -->
    <attribute name="guide.title"/>
    <!-- name and location of the temporary internet file. -->
    <attribute name="pdffile.output.pdf.loc"/>
    <!-- where the outdir will be. -->
    <attribute name="pdf.output.dir"/>
    <!-- Name and location of the dita control style file for this Guide.. -->
    <attribute name="ditcontrolstyle.loc"/>

    <sequential>
      <echo>Building @{guide.title}...</echo>
      
      <!-- process the .idd file to get a .pdf file -->
      <exec executable="cmd.exe" failonerror="yes" dir="@{pdf.exp.dir}"> 
        <arg line='/c call map2pdf "@{ditamapfile.loc}" /DSH:"@{plugin.default.dsh}" /OUTDIR:"@{pdf.output.dir}" /DITAControl:"@{ditcontrolstyle.loc}" ${pdf.dita.commom.params}'/> 
      </exec>
      
      <!-- Move the generated idd file to the export dir incase we need to look at it. -->
      <move todir="@{pdf.exp.dir}">
        <fileset dir="@{pdf.output.dir}">
           <include name="*.idd"/>
        </fileset>
     </move>
    </sequential>

  </macrodef>

  <description>
    =========================================================================
      Macro:  convertTMSXMLToIDE

      Purpose:  Runs transform to convert a TMS XML file into an ide file.
    =========================================================================
  </description>
  <macrodef name="convertTMSXMLToIDE">
    <!-- The location and name of the input xml file. -->
    <attribute name="tmsxmlfile.loc"/>
    <!-- The location and name of the ide file to generate. -->
    <attribute name="idefile.loc"/>
    <!-- The location and name of the ide file to generate log in. -->
    <attribute name="logfile.log"/>
    <!-- The title to give to the ide file. -->
    <attribute name="idetitle"/>

    <sequential>
       <echo>TMSXML FILE to IDE FILE started: @{tmsxmlfile.loc}</echo>
       <exec executable="java" failonerror="yes" error="@{logfile.log}" output="@{idefile.loc}"> 
         <arg line=' -classpath "${root.tms_sgml_jars}" "${root.XML_TO_SGML_PROG}" -makeidefile -singleColumn -dtd_dir "${root.XSL_SPEC_SOURCE}" -xsl "${root.XSL_TO_SGML_MSG_SOURCE}" @{tmsxmlfile.loc}'/> 
       </exec>
       <!-- Set the title in the .ide file generated.. -->
       <replaceregexp file="@{idefile.loc}"
                      match="[\p{Blank}]*&lt;titleblk&gt;[^\000]*&lt;/titleblk&gt;[\p{Blank}]*"
                      replace="&lt;titleblk&gt;&lt;title&gt;@{idetitle}&lt;/title&gt;&lt;/titleblk&gt;"
                      flags="gm"
                      byline="false"
                      encoding="UTF8" />
       <echo>TMSXML FILE to IDE FILE successful: @{idefile.loc}</echo>
    </sequential>

  </macrodef>

  <description>
    =========================================================================
      Macro:  convertOSGiTMSXMLToIDE

      Purpose:  Runs transform to convert a TMS XML file within an OSGi project 
                          into an ide file.
    =========================================================================
  </description>
  <macrodef name="convertOSGiTMSXMLToIDE">
    <!-- The full path to the bundle.xml file without the ".xml" extension -->
    <attribute name="bundle.l10n"/>
    <!-- The location and name of the ide file to generate. -->
    <attribute name="idefile.loc"/>
    <!-- The location and name of the ide file to generate log in. -->
    <attribute name="logfile.log"/>
    <!-- The title to give to the ide file. -->
    <attribute name="idetitle"/>
    <!-- The locale of the bundle.xml to use in procession -->
    <attribute name="locale"/>

    <sequential>
	 <local name="loc" />
       <condition property="loc" value="" else="_@{locale}" >
	   <equals arg1="@{locale}" arg2="en" />
       </condition>
	   
    <convertTMSXMLToIDE tmsxmlfile.loc="@{bundle.l10n}${loc}.xml" idefile.loc="@{idefile.loc}" logfile.log="@{logfile.log}" idetitle="@{idetitle}" />
	</sequential>

	</macrodef>
	
  <description>
    =========================================================================
      Macro:  convertTMSXMLToProperties

      Purpose:  Runs transform to convert a TMS XML file into an properties file.
    =========================================================================
  </description>

  <macrodef name="convertTMSXMLToProperties">
    <!-- The location and name of the input xml file. -->
    <attribute name="tmsxmlfile.loc"/>
    <!-- The location and name of the properties file to generate. -->
    <attribute name="propsfile.loc"/>
    <!-- The location and name of the ide file to generate log in. -->
    <attribute name="logfile.log"/>

    <sequential xmlns:if="ant:if" xmlns:unless="ant:unless">
     <condition property="onLinux">
       <os family="unix"  name="Linux"/>
     </condition>
       <echo>TMSXML FILE to PROPERTIES FILE: @{tmsxmlfile.loc}</echo>

       <exec executable="${project.tmsxml}/tmsxml_to_properties" failonerror="yes" output="@{logfile.log}" if:set="onLinux"> 
         <arg line='"@{tmsxmlfile.loc}" "${project.tmsxml}/xsl/propertiesResourceBundle.xsl" "@{propsfile.loc}"'/>
       </exec>
       <exec executable="java" failonerror="yes" output="@{logfile.log}" unless:set="onLinux"> 
         <arg line='-classpath "${root.tms_props_jars}" -DDTD_DIR="${root.XSL_SPEC_SOURCE}" -Xbootclasspath/a:"${root.tms_jars_}" "${root.XML_TO_MSG_PROG}" -in file:"@{tmsxmlfile.loc}" -xsl file:"${root.XSL_MSG_SOURCE}" -out "@{propsfile.loc}" -entityresolver DTDDirResolver -param preformat true -param doubleapos true -param varonly true '/> 
       </exec>

       <local name="dst.dir"/>
       <dirname property="dst.dir" file="@{tmsxmlfile.loc}"/>
       <copy file="@{propsfile.loc}" todir="${dst.dir}"/>

    </sequential>

  </macrodef>

  <description>
    =========================================================================
      Macro:  buildDocsEclipsePlugin

      Purpose:  Runs transform to create a guide eclispe help plugin.  Include
                creating the xhtml, toc, and copying all other needed files.
    =========================================================================
  </description>
  <macrodef name="buildDocsEclipsePlugin">
    <!-- The title of the guide. -->
    <attribute name="guide.title"/>
    <!-- The export plugin dir. -->
    <attribute name="plugin.exp.dir"/>
    <!-- The ship plugin dir. -->
    <attribute name="plugin.ship.dir"/>
    <!-- The base export plugin dir. -->
    <attribute name="plugin.base.exp.loc"/>
    <!-- The location of the guide .idd file. -->
    <attribute name="guide.loc"/>
    <!-- The location of the default.sch file for the guide. -->
    <attribute name="plugin.default.sch"/>
    <!-- The location of the plugin toc file in the exp dir. -->
    <attribute name="plugin.toc.exp"/>
    <!-- The location of the plugin toc file in the ship dir. -->
    <attribute name="plugin.toc.ship"/>
    <!-- Name base to give each html file in the plugin. -->
    <attribute name="plugin.base.html"/>
    <!-- Name base where the .idde and other plucing files reside. -->
    <attribute name="guide.base.loc"/>
    <!-- The pdf name of the guide. -->
    <attribute name="guide.pdf.name"/>
    <!-- The location of the pdf guide that was generated. -->
    <attribute name="guide.pdf.loc.name"/>
    <!-- The location of the guides css file for copying. -->
    <attribute name="guide.wb.css.file.exp"/>
    <!-- The location in the ship dir to copy the guides css file. -->
    <attribute name="guide.wb.css.file.ship"/>
    <!-- The footer file to use for this guide. -->
    <attribute name="guide.footer"/>

    <sequential>
    <!-- Specify which guide plugin we are building  -->
    <echo>Building @{guide.title} Eclipse Help Plugin..</echo>

    <!-- Delete the old plugin directories  -->
    <delete dir="@{plugin.exp.dir}"/>
    <mkdir dir="@{plugin.exp.dir}"/>
    <delete dir="@{plugin.ship.dir}"/>
    <mkdir dir="@{plugin.ship.dir}"/>

    <!-- process the .idd file to get xhtml files for the plugins  -->
    <exec executable="cmd.exe" failonerror="yes" dir="@{plugin.base.exp.loc}"> 
      <arg line='/c call iiddxhtm "@{guide.loc}" /V:"${plugins.props.file}" /S:"@{plugin.default.sch}" /OUTDIR:"@{plugin.exp.dir}" ${plugins.commom.params} @{guide.footer}'/> 
    </exec>

    <!-- Make some corrections to the toc file generated. -->
    <replaceregexp file="@{plugin.toc.exp}"
                         match="topic=&quot;@{plugin.base.html}&quot;&gt;"
                         replace="topic=&quot;@{plugin.base.html}&quot;&gt; &#32;&lt;topic href=&quot;@{guide.pdf.name}&quot; label=&quot;${pdfTitle}&quot; /&gt;"
                         byline="true" encoding="UTF8"/>

    <!-- put things in the ship tree -->
    <!-- Copy of the to toc file. -->
    <copy file="@{plugin.toc.exp}" tofile="@{plugin.toc.ship}"/>
    <!-- Copy over all of the htm and gif files-->
    <copy todir="@{plugin.ship.dir}">
       <fileset dir="@{plugin.exp.dir}">
          <include name="*.htm"/>
          <include name="*.gif"/>
          <exclude name="eserver.gif"/>
       </fileset>
    </copy>
    <!-- Copy over the plugin.xml file -->
    <copy file="@{guide.base.loc}/plugin.xml" tofile="@{plugin.ship.dir}/plugin.xml"/>
    <!-- Copy over the pdf file -->
    <copy file="@{guide.pdf.loc.name}" tofile="@{plugin.ship.dir}/@{guide.pdf.name}"/>
    <!-- Copy over the needed style sheet file -->
    <copy file="@{guide.wb.css.file.exp}" tofile="@{guide.wb.css.file.ship}"/>
    </sequential>

  </macrodef>

