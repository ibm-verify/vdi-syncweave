  <description>
    =========================================================================
      Macro:  zipTDIExamplesPackage

      Purpose:  Make the zip of the TDI Examples package in a specified location.
    =========================================================================
  </description>
  <macrodef name="zipTDIExamplesPackage">
   <!-- The zip file name and location for the example package. -->
   <attribute name="output.name"/>
   <!-- The zip file name and location for examples that are added to the identity edition. -->
   <attribute name="output.name.identity.ed"/>
   <!-- Determines whether the format of the txt files should be dos or unix.
        Specify either dos or unix. -->
   <attribute name="eol"/>

   <sequential>
      <!-- Delete the old zip file if it exists. -->
      <delete file="@{output.name}"/>

      <!-- Make sure the needed directory is created. -->
      <delete dir="${project.root.examples.export}"/>
      <mkdir dir="${project.root.examples.export}"/>
      <!-- Copy over the files needed -->
      <copy todir="${project.root.examples.export}">
        <fileset dir="${project.root.examples}">
          <include name="**/*"/>
        </fileset>
      </copy>

      <!-- Put the files in the format specified. -->
      <fixcrlf srcdir="${project.root.examples.export}"
               eol="@{eol}"
               includes="**/*.txt" />

     <!-- Make the Examples zip file. -->
      <zip zipfile="@{output.name}">
          <zipfileset dir="${project.root.export}" >
              <include name="examples/jms/*"/>
          </zipfileset>
      </zip>

     <!-- Make the Examples zip file. -->
      <zip zipfile="@{output.name.identity.ed}">
          <zipfileset dir="${project.root.export}" >
              <include name="examples/SPMLv2Parser/*"/>
          </zipfileset>
      </zip>

   </sequential>
  </macrodef>

  <description>
    =========================================================================
      Macro:  zipCommonPluginJars

      Purpose:  Adds common plugin jars to a zip file.
    =========================================================================
  </description>
  <macrodef name="zipCommonPluginJars">
    <!-- Name and location of the zip file being produced. -->
    <attribute name="plugin.zip"/>
    <!-- The prefix to put in the zip where all the jar files will go. -->
    <attribute name="plugin.prefix.dir"/>

    <sequential>
      <!-- Create the base jars package that is used by every plugin. -->
      <zip zipfile="@{plugin.zip}"  update="true">
          <zipfileset dir="${project.root.export}/jars/plugins"
                      prefix="@{plugin.prefix.dir}/jars">
              <include name="jmspwstore.jar" />
          </zipfileset>
      </zip>
    </sequential>

  </macrodef>

  <description>
    =========================================================================
      Macro:  zipCommonPluginFiles

      Purpose:  Adds generic specific common plugin files to a zip file.
    =========================================================================
  </description>
  <macrodef name="zipCommonPluginFiles">
    <!-- Name and location of the zip file being produced. -->
    <attribute name="plugin.zip"/>
    <!-- The prefix to put in the zip where all the jar files will go. -->
    <attribute name="plugin.prefix.dir"/>
    <!-- The format to put the files in. (dos or unix). -->
    <attribute name="plugin.file.format"/>
    <!-- The script suffixes to bring in. -->
    <attribute name="plugin.file.suffix"/>

    <sequential>
        <!-- Put the files in the format we need. -->
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/bin"
                 eol="@{plugin.file.format}"
                 includes="*.props *.@{plugin.file.suffix}" />
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/etc"
                 eol="@{plugin.file.format}"
                 includes="*.ldif" />
        <!-- Package up the scripts, a few props files, and ldif files. -->
        <zip zipfile="@{plugin.zip}"  update="true">
            <zipfileset dir="${project.root.pwd.plugin.export}/bin"
                        prefix="@{plugin.prefix.dir}/IDS">
               <include name="mqeconfig.props"/>
            </zipfileset>
        </zip>
    </sequential>

  </macrodef>

  <description>
    =========================================================================
      Macro:  zipTDIPwdPluginsPackage

      Purpose:  Make the zip of the TDI Plugins package in a specified location.
    =========================================================================
  </description>
  <macrodef name="zipTDIPwdPluginsPackage">
   <!-- The zip file name and location for the plugins base package. -->
   <attribute name="output.name.plugins.base"/>
   <!-- The zip file name and location for the plugins base package for windows specific files. -->
   <attribute name="output.name.plugins.base.win"/>
   <!-- The zip file name and location for the plugins base package for unix specific files. -->
   <attribute name="output.name.plugins.base.unix"/>
   <!-- The zip file name and location for the windows plugins package. -->
   <attribute name="output.name.win.x86"/>
   <!-- The zip file name and location for the windows x86_64 plugins package. -->
   <attribute name="output.name.win.x86.64"/>
   <!-- The zip file name and location for the linux plugins package. -->
   <attribute name="output.name.linux.x86"/>
   <!-- The zip file name and location for the linux x86_64 plugins package. -->
   <attribute name="output.name.linux.x86.64"/>
   <!-- The zip file name and location for the aix plugins package. -->
   <attribute name="output.name.aix"/>
   <!-- The zip file name and location for the solaris sparc plugins package. -->
   <attribute name="output.name.solaris.sparc"/>
   <!-- The zip file name and location for the hp parisc plugins package. -->
   <attribute name="output.name.hp.parisc"/>

   <sequential>
        <!-- Make sure the needed directory is created. -->
        <delete dir="${project.root.pwd.plugin.export}"/>
        <mkdir dir="${project.root.pwd.plugin.export}"/>
        <!-- Copy over the files from the install/bin directory for windows -->
        <copy todir="${project.root.pwd.plugin.export}">
          <fileset dir="${project.root.pwd.plugin.src}">
            <include name="**/*.bat"/>
            <include name="**/*.sh"/>
            <include name="**/*.props"/>
            <include name="**/*.ldif"/>
            <include name="**/*.nsf"/>
          </fileset>
        </copy>

        <!-- delete any existing zip files. -->
        <delete file="@{output.name.plugins.base}"/>
        <delete file="@{output.name.plugins.base.win}"/>
        <delete file="@{output.name.plugins.base.unix}"/>
        <delete file="@{output.name.win.x86}"/>
        <delete file="@{output.name.win.x86.64}"/>
        <delete file="@{output.name.linux.x86}"/>
        <delete file="@{output.name.linux.x86.64}"/>
        <delete file="@{output.name.aix}"/>
        <delete file="@{output.name.solaris.sparc}"/>
        <delete file="@{output.name.hp.parisc}"/>

        <!-- Create the base package. -->
        <zipCommonPluginJars plugin.zip="@{output.name.plugins.base}" plugin.prefix.dir="pwd_plugins" />

        <!-- Put the files in Windows format -->
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/domino/etc"
                 eol="dos"
                 includes="*.props" />
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/pam/etc"
                 eol="dos"
                 includes="*.props" />
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/sun/etc"
                 eol="dos"
                 includes="*.props" />
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/tds/etc"
                 eol="dos"
                 includes="*.props" />

        <!-- Create the base package for windows. -->
        <zipCommonPluginFiles plugin.zip="@{output.name.plugins.base.win}" plugin.prefix.dir="pwd_plugins" plugin.file.format="dos" plugin.file.suffix="bat" />

        <!-- Put the files in Unix format -->
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/domino/etc"
                 eol="unix"
                 includes="*.props" />
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/pam/etc"
                 eol="unix"
                 includes="*.props" />
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/sun/etc"
                 eol="unix"
                 includes="*.props" />
        <fixcrlf srcdir="${project.root.pwd.plugin.export}/tds/etc"
                 eol="unix"
                 includes="*.props" />

        <!-- Create the base package for unix. -->
        <zipCommonPluginFiles plugin.zip="@{output.name.plugins.base.unix}" plugin.prefix.dir="pwd_plugins" plugin.file.format="unix" plugin.file.suffix="sh" />

        <!-- Create the windows x86 zip. -->
        <zip zipfile="@{output.name.win.x86}" update="true">
            <zipfileset dir="${project.root.pwd.plugin.src}/tds/lib/win_x86"
                        prefix="pwd_plugins/IDS">
               <include name="idspwsync.dll"/>
            </zipfileset>
        </zip>

        <!-- Create the windows x86_64 zip. -->
        <zip zipfile="@{output.name.win.x86.64}" update="true">
            <zipfileset dir="${project.root.pwd.plugin.src}/tds/lib/win_x86_64"
                        prefix="pwd_plugins/IDS">
               <include name="idspwsync_64.dll"/>
            </zipfileset>
        </zip>

        <!-- Create the linux x86 zip. -->
        <zip zipfile="@{output.name.linux.x86}"  update="true">
            <zipfileset dir="${project.root.pwd.plugin.src}/tds/lib/linux_x86"
                        prefix="pwd_plugins/IDS">
               <include name="libidspwsync.so"/>
            </zipfileset>
        </zip>

        <!-- Create the linux x86_64 zip. -->
        <zip zipfile="@{output.name.linux.x86.64}"  update="true">
            <zipfileset dir="${project.root.pwd.plugin.src}/tds/lib/linux_x86_64"
                        prefix="pwd_plugins/IDS">
               <include name="libidspwsync_64.so"/>
            </zipfileset>
        </zip>

        <!-- Create the linux aix zip. -->
        <zip zipfile="@{output.name.aix}"  update="true">
            <zipfileset dir="${project.root.pwd.plugin.src}/tds/lib/aix"
                        prefix="pwd_plugins/IDS">
               <include name="libidspwsync.a.so"/>
               <include name="libidspwsync_64.a.so"/>
            </zipfileset>
        </zip>

        <!-- Create the solaris sparc zip. -->
        <zip zipfile="@{output.name.solaris.sparc}"  update="true">
            <zipfileset dir="${project.root.pwd.plugin.src}/tds/lib/solaris_sparc"
                        prefix="pwd_plugins/IDS">
               <include name="libidspwsync.so"/>
               <include name="libidspwsync_64.so"/>
            </zipfileset>
        </zip>

        <!-- Create the linux hp parisc zip. -->
        <zip zipfile="@{output.name.hp.parisc}"  update="true">
            <zipfileset dir="${project.root.pwd.plugin.src}/tds/lib/hp_parisc"
                        prefix="pwd_plugins/IDS">
               <include name="libidspwsync.sl"/>
               <include name="libidspwsync_64.sl"/>
            </zipfileset>
        </zip>

   </sequential>
  </macrodef>

  <description>
    =========================================================================
      Macro:  tarTDIZOSPackage

      Purpose:  Make the tar of the files to be shipped on ZOS.
    =========================================================================
  </description>
  <macrodef name="tarTDIZOSPackage">
   <!-- The tar file name and location for the zos tar file. -->
   <attribute name="output.name"/>

   <sequential>
     <!-- delete any existing tar files. -->
     <delete file="@{output.name}"/>

     <!-- Start tarring up the files.. -->
     <tar destfile="@{output.name}">

         <tarfileset dir="${project.root.export.zos.bin}"
                     preserveLeadingSlashes="true">
             <include name="ibmdisrv"/>
             <include name="ibmdisrv_ascii"/>
         </tarfileset>

         <!-- tar up the files that go in the lib directory -->
         <tarfileset dir="${project.root}/non_java/zOSTSOCommandLine/bin"
                     prefix="libs"
                     preserveLeadingSlashes="true">
             <include name="libtdiappc.so"/>
         </tarfileset>

     </tar>
   </sequential>
  </macrodef>

