  <description>
    =========================================================================
      Macro:  zipTDIAMCPackage

      Purpose:  Make the zip of the TDI AMC package in a specified location.
    =========================================================================
  </description>
  <macrodef name="zipTDIAMCPackage">
   <!-- The zip file name and location for the base AMC package. -->
   <attribute name="output.name.base"/>
   <!-- The zip file name and location for the windows AMC package. -->
   <attribute name="output.name.win"/>
   <!-- The zip file name and location for the unix AMC package. -->
   <attribute name="output.name.unix"/>
   <!-- The zip file name and location for the i5os AMC package. -->
   <attribute name="output.name.i5os"/>

   <sequential>
        <!-- delete any existing zip files. -->
        <delete file="@{output.name.base}"/>
        <delete file="@{output.name.win}"/>
        <delete file="@{output.name.unix}"/>
        <delete file="@{output.name.i5os}"/>

        <!-- One for Windows. -->
        <zip zipfile="@{output.name.win}">
            <zipfileset dir="${project.root.export.win.bin}" prefix="bin/amc/">
                <include name="backupamc.bat" />
            </zipfileset>
        </zip>

        <!-- One for UNIX. -->
        <zip zipfile="@{output.name.unix}">
            <zipfileset dir="${project.root.export.unix.bin}" prefix="bin/amc/">
                <include name="backupamc.sh" />
            </zipfileset>
        </zip>

        <!-- One for i5os. -->
        <zip zipfile="@{output.name.i5os}">
            <zipfileset dir="${project.root.export.i5os.bin}" prefix="bin/amc/">
                <include name="backupamc.sh" />
            </zipfileset>
        </zip>

        <!-- One for common zip. -->
        <zip zipfile="@{output.name.base}">
            <zipfileset dir="${project.root.export.amc.ship}/AMC" prefix="amc/">
                <include name="tdiamc.war"/>
            </zipfileset>
            <zipfileset dir="${project.root.export.amc.ship}/AMC/iscse" prefix="amc/iscse">
	         <include name="**/*"/>
            </zipfileset>
        </zip>
   </sequential>
  </macrodef>

  <description>
    =========================================================================
      Macro:  zipTDILicensePackage

      Purpose:  Make the zip of the TDI license package in a specified location.
    =========================================================================
  </description>
  <macrodef name="zipTDILicensePackage">
   <!-- The zip file name and location for the license package. -->
   <attribute name="output.name"/>

   <sequential>
      <delete dir="${project.root.license.export}"/>
      <mkdir dir="${project.root.license.export}"/>
       <!-- Copy over the license files needed. -->
       <copy todir="${project.root.license.export}">
         <fileset dir="${project.root.license}">
           <include name="*"/>
         </fileset>
       </copy>
       <!-- Create the proper license files. -->
        <concat destfile="${project.root.license.export}/TDI_License_zh.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_zh,LI_zh"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_zh_TW.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_zh_TW,LI_zh_TW"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_cs.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_cs,LI_cs"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_en.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_en,LI_en"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_fr.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_fr,LI_fr"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_de.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_de,LI_de"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_it.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_it,LI_it"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_ja.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_ja,LI_ja"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_ko.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_ko,LI_ko"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_pl.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_pl,LI_pl"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_pt_BR.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_pt,LI_pt"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_es.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_es,LI_es"/>
        </concat>
        <concat destfile="${project.root.license.export}/TDI_License_tr.txt" binary="true" append="true">
            <filelist dir="${project.root.license.export}" files="LA_tr,LI_tr"/>
        </concat>
        <copy file="${project.root.license.export}/TDI_License_en.txt"
              tofile="${project.root.license.export}/TDI_License.txt"/>

        <!-- Delete the old zip file if it exists. -->
        <delete file="@{output.name}"/>

        <!-- Make the license zip file. -->
        <zip zipfile="@{output.name}">
            <zipfileset dir="${project.root.license.export}/"
                prefix="license">
                <include name="TDI_License.txt"/>
                <include name="TDI_License_zh.txt"/>
                <include name="TDI_License_zh_TW.txt"/>
                <include name="TDI_License_cs.txt"/>
                <include name="TDI_License_en.txt"/>
                <include name="TDI_License_fr.txt"/>
                <include name="TDI_License_de.txt"/>
                <include name="TDI_License_it.txt"/>
                <include name="TDI_License_ja.txt"/>
                <include name="TDI_License_ko.txt"/>
                <include name="TDI_License_pl.txt"/>
                <include name="TDI_License_pt_BR.txt"/>
                <include name="TDI_License_es.txt"/>
                <include name="TDI_License_tr.txt"/>
            </zipfileset>
            <zipfileset dir="${project.root.license.export}"
                prefix="license">
                <include name="notices"/>
                <include name="non_ibm_license"/>
            </zipfileset>
        </zip>
   </sequential>
  </macrodef>

