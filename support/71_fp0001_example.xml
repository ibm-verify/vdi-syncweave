<?xml version="1.0"?>

<!--
  ===========================================================================
     File:  71_fp0001_example.xml

    Purpose:  Example shows how to create a full fixpack 1 of TDI 7.1.

    NOTE: All of these properties must be defined. Also
          only override the rules you need. The base ones are defined
          in install_zip_rules.xml.
-->

<project name="71_fp0001_example" basedir="." default="main">
		<target name="main">
		</target>

  <!-- Global variables for each IU to be built. -->

  <!--  BEGIN of Generic IU variables.  -->

  <!-- The type of IU packages we are creating.  In this case, its a fixpack.
       If the value is not Fixpack, its assumed to be an interim fix or la fix.
       Also, if its not a Fixpack, the version number is not used and will use
       the package name.
       MAIN_SUPPORT_PACKAGE_TYPE = FixPack | InterimFix | LimitedAvailabilityInterimFix
       NOTE: in SI 1.2.1 LimitedAvailabilityInterimFix is not yet recognized, so
       just use the FixPack for LAIFs also for now.-->
  <property name="SUPPORT_PACKAGE_TYPE"  value="FixPack"/>

  <!-- The version number for the IUs we are creating. For example, TDI 7.1 fixpack 1 would be 7.1.0.1 -->
  <property name="SUPPORT_PACKAGE_VERSION"  value="7.2.0.1"/>

  <!-- The name for the Main IU we are creating.
       This can be both the name of the Fixpack/IF/LAIF.
       If its a fixpack, you will only see this in the description
       of the package. -->
  <property name="SUPPORT_PACKAGE_NAME"  value="TDI-7.2-FP0001"/>

  <!-- More descriptive name for SWG Tagging process. -->
  <property name="SUPPORT_PACKAGE_DES_NAME"  value="IBM ${project.tdi.name} V${project.tdi.swgtag.vers} Fix Pack 1"/>

  <!-- The minimum version number the patch can be applied on top of. -->
  <property name="SUPPORT_MIN_VERSION"  value="7.2.0.0"/>

  <!-- The maximum version number the patch can be applied on top of. -->
  <property name="SUPPORT_MAX_VERSION"  value="7.2.0.0"/>

  <!--  END of Generic IU variables.  -->

  <!--  Tells whether the base should be included in the maintenance package.  -->
  <property name="BASE_PACKAGE_ENABLED"  value="true"/>

  <!--  Tells whether the server should be included in the maintenance package.  -->
  <property name="SERVER_PACKAGE_ENABLED"  value="true"/>

  <!--  Tells whether the ce should be included in the maintenance package.  -->
  <property name="CE_PACKAGE_ENABLED"  value="true"/>
  <!-- Note that when updating CE, you will need to update the project.tdi.version
       variable in project_setup.xml -->

  <!--  Tells whether the ce update site should be included in the maintenance package.  -->
  <property name="CE_UPDATE_PACKAGE_ENABLED"  value="true"/>

  <!--  Tells whether the examples should be included in the maintenance package.  -->
  <property name="EXAMPLES_PACKAGE_ENABLED"  value="true"/>

  <!--  Tells whether the javadocs should be included in the maintenance package.  -->
  <property name="JAVADOCS_PACKAGE_ENABLED"  value="false"/>

  <!--  Tells whether the amc should be included in the maintenance package.  -->
  <property name="AMC_PACKAGE_ENABLED"  value="false"/>

  <!--  Tells whether the license should be included in the maintenance package.  -->
  <!--  NOTE: Base must be true if license is true -->
  <property name="LICENSE_PACKAGE_ENABLED"  value="true"/>

  <!--  Tells whether a JRE should be included in the maintenance package.  -->
  <!--  NOTE: Base must be true if JRE is true -->
  <property name="JRE_PACKAGE_ENABLED"  value="false"/>

  <!--  Tells whether the plugins should be included in the maintenance package.  -->
  <property name="PLUGINS_PACKAGE_ENABLED"  value="false"/>

  <!--  Tells whether a zos packages should also be made for maintenance package.  -->
  <property name="ZOS_PACKAGE_ENABLED"  value="true"/>

  <!--  Tells whether LWI will  be updated in this maintenance package.  -->
  <property name="EWP_PACKAGE_ENABLED"  value="false"/>

  <!--  Now override the macros as needed to zip up what you need per IUs.
        Some macros may not need to be overwritten if you are replacing every file in an
        IU but its likely that you will not do this.  See install_zip_rules.xml for
        a list of macros. Here are the macros you can override at this time:
        Server - zipTDIServerPackage
        Base - zipBasePackage
        CE - zipTDICEPackage
        AMC - zipTDIAMCPackage
        Examples - zipTDIExamplesPackage
        JavaDocs - zipTDIJavaDocsPackage
        License - zipTDILicensePackage
        Plugins - zipTDIPwdPluginsPackage
        zos - tarTDIZOSPackage
  -->

  <description>
    =========================================================================
      Macro:  zipTagsFile

      Purpose:  Make the zip of the Tags file in a specified location.
    =========================================================================
  </description>
  <macrodef name="zipTagsFile">

     <!-- The zip file name and location for the tags package. -->
     <attribute name="output.name"/>

   <sequential>
        <!-- delete any existing zip files. -->
        <delete file="@{output.name}"/>
       
        <!-- Create the file. -->
        <create_fxtag_file outputname.loc="${project.root.export.swgtags}/IBM_Tivoli_Directory_Integrator.${SUPPORT_PACKAGE_VERSION}.fxtag"
                           swgfmidx="${prod_swgfmidx_name}" fixname="${SUPPORT_PACKAGE_DES_NAME}"
                           fixversion="${SUPPORT_PACKAGE_VERSION}" fixid="${SUPPORT_PACKAGE_NAME}" fixtype="${SUPPORT_PACKAGE_TYPE}"/>

        <!-- zip the file. -->
        <zip zipfile="@{output.name}">
            <zipfileset dir="${project.root.export.swgtags}"
                prefix="properties/version">
                <include name="IBM_Tivoli_Directory_Integrator.${SUPPORT_PACKAGE_VERSION}.fxtag"/>
            </zipfileset>
        </zip>

   </sequential>
  </macrodef>

