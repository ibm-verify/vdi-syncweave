        <parameter name="formevents"><![CDATA[
function ldapAuthenticationMethod_changed () {
	var key = "ldapAuthenticationMethod";
	var val = form.getConfig ( key );
	var enable = true;
	if ( val != null && val.equalsIgnoreCase ("Anonymous") )
		enable = false;
	form.getControl ("ldapUsername").setEnabled (enable);
	form.getControl ("ldapPassword").setEnabled (enable);
}
]]]]><![CDATA[></parameter>
