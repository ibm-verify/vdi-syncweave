        <parameter name="formevents"><![CDATA[
function ldapAuthenticationMethod_changed () {
	var key = "ldapAuthenticationMethod";
	var val = form.getConfig ( key );
	var enable = true;
	if ( val != null && val.equalsIgnoreCase ("Anonymous") )
		enable = false;
	form.getControl ("ldapUsername").setEnabled (enable);
	form.getControl ("ldapPassword").setEnabled (enable);
}
]]]]><![CDATA[></parameter>
        <parameter name="title">LDAP Connector</parameter>
        <TranslationFile>NLS/idi_conn_ldap</TranslationFile>
    </Form>
</MetamergeConfig>]]></parameter>
            <parameter name="ldapBinaryAttributes"><![CDATA[@SUBSTITUTE{javascript pname = "source.ldap.binaryAttributes"
param = getProperty(pname,null)
	
if (param === null)
	return ""
	
if (param.indexOf(",") > 0)
	atts = system.splitString(param,",")
else
if (param.indexOf("\n") > 0)
	atts = system.splitString(param,"\n")
else
	atts = system.splitString(param," ")
pstr = ""
for (a in atts)
	if (!a.toLowerCase().equals("objectsid"))
		pstr += a + "\n"
return pstr}]]></parameter>
