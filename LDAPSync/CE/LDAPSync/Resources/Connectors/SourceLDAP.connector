        <FormItem name="ldapUrl">
            <parameter name="Required">true</parameter>
            <parameter name="description">URL_DESC</parameter>
            <parameter name="label">URL_LABEL</parameter>
            <parameter name="panel"><![CDATA[

<Panel layout="Fill">
	<Group text="" layout="Grid" columns="4" onchange="updateURL">
		<Label name="url_label" text="ldap_url_host"/>
		<Text name="hostname" required="true" linklabel="url_label" tooltip="URL_DESC" size="15"/>
		<Label text="ldap_url_port" />
		<Text name="port" size="3" tooltip="URL_DESC" />
		<Button name="ssl" type="checkbox" tooltip="USE_SSL_DESC" text="ldap_url_ssl" binding="ldapUseSSL">
			<LayoutData horizontalSpan="4"/>
		</Button>
	</Group>
	<Script>
		function on_load() {
			ldapUrl = config.getStringParameter("ldapUrl");
			if(ldapUrl == null || ldapUrl.equals("")) {
				if(config.getBooleanParameter("ldapUseSSL", false))
					ldapUrl = "ldap://localhost:389";
				else
					ldapUrl = "ldaps://localhost:389";
			}

			try {
				// just to fool URL to accept our url string
				if (ldapUrl.startsWith("ldaps:")) {
					panel.setChecked("ssl", true);
					url = new java.net.URL(ldapUrl.replaceAll("ldaps:", "https:"));
				} else {
					panel.setChecked("ssl", false);
					url = new java.net.URL(ldapUrl.replaceAll("ldap:", "http:"));
				}
				if(url.getHost() != null)
					panel.setText("hostname", url.getHost());
				else
					panel.setText("hostname", "");
				if(url.getPort() != -1)
					panel.setText("port", url.getPort());
				else
					panel.setText("port", "" );
			} catch(err) {
				form.logProblem("ldapUrl", err);
				panel.setText("hostname", ldapUrl);
				panel.setText("port", "" );
			}
		}
		function updateURL() {
			prot = panel.isChecked("ssl") ? "ldaps" : "ldap";
			value = prot + "://" + panel.getText("hostname");
			port = panel.getText("port");
			if (port.length() > 0) 
				value += ":" + port;
			form.setConfig("ldapUrl",  value);
		}
	</Script>
</Panel>]]]]><![CDATA[></parameter>
