            <parameter name="nsSleepInterval">@SUBSTITUTE{javascript return connectorParam("source.ldap.secondsForPolling",10)}</parameter>
            <parameter name="nsTimeout">@SUBSTITUTE{javascript return connectorParam("source.ldap.changelogTimeout",60)}</parameter>
            <parameter name="stateKeyPersistence"><![CDATA[@SUBSTITUTE{javascript if ("true".equals(getProperty("simulate")))
	return "Manual"
else
	return "After read"}]]></parameter>
            <parameter name="useNotifications">@SUBSTITUTE{javascript return connectorParam("source.ldap.useNotifications","true")}</parameter>
