            <parameter name="ldapUseSSL"><![CDATA[@SUBSTITUTE{javascript pname = "source.ldap.url"
url = getProperty(pname)
if (url === null)
	return false
else
	return url.toLowerCase().indexOf("ldaps://") >= 0}]]></parameter>
            <parameter name="ldapUsername">@SUBSTITUTE{javascript return connectorParam("source.ldap.user")}</parameter>
