        <ConnectorMode>Iterator</ConnectorMode>
        <ConnectorState>Enabled</ConnectorState>
        <Configuration>
            <InheritFrom>[parent]</InheritFrom>
            <parameter name="debug">false</parameter>
            <parameter name="ldapBinaryAttributes"><![CDATA[@SUBSTITUTE{javascript pname = "target.ldap.binaryAttributes"
param = getProperty(pname,null)
	
if (param === null)
	return ""
	
if (param.indexOf(",") > 0)
	atts = system.splitString(param,",")
else
if (param.indexOf("\n") > 0)
	atts = system.splitString(param,"\n")
else
	atts = system.splitString(param," ")
pstr = ""
for (a in atts)
	if (!a.toLowerCase().equals("objectsid"))
		pstr += a + "\n"
return pstr}]]></parameter>
            <parameter name="ldapPageSize">@SUBSTITUTE{javascript return connectorParam("source.ldap.pageSize", 0)}</parameter>
