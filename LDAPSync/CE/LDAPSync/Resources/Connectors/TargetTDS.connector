<?xml version="1.0" encoding="UTF-8"?><MetamergeConfig Cycle="1" UUID="15583da1-b2ea-4e0b-a464-eeacd6953940" created="Mon Dec 30 13:03:45 CET 2013" createdBy="Administrator" main="TargetLDAP" modified="Mon Dec 30 13:03:45 CET 2013" modifiedBy="Administrator" project="LDAPSync" version="7.1.1">
    <Connector name="TargetLDAP">
        <InheritFrom>system:/Connectors/ibmdi.LDAP</InheritFrom>
