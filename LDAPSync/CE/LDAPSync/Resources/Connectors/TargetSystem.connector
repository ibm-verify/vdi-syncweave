        </LinkCriteria>
        <Hooks>
            <InheritFrom>[parent]</InheritFrom>
            <Hook name="before_initialize">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>before_initialize</Name>
                <Script><![CDATA[opEntry = task.getOpEntry(); // just to be sure we have it
alFC = opEntry.getObject("$alFC");
ctr = opEntry.getObject("$ctr");
targetTCB = null;

if (alFC != null) {
	targetTCB = alFC.getTCB();
	return; // exit this Hook
} else
if (ctr != null) {
	return;  // exit this Hook
}

alName = getALName("target.endpoint.AL");

if (alName != null) {
	p = alName.lastIndexOf("/");
	if (p > 0) {
		alNamePart = alName.substring(p+1);
	} else {
		alNamePart = alName;
	}
	
	try {
		alFC = system.getFunction("ibmdi.AssemblyLineFC");
		alFC.setParam("assemblyLine", alName);
		alFC.setParam("shareLog", "true");
		alFC.setParam("mode", "2"); // Manual mode
		targetTCB = alFC.getTCB();
		targetTCB.setTaskName(flowKey + "_" + alNamePart);

		// save ALFC in this AL's opEntry
		opEntry.setAttribute("$alFC", alFC);
		opEntry.setAttribute("$ctr", null);
		
		// set up $operation and search attributes of called AL's targetTCB
		targetTCB["$operation"] = "*not set*";
		targetTCB.search = null;
		
		if (opEntry != null) {
			targetTCB.setOperationInitParams(opEntry);
		}
	} catch (ex) {
		throw resource.getString("LDAPSYNC.CANNOT.LOAD.TARGET.SYSTEM.AL") + ": " + alName + " - " + ex;
	}	
} else {
//	ctrName = getProperty("target.endpoint.connector", "TargetTDS");
//	ctr = system.getConnector(ctrName);
	ctrName = getProperty("target.endpoint.connector.name", "TargetTDS");
	ctr = configureConnector(false, false, "target.endpoint", ctrName);
	if (ctr === null) {
		throw resource.getString("LDAPSYNC.CANNOT.LOAD.TARGET.SYSTEM.CONNECTOR") + ": " + ctrName;
	}

	// save ctr in this AL's opEntry
	opEntry.setAttribute("$alFC", null);
	opEntry.setAttribute("$ctr", ctr);
}

if (targetTCB !== null) {
	passGlobalVariablesViaTCB(targetTCB);
}]]></Script>
                <Enabled>true</Enabled>
            </Hook>
            <Hook name="default_fail">
                <InheritFrom>/Scripts/libDefaultOnError</InheritFrom>
                <Name>default_fail</Name>
                <Enabled>true</Enabled>
            </Hook>
            <Hook name="initialize_fail">
                <InheritFrom>/Scripts/libInitError</InheritFrom>
                <Name>initialize_fail</Name>
                <Enabled>true</Enabled>
            </Hook>
        </Hooks>
