            <Hook name="before_initialize">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>before_initialize</Name>
                <Script><![CDATA[alFC = thisComponent.getFunction();
alName = alFC.getParam("assemblyLine");
tcb = alFC.getTCB();
tcb.setTaskName(flowKey + "_LDAPSync_" + alName);

passGlobalVariablesViaTCB(tcb);

FCOpEntry = task.getOpEntry();
if (FCOpEntry != null) {
	tcb.setOperationInitParams(FCOpEntry);
}]]></Script>
                <Enabled>true</Enabled>
            </Hook>
            <Hook name="default_fail">
