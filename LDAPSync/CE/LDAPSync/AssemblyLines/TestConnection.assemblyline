        <ContainerEF name="EntryFeedContainer"/>
        <ContainerDF name="DataFlowContainer">
            <ModTime>1427192050157</ModTime>
            <Script name="debug test">
                <ModTime>1378286720093</ModTime>
                <parameter name="enabled">false</parameter>
                <parameter name="script"><![CDATA[choose = "CSVFile"

opEntry = task.getOpEntry()

function addPropToOpEntry(p, prefix) {
	if (typeof(prefix) == "undefined") {
		prefix = ""
	} else {
		if (!prefix.endsWith(".")) {
			prefix += "."
		}
	}
	opEntry[prefix + p.@name.getValue()] = p.getValue()
}

function handleEndpoint(c) {
	if (!c.@name.getValue().toLowerCase().startsWith("source_")) {
		return
	}
	
	var params = c.Configuration.getElementsByTagName("parameter")
	var inheritFrom = c.InheritFrom.getValue()
	var p = inheritFrom.lastIndexOf("/")
	inheritFrom = inheritFrom.substring(p+1)
	
	opEntry.removeAllAttributes()
	
	opEntry["endpoint.name"] = c.@name.getValue()
	opEntry["source.form"] = inheritFrom

	for (p in params) {
		addPropToOpEntry(p)
	}

	if (c.Parser != null && c.Parser.InheritFrom != null) {
		opEntry["source.parser.name"] = c.Parser.InheritFrom.getValue()
		params = c.Parser.getElementsByTagName("parameter")
		for (p in params) {
			addPropToOpEntry(p, "source.parser.parameter.")
		}
	}

//	task.dumpEntry(opEntry)
}	


file = system.openFileForInput("configs/SE_Test.xml")
xml = new java.lang.StringBuffer()

do {
	line = file.readLine()
	if (line != null) {
		xml.append(line + "\n")
	}	
} while (line != null)

xmlEntry = work.fromXML(xml.toString(), "*", "")

form = xmlEntry.getNodeList('//*[@name="source.form"]')

ctrs = xmlEntry.getNodeList('//Folder[@name="Connectors"]/Connector')

foundIt = null
for (c in ctrs) {
	handleEndpoint(c)
	
	try {
		jsonEntry = testConnection()
		jsonEntry.operation = "initialize,select"
		json = jsonEntry.toJSON()
		task.logmsg(json)
	} catch (ex) {
		task.logmsg("ERROR", "Problem with Connection: " + ex)
	}	
	
}]]></parameter>
            </Script>
            <Script name="Test the connection and return result">
                <ModTime>1427192050157</ModTime>
                <parameter name="script"><![CDATA[//
// posting application/json data causes parsers to escape dotted property names
//
var ope = task.getOpEntry();
var names = ope.getAttributeNames();
for(i = 0; i < names.length; i++) {
	var f = names[i];
	var ff = f.replaceAll("\\\\", ""); // source\.ldap -> source.ldap
	if(!ff.equals(f)) {
		ope.setAttribute(ff, ope.getAttribute(f));
		ope.removeAttribute(f);
	}
}

testId = ope.getString("testId");

task.logmsg("Test connection: " + testId);
java.lang.System.out.println("Test connection: " + testId);

if ("SE_DefaultFDS.Source_IDaaS_AD".equalsIgnoreCase(testId)) {
	flow = "Flow_User2TDS"; // also tested in utils loadProperties()
	getAllFlowParameters(ope, flow);	
	initUtils(flow);
}
jsonEntry = testConnection()
var json = jsonEntry.toJSON();
work.result = json;

sendCustomNotification("fds.testconnection",
						task.getOpEntry().getString("testId"), 
						json);]]></parameter>
            </Script>
        </ContainerDF>
