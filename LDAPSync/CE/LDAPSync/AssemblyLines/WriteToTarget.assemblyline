                                        <Script><![CDATA[e = system.newEntry();
e.setOperation(conn.getOperation());
e.setAttribute("members", conn.getAttribute(targetGroupMemberAttribute));

//if (typeof mem !== "undefined" && mem !== null) {
	logmsg("ERROR", "\n-----\nconn." + targetGroupMemberAttribute + ":"
			+ e.toDeltaString() + "\n-----")
