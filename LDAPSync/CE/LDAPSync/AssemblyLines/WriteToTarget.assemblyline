                <Component name="do timing - translate dn_2" state="Enabled"/>
                <Component name="ConstructContainerDN" state="Enabled"/>
                <Component name="do timing - checking scope_2" state="Enabled"/>
                <Component name="checkForEntryOutOfScope_2" state="Enabled"/>
                <Component name="NOT skip this container" state="Enabled"/>
                <Component name="Delete Container" state="Enabled"/>
                <Component name="DeleteContainer" state="Simulated"/>
                <Component name="Add Modify Container" state="Enabled"/>
                <Component name="AddModifyContainer" state="Simulated"/>
                <Component name="End time" state="Enabled"/>
                <Component name="Set change return value" state="Enabled"/>
            </SimulationStates>
            <ProxySettings/>
        </SimulationConfig>
        <LogConfig/>
        <ContainerEF name="EntryFeedContainer"/>
        <ContainerDF name="DataFlowContainer">
            <ModTime>1475819884598</ModTime>
            <Script name="doTiming - WriteToTarget has control">
                <ModTime>1389098588250</ModTime>
                <parameter name="script">if (doTiming) timing("writetotarget - prepare for filtering")</parameter>
            </Script>
            <Script name="checkForDN">
                <InheritFrom>/Scripts/checkForDN</InheritFrom>
                <ModTime>1362565953078</ModTime>
            </Script>
            <Script name="Initialize result to Skipped">
                <InheritFrom>/Scripts/initializeResultToSkipped</InheritFrom>
                <ModTime>1387276936765</ModTime>
            </Script>
            <Script name="Start time">
                <ModTime>1360238091640</ModTime>
                <parameter name="script">start = new java.util.Date().getTime()</parameter>
            </Script>
            <Script name="Prepare for filtering">
                <InheritFrom>/Scripts/prepareForFiltering</InheritFrom>
                <ModTime>1387276964687</ModTime>
            </Script>
            <Branch name="Process This Entry">
                <ModTime>1475819884598</ModTime>
                <Script name="Initialize result to Failed">
                    <ModTime>1431811643719</ModTime>
                    <parameter name="script"><![CDATA[work["$writeStatus"] = "failed";
work.removeAttribute("$error");
work.removeAttribute("$errorLogged");]]></parameter>
                </Script>
                <Script name="Initialize Cycle">
                    <ModTime>1430133475547</ModTime>
                    <parameter name="script"><![CDATA[if (doTiming) timing("writetotarget - init cycle")

// if this is the first cycle, prepare the cloned source LDAP Connector
// and set up some variables
//
if((typeof(firstTime) == "undefined")){
	firstTime = false;
	
	if (simulate)
		logmsg("*** " + resource.getString("LDAPSYNC.SIMULATED.RUN.NO.DATA.WILL.BE.MODIFIED") + " ***")

	if(!preserveContainers){
		msg = resource.getString("LDAPSYNC.PROPERTY.IS.NOT.SET")
		if (targetSuffixForUsers == null) {
			logmsg("FATAL", msg + ": target.suffixForUsers")
			throw where() + " - " + msg + ": target.suffixForUsers"
		}	
		if (targetSuffixForGroups == null) {
			logmsg("FATAL", msg + "target.suffixForGroups")
			throw where() + " - " + msg + "target.suffixForGroups"
		}	
	}	
	if (progressReport > 0 && !changeDetection) {
		logmsg("* " + resource.getString("LDAPSYNC.COUNT.FOR.PROGRESS.DISPLAY") + ": " + progressReport)
	}
}

// Set boolean flag to false
foundInTarget = false;

// Try to figure out entry type based on RDN
//
useSuffix = targetRootSuffix;
oc = work.getAttribute("objectClass")
typeOfEntry = entryType(oc)
cn = work.getString("cn");

if (cloudSync) {
	useRDN = sourceRDNAtt
	readRDN = useRDN
}
else 
if ("person".equals(typeOfEntry)) {
	useRDN = targetUserRDN
	readRDN = sourceUserRDN
}
else
if ("group".equals(typeOfEntry)) {
	useRDN = "cn"
	readRDN = useRDN
}
else 
if ("unknown".equals(typeOfEntry)){
	useRDN = "???"
	readRDN = useRDN
}
else {	
	// if type is unknown then this caught below, else it's a container so use the source RDN
	useRDN = sourceRDNAtt
	readRDN = useRDN
}

if (readRDN.equalsIgnoreCase(sourceRDNAtt)) {
	rdnValue = sourceRDNValue
	encodeRDN = false // already encoded
} else {
	rdnValue = getRDN(work, readRDN);
}	

//
// If source is AD then deleted entries are tombstones and are missing needed attributes
//    Also, the source rdn may have changed, and that could affect the target
//    Or the entry could have been moved in the AD DIT (moddn)
//    So, except for 'add' changes we always have to look up AD entries in the target based on objectGUID
//	  as the sourceGUID.
//
// For Domino the sourceGUID will be the UNID Attribute.
//
// For non-AD sources, changes to rdn or parent container require a lookup in the Target using the old dn
//
// For 'add' and 'modify' from non-AD changelog, there may not be all needed attributes in work
//    Needed attributes are for example: targetUserRDN and objectClass
//    Then we have to look up the entry in the source
//
// In general, for non-delete changes, we look up the entry in the target system
//
sourceEntry = null
if (targetLDAP != null && 
	("unknown".equals(typeOfEntry) || 
	 cn == null ||
	 rdnValue == null || 
	 newSuperior != null ||
	 newrdn != null ||
	 "delete".equals(deltaOperationTag) ||
	 (filterOnGroups || filterOnAttributes)) ) {
	if (changeDetection)	{
		// If entry coming from AD use sourceGUID to locate the entry in the target
		if (sourceGUID !== null && sourceGUID.length > 0) {
			if (targetEntry != null) {
				// the entry already read from the target in 'Prepare for filtering' Script
				sourceEntry = targetEntry
			} else {
				sc = system.newSearchCriteria()
				sc.addCriteria(auxLinkedGUIDAttribute, sc.EXACT, sourceGUID);
				targetLDAP.setParam("ldapReturnAttributes", auxLinkedDNAttribute +"\n" + auxLinkedGUIDAttribute + "\nsn\ncn\nobjectClass\n"+containerRDNs+targetUserRDN);
				try {
					sourceEntry = targetLDAP.findEntry(sc);
				} catch (ex) {
					sourceEntry = null
				}

				if (deBug) logmsg("-@@-->> target lookup for AD entry using " + auxLinkedGUIDAttribute + " = " + sourceGUID +
								(sourceEntry == null ? " - failed" : " - success"))
			}	
				
			foundInTarget = (sourceEntry !== null);

			if (sourceEntry != null && newrdn == null) {
				targetLDAPDN = sourceEntry.getString("$dn")
				if (rdnValue == null) {
					rdnValue = getRDN(sourceEntry, readRDN);
				}	
				
				if ("modify".equals(deltaOperationTag)) {
					previousDN = sourceEntry.getString(auxLinkedDNAttribute)
					// check for change to dn, and if so then set up newrdn and newSuperior variables
					if (!previousDN.toLowerCase().equals(sourceDN.toLowerCase())) { 
						try {
							ldapName = new javax.naming.ldap.LdapName(sourceDN)
						} catch (ex) {
							throw where() + " - " + resource.getString("LDAPSYNC.ERROR.PARSING.SOURCE.DN.TO.HANDLE.MODDN") + ": " + ex + " - dn: " + sourceDN
						}	
						rdns = ldapName.getRdns()
						newrdn = rdns.get(rdns.size()-1).toString()
						ldapName.remove(rdns.size()-1)
						newSuperior = ldapName.toString()
						logmsg("----->> " + resource.getString("LDAPSYNC.DETECTED.RENAME") + " newSuperior: " + newSuperior + "   newrdn: " + newrdn)
					}
				}	
			}	
		} 
	} 
	
	// if type is still unknown, try looking the entry up in the target using the adDn
	if ("unknown".equals(typeOfEntry) ||
		((filterOnGroups || filterOnAttributes) && !foundInTarget)) {

		// in case this is a modrdn or moddn, we have to look for the new DN in the source
		lookupDN = sourceDN
		sc = system.newSearchCriteria();
		
		if (targetIsTDS) {
			sc.addCriteria(auxLinkedDNAttribute, sc.EXACT, lookupDN.toLowerCase());
		} else {
			sourceAtt = work.getString("targetDn");
			if (sourceAtt !== null) {
				sourceAtt = cleanDN(sourceAtt).toLowerCase();
				work[auxLinkedDNAttribute] = sourceAtt;			
			} else {
				sourceAtt = work.getString("$dn").toLowerCase();
			}
			
			sc.addCriteria(targetLinkAttribute, sc.EXACT, sourceAtt);
		}	

		if (sc.getCriteria().size() > 0) {

			targetLDAP.setParam("ldapReturnAttributes", auxLinkedDNAttribute + "\n" + auxLinkedGUIDAttribute + "\nsn\ncn\nobjectClass\n"+containerRDNs+targetUserRDN);
			try {
/*				
				java.lang.System.out.println("--> W2T/Initialize Cycle - "
						+ " $dn: " + work.getString("$dn")
						+ " tdn: " + work.getString("targetDn")
						+ " adDn: " + work.getString(auxLinkedDNAttribute));

				java.lang.System.out.println("--> W2T/Initialize Cycle - lookup on delete for "
					+ sc.getCriteria()[0].name 
					+ " eq " 
					+ sc.getCriteria()[0].value);
*/
				sourceEntry = targetLDAP.findEntry(sc);
				if (sourceEntry == null) {
					if (targetLDAP.getFindEntryCount() > 1) {
						logmsg("WARN", "--> " +
									resource.getString("LDAPSYNC.MULTIPLE.ENTRIES.WERE.FOUND.IN.THE.TARGET") 
									+ "  " + auxLinkedDNAttribute
									+ " = " + lookupDN.toLowerCase())
						dupEntry = targetLDAP.getFirstFindEntry()
						do {
							logmsg("WARN", "      --> " + resource.getString("LDAPSYNC.DUPLICATE.ENTRY") + ": "
										+ dupEntry.getString("$dn"))
							dupEntry = targetLDAP.getNextFindEntry()
						} while (dupEntry != null)
						
						if (targetLDAP.getMaxDuplicateEntries() > targetLDAP.getFindEntryCount()) {
							logmsg("WARN", "..." + resource.getString("LDAPSYNC.MORE.ENTRIES.EXIST"))
						}
					}
				} else { // sourceEntry != null
					// handled further down when sourceEntry !== null
				}	
			} catch (ex) {
				sourceEntry = null
			}

			foundInTarget = (sourceEntry !== null);

			if (deBug) logmsg("-@@-->> target lookup for renamed/moved entry using " + auxLinkedDNAttribute + " = " + lookupDN +
					(sourceEntry == null ? " - failed" : " - success")
					+ "\n" + sourceEntry)
		}	
	}
}

// if we have a sourceEntry then try to determine type
if (sourceEntry == null) {
	sourceEntry = work // otherwise we only have the source data passed in
//	sourceEntry = system.newEntry();
} else {
	work[auxLinkedDNAttribute] = sourceEntry.getString(auxLinkedDNAttribute);
	work[auxLinkedGUIDAttribute] = sourceEntry.getString(auxLinkedGUIDAttribute);
	work.objectClass = sourceEntry.getString("objectClass");
	targetLDAPDN = sourceEntry.getString("$dn")
	if (rdnValue == null && !"???".equals(readRDN)) {
		rdnValue = getRDN(sourceEntry, readRDN);
	}
}

oc = work.objectClass;
typeOfEntry = entryType(oc);

// If identification fails, then skip this entry with an error message
//
if ("unknown".equals(typeOfEntry)) {
	logmsg("WARN",resource.getString("LDAPSYNC.UNABLE.TO.IDENTIFY.TYPE.OF.ENTRY") + ":\n" + jsonStr(work))
	addToStats(flowKey, "warn","warn");
	addToStats(flowKey, "unknown","skipped");
	system.skipEntry()
}
else
if (cloudSync) {
	useRDN = sourceRDNAtt
	readRDN = useRDN
} 
else
if ("person".equals(typeOfEntry)) {
	useRDN = targetUserRDN
	readRDN = sourceUserRDN
}
else
if ("group".equals(typeOfEntry)) {
	useRDN = "cn"
	readRDN = useRDN
}
else {	
	// if type is unknown then this caught below, else it's a container so use the source RDN
	useRDN = sourceRDNAtt
	readRDN = useRDN
}

if (rdnValue == null && readRDN.equalsIgnoreCase(sourceRDNAtt)) {
	rdnValue = sourceRDNValue
	encodeRDN = false // already encoded
}	

// Try to get tmhe RDN value - necessary for DN translation
if (rdnValue == null) {
	rdnValue = getRDN(sourceEntry, readRDN);
}	
	
if (rdnValue == null) {
	if ("person".equals(typeOfEntry)) {
		logmsg("ERROR",resource.getString("LDAPSYNC.CANNOT.FIND.RDN.ATTRIBUTE") + " (" + targetUserRDN + ") -> " + typeOfEntry + " entry: " + work.getString("$dn"))
		addToStats(flowKey, "error","error");
		addToStats(flowKey, typeOfEntry, "error")
		addToStats(flowKey, typeOfEntry, "skipped")
		system.exitFlow()
	} else {
		rdnValue = sourceRDNValue; // TODO should it be a call to getRDN()?
		encodeRDN = false // already encoded
	}	
}	

if (encodeRDN) {
	rdnValue = javax.naming.ldap.Rdn.escapeValue(cleanRDN(rdnValue))
}

work[readRDN] = rdnValue;
if (cn == null) {
	work["cn"] = sourceEntry["cn"];
}

// Increment the entry count and display message
callCount++;

if(changeDetection){
	logmsg("INFO","-> " + resource.getString("LDAPSYNC.PROCESSING") + " " + ((newrdn != null) ? "rename " : deltaOperationTag)
			+ " - " + typeOfEntry
			+ ((chglogMsg.length == 0) ? "" : " - " + chglogMsg)
		   	+ " - target dn: " + sourceDN);
} else {
	if((progressReport > 0) && (callCount % progressReport ) == 0){
		logmsg("INFO", resource.getString("LDAPSYNC.PROCESSING") + " " + typeOfEntry + " - " 
				+ resource.getString("LDAPSYNC.CURRENT.COUNT")+ ":" + callCount);
	}	
}

// Add to stats over entries processed
//
addToStats(flowKey,"total","processed")
if(typeOfEntry == "person" || typeOfEntry == "group"){
	addToStats(flowKey, typeOfEntry,"processed");
	opEntry["$typeOfEntry"] = typeOfEntry;
	work["$typeOfEntry"] = typeOfEntry;
} else{
	addToStats(flowKey, "container","processed");
	opEntry["$typeOfEntry"] = "container";
	work["$typeOfEntry"] = "container";
}

// the adDn may have been set during a target lookup above. If not, set it.
if (work[auxLinkedDNAttribute] === null) {
	work[auxLinkedDNAttribute] = cleanDN(work.getString("$dn").toLowerCase());
}	
work[auxLinkedGUIDSourceAttribute] = sourceGUID;

opEntry.setAttribute("$entry", prepareFindEntry(work, useRDN, rdnValue));

if (debugging) java.lang.System.out.println("W2T Init - op.type: " + opEntry.getString("$typeOfEntry") + " - " + opEntry.getString("$sourceDN"));]]></parameter>
                </Script>
                <Branch name="Entry is User">
                    <ModTime>1444728703634</ModTime>
                    <Script name="do timing - translate dn">
                        <ModTime>1383052566784</ModTime>
                        <parameter name="script">if (doTiming) timing("writetotarget - translating dn")</parameter>
                    </Script>
                    <ALMap name="ConstructDN">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <ModTime>1402045500656</ModTime>
                        <AttributeMap name="Input">
                            <InheritFrom>[no inheritance]</InheritFrom>
                            <AttributeMapItem>
                                <Name>$targetLDAPDN</Name>
                                <Type>advanced</Type>
                                <Script><![CDATA[if (targetLDAPDN !== null)
	return targetLDAPDN;
else
	return translateDN(sourceDN, useRDN, rdnValue, targetSuffixForUsers);]]></Script>
                            </AttributeMapItem>
                            <AttributeMapItem>
                                <Name>$translatedDN</Name>
                                <Type>advanced</Type>
                                <Script>return translateDN(sourceDN, useRDN, rdnValue, targetSuffixForUsers, newSuperior, newrdn);</Script>
                            </AttributeMapItem>
                        </AttributeMap>
                        <State>Enabled</State>
                    </ALMap>
                    <Script name="do timing - checking scope">
                        <ModTime>1383052572158</ModTime>
                        <parameter name="script">if (doTiming) timing("writetotarget - checking scope")</parameter>
                    </Script>
                    <Script name="checkForEntryOutOfScope">
                        <InheritFrom>/Scripts/checkForEntryOutOfScope</InheritFrom>
                        <ModTime>1360164680187</ModTime>
                    </Script>
                    <Branch name="NOT skip this person">
                        <ModTime>1444728703634</ModTime>
                        <Branch name="Delete User">
                            <ModTime>1428999796939</ModTime>
                            <Connector name="DeleteUser">
                                <InheritFrom>/Connectors/TargetSystem</InheritFrom>
                                <ModTime>1428999796939</ModTime>
                                <ConnectorMode>Delete</ConnectorMode>
                                <ConnectorState>Enabled</ConnectorState>
                                <Configuration>
                                    <UserComment><![CDATA[
]]></UserComment>
                                    <InheritFrom>[parent]</InheritFrom>
                                </Configuration>
                                <Parser>
                                    <InheritFrom>[parent]</InheritFrom>
                                </Parser>
                                <AttributeMap name="Input">
                                    <InheritFrom>[parent]</InheritFrom>
