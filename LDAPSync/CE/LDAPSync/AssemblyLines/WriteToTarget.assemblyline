            <Script name="End time">
                <ModTime>1383052690388</ModTime>
                <parameter name="script"><![CDATA[if (deBug) {
	end = new java.util.Date().getTime()
	logmsg("--@-->>> entry process time (msecs): " + (end-start))
}

if (doTiming) timing("writetotarget - after write")]]></parameter>
            </Script>
            <Script name="Set change return value">
                <ModTime>1473243182694</ModTime>
                <parameter name="script"><![CDATA[if (typeof(change) == "undefined") {
	change = false
}

if (work["$change"] !== null) {
	change = "true".equalsIgnoreCase(work.getString("$change"))
}

work["$change"] = change

//@@ TODO might want instead to check if $error is a String message, in
// which case, set error.status = 'failed' and .message = $error.
retError = work.getObject("$error");
if (retError != null) {
	if (!(retError instanceof com.ibm.di.entry.Entry && retError.getString("status") != "ok")) {
//		throw retError.toString();
		return;
	}
}
	
op = work.getString("$operation");
work["$operation"] = op;

writeStatus = work.getString("$writeStatus");
if (!"success".equalsIgnoreCase(writeStatus)) {
	op = "skipped";
} else
if (!change) {
	op = "unchanged";
} else 
if (!simulate && simEntry != null){
	simEntry["adDn"] = sourceDN;
	
	if (simEntry != null) {
		audit.log(flowKey,
					simEntry, 
					work.getString("$dn"), 
					work.getString("$targetLDAPDN"), 
					useRDN);
	}	
}

if(typeOfEntry == "person" || typeOfEntry == "group"){
	work["$typeOfEntry"] = typeOfEntry;
} else{
	work["$typeOfEntry"] = "container";
}

work.setAttribute("$simEntry", simEntry);]]></parameter>
            </Script>
