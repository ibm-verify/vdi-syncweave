                                        <Script><![CDATA[groupAtt = work.getAttribute("TargetUniqueMember");
if (groupAtt.size() == 0) {
	groupAtt.setOperation("replace");
	groupAtt.addValue(dummyMember);
	groupAtt.setValueOperation(0, "add");
}

conn.setAttribute(targetGroupMemberAttribute, work.TargetUniqueMember);

if(work.TargetUniqueMember.size() == 0 && targetIsLDAP){
	logmsg("WARN",resource.getString("LDAPSYNC.SKIPPING.ENTRY.BECAUSE.MEMBER.ATTRIBUTE.IS.EMPTY") + "  DN: " + work["$targetLDAPDN"]);
	addToStats(flowKey, "warn","warn");
	addToStats(flowKey, "group", "skipped", changeDetection)
	system.exitFlow();
}

added = true // skip the Add to stats script further down

addLinkedAttributes(work, conn, useRDN, rdnValue, changeDetType)

if (auditEnabled || simulate) {
	simEntry = system.newEntry();
	simEntry.merge(conn);
	if (simulate) {
		simEntry = simplifyAttributes(simEntry);
	}	
}

if (deBug) logmsg("-@@@->> conn before add: " + jsonStr(conn))

work["$operation"] = "add"
work["$conn"] = conn;
if (doTiming) timing("writetotarget - adding")]]></Script>
