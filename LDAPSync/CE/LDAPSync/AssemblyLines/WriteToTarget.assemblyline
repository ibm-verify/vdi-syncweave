                        <Branch name="Add Modify Group">
                            <ModTime>1475819884598</ModTime>
                            <Script name="Translate group members">
                                <ModTime>1449487564817</ModTime>
                                <parameter name="script"><![CDATA[targetMembers = system.newAttribute(targetGroupMemberAttribute);
sourceMemberAttributeDeleted = false;

if (simulate) {
	work.setAttribute("TargetUniqueMember", targetMembers);
	return;
}

// look for either 'member' or 'uniqueMember' attribute
sourceMemberAtt = "uniqueMember";
source = work.getAttribute(sourceMemberAtt);
if(source === null){
	sourceMemberAtt = "member";
	source = work.getAttribute(sourceMemberAtt);	
	if (source === null){
		source = system.newAttribute("member")
	}
}

sourceMemberAttributeDeleted = "delete".equals(source.getOperation());

if (!targetIsLDAP) {
	work.setAttribute("TargetUniqueMember", source);
	return;
}
	
targetMembers.setOperation(source.getOperation());

if (targetLDAP == null) {
	for (i = source.size(); i--;) {
		thisMember = source.getValue(i);
		if (thisMember !== null && thisMember.trim().length > 0) {
			targetMembers.addValue(source.getValue(i));
			valOp = source.getValueOperation(i);
			if (valOp == null || valOp.trim().length == 0) {
				valOp = "add"
			}
			targetMembers.setValueOperation(i, valOp);
		}	
	}	
} else {	
	badMembers = "";
	targetLDAP.setParam("ldapReturnAttributes",targetUserRDN+"\nsn\ncn\nobjectClass\n" + auxLinkedGUIDAttribute + "\n" + auxLinkedDNAttribute);
	for(i=0; i < source.size(); i++){
		thisMember = source.getValue(i).toLowerCase();
		memberDN = null;
		if (thisMember.trim().length == 0) {
			continue;
		}
		
		oldDN = cleanDN(thisMember);

		sc = system.newSearchCriteria();
		sc.addCriteria(auxLinkedDNAttribute,sc.EXACT,oldDN)
		try {
			mem = targetLDAP.findEntry(sc);
		} catch (ex) {
			mem = null
		}

		if (mem !== null) {
			memberDN = mem.getString("$dn");
		} else
		if (mem === null
			&& targetLDAP.getFindEntryCount() == 0 
			&& (result = checkScope(thisMember, sourceLDAP, changeDetType)).inScope) {
			mem = result.entryRead;
			if (mem != null) {

				memberType = result.typeOfEntry;
				
				if ("person".equals(memberType)) {
					memuseRDN = targetUserRDN;
					memreadRDN = sourceUserRDN;
					memsuffix = targetSuffixForUsers;
				}
				else
				if ("group".equals(memberType)) {
					memuseRDN = "cn"
					memreadRDN = useRDN
					memsuffix = targetSuffixForGroups;
				}
				else {
					// skip this entry
					if (deBug) logmsg("ERROR", "Could not identify member type: " + thisMember);
					continue;
				}
				
				try {
					memrdnValue = mem.getString(memreadRDN);
					if (memrdnValue === null) {
						if (deBug) logmsg("ERROR", "Error no RDN attribute for member: " + thisMember + " (" + memreadRDN + ")");
					} else {	
						memrdnValue = javax.naming.ldap.Rdn.escapeValue(cleanRDN(memrdnValue));
					}	
				} catch (ex) {
					if (deBug) logmsg("ERROR", "Error cleaning member RDN: " + thisMember + "   rdnValue: " + memrdnValue + " (" + memreadRDN + ")");
					memrdnValue = null;
				}	
				
				if (memrdnValue !== null) {
					try {
						memberDN = translateDN(oldDN, memuseRDN, memrdnValue, memsuffix, null, null);
					} catch (ex) {
						// could not identify this member
						if (deBug) logmsg("ERROR", "--&&--> Error translating member dn: " + oldDN);
						mem = null;
						memberDN = null;
					}	
					
				}
				
			}
		}	
			
		if(mem === null){
			if (targetLDAP.getFindEntryCount() > 1) {
				badMembers += "--> " +
							resource.getString("LDAPSYNC.SKIPPING.MEMBER.BECAUSE.MULTIPLE.ENTRIES.WERE.FOUND.IN.THE.TARGET") 
							+  auxLinkedDNAttribute + " = " + oldDN + "\n"
				mem = targetLDAP.getFirstFindEntry()
				do {
					badMembers += "      " + resource.getString("LDAPSYNC.DUPLICATE.ENTRY") + ": "
								+ mem.getString("$dn") + "\n"
					mem = targetLDAP.getNextFindEntry()
				} while (mem != null)
				
				if (targetLDAP.getMaxDuplicateEntries() > targetLDAP.getFindEntryCount()) {
					badMembers += "      ..." + resource.getString("LDAPSYNC.MORE.ENTRIES.EXIST") + "\n"
				}
			} else {	
				badMembers += "--> " +
							resource.getString("LDAPSYNC.SKIPPING.MEMBER.BECAUSE.NO.ENTRY.WAS.FOUND.IN.THE.TARGET") 
							+ auxLinkedDNAttribute + " = " + oldDN + "\n"
			}
			
			addToStats(flowKey, "warn","warn")
			continue;
		}
		
		if (memberDN !== null && memberDN.trim().length > 0) {
			targetMembers.addValue(memberDN);
			if (sourceMemberAttributeDeleted) {
				valOp = "delete";
			} else {
				valOp = source.getValueOperation(i);
				if (valOp == null || valOp.trim().length == 0) {
					valOp = "add";
				}
			}	
			targetMembers.setValueOperation(targetMembers.size()-1, valOp);
		}	
	}
	
	if (badMembers.length != 0) {
		logmsg("WARN",resource.getString("LDAPSYNC.THE.FOLLOWING.MEMBERS.WERE.NOT.ADDED.FROM.SOURCE.GROUP") 
					+ ": "+work.getString("$dn")+"\n"+badMembers);
	
		addToStats(flowKey, "missing","missing")	
		// if old file found, rename to GroupMembersLost<timestamp of file>.log
		
		logFile = openOutputFile(logFileFullname);
		logFile.newLine();
		logFile.write(system.formatDate(new java.util.Date(), "yyyy-MM-dd HH:mm:ss") 
						+ "  *** " + resource.getString("LDAPSYNC.CANNOT.FIND.THESE.MEMBERS.OF.THE.GROUP") + " "
						+ work.getString("$dn"));
		logFile.newLine();
		parts = system.splitString(badMembers,"\n")
		for (p in parts) {
			logFile.write(p);
			logFile.newLine();
		}	
		logFile.close();
	}	
}

if (sourceMemberAttributeDeleted) {
	if (!targetMembers.hasValue(dummyMember)) {
		targetMembers.addValue(dummyMember);
		targetMembers.setValueOperation(targetMembers.size()-1, "add");
	}	
}

work.setAttribute("targetUniqueMember", targetMembers);]]></parameter>
