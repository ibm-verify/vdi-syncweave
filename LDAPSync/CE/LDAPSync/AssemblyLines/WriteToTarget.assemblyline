                                        <Script><![CDATA[change = false;

// in case of group member modify (add/delete), do not read in the member attribute
// since this is handled by the script 'modify Group Members' later
groupAtt = work.getAttribute("TargetUniqueMember")
if (targetIsLDAP && targetLDAP !== null &&
	deltaOperationTag == "modify" && 
	groupAtt != null &&
	groupAtt.getOperation() == "modify") {
	thisConnector.connector.setParam("ldapReturnAttributes", groupReturnAttributes)
} else {
