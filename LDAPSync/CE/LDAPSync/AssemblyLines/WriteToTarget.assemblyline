                                        <Name>before_add</Name>
                                        <Script><![CDATA[addLinkedAttributes(work, conn, useRDN, rdnValue, changeDetType, newrdn, newSuperior, "person")

if ("true".equals(getProperty("password.enabled"))) {
	mappedPwd = conn.getObject("userPassword");
	pwd = generatePassword();
	conn.userPassword = pwd;
} else
if (conn.userPassword != null && conn.getString("userPassword") == null) {
	conn.removeAttribute("userPassword");
}

//java.lang.System.out.println("--> writing pwd: " + conn.getString("userPassword"));

if (auditEnabled || simulate) {
	simEntry = system.newEntry();
	simEntry.merge(conn);
	if (simulate) {
		simEntry = simplifyAttributes(simEntry);
	}	
}

if (deBug) logmsg("-@@@->> conn before add: " + jsonStr(conn))

work["$operation"] = "add";
work["$conn"] = conn;
if (doTiming) timing("writetotarget - adding")]]></Script>
