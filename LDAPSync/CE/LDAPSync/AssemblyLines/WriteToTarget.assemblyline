                            <Branch name="Group Members Modified">
                                <ModTime>1475819884598</ModTime>
                                <Script name="modify Group Members">
                                    <ModTime>1475819884598</ModTime>
                                    <parameter name="script"><![CDATA[members = work.getAttribute("targetUniqueMember");
targetLDAPDN = work.getString("$targetLDAPDN");

if (doTiming) timing("writetotarget - modifying group members")

membersAdded = 0;
for(i = 0; i<members.size(); i++){
	thisMember = members.getValue(i);
	try {
		if(members.getValueOperation(i) == "add"
			|| members.getValueOperation(i) == "unchanged"){
			if(!targetLDAP.compare(targetLDAPDN, targetGroupMemberAttribute, thisMember)){
				if (deBug) logmsg("--&&--> Adding member (" + thisMember + ") from group " + targetLDAPDN);
				targetLDAP.addAttributeValue(targetLDAPDN, targetGroupMemberAttribute, thisMember);
				if (!dummyMember.equalsIgnoreCase(thisMember)) {
					membersAdded++;
				}	
				change = true;
			}
		} 
	} catch (ex) {
		if (deBug) logmsg("ERROR", "Error adding member from " + targetGroupMemberAttribute + " - " + ex);
	}	

	try {
		if(members.getValueOperation(i) == "delete"){
			if(targetLDAP.compare(targetLDAPDN, targetGroupMemberAttribute, thisMember)){
				if (deBug) logmsg("--&&--> Removing member (" + thisMember + ") from group " + targetLDAPDN);
				targetLDAP.removeAttributeValue(targetLDAPDN, targetGroupMemberAttribute, thisMember);
				change = true;
			}
		}
	} catch (ex) {
		if (String(ex).indexOf("error code 65") < 0) {
			if (deBug) logmsg("ERROR", "Error removing member from " + targetGroupMemberAttribute + " - " + ex);
		} else { // last member has been removed from the LDAP group
			if(!targetLDAP.compare(targetLDAPDN, targetGroupMemberAttribute, dummyMember)) {
				if (deBug) logmsg("--&&--> Adding dummy member (" + dummyMember + ") from group " + targetLDAPDN);
				targetLDAP.addAttributeValue(targetLDAPDN, targetGroupMemberAttribute, dummyMember);
				// Redo removal of last member
				targetLDAP.removeAttributeValue(targetLDAPDN, targetGroupMemberAttribute, thisMember);
				membersAdded = 0;
				change = true;
			}
		}	
	}	
}

if (membersAdded > 0) {
	if(targetLDAP.compare(targetLDAPDN, targetGroupMemberAttribute, dummyMember)) {
		if (deBug) logmsg("--&&--> Removing dummy member (" + dummyMember + ") from group " + targetLDAPDN);
		targetLDAP.removeAttributeValue(targetLDAPDN, targetGroupMemberAttribute, dummyMember);
		change = true;
	}
}

if (simulate) {
	simEntry.setAttribute(members)
}]]></parameter>
