                                        <Script><![CDATA[addLinkedAttributes(work, conn, useRDN, rdnValue, changeDetType, newrdn, newSuperior)

if (auditEnabled || simulate) {
	simEntry = system.newEntry();
	simEntry.merge(conn);
	if (simulate) {
		simEntry = simplifyAttributes(simEntry);
	}	
}

if (targetIsLDAP) {
	conn.removeAttribute(useRDN); // do not write for modify operation
	conn.removeAttribute("objectClass")
}	

change = true;
added = false;

// for group member updates via changelog or delta detection, no member attribute need be written 
// for this step. It will be handled in the 'modify Group Member' script below
groupAtt = work.getAttribute("TargetUniqueMember");
if (targetIsLDAP && targetLDAP !== null) {
	conn.removeAttribute(targetGroupMemberAttribute);
} else 
if (work.TargetUniqueMember != null && work.TargetUniqueMember.size() > 0){
	conn.setAttribute(targetGroupMemberAttribute, work.getAttribute("TargetUniqueMember"));
}

if (deBug) logmsg("-@@@->> conn before modify: " + jsonStr(conn))

work["$operation"] = "modify"
work["$conn"] = conn;
if (doTiming) timing("writetotarget - modifying")]]></Script>
