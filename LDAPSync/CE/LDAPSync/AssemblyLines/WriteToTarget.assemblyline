                <Component name="FixDN" state="Enabled"/>
                <Component name="do timing - checking scope_1" state="Enabled"/>
                <Component name="checkForEntryOutOfScope_1" state="Enabled"/>
                <Component name="NOT skip this group" state="Enabled"/>
