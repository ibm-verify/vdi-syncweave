                                        <Script><![CDATA[addLinkedAttributes(work, conn, useRDN, rdnValue, changeDetType, newrdn, newSuperior);

if (auditEnabled || simulate) {
	simEntry = system.newEntry();
	simEntry.merge(conn);
	if (simulate) {
		simEntry = simplifyAttributes(simEntry);
	}	
}

if (targetIsLDAP) {
	conn.removeAttribute(useRDN); // do not write for modify operation
	conn.removeAttribute("objectClass");
}	

if (deBug) logmsg("-@@@->> conn before modify: " + jsonStr(conn))

work["$operation"] = "modify";
work["$conn"] = conn;
if (doTiming) timing("writetotarget - modifying")]]></Script>
