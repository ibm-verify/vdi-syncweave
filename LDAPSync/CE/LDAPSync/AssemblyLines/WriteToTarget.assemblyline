            <Hook name="prolog0">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>prolog0</Name>
                <Script><![CDATA[initUtils();

callCount = 0;

// get group attributes for map file in order to limit lookups to not include member attribute
try {
	groupReturnAttributes = "";
	mapFile = getProperty("target.group.mapFile", configDirectory + "/group.map")
	if (mapFile === null || mapFile.length == 0)
		mapFile = "group.map"
	if (mapFile.indexOf("/") < 0 && mapFile.indexOf("\\") < 0)
		mapFile = configDirectory + "/" + mapFile
	file = system.openFileForInput(mapFile);
	do{
		line = file.readLine();
		if(line != null && line.indexOf("=")>0){
			parts = system.splitString(line,"=");
			pos = parts[0].indexOf("{");
			if(pos > 0){
				parts[0] = parts[0].substring(0,pos);
			}
			if(parts[0].toLowerCase().indexOf("member") > 0){
				continue;
			}
			groupReturnAttributes += parts[0]+"\n";
		}
	}while(line != null)
	file.close();
} catch (ex) {
	throw where() + " " + resource.getString("LDAPSYNC.ERROR.READING.GROUP.MAP.FILE") + " (" + mapFile + "): " + ex
}	
groupReturnAttributes += "\ncn\nobjectClass\n" + auxLinkedGUIDSourceAttribute + "\n"

// get group attributes for map file in order to limit lookups to not include member attribute
try {
	personReturnAttributes = "";
	mapFile = getProperty("target.person.mapFile", "person.map")
	if (mapFile === null || mapFile.length == 0)
		mapFile = "person.map"
	if (mapFile.indexOf("/") < 0 && mapFile.indexOf("\\") < 0)
		mapFile = configDirectory + "/" + mapFile
	file = system.openFileForInput(mapFile);
	do{
		line = file.readLine();
		if(line != null && line.indexOf("=")>0){
			parts = system.splitString(line,"=");
			pos = parts[0].indexOf("{");
			if(pos > 0){
				parts[0] = parts[0].substring(0,pos);
			}
			personReturnAttributes += parts[0]+"\n";
		}
	}while(line != null)
	file.close();
	personReturnAttributes += "+\n"
								+ auxLinkedDNAttribute + "\n"
								+ auxLinkedGUIDAttribute + "\n"
								+ "ibm-ptaLinkAttribute\n"
								+ "ibm-ptaLinkValue\n";
} catch (ex) {
	throw where() + " " + resource.getString("LDAPSYNC.ERROR.READING.PERSON.MAP.FILE") + " (" + mapFile + "): " + ex
}	

// simulate by default
simulate = !"false".equalsIgnoreCase(getProperty("simulate"))

progressReport = 0

progressReportStr = main.commandLineParam("1")
if (progressReportStr !== null) {
	try {
		progressReport = system.toInt(progressReportStr)
	} catch (ex) {
		progressReport = 0
	}
}

if (progressReport == 0) {
	progressProp = getProperty("global.showProgressCount")
	if (progressProp !== null) {
		try {
			progressReport = system.toInt(progressProp)
		} catch (ex) {
			progressReport = 0
		}
	}	
}

if (targetRootSuffix !== null) {
	targetRootSuffix = cleanDN(targetRootSuffix, "target.ldap.searchBase property is not set");
}	
if (targetSuffixForUsers !== null) {
	targetSuffixForUsers = cleanDN(targetSuffixForUsers);
}	
if (targetSuffixForGroups !== null) {
	targetSuffixForGroups = cleanDN(targetSuffixForGroups);
}

targetRootSuffix = targetRootSuffix || "o=unspecifiedTargetSuffix";
targetSuffixForUsers = targetSuffixForUsers || "o=unspecifiedTargetSuffixForUsers"
targetSuffixForGroups = targetSuffixForGroups || "o=unspecifiedTargetSuffixForGroups"

// set dummyMember value, used to add Group entries to SDS with no members
dummyMember = "cn=dummyMemberFromFDS";

if (simulate) {
	logFilename = flowKey + "_GroupMembersMissing_simulate";
} else {
	logFilename = flowKey + "_GroupMembersMissing";
}	
logFileFullname = logFilepath + "/" + logFilename + ".log.temp"
try {
	file = openOutputFile(logFileFullname)
	logFiles.setAttribute(logFileFullname, file)
	file.close()
} catch (ex) {
	logmsg("ERROR","" + ex + " - " + resource.getString("LDAPSYNC.ERROR.CREATING.MISSING.MEMBERS.FILE") 
					+ ": " + logFileFullname)
}


ptaAttributes = ["ibm-ptalinkattribute", "ibm-ptalinkvalue"]

targetLDAP = null;]]></Script>
                <Enabled>true</Enabled>
            </Hook>
        </Hooks>
        <CheckpointConfig/>
        <SandboxConfig/>
