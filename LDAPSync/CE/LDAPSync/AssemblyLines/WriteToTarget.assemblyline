                                    <Hook name="before_modify">
                                        <InheritFrom>[no inheritance]</InheritFrom>
                                        <Name>before_modify</Name>
                                        <Script><![CDATA[addLinkedAttributes(work, conn, useRDN, rdnValue, changeDetType, newrdn, newSuperior, "person")
/*
if ("true".equals(getProperty("target.pwmap.auto"))) {
	mappedPwd = conn.getObject("userPassword");
	pwd = generatePassword();
	work.userPassword = pwd;
}
*/

if (auditEnabled || simulate) {
	simEntry = system.newEntry();
	simEntry.merge(conn);
	if (simulate) {
		simEntry = simplifyAttributes(simEntry);
	}	
}

if (targetIsLDAP) {
	conn.removeAttribute(useRDN); // do not write for modify operation
	conn.removeAttribute("objectClass");
	if (current !== null && current.getObject("ibm-pwdAccountLocked") === null) {
		conn.removeAttribute("ibm-pwdAccountLocked");
	}
}

change = true;

if (deBug) logmsg("-@@@->> conn before modify: " + jsonStr(conn))
//if (deBug) logmsg("--@-->> current before mod: " + jsonStr(current))

work["$operation"] = "modify"
work["$conn"] = conn;
if (doTiming) timing("writetotarget - modifying")]]></Script>
                                        <Enabled>true</Enabled>
                                    </Hook>
                                    <Hook name="default_fail">
                                        <Name>default_fail</Name>
                                        <Enabled>true</Enabled>
                                    </Hook>
                                    <Hook name="default_ok">
                                        <InheritFrom>[no inheritance]</InheritFrom>
                                        <Name>default_ok</Name>
                                        <Script><![CDATA[if (work["$writeStatus"] == null) {
	work["$writeStatus"] = "success";
}	

if (!passwordCaching || !isSync || !targetIsLDAP) {
	return;
}

// password cache reset if change detected
userPassword = work.getAttribute("$userPassword");
if (userPassword !== null) {
	pwdOp = userPassword.getOperation();
	if (deBug) { logmsg("--!!--> WriteToTarget (PwdCache) - (" + pwdOp + ") " + userPassword) }
	if (!"unchanged".equalsIgnoreCase(pwdOp)) {
		if (deBug) logmsg("--!!--> WriteToTarget (PwdCache) - resetting password for " + work.getString("$targetLDAPDN"))
		try {
			targetLDAP.removeAllAttributeValues(work.getString("$targetLDAPDN"), "userPassword");
			change = true;
		} catch (ex) {
			if (deBug) logmsg("--!!--> Exception: " + ex);
			if (ex.toString().toLowerCase().indexOf("nosuchattribute") < 0) {
				throw "AddModifyUser (PwdCache/Reset) - " + ex;
			}
		}	
	}
}]]></Script>
