            <Script name="Detect password change">
                <ModTime>1409572101811</ModTime>
                <parameter name="script"><![CDATA[if (!passwordCaching) {
	return;
}

userPassword = work.getObject("userPassword");
if (userPassword !== null) {
	work.setAttribute("$userPassword", "reset " + new java.util.Date());
	work["$userPassword"].setOperation(work.userPassword.getOperation());
}]]></parameter>
