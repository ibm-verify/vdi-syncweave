                <parameter name="com.ibm.di.log.level">INFO</parameter>
                <parameter name="enabled">true</parameter>
            </Logger>
        </LogConfig>
        <ContainerEF name="EntryFeedContainer"/>
        <ContainerDF name="DataFlowContainer">
            <Script name="display">
                <ModTime>1398355701149</ModTime>
                <parameter name="script"><![CDATA[msg = "\n-------> Hook name: " + hookName + "\n"

msg += "  >  hostname: " + getProperty("hostname") + "\n";
msg += "  >      port: " + getProperty("port") + "\n";
msg += "  >  severity: " + getProperty("severity") + "\n";
msg += "  >  facility: " + getProperty("facility") + "\n";
msg += "  > date mask: " + getProperty("dateMask") + "\n";

if (deBug) logmsg(msg);
java.lang.System.out.println(msg);]]></parameter>
            </Script>
