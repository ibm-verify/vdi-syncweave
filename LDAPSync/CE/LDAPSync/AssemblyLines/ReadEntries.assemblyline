                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="default_fail">
                        <Name>default_fail</Name>
                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="end_of_data">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>end_of_data</Name>
                        <Script>initialized = false</Script>
                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="override_getnext">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>override_getnext</Name>
                        <Script><![CDATA[if (typeof(initialized) == "undefined" || !initialized) {
	// must initialize this connector
	initialized = true
	
	//
	// This Connector uses properties to set up the CI, and if necessary Parser.
	//
	var ctrName
	var parserName
	var ctr = null
	var parser = null
	var useRDN = "CN"
	var typeOfEntry = "*unknown*"
	var userObjectClass = "person"
	var groupObjectClass = "group"
	var useObjectClass = userObjectClass
	
	userObjectClass = getProperty("source.userObjectClass","person")
	groupObjectClass = getProperty("group.userObjectClass","group")
	
	readRDN = getProperty("source.userRDN")
	typeOfEntry = opEntry.getString("$typeOfEntry")
	if ("person".equals(typeOfEntry)) {
		useObjectClass = userObjectClass
		useRDN = getProperty("source.userRDN")
	} else
	if ("group".equals(typeOfEntry)) {
		useObjectClass = groupObjectClass
		useRDN = "CN"
	} else
	if ("container".equals(typeOfEntry)) {
		useObjectClass = "organizationalUnit"
		useRDN = "OU"
	} else {
		typeOfEntry = "person"
		useObjectClass = userObjectClass
		useRDN = getProperty("source.userRDN")
		logmsg("WARN",resource.getString("LDAPSYNC.TYPE.OF.ENTRY.NOT.SET.DEFAULTING.TO.PERSON"))
	}

	ctr = configureConnector() // in Utils
}

try {
	var e = ctr.getNextEntry()
} catch (ex) {
	setException(ex, "fatal")
	e = null
}	

if (e == null) {
	result.setStatus(0);
	return;
}

//task.logmsg("\n\n\n------ Read entry:\n" + e.toString() + "\n\n\n.")

entry.removeAllAttributes()
entry.merge(e)

var rdn = entry[readRDN]
if (rdn == null) {
	throw where() + resource.getString("LDAPSYNC.NO.RDN.ATTRIBUTE.FOUND.IN.ENTRY.READ") + " - (" + readRDN + ")\n" + entry.toString()
}

if (entry.getString("$dn") == null) {
	entry["$dn"] = useRDN + "=" + entry.getString(readRDN);
}
if (entry.getString("objectClass") == null) {
	entry["objectClass"] = useObjectClass
}

entry["$dn"] = entry.getString("$dn") + ",ep=" + endpoint + ",flow=" + flowKey;

result.setStatus(1);

//system.ignoreEntry()

//task.logmsg("\n\n\n------ WORK:\n" + entry.toString() + "\n\n\n.")]]></Script>
                        <Enabled>true</Enabled>
                    </Hook>
                </Hooks>
