            <Hook name="prolog0">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>prolog0</Name>
                <Script><![CDATA[function getAttributeSyntaxes(schema, attr, syntaxEntry) {
	if(attr != null) {
		for(var i = 0; i < attr.size(); i++) {
			var name = attr.getValue(i);
			if(syntaxEntry[name] == null) {
				syntaxEntry[name] = getAttributeSyntax(schema, name);
			}	
		}
	}
}

function getAttributeSyntax(schema, attr) {
	var result=schema.lookup("AttributeDefinition/" + attr);
	var e = system.newEntry();
	if(result != null) {
		result = result.getAttributes("").getAll();
		while(result.hasMore()) {
			var av = result.next();
			for(i = 0; i < av.size(); i++) {
				e.addAttributeValue(av.getID(), av.get(i));
			}	
			if(av.getID() == "SYNTAX") {
				var str = SchemaLDAP.connector.mapAttributeSyntax(av.get(0));
				if(str != null)
					e.addAttributeValue("SyntaxString", str);
			}
		}
	}
	return e;
}]]></Script>
                <Enabled>true</Enabled>
            </Hook>
