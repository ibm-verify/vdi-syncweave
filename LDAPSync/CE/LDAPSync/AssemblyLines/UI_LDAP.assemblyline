                <Script name="QuerySchema">
                    <ModTime>1392717621222</ModTime>
                    <parameter name="script"><![CDATA[//
// -- Get schema dir context
//
SchemaLDAP.checkInitialize();
ctx = SchemaLDAP.connector.getLdapContext();
clsname = work.getString("objectclasses");
schema = ctx.getSchema("");

// -- clear work entry
work.removeAllAttributes();

// -- list all classes?
if(clsname == "*") {
	result=schema.lookup("classDefinition").list("");
	while(result && result.hasMore()) {
		obj = result.next();
		work.addAttributeValue("objectclasses", obj.getName());
	}
	
} else if(clsname != null) {
	var attrSyntax = system.newEntry();
	var classArray = [clsname];
	var useSup = true;
	if(clsname.indexOf(",") > 0) {
		classArray = clsname.split(",");
		useSup = false;
	}
	
	while(classArray.length > 0) {
		var nextClass = classArray.pop();
			
		result=schema.lookup("classDefinition/" + nextClass);
		if(result != null) {
			result = result.getAttributes("").getAll();
			var e = system.newEntry();
			while(result.hasMore()) {
				var attr = result.next();
				for(i = 0; i < attr.size(); i++)
					e.addAttributeValue(attr.getID(), attr.get(i));
				if(attr.getID() == "SUP" && useSup) {
					classArray.push(attr.get(0));
				}
			}
			getAttributeSyntaxes(schema, e.MAY, attrSyntax);
			getAttributeSyntaxes(schema, e.MUST, attrSyntax);
			work.setAttribute(e.getString("NAME"), e);
		}
	}
	work.setAttribute("__syntax__", attrSyntax)	
}]]></parameter>
                </Script>
                <Conditions>
                    <BranchCondition>
                        <LeftHand>objectclasses</LeftHand>
                        <Operator>hasValue</Operator>
                        <RightHand/>
                        <Negate>false</Negate>
                        <CaseSensitive>false</CaseSensitive>
                        <MatchAny>false</MatchAny>
                    </BranchCondition>
                </Conditions>
                <MatchAny>false</MatchAny>
                <Enabled>true</Enabled>
                <Type>1</Type>
            </Branch>
