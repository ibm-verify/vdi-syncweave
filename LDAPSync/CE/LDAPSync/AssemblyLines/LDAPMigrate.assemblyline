        </SimulationConfig>
        <LogConfig/>
        <ContainerEF name="EntryFeedContainer"/>
        <ContainerDF name="DataFlowContainer">
            <ModTime>1449487605603</ModTime>
            <Script name="determineFlows">
                <InheritFrom>/Scripts/determineFlows</InheritFrom>
                <ModTime>1355866327640</ModTime>
            </Script>
            <Script name="DEBUG save opEntry to properties">
                <ModTime>1449487605603</ModTime>
                <parameter name="enabled">false</parameter>
                <parameter name="script"><![CDATA[opEntry = task.getOpEntry()

if (opEntry.getString("global.flows") != null) {
	attnames = opEntry.getAttributeNames()
	try {
		file = openOutputFile(configDirectory + "/" + getProperty("global.flows") + "_LDAPSync.properties")
		
		for (att in attnames) {
			file.write(opEntry[att].getName() + "=" + opEntry[att].getValue())
			file.newLine()
		}
		
		file.close()
	} catch (ex) {
		// do nothing
		java.lang.System.out.println("DEBUG saving webUI props failed - " + ex)
	}	
}]]></parameter>
            </Script>
            <Script name="Launch Migration ALs">
                <ModTime>1408951356687</ModTime>
                <parameter name="script"><![CDATA[var al = new Array()
var alCnt = 0

for (cnt = 0; cnt < flows.length; cnt++) {
	flowKey = flows[cnt]
	
	ok = false
	for (i = 0; i < definedFlows.length && !ok; i++)
		if (definedFlows[i] == flowKey)
			ok = true;
	if (!ok) {
		logmsg("ERROR", resource.getString("LDAPSYNC.SKIPPING.UNDEFINED.FLOW.SPECIFIED") + ": " + flowKey)
		continue
	}
	
	initUtils(flowKey, true);

	vect = new java.util.Vector()
	
	tcb = system.newTCB()
	
	syncronize = false;
	passGlobalVariablesViaTCB(tcb);
	tcb.setOperationInitParams(opEntry)
	tcb.setTaskName(flowKey + "_LDAPMigrate")
	
	alName = "runDataFlow"
	
	vect.add(tcb)
	vect.add(task.getLog())
	try {
		al[alCnt] = main.startAL(alName, vect)
		alCnt++
	} catch (ex) {
		throw resource.getString("LDAPSYNC.ERROR.STARTING.MIGRATION.FOR.FLOW") + ": " + flowKey + " - " + ex
	}	
}]]></parameter>
            </Script>
            <Script name="waitForALsToComplete">
                <InheritFrom>/Scripts/waitForALsToComplete</InheritFrom>
                <ModTime>1372848491125</ModTime>
            </Script>
        </ContainerDF>
        <ThreadOptions/>
        <Operations/>
        <InitParams>
            <Schema name="AssemblyLineInitParams"/>
        </InitParams>
    </AssemblyLine>
</MetamergeConfig>