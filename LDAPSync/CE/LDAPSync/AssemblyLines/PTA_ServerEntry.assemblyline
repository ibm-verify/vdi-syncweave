<?xml version="1.0" encoding="UTF-8"?><MetamergeConfig Cycle="2" UUID="2c9d74e6-4c25-4c9a-9e92-029e7ab20e88" created="Mon Dec 30 13:03:45 CET 2013" createdBy="Administrator" main="PTA_ServerEntry" modified="Thu Jan 09 10:41:05 CET 2014" modifiedBy="Administrator" project="LDAPSync" version="7.1.1">
    <AssemblyLine name="PTA_ServerEntry">
        <ModTime>1389260463068</ModTime>
        <Settings>
            <parameter name="ALPoolSettingsDialog">showALPoolSettings</parameter>
            <parameter name="automapattributes">false</parameter>
            <parameter name="createTombstones">false</parameter>
            <parameter name="includeGlobalPrologs">true</parameter>
            <parameter name="nullBehaviorDialog">showNullBehavior</parameter>
        </Settings>
        <Hooks>
            <Hook name="prolog0">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>prolog0</Name>
                <Script><![CDATA[op = task.opEntry;

task.logmsg("")
task.logmsg("PTA Parameters")
task.logmsg("------------------------------------------------------------")
for(str in op.getAttributeNames()) {
	if(str == "ibm-slapdPtabindPW")
		task.logmsg(str + ": ************");
	else if(str.startsWith("ibm-"))
		task.logmsg(str + ": " + op.getString(str));
}

task.logmsg("")

var ldap = ["target.ldap.url", "target.ldap.user"];
task.logmsg("LDAP Connection Parameters (password not shown)")
task.logmsg("------------------------------------------------------------")
for(i = 0; i < ldap.length; i++) {
	str = ldap[i]
	task.logmsg(str + ": " + op.getString(str));
}
task.logmsg("")

// -- this function is used to construct the cn attribute
// -- it must be unique and valid. it is called from
// -- the "cn" and "$dn" maps for LDAPConnectorAdd
function constructCN() {
	var str = work.getString("ibm-slapdptasubtree");
	if(str != null) {
		str = str.replaceAll(",", "_");
		str = str.replaceAll("=", "_");
		str = str.replaceAll("-", "_");
		str = str.replaceAll("\\.", "_");
	}
	return str;	
}]]></Script>
                <Enabled>true</Enabled>
            </Hook>
        </Hooks>
        <CheckpointConfig/>
        <SandboxConfig/>
        <SimulationConfig>
