                <Script name="Initialize">
                    <ModTime>1458560758900</ModTime>
                    <parameter name="script"><![CDATA[//containers = new java.util.concurrent.ConcurrentHashMap()
containers = new java.util.HashMap()
sortedKeys = new java.util.ArrayList()

firstTime = false

try {
	searchBaseRDNS = new javax.naming.ldap.LdapName(sourceSearchBase).getRdns()
} catch (ex) {
	logmsg("ERROR", resource.getString("LDAPSYNC.ERROR.PARSING") + "source.searchBase: " + ex + " - dn: " + sourceSearchBase)
	system.ignoreEntry()
}]]></parameter>
                </Script>
                <Loop name="Container in source">
                    <ModTime>1459507508841</ModTime>
                    <LoopType>1</LoopType>
                    <Connector name="Container in source">
                        <InheritFrom>/Connectors/SourceLDAP</InheritFrom>
                        <ModTime>1459507508841</ModTime>
