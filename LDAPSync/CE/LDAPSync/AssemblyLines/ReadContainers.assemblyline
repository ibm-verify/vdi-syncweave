                            <InheritFrom>[parent]</InheritFrom>
                        </PoolDefinition>
                        <PoolInstance/>
                    </Connector>
                    <Branch name="Container in source">
                        <ModTime>1459507508841</ModTime>
                        <Script name="checkForDN">
                            <InheritFrom>[no inheritance]</InheritFrom>
                            <ModTime>1369294759187</ModTime>
                            <parameter name="script"><![CDATA[dn = work.getString("$dn")

if (dn === null) {
	logmsg("ERROR", where() + " - " + resource.getString("LDAPSYNC.NO.DN.ATTRIBUTE.FOUND.IN.ENTRY.SKIPPING"))
	addToStats(flowKey, "error", "error");
	system.continueLoop()	
}

work["$dn"] = cleanDN(dn)]]></parameter>
                        </Script>
                        <Script name="Accumulate container">
                            <ModTime>1382376241296</ModTime>
                            <parameter name="script"><![CDATA[dn = work.getString("$dn")

if (useDN(dn)) {
	// must reverse the order of RDNs in the entry DN in order to sort correctly
	try {
		ldapName = new javax.naming.ldap.LdapName(dn)
		rdns = ldapName.getRdns()
	} catch (ex) {
		logmsg("ERROR", resource.getString("LDAPSYNC.ERROR.PARSING.CONTAINER.DN") + ": " + ex + " - dn: " + dn)
		system.ignoreEntry()
	}
	
	for (j = rdns.size(); j--; ) {
		dnRdns = ldapName.getRdns()

		dn = ""
		for (k = 0; k < dnRdns.size(); k++) {
			if (dn.length > 0) {
				dn = dn + ","
			}
			dn = dn + dnRdns[k]
		}

		if (j >= searchBaseRDNS.size() && !containers.containsKey(dn)) {
			try {
				e = sourceLDAP.findEntry("$dn", ldapName.toString())
				containers.put(dn,e)
			} catch (ex) {
				// ignore @@TODO perhaps
			}	
		}	
		ldapName.remove(j)
	}
}]]></parameter>
                        </Script>
                        <Conditions/>
                        <MatchAny>false</MatchAny>
                        <Enabled>true</Enabled>
                        <Type>0</Type>
                    </Branch>
                </Loop>
                <Script name="Sort container dns by hierarchy">
                    <ModTime>1459507522752</ModTime>
                    <parameter name="enabled">true</parameter>
                    <parameter name="script"><![CDATA[keys = containers.keySet().toArray()
java.util.Arrays.sort(keys)
count = 0]]></parameter>
                </Script>
                <ScriptCondition>return typeof(firstTime) == "undefined"</ScriptCondition>
                <Conditions/>
                <MatchAny>false</MatchAny>
                <Enabled>true</Enabled>
                <Type>0</Type>
            </Branch>
            <Script name="Empty Work Entry">
                <ModTime>1367573917906</ModTime>
                <parameter name="script">work.removeAllAttributes()</parameter>
            </Script>
            <Branch name="More containers">
                <ModTime>1382377018312</ModTime>
                <Script name="debug output">
                    <ModTime>1382377018312</ModTime>
                    <parameter name="enabled">false</parameter>
                    <parameter name="script"><![CDATA[for (i = 0; i < keys.length; i++) {
	task.logmsg("#" + i + " - " + keys[i])
}]]></parameter>
                </Script>
                <Script name="Get next container">
                    <ModTime>1372761571515</ModTime>
                    <parameter name="script"><![CDATA[dn = keys[count]

e = containers.get(dn)

work.removeAllAttributes()
work.merge(e)

count++]]></parameter>
                </Script>
                <ScriptCondition>return count &lt; keys.length</ScriptCondition>
                <Conditions/>
                <MatchAny>false</MatchAny>
                <Enabled>true</Enabled>
                <Type>0</Type>
            </Branch>
