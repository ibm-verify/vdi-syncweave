                        <LinkCriteria/>
                        <Hooks>
                            <InheritFrom>[parent]</InheritFrom>
                            <ModTime>1459507508841</ModTime>
                            <Hook name="before_getnext">
                                <InheritFrom>[no inheritance]</InheritFrom>
                                <Name>before_getnext</Name>
                                <Script>work.removeAllAttributes()</Script>
                                <Enabled>true</Enabled>
                            </Hook>
                            <Hook name="before_initialize">
                                <InheritFrom>[no inheritance]</InheritFrom>
                                <ModTime>1459507508841</ModTime>
                                <Name>before_initialize</Name>
                                <Script><![CDATA[//Refer: Utils->prepareObjectClasses()

searchFilter = "(|";
iter = containerOC.keySet().iterator();
while (iter.hasNext()){
	key = iter.next();
	searchFilter += "(objectClass="+key+")";
}
/* should not be necessry anymore
if ("AD".equals(getProperty("source.changeDetectionType"))) {
	searchFilter += "(objectClass=container)"
}
*/
searchFilter += ")";
logmsg("> " + resource.getString("LDAPSYNC.MIGRATING.CONTAINER.ENTRIES.USING.SEARCH.FILTER") + ": "+searchFilter);
thisConnector.connector.setParam("ldapSearchFilter",searchFilter);

sourceLDAP = thisConnector.connector]]></Script>
                                <Enabled>true</Enabled>
                            </Hook>
                        </Hooks>
                        <CheckpointConfig/>
                        <SandboxConfig/>
                        <Reconnect>
                            <InheritFrom>[parent]</InheritFrom>
                            <ReconnectRules/>
