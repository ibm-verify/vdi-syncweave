<AssemblyLine name="monitorSNMP">
        <ModTime>1410176826085</ModTime>
        <Settings/>
        <Hooks>
            <ModTime>1395832417215</ModTime>
            <Hook name="prolog0">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>prolog0</Name>
                <Script><![CDATA[var flowKey = getProperty("global.flows");
var hookName = getProperty("$hookName");

function opEntryParams() {
	var e = task.getOpEntry();
	var s = java.lang.StringBuffer();
	var names = e.getAttributeNames();
	java.util.Arrays.sort(names);
	for (var n in names) {
		if (n.indexOf(flowKey) < 0) {
			s.append("opEntry:   " + e.getAttribute(n).toString() + "\n");
		}
	}
	
	return s.toString();
}

function tcbParams() {
	var e = task.getTCB();
	var s = java.lang.StringBuffer();
	var names = e.getAttributeNames();
	java.util.Arrays.sort(names);
	for (var n in names) {
		s.append("TCB:   " + e.getAttribute(n).toString() + "\n");
	}
	
	return s.toString();
}

function iwe() {
	var s = java.lang.StringBuffer();
	var e = work;
	var names = e.getAttributeNames();
	java.util.Arrays.sort(names);
	for (var n in names) {
		s.append("IWE:   " + e.getAttribute(n).toString() + "\n");
	}
	
	return s.toString();
}]]></Script>
                <Enabled>true</Enabled>
            </Hook>
        </Hooks>
