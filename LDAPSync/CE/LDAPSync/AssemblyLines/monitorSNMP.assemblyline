                <ModTime>1395832402317</ModTime>
                <parameter name="script"><![CDATA[msg = "\n-------> Hook name: " + hookName + "\n"
err = work.getObject("$error");
msg += "  >   trap port: " + getProperty("snmpTrapPort") + "\n";
msg += "  >   error msg: " + work.getString("$errorMessage") + "\n";
msg += "  > error level: " + work.getString("$level") + "\n";
msg += "  >   error loc: " + work.getString("$where") + "\n";
msg += "  > error entry:\n" + err + "\n";

task.logmsg(msg);
java.lang.System.out.println(msg);]]></parameter>
