                </LinkCriteria>
                <Hooks>
                    <InheritFrom>[parent]</InheritFrom>
                    <ModTime>1393944134631</ModTime>
                    <Hook name="after_initialize">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>after_initialize</Name>
                        <Script>originalReturnAttributes = thisConnector.connector.getParam("ldapReturnAttributes")</Script>
                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="before_execute">
                        <Name>before_execute</Name>
                        <Enabled>false</Enabled>
                    </Hook>
                    <Hook name="before_getnext">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>before_getnext</Name>
                        <Script><![CDATA[/*
if (typeof(rulesEngine) != "undefined" && rulesEngine != null) {
	rulesEngine.terminate()
}
*/]]></Script>
                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="before_initialize">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>before_initialize</Name>
                        <Script>ldap = thisConnector.connector</Script>
                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="default_fail">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>default_fail</Name>
                        <Script><![CDATA[// quick fix to deal with a bug/problem in the SDS Changelog Connector
// where some changelog entries do not have a changeType attribute
msg = error.getString("message")
if (msg.indexOf("CTGDIS969E") >= 0) {
	// swallow this error
	system.ignoreEntry()
}

notifyWritebackError(error)

var schedule = main.getScheduler("WriteBackMain KeepAlive");
if (schedule) {
	schedule.shutdown();
}
task.shutdown();

throw error.exception;]]></Script>
                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="initialize_fail">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>initialize_fail</Name>
                        <Script><![CDATA[notifyWritebackError(error)

system.sleep(sleepTime)

system.exitBranch("AssemblyLine")]]></Script>
                        <Enabled>true</Enabled>
                    </Hook>
                </Hooks>
                <CheckpointConfig/>
                <SandboxConfig/>
                <Reconnect>
                    <InheritFrom>[parent]</InheritFrom>
                    <ReconnectRules/>
                </Reconnect>
                <Operations/>
                <PoolDefinition>
                    <InheritFrom>[parent]</InheritFrom>
                </PoolDefinition>
                <PoolInstance/>
            </Connector>
        </ContainerEF>
        <ContainerDF name="DataFlowContainer">
            <ModTime>1430301934763</ModTime>
            <Script name="check if writeback has been disabled">
                <ModTime>1382099585921</ModTime>
                <parameter name="script"><![CDATA[CIs = session.getConfigInstances()
var writebackEnabled = false
for (CI in CIs) {
	if (CI.getConfigId().startsWith("SE_")) {
		if (!writebackEnabled) {
			writebackEnabled = main.getConnector(CI.getConfigId() + 
				":/Connectors/GeneralSettings").getConnectionConfig().getBooleanParameter("writeback.enabled", false)
			}	
		break
	}
}

if (!writebackEnabled) {
	system.sleep(sleepTime)
	task.logmsg("Exiting...")
	system.exitBranch("AssemblyLine")
}]]></parameter>
            </Script>
            <Branch name="modify">
                <ModTime>1430301934763</ModTime>
                <Script name="Retrieve additional attributes">
                    <ModTime>1430301934763</ModTime>
                    <parameter name="script"><![CDATA[ignoreChangesBySDI = !"false".equalsIgnoreCase(getProperty("writeback.ignoreChangesBySDI"));
targetDN = work.getString("targetdn");
operation = work.getOperation();

ldap.setParam("ldapReturnAttributes","modifiersName\n" 
				+ auxLinkedDNAttribute + "\n"
				+ auxLinkedGUIDAttribute + "\n");

try {
	entry = ldap.findEntry("$dn", targetDN);
	modifierOfCurrentEntry = entry.getString("modifiersName");
} catch (ex) {
	log("ERROR", resource.getString("LDAPSYNC.WRITEBACK.COULD.NOT.FIND.ENTRY.WITH.DN") 
				+ ": " + targetDN);
	system.exitFlow();
}

ldap.setParam("ldapReturnAttributes", originalReturnAttributes);

if (entry == null) {
	system.skipEntry() // @@TODO again, perhaps an error
}

work.merge(entry);]]></parameter>
                </Script>
                <Branch name="handling this entry modifier">
                    <ModTime>1386161318328</ModTime>
                    <Script name="Init cycle">
                        <ModTime>1386161318328</ModTime>
                        <parameter name="script"><![CDATA[jsonEntry.removeAllAttributes()
jsonEntry.adDn = work.getString(auxLinkedDNAttribute)
jsonEntry.sourceDn = work.getString(auxLinkedDNAttribute)
jsonEntry.sourceGUID = work.getString(auxLinkedGUIDAttribute)
jsonEntry.sdiUser = sdiUser
jsonEntry.modifiersName = entry.getString("modifiersName")
jsonEntry["changenumber"] = work.getString("changenumber")
jsonEntry["targetdn"] = targetDN
jsonEntry["operation"] = operation
jsonEntry.timestamp = new java.util.Date().getTime()
jsonEntry.enableDOM()

json = jsonEntry.toJSON()

sendCustomNotification("fds.writeback", "WritebackMain", json)]]></parameter>
                    </Script>
                    <Script name="Build RulesEngine">
                        <ModTime>1381219794421</ModTime>
                        <parameter name="script">refreshRulesEngine("writeback")</parameter>
                    </Script>
                    <Script name="Log">
                        <ModTime>1380200072109</ModTime>
                        <parameter name="script">logmsg("JSON: " + json)</parameter>
                    </Script>
                    <Script name="Apply Rules">
                        <ModTime>1378734574067</ModTime>
                        <parameter name="script">rulesEngine.runRules()</parameter>
                    </Script>
                    <ScriptCondition>return !ignoreChangesBySDI || !modifierOfCurrentEntry.equalsIgnoreCase(sdiUser)</ScriptCondition>
                    <Conditions/>
                    <MatchAny>false</MatchAny>
                    <Enabled>true</Enabled>
                    <Type>0</Type>
                </Branch>
                <ScriptCondition>return "modify".equals(work.getOperation())</ScriptCondition>
                <Conditions/>
                <MatchAny>false</MatchAny>
                <Enabled>true</Enabled>
                <Type>0</Type>
            </Branch>
        </ContainerDF>
