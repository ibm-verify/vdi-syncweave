        <LogConfig/>
        <ContainerEF name="EntryFeedContainer">
            <ModTime>1393944134631</ModTime>
            <Connector name="ChangeDetection_WriteBack">
                <InheritFrom>/Connectors/ChangeDetection_WriteBack</InheritFrom>
                <ModTime>1393944134631</ModTime>
                <ConnectorMode>Iterator</ConnectorMode>
                <ConnectorState>Enabled</ConnectorState>
                <Configuration>
