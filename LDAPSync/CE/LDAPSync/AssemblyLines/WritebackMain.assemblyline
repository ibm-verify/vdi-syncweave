<?xml version="1.0" encoding="UTF-8"?><MetamergeConfig Cycle="33" UUID="634c0285-ae07-40a5-ae60-ff1a94015da7" created="Mon Dec 30 13:03:45 CET 2013" createdBy="Administrator" main="WritebackMain" modified="Wed Apr 29 12:05:36 CEST 2015" modifiedBy="Administrator" project="LDAPSync" version="7.1.1">
    <AssemblyLine name="WritebackMain">
        <ModTime>1430301934763</ModTime>
        <Settings>
            <parameter name="ALPoolSettingsDialog">showALPoolSettings</parameter>
            <parameter name="automapattributes">false</parameter>
            <parameter name="createTombstones">false</parameter>
            <parameter name="includeGlobalPrologs">true</parameter>
            <parameter name="nullBehaviorDialog">showNullBehavior</parameter>
        </Settings>
        <Hooks>
            <ModTime>1402556638940</ModTime>
            <Hook name="epilog2">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>epilog2</Name>
                <Script><![CDATA[if (typeof(rulesEngine) != "undefined" && rulesEngine != null) {
	rulesEngine.terminate()
}]]></Script>
                <Enabled>true</Enabled>
            </Hook>
            <Hook name="onfailure">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>onfailure</Name>
                <Script><![CDATA[if (typeof(error) != "undefined") {
	exceptionStr = error.getString("exception")
	if (exceptionStr != null && exceptionStr.indexOf("ExitBranchException") < 0) {
		defaultErrorHandling("ERROR", false, true)
	
		notifyWritebackError(error)
		
		system.sleep(sleepTime)
	}
}

if (typeof(rulesEngine) != "undefined" && rulesEngine != null) {
	rulesEngine.terminate()
}]]></Script>
                <Enabled>true</Enabled>
            </Hook>
            <Hook name="prolog0">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>prolog0</Name>
                <Script><![CDATA[// find a Flow loaded on the Server in order to get SDS parameters
var opEntry = task.getOpEntry()

flowKey = "WB_WritebackMain"
responseLogFile = "WritebackHistory"
typeOfEntry = "person" // @@TODO only support Person entries

getAllFlowParameters(opEntry, flowKey);

initUtils(flowKey, true); // skip hooks init

var saveOpEntry = system.newEntry();
saveOpEntry.merge(opEntry);

sleepTime = 10 // used when Writeback is not enabled
var paramEntry = system.newEntry();

do {
	waitTimeParam = getProperty("writeback.timeout")
	try {
		waitTime = Math.max(10, system.toInt(waitTimeParam))
	} catch (ex) {
		waitTime = 30 // seconds before timeout for SDS changelog connector
	}
	
	numberOfPollsParam = getProperty("writeback.polls")
	try {
		numberOfPolls = Math.max(2, system.toInt(numberOfPollsParam))
	} catch (ex) {
		numberOfPolls = Math.round(waitTime / 5) // number of 5 second polls in the timeout
	}

	if (numberOfPolls < 1) {
		numberOfPolls = 1 // to avoid div by zero
	}
	
	pollTime = Math.floor(waitTime / (numberOfPolls*0.95))
	if (pollTime < 2) {
		pollTime = 2
	}
	
//	opEntry.removeAllAttributes()
	paramEntry.removeAllAttributes();
	
	var CIs = session.getConfigInstances()
	var CI
	
	for (CI in CIs) {
		if (CI.getConfigId().startsWith("SE_")) {
			var ALnames = CI.getAssemblyLineNames()
			for (var ALname in ALnames) {
				if (ALname.startsWith("Flow_")) {
					var paramEntry = getFlowParameters(CI.getConfigId(), ALname, null, null);
					if (paramEntry != null) {
						break
					}
				}
			}
		}
	}
	
	if (paramEntry.size() == 0) {
		CIs = session.listAllConfigurations()
		for (var CIname in CIs) {
			if (CIname.startsWith("SE_")) {
				CI = session.getConfigInstance(CIname)
				if (CI == null) {
					try {
						CI = session.startConfigInstance("configs/" + CIname + ".xml", true, null, CIname, null)
						if (CI != null) {
							var ALnames = CI.getAssemblyLineNames()
							for (var ALname in ALnames) {
								if (ALname.startsWith("Flow_")) {
									var paramEntry = getFlowParameters(CI.getConfigId(), ALname, null, null)
									if (paramEntry != null) {
										break
									}
								}
							}
						}
					} catch (ex) {
						errorMsg = resource.getString("LDAPSYNC.ERROR.LOADING.CI") + ": " + CIname + " - " + ex
						logmsg("ERROR", errorMsg)
					}	
				}	
			}
		}
	}
	
	if (paramEntry.size() == 0 || CI == null) {
		system.sleep(sleepTime)
		continue
	}
	
	CIs = session.getConfigInstances()
	var writebackEnabled = false
	for (CI in CIs) {
		if (CI.getConfigId().startsWith("SE_")) {
			if (!writebackEnabled) {
				writebackEnabled = main.getConnector(CI.getConfigId() + 
					":/Connectors/GeneralSettings").getConnectionConfig().getBooleanParameter("writeback.enabled", false)
				}	
			break
		}
	}
	
	if (!writebackEnabled) {
//		var schedule = main.getScheduler("WriteBackMain KeepAlive");
		var schedule = task.getScheduler();
		if (schedule) {
			schedule.shutdown();
		}
		task.shutdown();
		return;
	}
	
	sdiUser = getProperty("target.ldap.user")
	
	// check to make sure SDS is correctly configured and has changelog enabled
	if (writebackEnabled) {
		opEntry.testId = "SE_DefaultFDS.GeneralSettings"
		opEntry["source.form"] = "Form_LDAP"
		opEntry["read.count"] = 0
		opEntry["read.start"] = 0
		opEntry["source.ldap.url"] = getProperty("target.ldap.url")
		opEntry["source.ldap.user"] = getProperty("target.ldap.user")
		opEntry["source.ldap.password"] = getProperty("target.ldap.password")
		opEntry["source.ldap.searchbase"] = getProperty("target.ldap.searchbase")
		result = testConnection()
		
		writebackEnabled = "success".equals(result.status)
	}
	
	if (!writebackEnabled) {
		system.sleep(sleepTime)
	}
} while (!writebackEnabled);

opEntry.removeAllAttributes();
opEntry.merge(saveOpEntry);

jsonEntry = system.newEntry()]]></Script>
                <Enabled>true</Enabled>
            </Hook>
        </Hooks>
        <CheckpointConfig/>
        <SandboxConfig/>
        <SimulationConfig>
            <SimulationStates>
                <Component name="check if writeback has been disabled" state="Enabled"/>
                <Component name="modify" state="Enabled"/>
                <Component name="Retrieve additional attributes" state="Enabled"/>
                <Component name="handling this entry modifier" state="Enabled"/>
