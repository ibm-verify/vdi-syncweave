                <ModTime>1409223238259</ModTime>
            </Script>
            <Script name="Detect password change">
                <ModTime>1409571647992</ModTime>
                <parameter name="script"><![CDATA[if (!passwordCaching) {
	return;
}

pwdLastSet = work.pwdLastSet;
pwdLastSetOp = "unchanged";

if (pwdLastSet !== null) {
	pwdLastSetOp = pwdLastSet.getOperation();
}

if (!"unchanged".equals(pwdLastSetOp)
	/*|| "add".equals(pwdLastSetOp)*/
	) {
	if (deBug) logmsg("INFO","--!!--> ReadADChange (PwdCache) - detected pwd change.");
	work["$userPassword"] = "reset " + pwdLastSet;
}]]></parameter>
            </Script>
            <Script name="Add sourceLDAP">
                <ModTime>1409059076333</ModTime>
                <parameter name="script">work.setAttribute("$sourceLDAP", SourceLDAP.connector);</parameter>
            </Script>
