            <Branch name="deleted entry">
                <ModTime>1409648052597</ModTime>
                <Script name="rebuild old dn">
                    <ModTime>1409648052597</ModTime>
                    <parameter name="script"><![CDATA[lastParent = work.getString("lastKnownParent")

if (lastParent === null) {
	logmsg("WARN",resource.getString("LDAPSYNC.CANNOT.HANDLE.DELETE.OF.ENTRY.LASTKNOWNPARENT.NOT.FOUND") + " ObjectGUIDStr: "
			+ work.getString("objectGUIDStr"));
	addToStats(flowKey, "warn", "warn");
	system.skipEntry();
}

olddn = work.getString("$dn");
p = olddn.search(/[\x00-\x1F\x7F]/);
if (p < 0) {
	p = olddn.indexOf("\\0")
}
if (p > 0) {	
	oldrdn = olddn.substring(0,p);
} else {
	logmsg("WARN","<SRCH> " + resource.getString("LDAPSYNC.CANNOT.HANDLE.DELETE.OF.ENTRY.LASTKNOWNPARENT.NOT.FOUND") + " ObjectGUIDStr: "
			+ work.getString("objectGUIDStr"));
	addToStats(flowKey, "warn", "warn");
	system.skipEntry();
}
	
dn = oldrdn + "," + lastParent.toLowerCase()

//logmsg("Rebuilt dn: " + dn)

work["$dn"] = dn

try {
	ldapName = new javax.naming.ldap.LdapName(dn)
} catch (ex) {
	throw where() + " - " + resource.getString("LDAPSYNC.ERROR.PARSING.AD.CHANGE.DN") + ": " + ex + " - dn: " + dn
}	
rdns = ldapName.getRdns()
rdn = rdns.get(rdns.size()-1).getValue().trim()

work["cn"] = rdn]]></parameter>
                </Script>
                <ScriptCondition>return "delete".equals(work.getOperation())</ScriptCondition>
                <Conditions/>
                <MatchAny>false</MatchAny>
                <Enabled>true</Enabled>
                <Type>0</Type>
            </Branch>
