                    <parameter name="attributeList">pwdLastSet, member</parameter>
                    <parameter name="changeDetectionMode">DETECT_ATTRIBUTES</parameter>
                    <parameter name="debug">false</parameter>
                    <parameter name="deltaDB"><![CDATA[@SUBSTITUTE{javascript if (typeof(task) == "undefined") return "DEFAULT";
opEntry = task.getOpEntry();
return opEntry.getString("$deltaStore");}]]></parameter>
                    <parameter name="rowLocking">REPEATABLE_READ</parameter>
                    <parameter name="uniqueAttribute">objectGUIDStr</parameter>
                </Configuration>
