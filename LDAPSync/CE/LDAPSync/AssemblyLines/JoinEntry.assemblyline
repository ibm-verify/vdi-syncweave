                    <Hook name="override_getnext">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <ModTime>1395920763826</ModTime>
                        <Name>override_getnext</Name>
                        <Script><![CDATA[function prepareLinkCriteria(entry) {
	var scriptFilter = getProperty("join.search.filter")
	var attrName = getProperty("join.search.attribute")
	var operatorStr = getProperty("join.search.operator")
	var valStr = getProperty("join.search.value")
	var negateStr = getProperty("join.search.negate")
	var unaryStr = getProperty("join.search.combine")
	var searchCrit
	
	if (scriptFilter != null) {
		if (scriptFilter.toLowerCase().indexOf("ret.filter") < 0) {
			scriptFilter = "ret.filter=" + scriptFilter
		}
		
		if (deBug) logmsg("--@@@-> Join LinkCriteria (scripted): " + scriptFilter)
		
//		searchCrit = new com.ibm.di.server.SearchCriteria(scriptFilter, task.getScriptEngine())
		searchCrit = new com.ibm.di.server.SearchCriteria(scriptFilter, new com.ibm.di.script.ScriptEngine(null, main))
		searchCrit.buildCriteriaScript(entry);
	} else {
		searchCrit = new com.ibm.di.server.SearchCriteria(unaryValue(unaryStr));
		
		if (entry[valStr] !== null) {
			valStr = "$" + valStr;
		}
		
		searchCrit.addTemplate(attrName, operationValue(operatorStr), valStr)
		
		searchCrit.buildCriteria(entry)
		
		searchCrit.getCriteria(0).negate = negateValue(negateStr)
		
		if (deBug) logmsg("--@@@-> Join LinkCriteria: "
							+ (searchCrit.getCriteria(0).negate ? "NOT " : " ")
							+ searchCrit.getCriteria(0).name + " "
							+ searchCrit.getCriteria(0).match + " "
							+ searchCrit.getCriteria(0).value)
	}
	
	return searchCrit
}

function unaryValue(unaryStr) {
	if (unaryStr == null)
		unaryStr = "and"
	else
		unaryStr = unaryString.toLowerCase().trim()
		
	if (unaryStr == "and" || unaryStr == "&&" || unaryStr == "&" || unaryStr == "true" || unaryStr == "yes")
		return com.ibm.di.server.SearchCriteria.SEARCH_AND
	else
		return com.ibm.di.server.SearchCriteria.SEARCH_OR
}

function negateValue(negateStr) {
	if (negateStr == null)
		negateStr = ""
	else
		negateStr = negateStr.toLowerCase().trim()
		
	if (negateStr == "not" || negateStr == "!" || negateStr == "true" || negateStr == "yes")
		return true
	else
		return false
}

function operationValue(opStr) {
  if (opStr == null)
  	return com.ibm.di.server.SearchCriteria.EXACT
  	
  switch (opStr.toLowerCase()) {
  		case "equals" : 
  		case "equal" : 
  		case "=" :
  		case "==" : return com.ibm.di.server.SearchCriteria.EXACT
  		case "less than" : 
  		case "lessthan" :
  		case "lt" : 
  		case "<" : return com.ibm.di.server.SearchCriteria.LESS_THAN
  		case "less than or equal" :
  		case "lessthanorequal" :
  		case "le" : 
  		case "<=" :
  		case "=<" : return com.ibm.di.server.SearchCriteria.LESS_THAN_OR_EQUAL
  		case "greater than" : 
  		case "greaterthan" :
  		case "gt" :
  		case ">" : return com.ibm.di.server.SearchCriteria.GREATER_THAN
  		case "greater than or equal" :
  		case "greaterthanorequal" :
  		case "ge" :
  		case ">=" :
  		case "=<" : return com.ibm.di.server.SearchCriteria.GREATER_THAN_OR_EQUAL
  		case "contain" :
  		case "contains" : return com.ibm.di.server.SearchCriteria.SUBSTRING
  		case "^" :
  		case "sw" :
  		case "starts" :
  		case "startswith" :
  		case "starts with" : return com.ibm.di.server.SearchCriteria.INITIAL_STRING
  		case "$" :
  		case "ew" :
  		case "endswith" :
  		case "ends with" :
  		case "endwith" :
  		case "end with" :  return com.ibm.di.server.SearchCriteria.FINAL_STRING
  		case "not equals" : 
  		case "not equal" : 
  		case "ne" :
  		case "!=" :
  		case "=!" :
  		case "=!=" : return com.ibm.di.server.SearchCriteria.NOT_STRING
  		default : return com.ibm.di.server.SearchCriteria.EXACT 
  	}	
}

function setParameters(obj, type) {
	var searchStr = "join." + type + ".parameter."
	var searchStrLen = searchStr.length
	params = opEntry.getAttributeNames()
	java.util.Arrays.sort(params)
	
	for (var param in params) {
		var p = param.indexOf(searchStr)
		if (p >= 0) {
			var pval = getProperty(param)
			var pname = param.substring(p + searchStrLen)
			if (pval != null) {
				obj.setParam(pname, pval)
			}	
		}
	}
}

if (typeof(initialized) == "undefined" || !initialized) {
	// must initialize this connector
	initialized = true

	//
	// This Connector uses properties to set up the CI, and if necessary Parser.
	//
	var ctrName
	var parserName
	var ctr = null
	var parser = null
	var useRDN = "CN"
	var typeOfEntry = "*unknown*"
	
	typeOfEntry = alTCB.getString("$typeOfEntry")

	ctrName = getProperty("join.connector.name")
	ctr = system.getConnector(ctrName)
	if (ctr == null) {
		errormsg = resource.getString("LDAPSYNC.CONNECTOR.NOT.FOUND") + ": " + ctrName
		throw errormsg
	}
	
	setParameters(ctr,"connector")

	try {
		ctr.terminate()
	} catch (ex) {
		// do nothing
	}
		
	try {
		ctr.initialize(null)
	} catch (ex) {
		setException(ex, "fatal")
		throw resource.getString("LDAPSYNC.ERROR.INITIALIZING.JOIN.CONNECTOR") + ": " + ex
	}	
}

var entry = null
try {
	passedEntry = work;
	searchCrit = prepareLinkCriteria(passedEntry)

	work.removeAllAttributes();

	entry = ctr.findEntry(searchCrit)
} catch (ex) {
//	setException(ex, "fatal")
	errorMsg = resource.getString("LDAPSYNC.ERROR.JOINING.DATA") + ": " + ex
	logmsg(typeOfError, errorMsg)

	addToStats(flowKey, typeOfError, typeOfError)
	if (typeof(typeOfEntry) != "undefined") {
		addToStats(flowKey, typeOfEntry, typeOfError)
	}

	error.exception = ex
	error.message = errorMsg
	error.status = "failed"
	
	throw errorMsg
}	

if (entry != null) {
	work["$skipEntry"] = false;
	
 	var e = thisConnector.mapEntry(work, entry);
 	work.merge(e);
} else {
	if (ctr.getFindEntryCount() > 0) {
		errorMsg = resource.getString("LDAPSYNC.MULTIPLE.MATCHES.FOUND.BY.JOIN")
	} else {
		errorMsg = resource.getString("LDAPSYNC.NO.MATCH.FOUND.BY.JOIN")
	}

 	if (ifJoinFails.startsWith("skip")) {
		logmsg("WARN", errorMsg)
		work["$skipEntry"] = true
		addToStats(flowKey, "warn", "warn")
		if (typeof(typeOfEntry) != "undefined") {
			addToStats(flowKey, typeOfEntry, "warn")
		}
/*		
		addToStats(flowKey, "skipping", "skipping")
		if (typeof(typeOfEntry) != "undefined") {
			addToStats(flowKey, typeOfEntry, "skipping")
		}
 * 
 */
	}
	
	if (ifJoinFails.startsWith("abort")) {
		work["$skipEntry"] = true
		throw errorMsg
	}
}

if (error.exception != null) {
	work["$error"] = error
}	

if (deBug && entry != null) logmsg("---@@-> Joining entry: " + jsonStr(work))]]></Script>
                        <Enabled>true</Enabled>
