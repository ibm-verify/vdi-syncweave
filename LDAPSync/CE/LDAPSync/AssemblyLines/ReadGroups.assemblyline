                    <Hook name="after_getnext">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>after_getnext</Name>
                        <Script><![CDATA[groupIndex++;
if (groupIndex < syncGroupsList.length) {
	ldapCtr.setParam("ldapSearchBase", syncGroupsList[groupIndex]);
	ldapCtr.terminate();
	ldapCtr.initialize(null);
	ldapCtr.selectEntries();
}]]></Script>
