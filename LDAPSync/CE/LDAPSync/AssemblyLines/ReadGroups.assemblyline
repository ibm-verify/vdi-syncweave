                    <Hook name="before_initialize">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>before_initialize</Name>
                        <Script><![CDATA[ldapCtr = thisConnector.connector;
//input = thisConnector.connector

//Refer: Utils->prepareObjectClasses()
searchFilter = "(objectClass="+getProperty("source.groupObjectClass")+")";

if (cloudSync) {
	searchFilter = "(|" + searchFilter + "(objectClass=group)(objectClass=groupOfNames))";
}

logmsg("> " + resource.getString("LDAPSYNC.MIGRATING.GROUP.ENTRIES.USING.SEARCH.FILTER") + ": "+searchFilter);
ldapCtr.setParam("ldapSearchFilter",searchFilter);

var groupIndex = 0;
if (syncGroupsListEnabled) {
	ldapCtr.setParam("ldapSearchBase", syncGroupsList[groupIndex]);
}]]></Script>
