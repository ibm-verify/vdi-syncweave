                    <Hook name="after_initialize">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>after_initialize</Name>
                        <Script><![CDATA[var serverInfo = ldap.getServerInfo();
var lastChangeState = serverInfo.getString("highestCommittedUSN");
if (lastChangeState === null) {
	lastChangeState = serverInfo.getString("lastchangenumber");
	// try to add one to the last changenumber -> the next change
	try {
		lastChangenumber = system.toInt(lastChangeState);
		lastChangenumber++;
		lastChangeState = String(lastChangenumber);
	} catch (ex) {
		// do nothing		
	}
}]]></Script>
                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="before_execute">
                        <Name>before_execute</Name>
                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="before_getnext">
                        <Name>before_getnext</Name>
                        <Enabled>true</Enabled>
                    </Hook>
                    <Hook name="before_initialize">
                        <InheritFrom>[no inheritance]</InheritFrom>
                        <Name>before_initialize</Name>
                        <Script><![CDATA[//Refer: Utils->prepareObjectClasses()
searchFilter = "(objectClass="+getProperty("source.userObjectClass")+")";
ldap = thisConnector.connector;

if (cloudSync) {
	searchFilter = "(|" + searchFilter + "(objectClass=user)(objectClass=person))";
}

logmsg("> " + resource.getString("LDAPSYNC.MIGRATING.PERSON.ENTRIES.USING.SEARCH.FILTER") + ": "+searchFilter);
ldap.setParam("ldapSearchFilter",searchFilter);

// set up to retrieve all membership attribute available
if (typeof filterOnGroups !== "undefined" && filterOnGroups) {
	thisConnector.connector.setParam("ldapReturnAttributes", "*\nibm-allGroups\nmemberOf\ngroupMembership");
}]]></Script>
                        <Enabled>true</Enabled>
                    </Hook>
