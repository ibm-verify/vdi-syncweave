                <Branch name="More suffixes to check">
                    <ModTime>1467994585516</ModTime>
                    <Script name="Prepare this container">
                        <ModTime>1395616622587</ModTime>
                        <parameter name="script"><![CDATA[suffixKey = suffixes[suffixCnt];
containerEntry = suffixMap.get(suffixKey);
useRDN = containerEntry.getString("rdn");
typeOfEntry = containerEntry.getString("typeOfEntry");

work.removeAllAttributes()
work[useRDN] = containerEntry.getString("rdnValue");
work["$objectClass"] = typeOfEntry;
work["$translatedDN"] = containerEntry.getString("dn");
work["$targetLDAPDN"] = containerEntry.getString("dn");]]></parameter>
