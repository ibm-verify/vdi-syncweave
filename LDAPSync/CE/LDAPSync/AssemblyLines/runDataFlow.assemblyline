            <Branch name="Migration">
                <ModTime>1467994633331</ModTime>
                <Script name="Prepare for migration">
                    <ModTime>1458561198265</ModTime>
                    <parameter name="script"><![CDATA[checkTypes = ["container","person","group"];

//defaultALName = new java.util.concurrent.ConcurrentHashMap();
defaultALName = new java.util.HashMap();
defaultALName.put("container", "ReadContainers");
defaultALName.put("person", "ReadPersons");
defaultALName.put("group", "ReadGroups");

//defaultJoinALName = new java.util.concurrent.ConcurrentHashMap();
defaultJoinALName = new java.util.HashMap();
defaultJoinALName.put("person", "JoinEntry");

//joinALFC = new java.util.concurrent.ConcurrentHashMap();
joinALFC = new java.util.HashMap();

OnlyInitializeGroupDeltaStore = false;
types = [];
for (i = 0; i < checkTypes.length; i++) {
	thisType = checkTypes[i];
	if (thisType == "container" && !preserveContainers && !targetIsLDAP) {
		continue;
	} else
	if (thisType == "group" && filterOnGroups) {
		if (cloudSync) {
			continue;
		}
		
		OnlyInitializeGroupDeltaStore = !(true == handleType["group"]);
		handleType["group"] = true;
	}
	
	if (handleType[thisType] == true) {
		types.push(thisType);
	}
}

writeLostEntry(null, lostFileName);

changelogType = getProperty("source.changeDetectionType","delta").toLowerCase();

typeCnt = 0;
abortFlow = false;
endOfData = false;]]></parameter>
                </Script>
                <Branch name="Simulating">
                    <ModTime>1425990774368</ModTime>
                    <Script name="Signal start of simulated run">
                        <ModTime>1425990774368</ModTime>
                        <parameter name="script">reportSimulateStatus(null, null, null, "starting");</parameter>
                    </Script>
