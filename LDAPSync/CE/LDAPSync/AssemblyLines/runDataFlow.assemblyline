                            </Hook>
                            <Hook name="initialize_fail">
                                <InheritFrom>[no inheritance]</InheritFrom>
                                <Name>initialize_fail</Name>
                                <Script><![CDATA[change = false;
if (typeof(work) != "undefined" && work != null) {
	work["$status"] = "failed";
	work["$error"] = error;
}	
defaultInitErrorHandling("ERROR", true);]]></Script>
