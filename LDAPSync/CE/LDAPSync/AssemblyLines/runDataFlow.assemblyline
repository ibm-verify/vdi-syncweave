                    <Branch name="More types to migrate">
                        <ModTime>1467994633331</ModTime>
                        <Script name="Initialize for this entry type">
                            <ModTime>1467994633331</ModTime>
                            <parameter name="script"><![CDATA[typeOfEntry = types[typeCnt]
opEntry = task.getOpEntry();

currentType = typeOfEntry

opEntry["$deltaKey"] = getProperty("source.userRDN");
if (!"delta".equalsIgnoreCase(changelogType)) {
	opEntry["$deltaStore"] = connectorParam("source.ldap.stateKey", "statekey") + "_" + typeOfEntry.substring(0,1).toUpperCase();;
} else {
	opEntry["$deltaStore"] = connectorParam("source.ldap.stateKey", "statekey") + "_" + typeOfEntry.substring(0,1).toUpperCase();
}	
opEntry["$typeOfEntry"] = typeOfEntry;

if ("delta".equalsIgnoreCase(changelogType)) {
	opEntry["$enableDelta"] = (!simulate).toString();
	if (deBug) logmsg("--@@-> Delta Store: " + opEntry["$deltaStore"])
}

ALName = getALName("source.read." + typeOfEntry + ".AL",defaultALName.get(typeOfEntry));

endOfData = false;]]></parameter>
                        </Script>
                        <Branch name="NOT simulating">
                            <ModTime>1458843217584</ModTime>
                            <Script name="Reset iterator state key">
                                <ModTime>1458843217584</ModTime>
                                <parameter name="script"><![CDATA[cdType = getProperty("source.changeDetectionType","")

if (!simulate) {
	if ("delta".equalsIgnoreCase(cdType) || "ad".equalsIgnoreCase(cdType)) {
		stateKey = opEntry.getString("$deltaStore");
		if (typeof(lastDeltaStateKeyReset) == "undefined") {
			lastDeltaStateKeyReset = "";
		}

		if (!stateKey.equals(lastDeltaStateKeyReset)) {
			logmsg("INFO", resource.getString("LDAPSYNC.RESETTING.CHANGE.DETECTION.STATE.FOR.FLOW") + ": " + flowKey + " (" + stateKey.toUpperCase() + ")")
	
			tableName = "IDI_DS_" + stateKey.toUpperCase();
			try {
				com.ibm.di.store.StoreFactory.dropTable(tableName)
			} catch (ex) {
				if (String(ex).indexOf("-204") < 0 && String(ex).indexOf("SyntaxError") < 0) {
					logmsg("WARN", resource.getString("LDAPSYNC.UNABLE.TO.DELETE.DELTA.STORE.TABLE") + ": " + tableName 
							+ " - " + ex)
					addToStats(flowKey, "warn", "warn");
				}	
			}
			lastDeltaStateKeyReset = stateKey;
		}	
	} 
	
	if (!"delta".equalsIgnoreCase(cdType)) {
		stateKey = connectorParam("source.ldap.stateKey", "statekey");
		if (typeof(lastStateKeyReset) == "undefined") {
			lastStateKeyReset = "";
		}
		
		if (!stateKey.equals(lastStateKeyReset)) {
			logmsg("INFO", resource.getString("LDAPSYNC.RESETTING.CHANGE.DETECTION.STATE.FOR.FLOW") + ": " + flowKey + " (" + stateKey.toUpperCase() + ")")
			
			storeFactory.removeProperty(stateKey)
			lastStateKeyReset = stateKey;
		}	
	}	
}]]></parameter>
                            </Script>
                            <ScriptCondition>return !simulate</ScriptCondition>
