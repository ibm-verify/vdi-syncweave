                                            <ModTime>1395323275453</ModTime>
                                            <parameter name="script"><![CDATA[// For AD, Sun and SDS (& changelog compatible endpoints), set the change state
// to the last committed changenumber/USN
//
if (typeof(lastStateKeySet) == "undefined") {
	lastStateKeySet = "";
}

if (!lastStateKeySet.equals(stateKey) && "person".equals(typeOfEntry)) {
	lastStateKeySet = stateKey;	
	
	lastChangeState = work.getString("$lastChangeState");
	
	if (lastChangeState != null) {
		logmsg("INFO", resource.getString("LDAPSYNC.SETTING.CHANGE.STATE") + " (" + stateKey.toUpperCase() + "): " + lastChangeState)
		storeFactory.setProperty(stateKey, lastChangeState)	
	}
}]]></parameter>
