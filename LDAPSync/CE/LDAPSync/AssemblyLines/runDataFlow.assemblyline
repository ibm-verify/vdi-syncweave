            </Script>
            <Script name="Prepare target suffixes">
                <ModTime>1395615032142</ModTime>
                <parameter name="script"><![CDATA[suffixStr = ""

if (true /*preserveContainers || handleType.group == true*/) {

	if (targetRootSuffix != null && targetRootSuffix.trim().length != 0) {
		suffixStr = targetRootSuffix
	}
	
	try {
		if (!preserveContainers) {
			if (handleType.person == true) {
				if (targetSuffixForUsers == null || targetSuffixForUsers.trim().length == 0) {
					addToStats(flowKey, "error", "error");
					throw resource.getString("LDAPSYNC.PROPERTY.NOT.SET") + ": target.suffixForUsers. "
							+ resource.getString("LDAPSYNC.YOU.MUST.SPECIFY.WHERE.PERSON.ENTRIES.ARE.TO.BE.FLATTENED.UNDER")
				}
				if (suffixStr != "")
					suffixStr += ";"
				suffixStr += targetSuffixForUsers
			}	
			if (handleType.group == true) {
				if (targetSuffixForGroups == null || targetSuffixForGroups.trim().length == 0) {
					addToStats(flowKey, "error", "error");
					throw resource.getString("LDAPSYNC.PROPERTY.NOT.SET") + ": target.suffixForGroup. "
							+ resource.getString("LDAPSYNC.YOU.MUST.SPECIFY.WHERE.GROUP.ENTRIES.ARE.TO.BE.FLATTENED.UNDER")
				}
				if (suffixStr != "")
					suffixStr += ";"
				suffixStr += targetSuffixForGroups
			}	
		}
	} catch (ex) {
		throw where() + " - " + ex
	}
}]]></parameter>
            </Script>
            <Script name="Build suffixMap">
                <ModTime>1459508052558</ModTime>
                <parameter name="script"><![CDATA[//suffixMap = new java.util.concurrent.ConcurrentHashMap();
suffixMap = new java.util.HashMap();
suffixes = system.splitString(suffixStr.toLowerCase(), ";");

for (suffixCnt = 0; suffixCnt < suffixes.length; suffixCnt++) {
	container = suffixes[suffixCnt];
	
	try {
		ldapName = new javax.naming.ldap.LdapName(container);
	} catch (ex) {
		throw where() + " - " + resource.getString("LDAPSYNC.ERROR.REPARSING.CONTAINER.DN")
					+ ": " + ex + " - DN: " + container;
	}	
	rdns = ldapName.getRdns();
	rdnSize = rdns.size();


	for (i = rdnSize; i > 1; i--) {
		if (i < rdnSize) {
			ldapName.remove(i);
		}

		subRDNs = ldapName.getRdns();
		rdn = subRDNs[0].toString();
		for (j = 1; j < subRDNs.size(); j++) {
			rdn += "," + subRDNs[j].toString();
		}
			
		if (!suffixMap.containsKey(rdn)) {
			e = system.newEntry();
			e.dn = ldapName.toString();
			e.rdn = rdns[i-1].getType();
			e.rdnValue = rdns[i-1].getValue();
			e.typeOfEntry = containerRDN.get(e.getString("rdn"));
			suffixMap.put(rdn, e);
		}
	}
}

suffixes = suffixMap.keySet().toArray();
java.util.Arrays.sort(suffixes);
suffixCnt = 0;]]></parameter>
            </Script>
            <Script name="start timing_1">
                <ModTime>1383052728262</ModTime>
                <parameter name="script">if (doTiming) timing("create suffixes")</parameter>
            </Script>
            <Loop name="More suffixes to check">
                <ModTime>1467994585516</ModTime>
