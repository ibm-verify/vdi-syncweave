            <Hook name="prolog0">
                <InheritFrom>[no inheritance]</InheritFrom>
                <Name>prolog0</Name>
                <Script><![CDATA[if (!singletonAL()) {
	stopMsg = resource.getString("STOPPING.EXTRA.INSTANCE.OF.FLOW");
	task.logmsg("WARN", stopMsg);
	java.lang.System.out.println(stopMsg);
	
	quickStop = true;
	task.shutdown();
	return;
}

quickStop = false;

initUtils();

prepareReport(); // prepare carrier of operation statistics

//
// Print Flow report
//
logmsg("\n" + FlowReport() + "\n")

typeOfEntry = "* unknown *"

changeDetType = getProperty("source.changeDetectionType","delta").toLowerCase()
if (preserveContainers)
	containerMsg = " " + resource.getString("LDAPSYNC.MIRRORING.HIERARCHY")
else
	containerMsg = " " + resource.getString("LDAPSYNC.FLATTENING.HIERARCHY")

logmsg("--> " + resource.getString("LDAPSYNC.STARTING.MIGRATION") + ": " + flowKey + " - " + containerMsg)
cont2Migrate = getProperty("source.containersToMigrate", null);
if (cont2Migrate !== null) {
	logmsg("-->   " + resource.getString("LDAPSYNC.CONTAINERS.TO.MIGRATE") + ":\n" + cont2Migrate);
}	
cont2Skip = getProperty("source.containersToSkip", null);
if (cont2Skip !== null) {
	logmsg("-->   " + resource.getString("LDAPSYNC.CONTAINERS.TO.SKIP") + ":\n" + cont2Skip)
}

stateKey = "";
abortFlow = false;
storeFactory = com.ibm.di.store.StoreFactory().getDefaultPropertyStore();]]></Script>
