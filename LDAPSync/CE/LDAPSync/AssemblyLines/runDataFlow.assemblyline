                            <Hook name="default_fail">
                                <InheritFrom>[no inheritance]</InheritFrom>
                                <Name>default_fail</Name>
                                <Script><![CDATA[errmsg = error.getString("message");
if (errmsg !== null && 
	(errmsg.indexOf("error code 32") >= 0 || // no such object
	 errmsg.indexOf("error code 53") >= 0)) { // no global superior knowledge 
	error.status = "ok";
	error.exception = null;
	error.message = null;
	return; // do nothing
}

defaultErrorHandling("ERROR", true);

abortFlow = true;]]></Script>
