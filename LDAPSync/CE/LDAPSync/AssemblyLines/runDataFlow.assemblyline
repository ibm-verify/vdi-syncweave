            <Script name="start timing_2">
                <ModTime>1383052735902</ModTime>
                <parameter name="script">if (doTiming) timing("start sync")</parameter>
            </Script>
            <Branch name="Synchronize">
                <ModTime>1467994595095</ModTime>
                <Script name="Stop if simulated">
                    <ModTime>1369220638265</ModTime>
                    <parameter name="script"><![CDATA[if (simulate) {
	logmsg("WARN", resource.getString("LDAPSYNC.LDAPSYNC.CAN.NOT.BE.SIMULATED.PLEASE.CHANGE.THE.SIMULATE.PROPERTY"))
	logmsg("WARN", " - " + resource.getString("LDAPSYNC.PLEASE.SET.THE.FOLLOWING.PROPERTY.SIMULATEFALSE"))
	logmsg("WARN", "   " + resource.getString("LDAPSYNC.OR.USE.THE.COMMANDLINE.OPTION.0.ACTUAL"))
	
	system.exitFlow()
}]]></parameter>
                </Script>
                <Script name="Prepare for synchronization">
                    <ModTime>1458561156863</ModTime>
                    <parameter name="script"><![CDATA[//defaultALName = new java.util.concurrent.ConcurrentHashMap()
defaultALName = new java.util.HashMap()
defaultALName.put("sun", "ReadSunChange") 
defaultALName.put("ad", "ReadADChange") 
defaultALName.put("tds", "ReadTDSChange")
defaultALName.put("sds", "ReadTDSChange")
defaultALName.put("delta", "ReadEntries")

//defaultJoinALName = new java.util.concurrent.ConcurrentHashMap()
defaultJoinALName = new java.util.HashMap()
defaultJoinALName.put("container", "JoinEntry")
defaultJoinALName.put("person", "JoinEntry")
defaultJoinALName.put("group", "JoinEntry")

//joinALFC = new java.util.concurrent.ConcurrentHashMap();
joinALFC = new java.util.HashMap();

// force roll of Entry Lost file
writeLostEntry(null, lostFileName)

checkTypes = ["container","person","group"]

types = []
for (i = 0; i < checkTypes.length; i++) {
	thisType = checkTypes[i]
	if (thisType == "container" && !preserveContainers && !targetIsLDAP) {
		continue;
	}
	if (handleType[thisType] == true) {
		types[types.length] = thisType
	}
}

typeCnt = 0]]></parameter>
                </Script>
                <Script name="Get change detection">
                    <ModTime>1381863471187</ModTime>
                    <parameter name="script">changelogType = getProperty("source.changeDetectionType","delta").toLowerCase()</parameter>
                </Script>
                <Loop name="more types to detect changes on">
                    <ModTime>1467994595095</ModTime>
                    <LoopType>0</LoopType>
                    <Branch name="more types to detect changes on">
                        <ModTime>1467994595095</ModTime>
                        <Script name="Get AL name">
                            <ModTime>1467994595095</ModTime>
                            <parameter name="script"><![CDATA[typeOfEntry = types[typeCnt]

currentType = typeOfEntry

opEntry = task.getOpEntry();
opEntry["$deltaKey"] = getProperty("source.userRDN");
if (!"delta".equalsIgnoreCase(changelogType)) {
	opEntry["$deltaStore"] = connectorParam("source.ldap.stateKey", "statekey") + "_" + typeOfEntry.substring(0,1).toUpperCase();;
} else {
	opEntry["$deltaStore"] = connectorParam("source.ldap.stateKey", "statekey") + "_" + typeOfEntry.substring(0,1).toUpperCase();
}	
opEntry["$typeOfEntry"] = typeOfEntry;

if ("delta".equalsIgnoreCase(changelogType)) {
	opEntry["$enableDelta"] = (!simulate).toString();
	if (deBug) logmsg("--@@-> Delta Store: " + opEntry["$deltaStore"])
} else {
	typeCnt = types.length // stop after this single cycle
}

ALName = getALName("source.delta." + typeOfEntry + ".AL",null)
if (ALName == null || ALName.trim().length == 0) {
	ALName = getALName("source.read." + typeOfEntry + ".AL",defaultALName.get(changelogType))
}]]></parameter>
                        </Script>
                        <Script name="prepare for Sync loop">
                            <InheritFrom>/Scripts/prepareForLooping</InheritFrom>
                            <ModTime>1368701648156</ModTime>
                        </Script>
