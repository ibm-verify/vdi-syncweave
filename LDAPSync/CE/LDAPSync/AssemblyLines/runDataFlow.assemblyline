                    <Script name="Increment suffixCnt">
                        <ModTime>1395617392766</ModTime>
                        <parameter name="script">suffixCnt++;</parameter>
                    </Script>
                    <ScriptCondition><![CDATA[return !cloudSync 
		&& suffixCnt < suffixes.length 
		&& !simulate && !abortFlow && targetIsLDAP]]></ScriptCondition>
