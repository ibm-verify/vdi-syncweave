        <LogConfig>
            <Logger name="FileRollerAppender">
                <InheritFrom>system:/Loggers/ibmdi.FileRollerAppender</InheritFrom>
                <parameter name="IDIFileRoller.File"><![CDATA[@SUBSTITUTE{javascript path = "LDAPSync/logs/";
alName = "ProvisionISAM";
opEntry = task.getOpEntry();
attNames = opEntry.getAttributeNames();
flowKey = ""
for (i = 0; i < attNames.length && flowKey.length == 0; i++) {
	if (attNames[i].startsWith("Flow_")) {
		p = attNames[i].indexOf(".")
		if (p > 0) {
			flowKey = attNames[i].substring(0,p)
		}	
	}
}
logname = path + flowKey + "-" + alName + ".log"
//java.lang.System.out.println("\n----\nflowKey: " + flowKey + "")
//java.lang.System.out.println("\n----\nlogname: " + logname+"\n----");
return logname;}]]></parameter>
                <parameter name="IDIFileRoller.RollCount">50</parameter>
                <parameter name="Pattern.ConversionPattern">%d{ISO8601} - %m%n</parameter>
                <parameter name="com.ibm.di.log.layout">Pattern</parameter>
                <parameter name="com.ibm.di.log.level">INFO</parameter>
                <parameter name="enabled">true</parameter>
            </Logger>
        </LogConfig>
