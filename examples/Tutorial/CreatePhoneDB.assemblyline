                        <SchemaItem>
                            <Name>User</Name>
                        </SchemaItem>
                        <SchemaItem>
                            <Name>telephoneNo</Name>
                        </SchemaItem>
                    </Schema>
                    <LinkCriteria/>
                    <Hooks>
                        <InheritFrom>[parent]</InheritFrom>
                    </Hooks>
                    <CheckpointConfig/>
