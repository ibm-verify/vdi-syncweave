                        <parameter name="userComment"/>
                    </Configuration>
                    <Parser>
                        <UserComment/>
                        <InheritFrom>system:/Parsers/ibmdi.XML</InheritFrom>
                        <parameter name="debug">false</parameter>
                        <parameter name="isnamespaceaware">false</parameter>
