<MetamergeConfig Cycle="10" UUID="f5c0a313-cb0d-4540-b64c-2e86a68d0133" created="Fri Aug 22 12:35:05 CEST 2008" createdBy="NO010196" main="CreatePhoneDB" modified="Fri Aug 22 13:43:10 CEST 2008" modifiedBy="NO010196" project="Tutorial" version="7.0">
    




<AssemblyLine name="CreatePhoneDB">
        <Settings/>
        <Hooks/>
        <CheckpointConfig/>
        <SandboxConfig/>
        <SimulationConfig>
            <SimulationStates>
                <Component name="Create table" state="Enabled"/>
                <Component name="ConnectorLoop" state="Enabled"/>
                <Component name="PhoneDB" state="Simulated"/>
            </SimulationStates>
            <ProxySettings/>
        </SimulationConfig>
        <LogConfig/>
        <ContainerEF name="EntryFeedContainer"/>
        <ContainerDF name="DataFlowContainer">
            <Script name="Create table">
                <parameter name="includeFiles"/>
                <parameter name="script"><![CDATA[// Set up the DDL
//
var createSQL = "CREATE TABLE PHONEDB" +
		       " (" +
				" NAME VARCHAR(100) NOT NULL," +
				" PHONE VARCHAR(250) NOT NULL," +
				" CONSTRAINT pk_NAMENUMBER PRIMARY KEY (NAME, PHONE)" +
			   ")";

// Delete table if it already exists
//
task.logmsg("...dropping table...");
res = PhoneDB.connector.execSQL( "DROP TABLE PHONEDB" );

// Who cares if this fails :) Now try to re-create it

task.logmsg("...creating table...");
task.logmsg("...SQL: " + createSQL);

// Call CI method for JDBC Connector: execSQL()
//
res = PhoneDB.connector.execSQL( createSQL );

// Check result for any errors again
//
if (res.length() > 0) {
	task.logmsg("Error creating table: " + res);
	task.shutdown(); // Stop the AL
}

// Now to create the index
//
task.logmsg("...Creating Index...");
res = PhoneDB.connector.execSQL( "CREATE INDEX TNAME ON PHONEDB(NAME)" );

// Check result for any errors again
//
if (res.length() > 0) {
	task.logmsg("Error creating table: " + res);
	task.shutdown(); // Stop the AL
}]]></parameter>
            </Script>
            <Loop name="ConnectorLoop">
                <LoopType>1</LoopType>
                <Connector name="ConnectorLoop">
                    <InheritFrom>system:/Connectors/ibmdi.FileSystem</InheritFrom>
