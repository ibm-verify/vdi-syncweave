                <Branch name="ConnectorLoop">
                    <Connector name="PhoneDB">
                        <InheritFrom>system:/Connectors/ibmdi.JDBC</InheritFrom>
                        <ConnectorMode>AddOnly</ConnectorMode>
                        <ConnectorState>Enabled</ConnectorState>
                        <Configuration>
                            <UserComment/>
