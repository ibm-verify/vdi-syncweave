<AttributeMapItem>
<Name>whatnoun</Name>
<Type>advanced</Type>
<Script><![CDATA[if((work.getAttribute("event.type").getValue()).equals("di.server.api.authenticate")) {	
ret.value = "user";
} else {
var charArray = work.getAttribute("event.userData.authorizationMethod").getValue().toCharArray();
	var i;
	for(i=0;i<charArray.length;i++){
		if(charArray[i]>='A' && charArray[i]<='Z')
			break;
	}
 	ret.value = work.getAttribute("event.userData.authorizationMethod").getValue().substring(i,charArray.length);
}]]></Script>
</AttributeMapItem>
<AttributeMapItem>
<Name>whatsuccess</Name>
<Type>advanced</Type>
<Script><![CDATA[if((work.getAttribute("event.userData.success").getValue()).equalsIgnoreCase("true")) {
	ret.value = "success";
} else {
	ret.value = "failure";
}]]></Script>
<Simple>event.userData.success</Simple>
<SubstitutionTemplate>OK</SubstitutionTemplate>
</AttributeMapItem>
<AttributeMapItem>
<Name>whatverb</Name>
<Type>advanced</Type>
<Script><![CDATA[if(work.getAttribute("event.type").getValue().equals("di.server.api.authenticate")) {
	ret.value = "authenticate";
} else {
	var charArray = work.getAttribute("event.userData.authorizationMethod").getValue().toCharArray();
	var i;
	for(i=0;i<charArray.length;i++){
		if(charArray[i]>='A' && charArray[i]<='Z')
			break;
	}
	ret.value = work.getAttribute("event.userData.authorizationMethod").getValue().substring(0,i);
}
]]></Script>
<SubstitutionTemplate><![CDATA[
]]></SubstitutionTemplate>
</AttributeMapItem>
<AttributeMapItem>
<Name>when</Name>
<Type>advanced</Type>
<Script><![CDATA[var date = work.getAttribute("event.userData.eventDate").getValue(0);
var sdf = new java.text.SimpleDateFormat("yyyy-MM-dd HH:mm:ss:SSS");
var cal = java.util.Calendar.getInstance();

cal.setTime(date);
var time = (cal.get(java.util.Calendar.ZONE_OFFSET) + cal.get(java.util.Calendar.DST_OFFSET))/ (60 * 1000);
var nf = java.text.NumberFormat.getInstance();
nf.setMaximumFractionDigits(0);
nf.setMinimumIntegerDigits(2);
var formated = sdf.format(date) + "+" + nf.format(time / 60) + ":"+ nf.format(time % 60);
ret.value = formated;]]></Script>
<Simple>event.dateCreated</Simple>
<SubstitutionTemplate>NOW</SubstitutionTemplate>
