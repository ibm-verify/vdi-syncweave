<Connector name="processOutput">
<ConnectorMode>Script</ConnectorMode>
<ConnectorState>Enabled</ConnectorState>
<Configuration/>
<ConnectorScript><![CDATA[/* The standard output that results from executing the remote command is stored 
 * in the attribute 'command.out'.  The standard error that results from executing 
 * the remote command is stored in the attribute 'command.error'.  
 * The attribute 'command.returnCode' contains the return code which indicates 
 * the success of the remote command execution */

var rc = work.getAttribute("command.out");
var br = new java.io.BufferedReader(new java.io.StringReader(rc.toString()));
var line = br.readLine();
while (line != null){
	task.logmsg("the next line is " + line);	
	line = br.readLine();
}
br.close();

]]></ConnectorScript>
