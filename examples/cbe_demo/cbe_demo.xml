<Connector name="prepareParamsForWS">
<ConnectorMode>Script</ConnectorMode>
<ConnectorState>Enabled</ConnectorState>
<Configuration/>
<ConnectorScript><![CDATA[
//Get CBE Event
var event = work.getAttribute("event").getValue(0);

var notificationArray = new com.ibm.wtci.samples.axiswsn10.wsn.NotificationMessageHolderType[1];

//Creating an instance of NotificationMessageHolderType
notificationArray[0] = new com.ibm.wtci.samples.axiswsn10.wsn.NotificationMessageHolderType();

//Creating a Topic element with name 'Topic' and value of
//dialect attribute as 'tec'
var msgTopic = new org.apache.axis.message.MessageElement[1];

msgTopic[0] = new org.apache.axis.message.MessageElement();
msgTopic[0].setName("Topic");
msgTopic[0].setAttribute("dialect", "none");

var topicExpType = new com.ibm.wtci.samples.axiswsn10.wsn.TopicExpressionType();

topicExpType.set_any(msgTopic);

//Setting the Topic of the notification
notificationArray[0].setTopic(topicExpType);

//Setting the event to be the message of the notification
notificationArray[0].setMessage(event);

//Setting information about the producer of the event in
//the notification
var endPointRef = new com.ibm.wtci.samples.axiswsn10.wsa.EndpointReferenceType();
var au = new com.ibm.wtci.samples.axiswsn10.wsa.AttributedURI();
var value = new org.apache.axis.types.URI("protocol", "9.182.182.71");
au.set_value(value);
endPointRef.setAddress(au);
notificationArray[0].setProducerReference(endPointRef);

work.setAttribute("event_as_notification", notificationArray);]]></ConnectorScript>
