                <parameter name="script"><![CDATA[// Sample connector
// Place initialization code before function declarations


var userName = null
var entries = null
var entryCnt = 0
var access_Token = null
var access_Token_Secret = null
var consumer_Key = null
var consumer_Secret = null
var tweet_Text = null
var accessToken = null
var twitter = null

//The 'initialize()' method reads the connector's parameters and makes the necessary preparations 
//for the actual work (creates a connection, etc.). In this method the Twitter4J API is initialized 
//to gain access to Twitter through Oauth by providing the obtained 
//Consumer Key, Consumer Secret,  Access Token and Access Token Secret.

function initialize() {
	
	userName = connector.getParam("User Name")
	access_Token = connector.getParam("Access Token")
	access_Token_Secret = connector.getParam("Access Token Secret")
	consumer_Key = connector.getParam("Consumer key")
	consumer_Secret = connector.getParam("Consumer Secret")
	
	accessToken = new twitter4j.auth.AccessToken(access_Token, access_Token_Secret);
	twitter = new twitter4j.TwitterFactory().getInstance();
	twitter.setOAuthConsumer(consumer_Key, consumer_Secret);
    twitter.setOAuthAccessToken(accessToken);
    	
}

//This method is required for Iterator mode. This method is called only when the Connector is used in 
//Iterator mode, after it has been initialized. 
//The 'selectEntries()'  method contains the code that is needed to execute 
//prior to starting to iterate over the Entries returned.
//The below code will connect to the Twitter Account and pick the recent 20 tweets.

function selectEntries()
{
	try {
	entries = twitter.getUserTimeline(userName);
	}
	catch (TwitterException) {
        throw TwitterException
    }	
	entryCnt = 0
}

//This method is called on each AssemblyLine's iteration 
//when the connector is in Iterator mode. It is expected to 
//return a single Entry that feeds the rest of the AssemblyLine. 
//The Twitte4J API pulls the tweets from the Twitter account and 
//the tweets in JSON format are parsed. The parsed data User Screen Name, 
//Tweet text, and the creation date is put into an Entry.

function getNextEntry ()
{
	if (entries == null || entryCnt >= entries.length) {
		result.setStatus (0);
		return;
	}
	entry["$rowNumber"] = entryCnt
	entry["$totalRows"] = entries.length
	var status = entries.get(entryCnt);
	var user = status.getUser();
	entry["User Screen Name"] = user.getScreenName();
	entry["Tweet"] = status.getText();
	entry["Date of Creation"] = status.getCreatedAt();
    
    entryCnt++;
	result.setStatus (1);
	return entry
}

//This method is called every time a connector is used in AddOnly mode, 
// The goal of this method is to add/save/store the Entry passed in as parameter
// to this method into the connector's data source.
//The method reads the TwitterText attribute in the Output Map to add 
//the tweet text to the Twitter account in AddOnly Mode of this connector.

function putEntry (){
	tweet(entry.getAttribute("TwitterText").getValue())
}

function modEntry ()
{
}

function deleteEntry ()
{
}

function findEntry ()
{
}

//This method returns the schema of the connected data source. 
//If you implement it (it’s optional), the Configuration Editor 
//presents the returned values as the connector's schema. 
//These return values are stored as list of Entry objects, 
//one for each column/attribute in the schema. Schemas are displayed in the connector
//Input/Output Map. You can create the Input schema for the connector as per the code below.
//The Input Map Attributes User Screen Name, Tweet, Date of Creation

function querySchema ()
{
	for (var i = 0; i < entries.length; i++)  {
		list.add(addEntry("User Screen Name","java.lang.String"));
		list.add(addEntry("Tweet","java.lang.String"));
		list.add(addEntry("Date of Creation","java.util.Date"));
	}		
	result.setStatus (1);
}

function addEntry(name,syntax){
	var e = system.newEntry();
	e.addAttributeValue("name",name);
	e.addAttributeValue("syntax",syntax);
	return e;
}

//This method is called by the AssemblyLine after it has 
//finished cycling and before it terminates. 
//You can put here any cleanup code, that is, release connections, 
//resources that you created in the initialize method or later during processing.
 
function terminate() {
	entries = null
}

function tweet(tweetText){
    try {
        twitter.updateStatus(tweetText);
    } catch (TwitterException) {
        throw TwitterException
    }
}

