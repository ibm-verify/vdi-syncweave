<Hook>
<Name>after_lookup</Name>
<Script><![CDATA[var resEntry = system.newEntry();

// return the requested attributes in the response
var i=0;
while (i < work.getAttribute("spml.attributeDescription").size()) {
	var attName = work.getAttribute("spml.attributeDescription").getValue(i++);
	resEntry.addAttributeValue(attName, conn.getObject(attName));
}

// set the distinguishedName as an object id
resEntry.setAttribute("spml.psoID", conn.getAttribute("$dn"));

work.addAttributeValue("spml.resultEntries", resEntry);]]></Script>
<Enabled>true</Enabled>
</Hook>
<Hook>
<Name>before_execute</Name>
<Script><![CDATA[
var name = work.getString("spml.filter.substrings.name");

var value = work.getString("spml.filter.substrings.final");

var search = system.newSearchCriteria();

search.addTemplate(name, com.ibm.di.server.SearchCriteria.SUBSTRING, value);

performSearch.setCriteria(search);]]></Script>
<Enabled>true</Enabled>
</Hook>
<Hook>
<Name>before_lookup</Name>
<Script><![CDATA[// set the base directory
performSearch.getConnector().setParam("ldapSearchBase", work.getString("spml.ContainerID"));

// set the search scope
performSearch.getConnector().setParam("ldapSearchScope", work.getString("spml.scope").toLowerCase());
]]></Script>
<Enabled>true</Enabled>
</Hook>
<Hook>
<Name>lookup_multiple</Name>
<Script><![CDATA[var connector = performSearch.getConnector();

// the first of all the entries.
var entry = connector.getFirstFindEntry();

// put all the found entries in the result
while (entry != null) {
	var resEntry = system.newEntry();

	// return the requested attributes in the response
	var i=0;
	while (i < work.getAttribute("spml.attributeDescription").size()) {
		var attName = work.getAttribute("spml.attributeDescription").getValue(i++);
		resEntry.addAttributeValue(attName, entry.getObject(attName));
	}

	// set the distinguishedName as an object id
	resEntry.setAttribute("spml.psoID", entry.getAttribute("$dn"));

	work.addAttributeValue("spml.resultEntries", resEntry);

	// the next entry found
	entry = connector.getNextFindEntry();
}
]]></Script>
<Enabled>true</Enabled>
</Hook>
<Hook>
<Name>lookup_nomatch</Name>
<Script><![CDATA[var resEntry = system.newEntry();

// set an empty entry for the blank result
work.addAttributeValue("spml.resultEntries", resEntry);]]></Script>
<Enabled>true</Enabled>
</Hook>
</Hooks>
