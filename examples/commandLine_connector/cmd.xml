<Folder name="Parsers">
<Parser name="DemoScriptParser">
<InheritFrom>system:/Parsers/ibmdi.ScriptParser</InheritFrom>
<parameter name="script"><![CDATA[//
// This is a simple parser that returns one line at a time from
// the input stream.
//

var counter = 0;

function writeEntry ()
{
	out.write (entry.getString("line"));
	out.newLine();
}

function readEntry ()
{
	var str = inp.readLine();
	var attrName = '';
	var attrValue = '';

	if ( str == null )
	{
		result.setStatus (0);
		result.setMessage ("End of input");
		return;
	}
	

	while ( str != null ) {
	counter++;

	attrName = str.substring(0, str.indexOf('='));
	attrValue = str.substring(str.indexOf('=')+1);
	entry.setAttribute ( attrName, attrValue );
	str = inp.readLine();
	}

	
}
]]></parameter>
</Parser>
