            <ContainerDF name="DataFlowContainer">
                <Script name="SendCustomNotification">
                    <parameter name="script"><![CDATA[//get the type, ID and user data for the custom notification
var msgType = work.getAttribute("http.qs.MessageType");
var msgID = work.getAttribute("http.qs.MessageID");
var usrData = work.getAttribute("http.qs.UserData");

var isNotificationSent = false;


//send custom notification if the type is not null
if(msgType != null && msgType.getValue().toString().length() > 0){
	session.sendCustomNotification(msgType, msgID, usrData);
	isNotificationSent = true;
}]]></parameter>
                </Script>
                <Script name="UpdatePage">
                    <parameter name="script"><![CDATA[//prepare the HTML string for the response

var str = "";

str += "<html>\n";
str += "<body>\n";

str += "<form name=\"input\" action=\"http://localhost:80/\" method=\"get\">\n";
str += "Enter Message Type: \n";
str += "<input type=\"text\" name=\"MessageType\" value=\"\" size=\"20\">";
str += "<br>";
str += "Enter MessageID: \n";
str += "<input type=\"text\" name=\"MessageID\" size=\"20\">\n";
str += "<br>\n";
str += "Enter User Data: ";
str += "<input type=\"text\" name=\"UserData\" size=\"20\">";
str += "<br>";
str += "<input type=\"submit\" value=\"Send\">\n";
str += "</form>\n";
str += "<p>\n";
str += "Click the \"Send\" button to send a custom notification.\n";
str += "</p>\n";
str += "<p>\n";
	if(isNotificationSent){
		str += "You sent custom notification of type \""+ msgType +"\" with message ID: \"" + msgID + "\"";
		str += " and user data: \"" + usrData + "\"";
	} else{
		str += "No custom notification was send because no type was entered!"
	}
str += "</p>\n";

str += "</body>\n";
str += "</html>";]]></parameter>
                </Script>
            </ContainerDF>
            <ThreadOptions/>
            <Operations/>
            <InitParams>
                <Schema name="AssemblyLineInitParams"/>
            </InitParams>
        </AssemblyLine>
