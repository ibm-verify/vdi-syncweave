        <section name="KQZ_JAVA">
            <label msgKey="KQZ_JAVA_SECTION_LABEL">Java</label>
            <description msgKey="KQZ_JAVA_SECTION_DESC">Java Parameters</description>
            <property browseType="dir" defaultValue="C:\Program Files\IBM\Java50" name="JAVA_HOME" required="false" type="browse">
                <label msgKey="KQZ_JAVA_HOME_LABEL">Java Home</label>
                <description msgKey="KQZ_JAVA_HOME_DESC">The path to where java is installed.</description>
            </property>
            <property defaultValue="ERROR" name="JAVA_TRACE_LEVEL" required="true" type="restricted">
                <label msgKey="KQZ_JAVA_TRACE_LABEL">Trace Level</label>
                <description msgKey="KQZ_JAVA_TRACE_DESC">This parameter allows you to specify the trace level used by the Java providers.</description>
                <values>
                    <value name="ERROR">
                        <label msgKey="KQZ_TRACE_ERROR">Error</label>
                    </value>
                    <value name="WARN">
                        <label msgKey="KQZ_TRACE_WARN">Warning</label>
                    </value>
                    <value name="INFO">
                        <label msgKey="KQZ_TRACE_INFO">Information</label>
                    </value>
                    <value name="DEBUG_MIN">
                        <label msgKey="KQZ_TRACE_DBGMIN">Minimum Debug</label>
                    </value>
                    <value name="DEBUG_MID">
                        <label msgKey="KQZ_TRACE_DBGMID">Medium Debug</label>
                    </value>
                    <value name="DEBUG_MAX">
                        <label msgKey="KQZ_TRACE_DBGMAX">Maximum Debug</label>
                    </value>
                    <value name="ALL">
                        <label msgKey="KQZ_TRACE_ALL">All</label>
                    </value>
                </values>
            </property>
            <property defaultValue="" name="JAVA_JVM_ARGS" required="false" type="string">
                <label msgKey="KQZ_JVM_ARGS_LABEL">JVM Arguments</label>
                <description msgKey="KQZ_JVM_ARGS_DESC">This parameter allows you to specify an optional list of arguments to the java virtual machine.</description>
            </property>
        </section>
        <section name="KQZ_JMX_JSR160_JSR160">
            <label msgKey="KQZ_JMX_JSR160_JSR160_LABEL">JSR-160-Compliant Server</label>
            <property defaultValue="" name="KQZ_JMX_JSR160_JSR160_USER_ID" required="false" type="string">
                <label msgKey="KQZ_JMX_JSR160_JSR160_USER_ID_LABEL">User ID</label>
                <description msgKey="KQZ_JMX_JSR160_JSR160_USER_ID_DESC">The user id for connecting to the MBean Server.</description>
            </property>
            <property defaultValue="" name="KQZ_JMX_JSR160_JSR160_PASSWORD" required="false" type="password">
                <label msgKey="KQZ_JMX_JSR160_JSR160_PASSWORD_LABEL">Password</label>
                <description msgKey="KQZ_JMX_JSR160_JSR160_PASSWORD_DESC">Password</description>
            </property>
            <property defaultValue="service:jmx:rmi:///jndi/rmi://localhost:8686/jmxrmi" name="KQZ_JMX_JSR160_JSR160_SERVICE_URL" required="true" type="string">
                <label msgKey="KQZ_JMX_JSR160_JSR160_SERVICE_URL_LABEL">Service URL</label>
                <description msgKey="KQZ_JMX_JSR160_JSR160_SERVICE_URL_DESC">The service URL for connecting to the MBean Server.</description>
            </property>
            <property name="KQZ_JMX_JSR160_JSR160_CLASS_PATH_SEPARATOR" required="true" type="separator">
                <label msgKey="KQZ_JMX_JSR160_JSR160_CLASS_PATH_SEPARATOR_LABEL">n/a</label>
            </property>
            <property name="KQZ_JMX_JSR160_JSR160_CLASS_PATH_TITLE" required="true" type="text">
                <label msgKey="KQZ_JMX_JSR160_JSR160_CLASS_PATH_TITLE_LABEL">Class path information</label>
            </property>
            <property defaultValue="" name="KQZ_JMX_JSR160_JSR160_BASE_PATHS" required="false" type="string">
                <label msgKey="KQZ_JMX_JSR160_JSR160_BASE_PATHS_LABEL">Base Paths</label>
                <description msgKey="KQZ_JMX_JSR160_JSR160_BASE_PATHS_DESC">Directories used to locate any Java class path entry or jar directory which is not fully-qualified.</description>
            </property>
            <property defaultValue="" name="KQZ_JMX_JSR160_JSR160_JAR_FILES" required="false" type="string">
                <label msgKey="KQZ_JMX_JSR160_JSR160_JAR_FILES_LABEL">Class Path</label>
                <description msgKey="KQZ_JMX_JSR160_JSR160_JAR_FILES_DESC">Jar files which Java will look in to find a needed class or resource.</description>
            </property>
            <property defaultValue="" name="KQZ_JMX_JSR160_JSR160_JAR_PATHS" required="false" type="string">
                <label msgKey="KQZ_JMX_JSR160_JSR160_JAR_PATHS_LABEL">Jar Directories</label>
                <description msgKey="KQZ_JMX_JSR160_JSR160_JAR_PATHS_DESC">Directories which contain jar files which Java will look in to find a needed class or resource. All jar files in each of these directories will be looked in.</description>
            </property>
        </section>
    </AgentConfig:agent>
