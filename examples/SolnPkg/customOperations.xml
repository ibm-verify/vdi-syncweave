<Connector name="deleteFromServer">
<ConnectorMode>Script</ConnectorMode>
<ConnectorState>Enabled</ConnectorState>
<Configuration/>
<ConnectorScript><![CDATA[
//Attempts to delete the entry from the server
//This dn must be in the work entry
//which should be passed by the calling AL

task.logmsg("ldapdelete operation passed.");
var dn=work.getString("dn");
if(dn!=null){
    var entryToDelete = system.newEntry();
    entryToDelete.setAttribute("$dn",dn);
    ldapConn.connector.initialize(null);
    ldapConn.connector.deleteEntry(entryToDelete,system.newSearchCriteria());
    ldapConn.connector.terminate();
    task.logmsg("--------------------"); 
    task.logmsg("Deleted Entry: "+ dn);
    task.logmsg("--------------------"); 
}else{ //throw an exception for the calling AL to handle
    var message = "No dn attribute found in work entry";
    task.logmsg("--------------------"); 
    task.logmsg(message);
    task.logmsg("--------------------"); 
    throw new java.lang.Exception(message);
}]]></ConnectorScript>
