<Parser name="BracketParser">
<InheritFrom>system:/Parsers/ibmdi.ScriptParser</InheritFrom>
<parameter name="characterSet"/>
<parameter name="description"/>
<parameter name="script"><![CDATA[function readEntry ()
{
	var inpLine = inp.readLine ();
	if ( inpLine == null ) {
		result.setStatus ( 0 );
		result.setMessage ( "End of input" );
		return;
	}

	var line = String ( inpLine );
	var current_index = 0;
	while ( current_index < line.length ) {
		var indOfColon = line.indexOf ( ":", current_index );
		var indOfComma = line.indexOf ( ",", current_index );
		if ( indOfComma == -1 ) {
			indOfComma = line.length - 1;
		}
		var parsedLine = line.substr ( indOfColon + 1, indOfComma - indOfColon - 1 );
		var name = line.substr ( current_index + 1, indOfColon - current_index - 1 );
		current_index = indOfComma + 1;
		entry.addAttributeValue ( name, parsedLine );
	}
	result.setStatus ( 1 );
}


function writeEntry ()
{	
	out.write( "[" );
	var names = entry.getAttributeNames ();
    for ( var i = 0; i < names.length; i++ ) 
	{
    	var attribute = entry.getAttribute ( names[i] );
        for ( var j = 0; j < attribute.size (); j++ ) {
           	out.write ( attribute.getName () + ":" + attribute.getValue ( j ) + 
						( ( i < ( names.length -1 ) || j < ( attribute.size () -1 ) ) ? ", " : "" ) );
		}
    }
    out.write ( "]" );
	out.newLine ();
	out.flush ();
}]]></parameter>
</Parser>
