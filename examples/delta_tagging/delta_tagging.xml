            <ContainerDF name="DataFlowContainer">
                <Script name="Remove_Delta_Tagging_At_Value_Level">
                    <parameter name="script"><![CDATA[//get the names of all attributes
var attrNames = work.getAttributeNames(); 

for (var i = 0; i < attrNames.length; i++) {
	var attr = work.getAttribute(attrNames[i]);
	
	if (attr.size() > 1 && (attr.getOper() != 'd')) {
		var isFirstAttrValue = true;	//determine if we add value for the first time
		
		var values = attr.getValues();	//get the values for the current attribute
		
		for(var k = 0; k < values.length; k++) {
			if (!attr.getValueOperation(k).equalsIgnoreCase("delete"))
				if(isFirstAttrValue){
					//if we add value for the first time 
					work.setAttribute(attrNames[i], values[k]);
					isFirstAttrValue = false;
			} else {
				work.addAttributeValue(attrNames[i], values[k]);
			}	
		}
	}
}]]></parameter>
                </Script>
