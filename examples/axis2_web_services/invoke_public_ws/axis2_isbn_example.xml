                            <SchemaItem>
                                <Name>$soapHeader</Name>
                                <Syntax>String</Syntax>
                            </SchemaItem>
                            <SchemaItem>
                                <Name>IsValidISBN10</Name>
                            </SchemaItem>
                        </Schema>
                        <Hooks>
                            <InheritFrom>[parent]</InheritFrom>
                        </Hooks>
                        <Configuration>
                            <UserComment/>
                            <InheritFrom>[parent]</InheritFrom>
                            <parameter name="debug">false</parameter>
                            <parameter name="endpoint">ISBNServiceSoap</parameter>
                            <parameter name="operation">IsValidISBN10</parameter>
                            <parameter name="service">ISBNService</parameter>
                            <parameter name="userComment"/>
                            <parameter name="wsdlUrl">http://webservices.daehosting.com/services/isbnservice.wso?WSDL</parameter>
                        </Configuration>
                        <SandboxConfig/>
                        <AttributeMap name="Input">
                            <InheritFrom>[parent]</InheritFrom>
                            <AttributeMapItem>
                                <Name>IsValidISBN10Response</Name>
                                <Type>advanced</Type>
                                <Enabled>true</Enabled>
                                <Script>conn.IsValidISBN10Response</Script>
                            </AttributeMapItem>
                        </AttributeMap>
                        <AttributeMap name="Output">
                            <InheritFrom>[parent]</InheritFrom>
                            <AttributeMapItem>
                                <Name>IsValidISBN10</Name>
                                <Type>advanced</Type>
                                <Enabled>true</Enabled>
                                <Script>work.IsValidISBN10;</Script>
                            </AttributeMapItem>
                        </AttributeMap>
                    </Function>
                    <Script name="PrintResponse">
                        <parameter name="enabled">true</parameter>
                        <parameter name="includeFiles"/>
                        <parameter name="script"><![CDATA[// prints whether the ISBN is correct or not. 
// also displays the actual ISBN and the digit count  

var result = work.IsValidISBN10Response.getChildNodes().item(1);
if("true".equals(result)) {
	task.logmsg("CORRECT ISBN");
} else {
	task.logmsg("INCORRECT ISBN");
}
task.logmsg("<< ISBN: " + work.ISBN + " | Digit count: " + work.ISBNlength + " >>");
task.logmsg("");]]></parameter>
                    </Script>
                    <Conditions>
                        <BranchCondition>
