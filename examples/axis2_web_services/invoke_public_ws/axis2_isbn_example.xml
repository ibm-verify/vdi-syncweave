            <ContainerDF name="DataFlowContainer">
                <Script name="CalculateISBNLength">
                    <parameter name="includeFiles"/>
                    <parameter name="script"><![CDATA[// checks the count of digits in the ISBN. if they are 10 or 13 a separate
// ws client will be used, otherwise an error message will be displayed (no ws call)

var temp = work.ISBN.getValue().replaceAll("[^0-9]", "");
var length = temp.length();
if(length == 9 && work.ISBN.getValue().length() == 10 && work.ISBN.getValue().endsWith("X")) {
	length++;
}
work.ISBNlength = length;]]></parameter>
                </Script>
                <Branch name="ISBN10">
                    <Script name="SetRequestParameter">
                        <parameter name="includeFiles"/>
                        <parameter name="script"><![CDATA[// assembles the ISBN(10) element that will be sent for validation 

var levelOne = work.createElementNS("http://webservices.daehosting.com/ISBN", "trgnamespace:IsValidISBN10");
var levelTwo = work.createElementNS("http://webservices.daehosting.com/ISBN", "trgnamespace:sISBN");
levelTwo.appendChild(work.createTextNode(work.ISBN));
levelOne.appendChild(levelTwo);
work.appendChild(levelOne);]]></parameter>
                    </Script>
