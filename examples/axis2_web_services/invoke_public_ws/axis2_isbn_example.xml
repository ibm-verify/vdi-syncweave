                                <Syntax>String</Syntax>
                            </SchemaItem>
                            <SchemaItem>
                                <Name>http.content-type</Name>
                                <Syntax>String</Syntax>
                            </SchemaItem>
                        </Schema>
                        <Schema name="Output">
