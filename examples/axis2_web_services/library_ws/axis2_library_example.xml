            <ContainerDF name="DataFlowContainer">
                <Branch name="HttpRequestIsGet">
                    <Script name="ReturnWSDL">
                        <parameter name="includeFiles"/>
                        <parameter name="script"><![CDATA[// the server received a 'GET' request, so it returns a response 
// containing the WSDL file describing the service 
	
	var filename = task.getConnector("Axis2WebServiceServerConnector").getConnector().getParam("wsdlUrl");
	var input = new java.io.BufferedReader(new java.io.FileReader(filename));
	var wsdlText = "";
	var line;
	while((line = input.readLine()) != null) {
		wsdlText += line + "\n";
	}
	work.setAttribute("http.body", wsdlText);
	//work.setAttribute("$authResult", true);
	task.logmsg("<<<<<<<<<< Response = " + filename);]]></parameter>
                    </Script>
                    <Conditions>
                        <BranchCondition>
                            <LeftHand>http.method</LeftHand>
                            <Operator>contains</Operator>
                            <RightHand>GET</RightHand>
                        </BranchCondition>
                    </Conditions>
                    <MatchAny>false</MatchAny>
                    <Enabled>true</Enabled>
                    <Type>0</Type>
                </Branch>
                <Branch name="HttpRequestIsPost">
                    <Script name="CreateBookMap">
                        <parameter name="enabled">true</parameter>
                        <parameter name="includeFiles"/>
                        <parameter name="script"><![CDATA[//creates a map with the books present in the library

var map = new java.util.HashMap();
map.put("Julius Caesar", "Shakespeare");
map.put("I Robot", "Asimov");
map.put("Gun seller", "Lory");
map.put("Under the yoke", "Vazov");
map.put("A Christmas Carol", "Dickens");
map.put("A Connecticut Yankee in King Arthur's Court", "Twain");
map.put("A Dream Within a Dream", "Poe");
map.put("A Midsummer Night's Dream", "Shakespeare");
map.put("A Princess of Mars", "Burroughs");
map.put("A Room With a View", "Forster");
map.put("A Thief in the Night", "Hornung");
map.put("A Treatise on Government", "Aristotle");
map.put("A Woman of No Importance", "Wilde");
map.put("A Woman of Thirty", "Balzac");
map.put("Aaron Trow", "Trollope");
map.put("Foundation", "Asimov");
map.put("Hobbit", "Tolkien");
map.put("King Solomon's Mines", "Haggard");
map.put("Lady Susan", "Austen");
map.put("Lady Windermere's Fan", "Wilde");
// add more if you want

work.addAttributeValue("bookMap", map);]]></parameter>
                    </Script>
                    <Script name="PrintRequest">
                        <parameter name="includeFiles"/>
                        <parameter name="script"><![CDATA[//prints the request received from the client

task.logmsg(">>>>>>>>>> Request = " + work.book.toString());]]></parameter>
                    </Script>
                    <Script name="AssembleResponse">
                        <parameter name="includeFiles"/>
                        <parameter name="script"><![CDATA[// assembles the response to the received 'POST' request

var user = work.getString("http.remote_user");
var pass = work.getString("http.remote_pass");
task.logmsg("User: " + user + " Password: " + pass);
if(!user.equals("user") || !pass.equals("pass")) {
 	//work.setAttribute("$authResult", "false");
 	work.$faultCode = "myCode";
 	work.$faultReason = "SOAP fault: Error in processing";
} else {
	//work.setAttribute("$authResult", "true");
	work.$faultCode = null;
 	work.$faultReason = null;
	var title = work.book.getFirstChild().getNodeValue().trim();
	var author = work.book.getLastChild().getNodeValue().trim();
	var booleanResult = false;
	var map = work.getAttribute("bookMap").getValue(0);
	var containedValue = map.get(title);
	if(containedValue != null && containedValue.equals(author)) {
		booleanResult = true;
	}
	var attr = work.createElementNS("http://www.example.com/library/", "trgnsp:isAvailable");
	attr.appendChild(work.createTextNode(booleanResult));
	work.appendChild(attr);
	task.logmsg("<<<<<<<<<< Assembled Response = " + attr);
}]]></parameter>
                    </Script>
                    <Script name="CalculateProcessTime">
                        <parameter name="includeFiles"/>
                        <parameter name="script"><![CDATA[// calculates the time needed to receive and process the request.
// this data is sent in the soap header of the response

var currentTime = java.lang.Long.parseLong(java.lang.System.currentTimeMillis());
var processTime = java.lang.Math.abs(currentTime - java.lang.Long.parseLong(work.$soapHeader));

var header = work.createElement("$soapHeader");
header.appendChild(work.createTextNode(processTime));
work.setAttribute(header);]]></parameter>
                    </Script>
                    <Conditions>
                        <BranchCondition>
                            <LeftHand>http.method</LeftHand>
                            <Operator>contains</Operator>
                            <RightHand>POST</RightHand>
                        </BranchCondition>
                    </Conditions>
                    <MatchAny>false</MatchAny>
                    <Enabled>true</Enabled>
                    <Type>0</Type>
                </Branch>
