<?xml version="1.0"?>
<xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform"
	xmlns:xalan2="http://xml.apache.org/xalan"
	xmlns:fixquote="com.tivoli.tmsxml.tools.FixQuote"
	xmlns:fixbackslash="com.tivoli.tmsxml.tools.FixBackslash"
	xmlns:fixquotationmark="com.tivoli.tmsxml.tools.FixQuotationMark"
        xmlns:str="http://exslt.org/strings"
	extension-element-prefixes="xalan2 str" version="1.0">

