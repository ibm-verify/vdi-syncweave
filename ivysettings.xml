  Ivy Settings Configuration
  
  This file configures Ivy to use multiple Maven repository mirrors
  to avoid rate-limiting issues with Maven Central.
  
  Repository Priority:
  1. Google Maven Central Mirror (primary)
  2. Maven Central (fallback)
  3. UK Maven Mirror (fallback)
-->
<ivysettings>
  <settings defaultResolver="chain-resolver"/>

  <resolvers>
    <!-- Chain resolver with returnFirst="true": stops at the first resolver
         that successfully delivers the artifact.  checkmodified="false" on
         each resolver prevents Ivy from issuing extra HEAD/GET requests to
         verify freshness against every mirror after a successful download,
         which is what triggers the spurious "proxy server not well configured"
         warning even when the network is perfectly fine. -->
    <chain name="chain-resolver" returnFirst="true">

      <!-- Maven Central - primary -->
      <ibiblio name="maven-central"
               root="https://repo1.maven.org/maven2/"
               m2compatible="true"
               checkmodified="false"/>

      <!-- Google Maven Central Mirror - fallback -->
      <ibiblio name="google-maven-central"
               root="https://maven-central.storage-download.googleapis.com/maven2/"
               m2compatible="true"
               checkmodified="false"/>

    </chain>
  </resolvers>
</ivysettings>

