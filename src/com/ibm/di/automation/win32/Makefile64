#commands for generating 64-bit COMProxy.dll; ; COMProxy.pdb is also generated (for debugging purposes)   

# target for linking the dll
link_dll : create_dirs clear_linker_files compile_source
	link /OUT:"bin64\COMProxy.dll" /INCREMENTAL:NO /NOLOGO /DLL /DEBUG /PDB:"bin64\COMProxy.pdb" /SUBSYSTEM:WINDOWS /OPT:REF /OPT:ICF /MACHINE:X64 /ERRORREPORT:PROMPT obj64\COMProxy.obj obj64\COMUtil.obj obj64\IDispatch.obj obj64\IUnknown.obj obj64\SafeArray.obj obj64\VARIANT.obj
	
# target for compiling the source files to obj files
compile_source : clear_compiler_files COMProxy.cpp COMUtil.cpp IDispatch.cpp IUnknown.cpp SafeArray.cpp VARIANT.cpp COMUtil.h IDispatch.h IUnknown.h SafeArray.h VARIANT.h																														
	cl /O2 /Oi /GL /I "%ADKS_ROOT%\ibm\jdk\1.5\include" /D "WIN32" /D "NDEBUG" /D "_WINDOWS" /D "_USRDLL" /D "COMPROXY_EXPORTS" /D "_CRT_SECURE_NO_WARNINGS" /D "_WINDLL" /D "_UNICODE" /D "UNICODE" /FD /EHsc /MT /Gy /Fo"obj64\\" /Fd"bin64\COMProxy.pdb" /W3 /nologo /c /Zi /TP /errorReport:prompt COMProxy.cpp COMUtil.cpp IDispatch.cpp IUnknown.cpp SafeArray.cpp VARIANT.cpp

# delete linker generated files, if they already exist in the folder
clear_linker_files :
	rmdir /S /Q bin64
	mkdir bin64

# delete the OBJ files generated by the compiler, if they are present in the folder
clear_compiler_files :
	rmdir /S /Q obj64
	mkdir obj64
	
# create the "obj64" and "bin64" folders if they do not exist
create_dirs :
	IF NOT EXIST obj64 mkdir obj64
	IF NOT EXIST bin64 mkdir bin64