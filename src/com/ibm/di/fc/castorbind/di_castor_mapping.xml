<?xml version="1.0"?>
<!DOCTYPE mapping PUBLIC "-//EXOLAB/Castor Object Mapping DTD Version 1.0//EN"
                         "http://castor.exolab.org/mapping.dtd">

<mapping>
    <class name="com.ibm.di.fc.castorbind.TypeWrapper" auto-complete="true">
        <map-to xml="typewrapper"/>

        <field name="Boolean" type="java.lang.Boolean">
            <bind-xml name="boolean" node="element"/>
        </field>
        <field name="Long" type="java.lang.Long">
            <bind-xml name="long" node="element"/>
        </field>
        <field name="Double" type="java.lang.Double">
            <bind-xml name="double" node="element"/>
        </field>
        <field name="Float" type="java.lang.Float">
            <bind-xml name="float" node="element"/>
        </field>
        <field name="Byte" type="java.lang.Byte">
            <bind-xml name="byte" node="element"/>
        </field>
        <field name="Short" type="java.lang.Short">
            <bind-xml name="short" node="element"/>
        </field>
    </class>

    <class name="com.ibm.di.fc.castorbind.StringArrayWrapper" auto-complete="true">
        <map-to xml="strings"/>
        <field name="Strings" type="string" collection="array">
            <bind-xml name="string" node="element"/>
        </field>
    </class>

    <class name="com.ibm.di.fc.castorbind.CharArrayWrapper" auto-complete="true">
        <map-to xml="chars"/>

        <field name="Characters" type="char" collection="array">
            <bind-xml name="character" node="element"/>
        </field>
    </class>

    <class name="com.ibm.di.fc.castorbind.ByteArrayWrapper" auto-complete="true">
        <map-to xml="bytes"/>

        <field name="Bytes" type="java.lang.Byte" collection="array">
            <bind-xml name="byte" node="element"/>
        </field>
    </class>

</mapping>
