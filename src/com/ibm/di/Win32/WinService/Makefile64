ibmdiservice.exe: create_dirs clear_compiler_files clear_linker_files NTServApp IBMDIService NTService NTServMsg.RES
		link /OUT:bin64/ibmdiservice.exe /INCREMENTAL:NO /NOLOGO /DEBUG /PDB:"bin64\ibmdiservice.pdb" /OPT:REF /OPT:ICF obj64\NTServApp.obj obj64\IBMDIService.obj obj64\NTService.obj /MACHINE:X64 Advapi32.lib obj64\NTServMsg.RES

IBMDIService: IBMDIService.cpp IBMDIService.h NTServMsg
		cl /c IBMDIService.cpp /I obj64 /Zi /Fd"obj64\vc.pdb" /Fo"obj64\\"
		
NTServApp: NTServApp.cpp NTServApp.h NTServMsg
		cl /c NTServApp.cpp /I obj64 /Zi /Fd"obj64\vc.pdb" /Fo"obj64\\"

NTService: NTService.cpp NTService.h NTServMsg
		cl /c NTService.cpp /I obj64 /Zi /Fd"obj64\vc.pdb" /Fo"obj64\\"

NTServMsg.RES: NTServMsg
		rc obj64\NTServMsg.rc

NTServMsg: NTServMsg.mc
		mc NTServMsg.mc -r obj64\ -h obj64\
		
# delete linker generated files, if they already exist in the folder
clear_linker_files :
		rmdir /S /Q bin64
		mkdir bin64

# delete the obj64 file generated by the compiler, if it is present in the folder
clear_compiler_files :
		rmdir /S /Q obj64
		mkdir obj64
	
# create the "obj64" and "bin64" folders if they do not exist
create_dirs :
		IF NOT EXIST obj64 mkdir obj64
		IF NOT EXIST bin64 mkdir bin64