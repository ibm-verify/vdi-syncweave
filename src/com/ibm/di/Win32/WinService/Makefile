ibmdiservice.exe: create_dirs clear_compiler_files clear_linker_files NTServApp IBMDIService NTService NTServMsg.RES
		link /OUT:bin/ibmdiservice.exe /INCREMENTAL:NO /NOLOGO /DEBUG /PDB:"bin\ibmdiservice.pdb" /OPT:REF /OPT:ICF obj\NTServApp.obj obj\IBMDIService.obj obj\NTService.obj Advapi32.lib obj\NTServMsg.RES

IBMDIService: IBMDIService.cpp IBMDIService.h NTServMsg
		cl /c IBMDIService.cpp /I obj /Zi /Fd"obj\vc.pdb" /Fo"obj\\"
		
NTServApp: NTServApp.cpp NTServApp.h NTServMsg
		cl /c NTServApp.cpp /I obj /Zi /Fd"obj\vc.pdb" /Fo"obj\\"

NTService: NTService.cpp NTService.h NTServMsg
		cl /c NTService.cpp /I obj /Zi /Fd"obj\vc.pdb" /Fo"obj\\"

NTServMsg.RES: NTServMsg
		rc obj\NTServMsg.rc

NTServMsg: NTServMsg.mc
		mc NTServMsg.mc -r obj\ -h obj\
		
# delete linker generated files, if they already exist in the folder
clear_linker_files :
		rmdir /S /Q bin
		mkdir bin

# delete the OBJ file generated by the compiler, if it is present in the folder
clear_compiler_files :
		rmdir /S /Q obj
		mkdir obj
	
# create the "obj64" and "bin64" folders if they do not exist
create_dirs :
		IF NOT EXIST obj mkdir obj
		IF NOT EXIST bin mkdir bin
