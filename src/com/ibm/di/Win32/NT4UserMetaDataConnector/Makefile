#commands for generating 32-bit WindowsUsers.dll; ; WindowsUsers.pdb is also generated (for debugging purposes)   

# target for linking the dll
link_dll : create_dirs clear_linker_files compile_source
	link /OUT:"bin\WindowsUsers.dll" /INCREMENTAL:NO /NOLOGO /DLL /DEBUG /PDB:"bin\WindowsUsers.pdb" /SUBSYSTEM:WINDOWS /OPT:REF /OPT:ICF /MACHINE:X86 /ERRORREPORT:PROMPT Advapi32.lib Netapi32.lib Mpr.lib obj\NTMetaData.obj obj\NTMetaDataException.obj obj\Wrapper_LPWSTR.obj obj\JavaStructures.obj

# target for compiling the source files to WindowsUsers.obj
compile_source : clear_compiler_files com_ibm_di_connector_NT4UserMetaDataConnector_NTMetaData.h JavaStructures.h NTMetaData.h NTMetaDataException.h Wrapper_LPWSTR.h NTMetaData.cpp NTMetaDataException.cpp Wrapper_LPWSTR.cpp JavaStructures.cpp
	cl /O2 /Oi /GL /I "%ADKS_ROOT%\ibm\jdk\1.5\include" /D "WIN32" /D "_WINDOWS" /D "_USRDLL" /D "WINDOWSUSERS_EXPORTS" /D "_CRT_SECURE_NO_WARNINGS" /D "_UNICODE" /D "UNICODE" /D "_WINDLL" /Fo"obj\\" /Fd"bin\WindowsUsers.pdb" /FD /EHsc /MT /Gy /W4 /nologo /c /Zi /TP /errorReport:prompt NTMetaData.cpp NTMetaDataException.cpp Wrapper_LPWSTR.cpp JavaStructures.cpp																																						

# delete linker generated files, if they already exist in the folder
clear_linker_files :
	rmdir /S /Q bin
	mkdir bin

# delete the OBJ file generated by the compiler, if it is present in the folder
clear_compiler_files :
	rmdir /S /Q obj
	mkdir obj
	
# create the "obj64" and "bin64" folders if they do not exist
create_dirs :
	IF NOT EXIST obj mkdir obj
	IF NOT EXIST bin mkdir bin