#commands for generating 64-bit domchdet.dll; domchdet.pdb is also generated (for debugging purposes)   

# target for linking the dll
link_dll : create_obj_dir clear_linker_files compile_source
	link /OUT:"bin64\domchdet.dll" /INCREMENTAL:NO /NOLOGO /DLL /DEBUG /PDB:"bin64\domchdet.pdb" /SUBSYSTEM:WINDOWS /OPT:REF /OPT:ICF /MACHINE:X64 /ERRORREPORT:PROMPT "%ADKS_ROOT%\ibm\notes\8.5\lib\64\notes.lib" obj64\DominoChangeDetection.obj
		
# target for compiling the source files to DominoChangeDetection.obj
compile_source : clear_compiler_files com_ibm_di_connector_DominoChangeDetectionConnector.h DominoChangeDetection.c
	cl /O2 /Oi /GL /I "%ADKS_ROOT%\ibm\notes\8.5\include" /I "%ADKS_ROOT%\ibm\jdk\1.5\include" /D "WIN32" /D "NDEBUG" /D "_WINDOWS" /D "_USRDLL" /D "DOMCHDET_EXPORTS" /D "_CRT_SECURE_NO_WARNINGS" /D "NT" /D "_AMD64_" /D "HANDLE_IS_32BITS" /D "W32" /D "W64" /D "ND64" /D "_WINDLL" /D "_UNICODE" /D "UNICODE" /Fo"obj64\\" /Fd"bin64\domchdet.pdb" /FD /EHsc /MT /Gy /W3 /nologo /c /Zi /TC /errorReport:prompt DominoChangeDetection.c														
	
# delete linker generated files, if they already exist in the folder
clear_linker_files :
	rmdir /S /Q bin64
	mkdir bin64

# delete the OBJ file generated by the compiler, if it is present in the folder
clear_compiler_files :
	rmdir /S /Q obj64
	mkdir obj64
	
# create the "obj64" and "bin64" folders if they do not exist
create_obj_dir :
	IF NOT EXIST obj64 mkdir obj64
	IF NOT EXIST bin64 mkdir bin64