#commands for generating 32-bit domchdet.dll; domchdet.pdb is also generated (for debugging purposes)   

# target for linking the dll
link_dll : create_dirs clear_linker_files compile_source
	link /OUT:"bin\domchdet.dll" /INCREMENTAL:NO /NOLOGO /DLL /DEBUG /PDB:"bin\domchdet.pdb" /SUBSYSTEM:WINDOWS /OPT:REF /OPT:ICF /MACHINE:X86 /ERRORREPORT:PROMPT "%ADKS_ROOT%\ibm\notes\8.5\lib\32\notes.lib" obj\DominoChangeDetection.obj

# target for compiling the source files to DominoChangeDetection.obj
compile_source : clear_compiler_files DominoChangeDetection.c com_ibm_di_connector_DominoChangeDetectionConnector.h
	cl /O2 /Oi /GL /I "%ADKS_ROOT%\ibm\notes\8.5\include" /I "%ADKS_ROOT%\ibm\jdk\1.5\include" /D "WIN32" /D "NDEBUG" /D "_WINDOWS" /D "_USRDLL" /D "DOMCHDET_EXPORTS" /D "_CRT_SECURE_NO_WARNINGS" /D "NT" /D "HANDLE_IS_32BITS" /D "W32" /D "W64" /D "ND64" /D "_WINDLL" /D "_UNICODE" /D "UNICODE" /Fo"obj\\" /Fd"bin\domchdet.pdb" /FD /EHsc /MT /Gy /W3 /nologo /c /Zi /TC /errorReport:prompt DominoChangeDetection.c
	
# delete linker generated files, if they already exist in the folder
clear_linker_files :
	rmdir /S /Q bin
	mkdir bin

# delete the OBJ file generated by the compiler, if it is present in the folder
clear_compiler_files :
	rmdir /S /Q obj
	mkdir obj
	
# create the "obj" and "bin" folders if they do not exist.
create_dirs :
	IF NOT EXIST obj mkdir obj
	IF NOT EXIST bin mkdir bin